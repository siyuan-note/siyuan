							"TextMarkTextContent": "Main Menu"
						},
						{
							"Type": "NodeText",
							"Data": "​ - "
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "kbd",
							"TextMarkTextContent": "User Guide"
						},
						{
							"Type": "NodeText",
							"Data": " ​ to view it again"
						}
					]
				}
			]
		},
		{
			"ID": "20260614115050-7gcj2yx",
