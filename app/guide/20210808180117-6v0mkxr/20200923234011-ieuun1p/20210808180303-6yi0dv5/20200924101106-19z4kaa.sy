							"Children": [
								{
									"Type": "NodeText",
									"Data": "Multiple aliases can be set, separated by commas ("
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ","
								},
								{
									"Type": "NodeText",
