					"TextMarkTextContent": "Content Block/Reference"
				}
			]
		},
		{
			"ID": "20261024163828-lzw145z",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-lzw145z",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Create and reference a document"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20260927091603-y3kej6k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927091603-y3kej6k",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "After entering "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": " or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[["
				},
				{
					"Type": "NodeText",
					"Data": " and a document title, choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Choose location and create document"
				},
				{
					"Type": "NodeText",
					"Data": " in the reference suggestions to select a notebook root or a parent document. Confirm to create the document there and insert its reference at the original position. This location applies only to this creation and does not change the default save path."
				}
			]
		},
		{
			"ID": "20261024161816-s5676uo",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-s5676uo",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Canceling creates no document. This is available on desktop and mobile. This action is also available when binding or rebinding a database entry. The entry is bound to the new document only after the document has been created successfully; canceling or a creation failure leaves the original binding unchanged."
				}
			]
		},
		{
			"ID": "20261024163828-szunoty",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-szunoty",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Automatic closing and completion"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261014130425-k3pzlyv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-k3pzlyv",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Enable automatic closing in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Bidirectional Links"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Auto-close [[ or 【【"
				},
				{
					"Type": "NodeText",
					"Data": " enables automatic closing, which is off by default. When enabled, typing [[ or 【【 inserts the matching ]] or 】】 after the caret."
				}
			]
		},
		{
			"ID": "20261024164212-9kl4yx2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-9kl4yx2",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Typing the two closing brackets skips them and completes the reference. Selecting a candidate with Enter also replaces the closing brackets; Backspace inside an empty [[]] or 【【】】 deletes the entire pair."
				}
			]
		},
		{
			"ID": "20261014130425-jqqpiql",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-jqqpiql",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Completing a reference with ]] or 】】 first looks for a document with an exactly matching title, then a title matching without regard to case, then a matching daily note. If none match, a document is created at the configured location for reference creation."
				}
			]
		},
		{
			"ID": "20261024164212-a6pp30k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-a6pp30k",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "This does not apply in inline code, code blocks or inline math. Input method text is handled after it is committed, and closing brackets already supplied by the input method are preserved."
				}
			]
		},
