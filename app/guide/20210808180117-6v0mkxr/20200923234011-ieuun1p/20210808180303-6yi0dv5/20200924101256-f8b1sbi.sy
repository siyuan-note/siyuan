			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Insert a reference"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261024163828-j5aiqzx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-j5aiqzx",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Type "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": " in the editor, then enter keywords to find a block. Use the up and down arrow keys to select a result and press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " to insert the reference."
				}
			]
		},
		{
			"ID": "20261024163828-375t61d",
			"Type": "NodeParagraph",
			"Properties": {
