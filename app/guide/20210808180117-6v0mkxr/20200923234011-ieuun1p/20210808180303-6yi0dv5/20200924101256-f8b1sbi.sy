			"Properties": {
				"id": "20220623200920-67ob14v",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Block references link to existing content so that the same note can be used in different contexts. A reference appears as clickable anchor text; hovering over it previews the referenced block."
				}
			]
		},
		{
			"ID": "20261024163828-2skrjys",
			"Type": "NodeHeading",
			"Properties": {
