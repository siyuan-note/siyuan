					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Compact mode"
				},
				{
					"Type": "NodeText",
					"Data": " to reduce spacing in desktop toolbars, tabs, navigation lists, menus and dialogs, including when using the desktop interface in the tablet app. The change takes effect immediately and is off by default. Editor text size, document and database content, exports and the mobile interface are unchanged."
				}
			]
		},
		{
			"ID": "20261013113128-w8t5pmt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261013113128-w8t5pmt",
				"updated": "20261013113128"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Built-in light and dark themes support compact mode. With community themes, the effect depends on the theme's layout styles; some areas may retain their original spacing."
				}
			]
		},
