			]
		},
		{
			"ID": "20260920102915-3kq9ofr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-3kq9ofr",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Enable this feature in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Spell Check"
				},
				{
					"Type": "NodeText",
					"Data": ". Misspelled words are marked with wavy underlines."
				}
			]
		},
		{
			"ID": "20260920102915-8dfar3l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-8dfar3l",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Desktop app: right-click an underlined word and choose a spelling suggestion from SiYuan's menu. You can also add a correctly spelled word to the dictionary. Use a normal right-click without holding "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20260920102915-kl8nygu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-kl8nygu",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Browser: enable spell checking and select the languages to check in your browser settings. In Chrome, hold "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " and right-click an underlined word to open the browser's native spelling menu."
				}
			]
		},
		{
			"ID": "20260920102915-7eun9ey",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-7eun9ey",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When spell checking starts depends on the environment. After opening a document, even if the caret has been restored, you may need to click the document body and wait briefly for underlines to appear."
				}
			]
		},
		{
			"ID": "20260928091724-mshqwvb",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260928091724-mshqwvb",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Slash menu and toolbar customization"
				}
			]
		},
		{
			"ID": "20260927164841-n9zgr7r",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927164841-n9zgr7r",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "On mobile, open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Appearance"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Menu and button visibility and order"
				},
				{
					"Type": "NodeText",
					"Data": " and select the slash menu category while editing a custom profile. Mobile and desktop use the same profile settings for the total switch, candidate visibility, and order."
				}
			]
		},
		{
			"ID": "20261024164212-9kmphmj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-9kmphmj",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The default is on for desktop and off for mobile. Enable the switch, confirm to save, and activate the profile; then type / to search for content blocks and select a result to insert at the original cursor position."
				}
			]
		},
		{
			"ID": "20261024163013-3cctil8",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-3cctil8",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Edit and save a profile"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20260927164841-clwu05c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927164841-clwu05c",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In custom profiles, use the category selector to switch between the toolbar and slash menu. Drag the six-dot handle on the left of an item to change its order, or use its switch to change visibility. Drag near the list edge to scroll. Clear the search before sorting, and confirm to save the profile."
				}
			]
		},
		{
			"ID": "20261024161816-5rsqqov",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-5rsqqov",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Built-in profiles are read-only; duplicate one to customize it, then activate the saved profile. Profiles are stored on this device and are not synced across devices. New custom profiles based on Simple or Full follow future visibility defaults for entries you have not changed. An entry you toggle remains an explicit choice."
				}
			]
		},
		{
			"ID": "20261024161816-clrr7ge",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-clrr7ge",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Existing profiles retain their original visibility behavior; copying a profile or creating one based on Current preserves its inheritance and explicit choices. New profiles based on Simple or Full follow the default order as versions change until you customize a level. Based on Current and duplicate preserve existing custom orders."
				}
			]
		},
		{
			"ID": "20261024161816-aog0a1w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-aog0a1w",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Clear the search and use the reset icon in a column or dock group title to reset that level. To reset every level, use the refresh icon labeled Reset all orders on the right of the Position column title on desktop, or the Reset all orders button at the bottom on mobile."
				}
			]
		},
		{
			"ID": "20261024164212-hm3f99e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-hm3f99e",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Confirm to save; Cancel discards the changes. Resetting order preserves visibility and dock placement, and reset levels continue to follow future default order changes."
				}
			]
		},
		{
			"ID": "20261020212341-1sz2i9r",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261020212341-1sz2i9r",
				"updated": "20261020212341"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Backlinks at the bottom of documents"
				}
			],
			"HeadingLevel": 2
		},
