				{
					"Type": "NodeText",
					"Data": "On desktop and mobile, enable "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Bidirectional Links"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Show the backlinks panel at the bottom of the document"
				},
				{
					"Type": "NodeText",
					"Data": " to view backlinks and mentions at the end of the document. The panel loads as you approach it. It appears after the end of the document is loaded and is hidden when there are no results."
				}
			]
		}
	]
}
