				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Spell Check"
				},
				{
					"Type": "NodeText",
					"Data": ". Misspelled words are marked with wavy underlines."
				}
			]
		},
		{
			"ID": "20260920102915-8dfar3l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-8dfar3l",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Desktop app: right-click an underlined word and choose a spelling suggestion from SiYuan's menu. You can also add a correctly spelled word to the dictionary. Use a normal right-click without holding "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20260920102915-kl8nygu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-kl8nygu",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Browser: enable spell checking and select the languages to check in your browser settings. In Chrome, hold "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " and right-click an underlined word to open the browser's native spelling menu."
				}
			]
		},
		{
			"ID": "20260920102915-7eun9ey",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-7eun9ey",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When spell checking starts depends on the environment. After opening a document, even if the caret has been restored, you may need to click the document body and wait briefly for underlines to appear."
				}
			]
		}
