		{
			"ID": "20260905124213-swdj34k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905124213-swdj34k",
				"updated": "20260905124213"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Type / and choose Tabbed container to create two tabs. Click a title to switch tabs; double-click it or use the tab menu to edit it. Titles support the same inline formatting as callouts, and tab content can contain nested tabbed containers."
				}
			]
		},
		{
			"ID": "20260905124213-zh5dvu9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905124213-zh5dvu9",
				"updated": "20260905124213"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Use the menu beside the tabs to add, duplicate, delete or reorder tabs and choose a top or left layout. The active tab and layout are saved and synced with the document. Switching in a read-only view is temporary. Removing the tab layout preserves every title and its content in order."
				}
			]
		},
