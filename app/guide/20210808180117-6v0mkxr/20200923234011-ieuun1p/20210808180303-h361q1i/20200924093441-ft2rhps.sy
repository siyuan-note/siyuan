					"Data": "​ and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "template"
				},
				{
					"Type": "NodeText",
					"Data": "​, both equivalent. Using them enables syntax highlighting for "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20201204184532-3qm9l8n",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "SiYuan template"
				},
				{
					"Type": "NodeText",
					"Data": " syntax. When exporting as a template, the code block is not exported as a code block, but converted to plain paragraph text instead."
				}
			]
		},
