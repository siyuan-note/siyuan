			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A phrase consists of strings joined with "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "+"
				},
				{
					"Type": "NodeText",
					"Data": ". The tokenizer turns the input into tokens, and a phrase requires those tokens to match next to each other in order. Use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AND"
				},
				{
					"Type": "NodeText",
					"Data": " when several keywords must appear but do not need to be adjacent."
				}
			]
		},
