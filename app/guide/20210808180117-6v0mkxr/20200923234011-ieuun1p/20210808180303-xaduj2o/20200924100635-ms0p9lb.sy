			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Bookmark"
				}
			]
		},
		{
			"ID": "20210104091414-5n6da7j",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-5n6da7j",
				"updated": "20210702231509"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If you need to \"favorite\" content blocks, please open the attribute panel through the block icon menu, and then you can set bookmarks in the attribute panel."
				}
			]
		},
		{
			"ID": "20210104091414-b6lifws",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-b6lifws",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Bookmarked blocks appear in the bookmark panel ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": ", or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Control"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": " on macOS). To remove a bookmark, clear the block’s bookmark attribute or use the delete action in the bookmark panel. This removes the bookmark and leaves the block intact."
				}
			]
		},
		{
			"ID": "20210104091414-qp10fn0",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210104091414-qp10fn0",
				"updated": "20261122110650"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Tag"
				}
			]
		},
		{
			"ID": "20210104091414-x7yerg6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-x7yerg6"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The tag is used to mark the block in the content block. The syntax is to wrap the tag identifier with two "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": " in the first and one after the other, like this "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#Tag#"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20210104091414-4cl5j5v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-4cl5j5v"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Tag support hierarchical levels, so that content blocks can be sorted more easily. Use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " to separate different levels, like this "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#A/B/C#"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20210104091414-s3vdbdu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-s3vdbdu",
				"updated": "20261122110650"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open the tag panel ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌃"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": "​). On desktop, click a tag to see matching blocks in the Tag tab. Clicking another tag reuses that tab and leaves your global search intact. To remove a tag from a content block, delete it in the block."
				}
			]
		},
		{
			"ID": "20261118205131-c06a361",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261118205131-c06a361",
				"updated": "20261118205131"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In the tag panel, choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Sort"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Custom Sorting"
				},
				{
					"Type": "NodeText",
					"Data": " to reorder sibling tags by dragging their rows. On mobile, touch and hold a row before dragging it. The custom order is saved with your workspace data. If you delete a tag from the tag panel and later recreate it, it appears after sibling tags with a saved position. Clear the tag filter before reordering."
				}
			]
		},
		{
			"ID": "20261118220329-d6b4aaa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261118220329-d6b4aaa",
				"updated": "20261118220329"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In the tag panel, choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Sort"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Recently added"
				},
				{
					"Type": "NodeText",
					"Data": " to order tags at each level by their latest addition to a document or content block. Tags with no recorded addition time appear last."
				}
			]
		},
		{
			"ID": "20261116215152-c63f941",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261116215152-c63f941",
				"updated": "20261116220110"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In the tag panel menu, choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Rename"
				},
				{
					"Type": "NodeText",
					"Data": " to rename a tag and its subtags across documents. Undo the rename from any affected document, and redo it from that same document. Existing database entries and their field values are preserved."
				}
			]
		},
		{
			"ID": "20230928113947-gnlob5l",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20230928113947-gnlob5l",
				"updated": "20230928113958"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Note"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20230928113959-ebzf9zy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230928113959-ebzf9zy",
				"updated": "20231205225745"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Please do not use special symbols in bookmarks or tags, otherwise you will not be able to search globally, and you will not be able to rename and delete them in the bookmarks/tags panel. The \"special symbols\" here include: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "*"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "_"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "["
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "]"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "!"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "`"
				},
				{
					"Type": "NodeText",
					"Data": "​ , "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&amp;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~ "
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "("
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ")"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "="
				},
				{
					"Type": "NodeText",
					"Data": "​ and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": "​."
				}
			]
		}
	]
}
