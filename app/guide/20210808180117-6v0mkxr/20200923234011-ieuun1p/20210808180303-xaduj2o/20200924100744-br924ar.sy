				{
					"Type": "NodeText",
					"Data": "Image OCR to extract text"
				}
			]
		},
		{
			"ID": "20230117003636-0buf00n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230117003636-0buf00n",
				"updated": "20261001000112"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Assets"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "OCR"
				},
				{
					"Type": "NodeText",
					"Data": " select Tesseract or PaddleOCR and enable automatic OCR. Recognition runs offline in the kernel without an open interface. Tesseract requires a separate desktop installation."
				}
			]
		},
		{
			"ID": "20261001000112-e9wid3h",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261001000112-e9wid3h",
				"updated": "20261001000112"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "PaddleOCR includes PP-OCRv6 Tiny and Small models, available offline without downloading. Tiny uses fewer resources; Small offers higher accuracy. To import another compatible PP-OCRv6 model, select its detection and recognition ONNX files and the corresponding inference.yml files. Imported models sync with the workspace; the provider and selected model are saved per device."
				}
			]
		},
		{
			"ID": "20261001000112-ogz08vw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261001000112-ogz08vw",
				"updated": "20261001000112"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The selected provider handles both automatic and manual recognition. Switching preserves existing results; use the image menu to rerun OCR explicitly. Failures preserve the previous result and do not switch providers. Text remains available for image text search and editing. Encrypted notebooks do not participate in OCR."
				}
			]
		},
		{
			"ID": "20230202231728-0z5bs0m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230202231728-0z5bs0m",
				"updated": "20230801231949"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Note"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20230202231731-bdh7lab",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20230202231731-bdh7lab",
				"updated": "20261001013550"
			},
			"Children": [
				{
					"ID": "20230202231732-n7z8jth",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230202231732-n7z8jth",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20230202231732-f3jkj7p",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230202231732-f3jkj7p",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "When installing Tesseract OCR, you need to check the language pack you need, and add the installed Tesseract-OCR directory path to the environment variable "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "PATH"
								},
								{
									"Type": "NodeText",
									"Data": "​, so that SiYuan can directly call the "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "tesseract"
								},
								{
									"Type": "NodeText",
									"Data": "​ command to extract text from image OCR. If the installation is normal, you can search for "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "tesseract-ocr enabled"
								},
								{
									"Type": "NodeText",
									"Data": "​ in the kernel boot log; If you want to disable Tesseract, set the environment variable "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_ENABLED=false"
								},
								{
									"Type": "NodeText",
									"Data": "​"
								}
							]
						}
					]
				},
				{
					"ID": "20230202231800-z8hswmk",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230202231800-z8hswmk",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20230202231800-c3x45ky",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230202231800-c3x45ky",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "SiYuan"
								},
								{
									"Type": "NodeText",
									"Data": " does not enable all installed language packs, because too many language packs will cause OCR to be slow or time out, and take up too many system resources, so by default only "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "eng"
								},
								{
									"Type": "NodeText",
									"Data": "​​, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "chi*"
								},
								{
									"Type": "NodeText",
									"Data": "​​, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "fra"
								},
								{
									"Type": "NodeText",
									"Data": "​​, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "spa"
								},
								{
									"Type": "NodeText",
									"Data": "​​, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "deu"
								},
								{
									"Type": "NodeText",
									"Data": "​​, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "rus"
								},
								{
									"Type": "NodeText",
									"Data": "​​ and "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "osd"
								},
								{
									"Type": "NodeText",
									"Data": "​​ will be enabled at most, if you need more accurate language support, you can specify the language pack by configuring the environment variable "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_LANGS"
								},
								{
									"Type": "NodeText",
									"Data": "​​, such as "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_LANGS=chi_sim+eng"
								},
								{
									"Type": "NodeText",
									"Data": "​​"
								}
							]
						}
					]
				},
				{
					"ID": "20230211102830-9azqf9m",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230211102830-9azqf9m",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20230211102830-sbchex4",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230211102830-sbchex4",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Both providers support PNG, JPEG, TIFF, BMP, GIF, and WebP images; Tesseract also supports PBM, PGM, PPM, and PNM"
								}
							]
						}
					]
				},
				{
					"ID": "20230211102834-fx3o5su",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230211102834-fx3o5su",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20230211102834-3jzjdrv",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230211102834-3jzjdrv",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "For Tesseract, By default, only images below 2MB are processed. If you need to adjust, you can set the environment variable "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_MAX_SIZE"
								},
								{
									"Type": "NodeText",
									"Data": "​​, the unit of value is bytes, for example: "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_MAX_SIZE=4000000"
								},
								{
									"Type": "NodeText",
									"Data": "​​ adjust the upper limit to 4MB; PaddleOCR supports images up to 32 MiB and 24 million pixels"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20230117003636-ouxlaen",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230117003636-ouxlaen",
