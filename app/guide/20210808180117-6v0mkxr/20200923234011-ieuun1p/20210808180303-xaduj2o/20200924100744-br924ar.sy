				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Show image file names"
				},
				{
					"Type": "NodeText",
					"Data": " to show file names above local images, without the asset path or generated ID and with the extension preserved. Click a name to open the rename dialog. Confirming the new name updates all links that reference the asset; canceling leaves the name unchanged. Read-only views and encrypted notebooks do not support renaming from the image name."
				}
			]
		},
