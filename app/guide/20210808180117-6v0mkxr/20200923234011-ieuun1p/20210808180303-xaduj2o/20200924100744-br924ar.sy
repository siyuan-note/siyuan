			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When inserting an existing asset, keywords also match image titles, tooltip text, and existing OCR text. The same image may have different titles or tooltip text in different documents; any matching reference can locate the asset. Encrypted notebook assets are excluded from this global search."
				}
			]
