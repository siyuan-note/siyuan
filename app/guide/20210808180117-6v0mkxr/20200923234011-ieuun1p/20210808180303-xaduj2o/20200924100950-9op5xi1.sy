		{
			"ID": "20260924173802-6zzgsf2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260924173802-6zzgsf2",
				"updated": "20260926131843"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Select a list or one or more list items, then use the heading shortcuts above or choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Block menu"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Turn into"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Heading 1 block"
				},
				{
					"Type": "NodeText",
					"Data": " (or another heading level) to remove the selected items’ bullets or checkboxes and turn their first blocks into independent headings. Later paragraphs and nested lists stay in order, and unselected items remain lists. Selecting a whole list affects its immediate items only. To turn the first blocks into ordinary paragraphs, use the paragraph shortcut or choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Block menu"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Turn into"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Paragraph block"
				},
				{
					"Type": "NodeText",
					"Data": ". This also removes existing heading formatting. Block IDs, database bindings, and field values are preserved. Items whose first block is neither a paragraph nor a heading are skipped. Mobile uses the same block menu. With only a caret inside a paragraph or heading, the shortcut changes that block without removing its surrounding list."
				},
				{
					"Type": "NodeText",
					"Data": " To remove only the list structure while keeping headings and other content block types, choose "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Block menu"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Turn into"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Remove list"
				},
				{
					"Type": "NodeText",
					"Data": ". This works for a whole list or selected list items, preserves nested lists and content block IDs, database bindings, and field values, and is also available on mobile."
				}
			]
		},
