			"Children": [
				{
					"Type": "NodeText",
					"Data": "Overview"
				}
			]
		},
		{
			"ID": "20261024161440-m61l4ga",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161440-m61l4ga",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The tables list default shortcuts; after customization, use the bindings shown in settings. Values before and after a slash are for Windows/Linux and macOS respectively. On mobile, external-keyboard support depends on the operation."
				}
			]
		},
		{
			"ID": "20260908092714-3tm4lvq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260908092714-3tm4lvq",
				"updated": "20260921111101"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Keymap"
				},
				{
					"Type": "NodeText",
					"Data": ", you can assign multiple shortcuts to the same action. Right-click any shortcut except the first to make it the primary shortcut. When shortcuts are the same, the current local scope takes precedence over the general scope. To avoid interfering with normal text input, a single character alone or a single character combined with "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " cannot be set as a shortcut."
				}
			]
		},
		{
			"ID": "20261015193140-bd3r41i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015193140-bd3r41i",
				"updated": "20261015193140"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Keymap"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Element"
				},
				{
					"Type": "NodeText",
					"Data": " you can assign separate shortcuts to the Note, Tip, Important, Warning, and Caution callout blocks. All five are unassigned by default and also work with an external keyboard on mobile. Like the blockquote shortcut, they convert the current or selected blocks, or insert an empty callout when conversion is unavailable. Inside a callout, a different type changes its type; the same type removes the wrapper when it has one unfolded child, or inserts an empty callout after the current child when it has multiple children or a folded child."
				}
			]
		},
		{
			"ID": "20261011091952-wqpp0rc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011091952-wqpp0rc",
				"updated": "20261011091952"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Keymap"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "General"
				},
				{
					"Type": "NodeText",
					"Data": ", configure “Previous database entry” and “Next database entry” to switch between entries in the current preview using the source view’s filters and sort order. These shortcuts are unassigned by default and also work with an external keyboard on mobile. Navigation is available when the preview is opened from a database view; it stops at the first and last entries."
				}
			]
		},
		{
			"ID": "20261002010621-zd9bn2e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002010621-zd9bn2e",
				"updated": "20261002013053"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The shortcuts for the command palette, recent documents, data history, flashcard review, inline appearance, main menu, and tab list open their panels. Pressing the shortcut again keeps the panel open. Press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " to close it; if an editor popup is visible, Esc closes that popup first. In flashcard content, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " selects blocks. Hold "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " to focus the review buttons, then press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " to close the dialog."
				}
			]
		},
