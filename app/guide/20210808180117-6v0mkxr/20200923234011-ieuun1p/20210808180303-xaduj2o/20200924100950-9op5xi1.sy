		{
			"ID": "20261002230606-fd59093",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002230606-fd59093",
				"updated": "20261016013311"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When a code block has no individual "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Number of Tab Spaces"
				},
				{
					"Type": "NodeText",
					"Data": " setting, indenting or outdenting detects consistent indentation from at least two nonblank lines and saves it for that block. Tabs or the smallest space indent of 2, 4, 6, or 8 spaces are recognized; other space indents must be multiples of that width. Mixed indentation or insufficient evidence falls back to "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Behavior"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Number of Tab Spaces"
				},
				{
					"Type": "NodeText",
					"Data": ". An explicit block setting takes precedence. Detection does not reformat existing code."
				}
			]
		},
