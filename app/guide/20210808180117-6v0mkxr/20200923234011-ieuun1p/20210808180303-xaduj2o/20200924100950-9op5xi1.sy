				"updated": "20261010202520"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When the tab bar has focus, Left and Right move focus between top tabs; Up and Down move focus between left tabs. Arrow keys in the content keep their normal editing behavior."
				},
				{
					"Type": "NodeText",
					"Data": " While editing a tab title, press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab"
				},
				{
					"Type": "NodeText",
					"Data": " to finish editing and move to the content. Clicking the content also ends title editing."
				},
				{
					"Type": "NodeText",
					"Data": " Up and Down move between surrounding blocks, the active tab title, and its content. At the start or end of a tab title, Left and Right keep the caret inside the title."
				},
				{
					"Type": "NodeText",
					"Data": " Press Esc while editing a tab title to finish editing and keep the current text."
				}
			]
		},
