				{
					"Type": "NodeText",
					"Data": "While editing a node, Enter in its first paragraph creates a sibling and continues editing there; text after the caret and subsequent content blocks move to the new node. At the start of a nonempty first paragraph, it inserts an empty node before the current node. Tab and Shift+Tab move the whole branch while preserving its child nodes. Merge adjacent nodes with Backspace at the start or Delete at the end to keep multiple paragraphs in one node. Other content blocks retain their normal Enter behavior, and code blocks, tables, input methods and suggestion menus retain their editing controls. Existing customized editor shortcuts take precedence."
				}
			]
		},
		{
			"ID": "20261020162345-sclp2zh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020162345-sclp2zh",
				"updated": "20261020162345"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Drag with the left mouse button on blank canvas to select several nodes. Hold "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Command"
				},
				{
					"Type": "NodeText",
					"Data": " on macOS) and click a node to toggle its selection. On touch screens, select a node and enable "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Multi-select"
				},
				{
					"Type": "NodeText",
					"Data": " at the bottom, then tap nodes individually. Tap the button again or press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " to leave this mode. Copy and cut include complete subtrees; selecting both a parent and its descendants copies the branch once. Copies retain node styles, internal connections and complete summaries. The root cannot be cut. Failed clipboard writes and systems that support only plain text leave the original nodes intact."
				}
			]
		},
		{
			"ID": "20260930234403-5eh3gn8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930234403-5eh3gn8",
				"updated": "20261020162345"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "With one node selected, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl+V"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘V"
				},
				{
					"Type": "NodeText",
					"Data": " pastes as child nodes, and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl+Shift+V"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⇧⌘V"
				},
				{
					"Type": "NodeText",
					"Data": " pastes as sibling nodes. The bottom "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "More"
				},
				{
					"Type": "NodeText",
					"Data": " menu also provides copy, cut and both paste actions. Copied mind map nodes retain their hierarchy; ordinary text, images and content blocks are inserted through a new node's editor. While editing node text, paste uses the normal content editor behavior. Wait for an image upload to finish before leaving node editing."
				}
			]
		},
		{
			"ID": "20260926152753-8trdt10",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926152753-8trdt10",
				"updated": "20261024124323"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Select one or more nodes, then activate "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Summary"
				},
				{
					"Type": "NodeText",
					"Data": " in the bottom node menu to create all valid groups in one undoable operation and edit the first new summary. Esc on the canvas leaves multi-select mode. While editing summary text, Enter saves and Esc cancels the text edit. Delete or Backspace removes the selected summary."
				},
				{
					"Type": "NodeText",
					"Data": " When a color or width panel is open, Escape closes it and cancels any unsaved width preview."
				}
			]
		},
		{
			"ID": "20261001015635-5eooc5g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261001015635-5eooc5g",
				"updated": "20261001015635"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When a mind map resize handle has keyboard focus, use the arrow keys to adjust its width or height by 10 px, or hold "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " with an arrow key for 1 px steps. These keys apply only to the focused resize handle. Press "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " during a drag to cancel resizing."
				}
			]
		},
