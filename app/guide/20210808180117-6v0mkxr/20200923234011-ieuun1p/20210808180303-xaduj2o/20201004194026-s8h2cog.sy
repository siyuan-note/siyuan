			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "On this computer, open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
