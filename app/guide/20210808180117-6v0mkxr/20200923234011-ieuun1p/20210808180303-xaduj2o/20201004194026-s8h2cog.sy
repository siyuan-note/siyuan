			]
		},
		{
			"ID": "20221025092947-gd0wmbi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20221025092947-gd0wmbi",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "On this computer, open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Authentication"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Server"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Use on browser"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Open browser"
				},
				{
					"Type": "NodeText",
					"Data": " in the running app. Keep the kernel running and use the address it opens, including its port."
				}
			]
		},
		{
			"ID": "20221025092947-5m97t0e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20221025092947-5m97t0e",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "For another device on the same LAN, first configure a lock screen password or a valid configuration for "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804190002-oidcen1",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "OIDC login"
				},
				{
					"Type": "NodeText",
					"Data": ", enable "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Authentication"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Server"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Network serving"
				},
				{
					"Type": "NodeText",
					"Data": ", and reopen SiYuan after it exits. Then use the kernel computer’s LAN IP in place of "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "127.0.0.1"
				},
				{
					"Type": "NodeText",
					"Data": ", keeping the displayed port. The firewall must allow that port. For public-network access, the following deployment options are available:"
				}
			]
		},
		{
			"ID": "20210104091447-6y4386v",
