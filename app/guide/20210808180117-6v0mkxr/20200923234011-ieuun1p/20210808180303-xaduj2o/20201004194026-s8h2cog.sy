			"Type": "NodeParagraph",
			"Properties": {
				"id": "20221025092947-5m97t0e",
				"updated": "20231022211844"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In addition to the use of the local LAN, the use of the public network can be achieved by the following two methods:"
				}
			]
		},
		{
			"ID": "20210104091447-6y4386v",
