							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613180619-6qfwhs6",
								"updated": "20260613180619"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Shortcut Behavior"
								},
								{
									"Type": "NodeText",
									"Data": ": When using the shortcut to open a diary, it uses the last selected notebook"
								}
							]
						}
					]
				},
				{
					"ID": "20260613180619-4cz2avf",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613180619-4cz2avf",
						"updated": "20261027135536"
					},
					"Children": [
						{
							"ID": "20260613180619-byb9lcr",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613180619-byb9lcr",
								"updated": "20261027135536"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Opening behavior"
								},
								{
									"Type": "NodeText",
									"Data": ": The button and shortcut open the document at the name and location resolved from today's save path template, or create it if missing. They do not search by the daily note date attribute, so renaming or moving the original can cause another daily note to be created"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261008101708-b7c9jyj",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261008101708-b7c9jyj",
				"updated": "20261027135536"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Create and reference daily notes by date"
				}
			]
		},
		{
			"ID": "20261008101708-65762qi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-65762qi",
				"updated": "20261008101708"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Type "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[today"
				},
				{
					"Type": "NodeText",
					"Data": ", "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[tomorrow"
				},
				{
					"Type": "NodeText",
					"Data": ", or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[25 sept"
				},
				{
					"Type": "NodeText",
					"Data": " in the editor to show a daily note candidate in reference completion. Relative dates and full or abbreviated month names are recognized in the interface language and English. Complete Gregorian dates such as "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[2026-09-25"
				},
				{
					"Type": "NodeText",
					"Data": " are also supported."
				}
			]
		},
		{
			"ID": "20261008101708-8o948mt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-8o948mt",
				"updated": "20261008172530"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Dates without a year use the current year. Candidates display the actual document name or the name resolved from the creation template, the full path, and the target date. Existing daily note icons support hover previews. For ambiguous expressions such as "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "03/04"
				},
				{
					"Type": "NodeText",
					"Data": " or invalid dates, no daily note candidate is shown. Use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "YYYY-MM-DD"
				},
				{
					"Type": "NodeText",
					"Data": ". Regular document search remains available."
				}
			]
		},
		{
			"ID": "20261008101708-3n0qxms",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-3n0qxms",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Candidates use the last selected daily note notebook. If none is selected or that notebook is unavailable, candidates show the full paths for available notebooks. Selecting a candidate saves its notebook as the daily note notebook."
				}
			]
		},
		{
			"ID": "20261024164212-v6e0cgk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-v6e0cgk",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Leaving candidates unselected creates no document. Encrypted notebooks can reference daily notes only within the same notebook; ordinary notebooks cannot reference daily notes in encrypted notebooks."
				}
			]
		},
		{
			"ID": "20261008101708-yprxiyp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-yprxiyp",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Typing and viewing candidates create no document. Missing daily notes display New daily note and a calendar-plus icon. Moving the caret after a creation request does not cancel insertion at the original input position; modified or deleted input is not overwritten."
				}
			]
		},
		{
			"ID": "20261024164212-ma3a2a1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-ma3a2a1",
				"updated": "20261027135536"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Selecting a candidate first searches the target notebook by the daily note date attribute, including moved or renamed documents that retain it. If several match, the document at the template name and location is preferred; otherwise, the one with the smallest ID is used. If the ordinary button creates another daily note at that location, date candidates will prefer it. Neither entry point reapplies the content template when reusing a document."
				}
			]
		},
		{
			"ID": "20261024161816-m4mro3d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-m4mro3d",
				"updated": "20261027135536"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If no date attribute matches, the document at the template name and location is reused or created, and a reference is inserted. The path template, now in the content template, and the daily note date attribute use the target date; actual creation and update timestamps retain the real operation time."
				}
			]
		},
		{
			"ID": "20260613180619-9fh070b",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260613180619-9fh070b",
				"updated": "20261024163429"
