							"ID": "20260613180619-byb9lcr",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613180619-byb9lcr",
								"updated": "20260613180619"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "First Open"
								},
								{
									"Type": "NodeText",
									"Data": ": When opening the diary for today, if a document for that date does not yet exist, the system creates one based on the configured save path and template; if it already exists, it opens directly"
								}
							]
						}
					]
				}
