		{
			"ID": "20261008101708-b7c9jyj",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261008101708-b7c9jyj",
				"updated": "20261008172530"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Create and reference daily notes by date"
				}
			]
		},
		{
			"ID": "20261008101708-65762qi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-65762qi",
				"updated": "20261008101708"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Type "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[today"
				},
				{
					"Type": "NodeText",
					"Data": ", "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[tomorrow"
				},
				{
					"Type": "NodeText",
					"Data": ", or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[25 sept"
				},
				{
					"Type": "NodeText",
					"Data": " in the editor to show a daily note candidate in reference completion. Relative dates and full or abbreviated month names are recognized in the interface language and English. Complete Gregorian dates such as "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[[2026-09-25"
				},
				{
					"Type": "NodeText",
					"Data": " are also supported."
				}
			]
		},
		{
			"ID": "20261008101708-8o948mt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-8o948mt",
				"updated": "20261008172530"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Dates without a year use the current year. Candidates display the actual document name or the name resolved from the creation template, the full path, and the target date. Existing daily note icons support hover previews. For ambiguous expressions such as "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "03/04"
				},
				{
					"Type": "NodeText",
					"Data": " or invalid dates, no daily note candidate is shown. Use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "YYYY-MM-DD"
				},
				{
					"Type": "NodeText",
					"Data": ". Regular document search remains available."
				}
			]
		},
		{
			"ID": "20261008101708-3n0qxms",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-3n0qxms",
				"updated": "20261008172530"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Candidates use the last selected daily note notebook. If none is selected or that notebook is unavailable, candidates show the full paths for available notebooks. Selecting a candidate saves its notebook as the daily note notebook. Leaving candidates unselected creates no document. Encrypted notebooks can reference daily notes only within the same notebook; ordinary notebooks cannot reference daily notes in encrypted notebooks."
				}
			]
		},
		{
			"ID": "20261008101708-yprxiyp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008101708-yprxiyp",
				"updated": "20261008172530"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Typing and viewing candidates create no document. Missing daily notes display New daily note and a calendar-plus icon. Moving the caret after a creation request does not cancel insertion at the original input position; modified or deleted input is not overwritten. Selecting a candidate reuses the daily note for that date in the target notebook, including moved or renamed documents that retain their daily note date attribute. If none exists, the daily note settings are used to create it and insert a reference. The path template, now in the content template, and the daily note date attribute use the target date; actual creation and update timestamps retain the real operation time."
				}
			]
		},
		{
			"ID": "20260613180619-9fh070b",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260613180619-9fh070b",
