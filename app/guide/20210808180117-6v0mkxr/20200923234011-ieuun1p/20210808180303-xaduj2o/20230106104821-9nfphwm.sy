			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Closing a window or opening another workspace does not necessarily close the original workspace. If you specify a workspace with the "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": " parameter, update the path in your startup command or shortcut to the renamed folder's path before restarting."
				}
			]
		},
