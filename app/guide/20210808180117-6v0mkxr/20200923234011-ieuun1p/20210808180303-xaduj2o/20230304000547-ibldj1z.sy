							"Children": [
								{
									"Type": "NodeText",
									"Data": "Use "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/AI writing"
								},
								{
									"Type": "NodeText",
									"Data": " to open the writing dialog. For AI editing, select text and choose "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "AI Edit"
								},
								{
									"Type": "NodeText",
									"Data": " in the selection toolbar, or choose it from the block menu. The result streams into a panel where you can replace or insert it, copy it, retry, stop, or discard it. Replacement is available only for a supported selection within one block. Cross-block selections, complex sources, and sources changed while generating can still use insertion."
								}
							]
						}
					]
