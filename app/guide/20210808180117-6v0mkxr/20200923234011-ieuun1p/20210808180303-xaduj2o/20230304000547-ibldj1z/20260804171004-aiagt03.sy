			"Children": [
				{
					"Type": "NodeText",
					"Data": "Data snapshots and rollback"
				}
			]
		},
		{
			"ID": "20260804170110-f3ewu2w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170110-f3ewu2w",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Before the first write to workspace data in a task turn, the agent automatically creates a data snapshot, with at most one snapshot per turn. If the result is not acceptable, use the rollback action on the snapshot notice in the session."
				}
			]
		},
		{
			"ID": "20260804170111-loi92zi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170111-loi92zi",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The snapshot covers workspace data, but not changes made to external systems by external MCP services or plugins. Regenerating an answer, stopping a task, or deleting a session also does not automatically undo completed write operations."
				}
			]
		},
		{
