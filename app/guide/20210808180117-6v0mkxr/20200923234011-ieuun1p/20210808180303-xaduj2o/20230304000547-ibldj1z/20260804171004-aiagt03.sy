				}
			]
		},
		{
			"ID": "20260804170056-8tp1qi0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170056-8tp1qi0",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A stdio service inherits only the kernel environment variables selected by the user and reads their current values whenever it starts. Its environment variable entries can also reference secrets and variables. Referencing a secret provides its plaintext value to the program and its child processes; directly entered values are stored in plaintext. HTTP services that require authorization guide you through OAuth. Store reusable secrets and parameters in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Secrets and Variables"
				},
				{
					"Type": "NodeText",
					"Data": ". For details, see "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804185002-secvr03",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Secrets and Variables"
				},
				{
					"Type": "NodeText",
					"Data": ". External MCP tools may send local data, change external systems, or incur charges; review the effects shown on confirmation cards."
				}
			]
		},
		{
			"ID": "20260804170057-8amo72d",
