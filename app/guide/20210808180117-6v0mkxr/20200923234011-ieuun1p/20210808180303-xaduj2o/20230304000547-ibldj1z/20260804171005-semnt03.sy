			"Children": [
				{
					"Type": "NodeText",
					"Data": "Embedding index"
				}
			]
		},
		{
			"ID": "20260804170135-ebuv3e8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170135-ebuv3e8",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "After the embedding model is enabled, SiYuan generates vectors for eligible blocks in the background. Vectors are updated automatically when content is created or changed."
				}
			]
		},
