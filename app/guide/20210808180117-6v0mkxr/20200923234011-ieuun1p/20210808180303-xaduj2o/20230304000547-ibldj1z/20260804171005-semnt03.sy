				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Rebuild embedding index"
				},
				{
					"Type": "NodeText",
					"Data": ". Rebuilding clears existing vectors and recalculates them in the background, so semantic search results may be incomplete until it finishes."
				}
