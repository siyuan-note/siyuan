				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Overview"
				}
			]
		},
		{
			"ID": "20260804170125-j1n3peq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170125-j1n3peq",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Semantic search finds content with similar meaning by comparing text vectors. Full-text search depends on the presence of keywords, while semantic search can find notes that use different wording for related topics."
				}
			]
		},
		{
			"ID": "20260804170126-6x70vu9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170126-6x70vu9",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Configuration"
				}
			]
		},
		{
			"ID": "20260804170127-3fpyace",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170127-3fpyace",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Embedding model"
				}
			]
		},
		{
			"ID": "20260804170128-jeg9t7v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170128-jeg9t7v",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Enable "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Semantic Search"
				},
				{
					"Type": "NodeText",
					"Data": " in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Artificial Intelligence"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Embedding Model"
				},
				{
					"Type": "NodeText",
					"Data": ", then configure the API base URL, API key, model, vector dimensions, and timeout. Use the connection test to verify the model."
				}
			]
		},
		{
			"ID": "20260804170129-j6gqedu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170129-j6gqedu",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Set vector dimensions to 0 to use the model default. Specify another value only when the target model supports custom dimensions. Rebuild the embedding index after changing the model or dimensions."
				}
			]
		},
		{
			"ID": "20260804170130-y6xqvqi",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170130-y6xqvqi",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Rerank model"
				}
			]
		},
		{
			"ID": "20260804170131-56r9zeg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170131-56r9zeg",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The rerank model is optional. When enabled, it scores the candidates retrieved by vector search again to improve result ordering. A larger candidate count can improve accuracy but also increases latency and cost."
				}
			]
		},
		{
			"ID": "20260804170132-b16r2xu",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170132-b16r2xu",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "How to use"
				}
			]
		},
		{
			"ID": "20260804170133-5hntadu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170133-5hntadu",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open full-text search, select "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Semantic Search"
				},
				{
					"Type": "NodeText",
					"Data": " under "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Search Method"
				},
				{
					"Type": "NodeText",
					"Data": ", and describe the content in natural language. Notebook, path, and block-type filters remain available."
				}
			]
		},
		{
			"ID": "20260804170134-hmpxo2z",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170134-hmpxo2z",
