			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Plugins extend menus, panels, editor interactions, and other SiYuan features. They can also provide custom block rendering."
				}
			]
		},
		{
			"ID": "20230512195420-9550ilh",
