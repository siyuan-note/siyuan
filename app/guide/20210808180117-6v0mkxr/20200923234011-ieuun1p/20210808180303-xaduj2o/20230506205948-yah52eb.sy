					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20210824202056-udkf7wg",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "widgets"
				},
				{
					"Type": "NodeText",
					"Data": " for self-contained tools embedded in a document. Choose a suitable plugin for features that integrate with SiYuan’s interface and workflows."
