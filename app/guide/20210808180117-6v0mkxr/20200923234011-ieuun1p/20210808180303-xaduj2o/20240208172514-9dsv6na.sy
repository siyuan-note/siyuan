						"id": "20260613171129-ksd0v5v",
						"updated": "20260920084445"
					},
					"Children": [
						{
							"ID": "20260613171129-l092i7g",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613171129-l092i7g",
								"updated": "20260920084445"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Removing Groups"
								},
								{
									"Type": "NodeText",
									"Data": ": In table, list, and gallery views, select \"None\" to remove grouping; kanban view cannot remove grouping"
