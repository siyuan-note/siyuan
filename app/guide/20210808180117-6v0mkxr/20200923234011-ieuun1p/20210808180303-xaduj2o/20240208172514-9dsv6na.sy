									"Type": "NodeText",
									"Data": "Use "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{index . \"custom-xxx\"}"
								},
								{
									"Type": "NodeText",
									"Data": "​ to access block custom attributes"
								}
							]
						}
					]
				},
