									"TextMarkTextContent": ".action{index . \"entryUpdated\"}"
								},
								{
									"Type": "NodeText",
									"Data": "​ to access the update time of the row's bound block"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240208173416-r12kam0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208173416-r12kam0",
				"updated": "20240208173710"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "For example, the following "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Bills"
				},
				{
					"Type": "NodeText",
					"Data": "​ database "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Template"
				},
				{
					"Type": "NodeText",
					"Data": "​ field demonstrates the sum of "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Food"
				},
				{
					"Type": "NodeText",
					"Data": "​ and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Clothing"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20240208173526-0q14afa",
			"Type": "NodeAttributeView",
			"Properties": {
				"id": "20240208173526-0q14afa",
				"updated": "20250101093657"
			},
			"AttributeViewID": "20240208173528-oq4elsj",
			"AttributeViewType": "table"
		},
		{
			"ID": "20260830120000-a1dspen",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260830120000-a1dspen",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Display templates"
				}
			]
		},
		{
			"ID": "20260830120001-b2dspen",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120001-b2dspen",
				"updated": "20260830120001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A normal field can use a display template without changing its field type. Open the field menu from the column header and enter the template in the template input at the bottom. The template changes only the displayed content; editing the cell still reads and writes the original stored value. Template, rollup, line number, created time, and updated time fields do not support display templates."
				}
			]
		},
		{
			"ID": "20260830120002-c3dspen",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120002-c3dspen",
				"updated": "20260830124002"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Display templates use the same Go template syntax as template snippets, with "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{"
				},
				{
					"Type": "NodeText",
					"Data": " and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": " delimiters, and may include HTML. For example, if the Progress field stores 42, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;progress value=\".action{.Progress}\" max=\"100\"&gt;&lt;/progress&gt; .action{.Progress}%"
				},
				{
					"Type": "NodeText",
					"Data": " displays a progress bar at 42% followed by the text 42%. HTML is sanitized by default."
				}
			]
		},
		{
			"ID": "20260830120003-d4dspen",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120003-d4dspen",
				"updated": "20260830122003"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Fields in the same row can be referenced by name. For example, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;strong&gt;.action{.Name}&lt;/strong&gt;: .action{.Progress}%"
				},
				{
					"Type": "NodeText",
					"Data": " combines the Name and Progress fields. For a field name containing spaces or symbols, use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index . \"Project Name\"}"
				},
				{
					"Type": "NodeText",
					"Data": ". To avoid ambiguity caused by duplicate or renamed fields, use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index .id_mod \"FieldID\"}"
				},
				{
					"Type": "NodeText",
					"Data": " to reference a field by ID."
				}
			]
		},
		{
			"ID": "20260830120004-e5dspen",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120004-e5dspen",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A display template reads each field's original stored value, not the display result produced by another display template. Filters, sorts, and groups can use either the original value or the template-rendered value."
				}
			]
		},
		{
			"ID": "20261024164212-gdqa5ya",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-gdqa5ya",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Clear the display template to restore the field's original display. Relation fields follow the display template of the target database's primary key, including empty results, while preserving the original primary key value and relation."
				}
			]
		},
		{
			"ID": "20261002224707-n5wvv5s",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261002224707-n5wvv5s",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Automations"
				}
			]
		},
		{
			"ID": "20261024163013-narckt9",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-narckt9",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Configure a rule"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-5by05dc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-5by05dc",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In a database view, open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Automations"
				},
				{
					"Type": "NodeText",
					"Data": " to add a rule. Changes are saved automatically; text is saved when the field loses focus or Enter is pressed. New rules are disabled by default. Incomplete rules are automatically disabled and show what is missing; enable them manually after completing the configuration."
				}
			]
		},
		{
			"ID": "20261024161816-343hmt7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-343hmt7",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Rules are shared by the entire database and can be triggered by item changes in any view or mirror"
				},
				{
					"Type": "NodeText",
					"Data": ". If a referenced field is deleted or its type changes, or a target database is deleted, the next item write automatically pauses the affected rule and identifies the rule and missing reference."
				}
			]
		},
		{
			"ID": "20261024164212-qox2ysv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-qox2ysv",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The source edit is saved and the rule configuration is retained; repair it and enable the rule manually. Locked databases, authentication failures, corrupt data, and write failures still roll back the edit and automatic actions."
				}
			]
		},
		{
			"ID": "20261017202044-s3bkzez",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017202044-s3bkzez",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Notify on success is enabled by default and can be set independently for each rule. It reports actual additions, updates, or collections after the entire transaction commits; several rules share one summary, counting only rules with notifications enabled."
				}
			]
		},
		{
			"ID": "20261024164212-c61ag21",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-c61ag21",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Updating several fields of one entry counts as one updated entry. Turning notifications off does not stop execution or hide errors. Unmatched conditions, missing targets, unchanged values, repeated matches, manual collection or cleanup, undo, redo, and failed transactions do not produce success messages."
				}
			]
		},
		{
			"ID": "20261024163013-y4ij593",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-y4ij593",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Triggers"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-ayryj7q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-ayryj7q",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Configure a rule in three sections: “When this event occurs”, “And the triggering item matches (optional)”, and “Run these actions”. Choose added items or changed fields as the event. A field-change trigger can watch one field or any editable field; writing the same value again does not trigger it. The second section checks the triggering item's values after the change; leaving it empty adds no restriction."
				}
			]
		},
		{
			"ID": "20261024163013-29a3zep",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-29a3zep",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Actions and values"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-hrqksxn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-hrqksxn",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Each rule can run several actions in order. Choose the operation and its target, then add the fields to set and their value sources. Editing supports the triggering item, related items, or items matching filters in a selected database."
				}
			]
		},
		{
			"ID": "20261024164212-og3pxc9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-og3pxc9",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Conditions inside an action filter the items to modify, not the triggering item; empty target conditions match all items in that target. Adding creates an unbound item in this or another database."
				}
			]
		},
		{
			"ID": "20261002224707-x0qa1o9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-x0qa1o9",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Action values can use a fixed value, a source field of a compatible type, the trigger time, a relation to the triggering item, or a calculated template. Trigger time applies to date fields; triggering-item relations require a relation field pointing to the source database. Editing primary text preserves the existing binding and icon."
				}
			]
		},
		{
			"ID": "20261024163013-wiw3yku",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-wiw3yku",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Set values with templates"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261016165601-kcsjytv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-kcsjytv",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Choose Template as the value source to edit a "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{...}"
				},
				{
					"Type": "NodeText",
					"Data": " template inline. Editing a template pauses the rule; enable it again after editing. Every editable field supports templates; computed fields such as creation time, update time, row number, rollup, and template fields cannot be assigned. Primary fields retain their existing binding."
				}
			]
		},
		{
			"ID": "20261016165601-v82xurl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-v82xurl",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "For example, when a watering task is completed, add the next task and set its date to "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{((now).AddDate 0 0 7).Format \"2006-01-02\"}"
				},
				{
					"Type": "NodeText",
					"Data": ". "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "now"
				},
				{
					"Type": "NodeText",
					"Data": " is fixed to the trigger time, and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate 0 0 7"
				},
				{
					"Type": "NodeText",
					"Data": " advances seven calendar days. The rule saves the frontend time zone when templates are first used and keeps that zone across devices."
				}
			]
		},
		{
			"ID": "20261016165601-r1dfdx7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-r1dfdx7",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "field \"fieldID\""
				},
				{
					"Type": "NodeText",
					"Data": " reads a source item's stored value; dates support "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate"
				},
				{
					"Type": "NodeText",
					"Data": ". Renaming a field does not change its ID reference. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "value \"fieldID\""
				},
				{
					"Type": "NodeText",
					"Data": " reads a structured payload, and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "toJson"
				},
				{
					"Type": "NodeText",
					"Data": " outputs JSON. For example, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{toJson (dateAdd 0 0 7 (value \"fieldID\"))}"
				},
				{
					"Type": "NodeText",
					"Data": " advances both ends of a date range while preserving its date-only or specific-time setting."
				}
			]
		},
		{
			"ID": "20261016165601-l1uq6e6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-l1uq6e6",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Text, URL, email, and phone fields use text. Numbers must be finite, and checkboxes use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "true"
				},
				{
					"Type": "NodeText",
					"Data": " or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "false"
				},
				{
					"Type": "NodeText",
					"Data": ". Dates accept ISO dates, date-times, or date payload JSON. Select uses an existing option name; multi-select uses a JSON array of names or option objects. Relations use existing item ID arrays; assets and locations use their existing payload JSON. Templates do not create options, related items, or assets."
				}
			]
		},
		{
			"ID": "20261016165601-tphvdoa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-tphvdoa",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Expand Data used for preview, select an actual example entry, and adjust the preview date or referenced fields before viewing the result. These inputs do not modify entries. Empty output clears the field; missing variables, empty source dates, invalid types, or invalid references roll back the triggering edit and all actions."
				}
			]
		},
		{
			"ID": "20261024161816-coesny2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-coesny2",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Results are stored once, and redo reuses them. SQL, files, network access, loops, and recursion are unavailable. Source is limited to 8 KiB; each input and output to 64 KiB. Saving templates requires a client supporting automation format 2; older clients explicitly reject the database. Existing format 1 rules remain compatible."
				}
			]
		},
		{
			"ID": "20261016174753-qsam7m8",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261016174753-qsam7m8",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Template examples"
				}
			]
		},
		{
			"ID": "20261016174753-9j350k4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016174753-9j350k4",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Copy a complete example into the template editor. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "FIELD_ID"
				},
				{
					"Type": "NodeText",
					"Data": " is a placeholder: replace it with the source field ID in the triggering item's database, not the field name. When copying a field, use matching source and target types. When copying relations, both relation fields must also point to the same database."
				}
			]
		},
		{
			"ID": "20261016174753-knf2f34",
			"Type": "NodeTable",
			"TableAligns": [
				0,
				0
			],
			"Properties": {
				"id": "20261016174753-knf2f34",
				"updated": "20261016174753"
			},
			"Children": [
				{
					"Type": "NodeTableHead",
					"Children": [
						{
							"Type": "NodeTableRow",
							"Children": [
								{
									"Type": "NodeTableCell",
									"Children": [
										{
											"Type": "NodeText",
											"Data": "Use"
										}
									]
								},
								{
									"Type": "NodeTableCell",
									"Children": [
										{
											"Type": "NodeText",
											"Data": "Template content"
										}
									]
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date: trigger day"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{now | date \"2006-01-02\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date: seven days after the trigger"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{((now).AddDate 0 0 7).Format \"2006-01-02\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date: move a source date or range forward seven days, preserving time settings"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{toJson (dateAdd 0 0 7 (value \"FIELD_ID\"))}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Text, primary, URL, email, or phone: copy a source field"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{field \"FIELD_ID\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Text or primary: append a suffix to source text"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{field \"FIELD_ID\"} (next)"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Number: add one to the source number, including decimals"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{addf (field \"FIELD_ID\") 1}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Checkbox: invert the source value"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{not (field \"FIELD_ID\")}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Select: use an existing option"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Done"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Multi-select: use two existing options"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "[\"Work\",\"Important\"]"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date, multi-select, relation, asset, or location: copy a source field of the same type"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{toJson (value \"FIELD_ID\")}"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261016174753-dmprrcl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016174753-dmprrcl",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": ""
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "2006-01-02"
				},
				{
					"Type": "NodeText",
					"Data": " is a fixed date format layout; do not replace it with the current date. The option names in the select and multi-select examples must already exist in the target field; replace them as needed. Check the preview before enabling the rule."
				}
			]
		},
		{
			"ID": "20261024164212-aksjfz7",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024164212-aksjfz7",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Rule examples"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261016113125-e9334a5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016113125-e9334a5",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "For example, to record the first completion time, watch changes to Status, require the triggering item's Status to be Done and Completion time to be empty, then edit the triggering item and set Completion time to Trigger time. After completing the configuration, enable the rule. Without the empty-time condition, completing the item again can overwrite its completion time."
				}
			]
		},
		{
			"ID": "20261002224707-s9ne4gk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-s9ne4gk",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "For example, create a two-way relation between a task database and a time-log database. When a task status changes to In progress, add a log with its start date set to the trigger time and its relation set to the triggering task. When the status changes to Done, edit related logs whose end date is empty and set that date to the trigger time."
				}
			]
		},
		{
			"ID": "20261024164212-dnilvbf",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024164212-dnilvbf",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Execution, undo, and compatibility"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-ri3sf0d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-ri3sf0d",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Automatic actions and the original edit are undone and redone together, and both roll back if execution fails. Redo retains the original item IDs and timestamps. Automatic actions do not trigger other rules. Imports, sync, history restoration, and undo replay do not trigger rules again; ordinary API writes trigger rules but do not create editor undo entries."
				}
			]
		},
		{
			"ID": "20261002224707-cvkf5jx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-cvkf5jx",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Encrypted databases can only act on databases in the same encrypted notebook. Unlock the notebook first. If a target database or field is unavailable, correct or pause the rule. Copying a database preserves its rules in a paused state; check their targets and relation fields before enabling them."
				}
			]
		},
		{
			"ID": "20261015141042-fm4qoja",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261015141042-fm4qoja",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Collect ordinary blocks"
				}
			]
		},
		{
			"ID": "20261024163013-6bomil1",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-6bomil1",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Watch scope and conditions"
				}
			],
			"HeadingLevel": 4
		},
		{
			"ID": "20261015141042-nrq3k5z",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-nrq3k5z",
				"updated": "20261027120633"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Choose the Block matches conditions trigger, then use the add button under Watch scope to select notebooks or documents. In the picker, check multiple notebooks or documents and confirm to add them together. Selections are retained while searching or expanding the tree. Duplicate selections are ignored; each rule can contain up to 32 notebooks or documents in total. Click a document title to preview it in a floating window while keeping automation settings open; its icon also supports hover preview. Notebook and document scopes are combined."
				}
			]
		},
		{
			"ID": "20261024161816-3zxzd6e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-3zxzd6e",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Block types, tags, and custom attributes use separate Chip groups; add conditions with each group's add button, and remove them with the Chip's close button. The block type picker supports search and repeated selections. Click a tag or attribute Chip to edit it; Enter confirms tags, while attribute changes remain drafts until confirmed, and Escape or Cancel discards them."
				}
			]
		},
		{
			"ID": "20261024161816-xefugwl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-xefugwl",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Tags are trimmed and deduplicated. Block types use OR. Tags and custom attributes each default to Match all; choose Match any separately when needed. The three groups still use AND, and an empty group adds no restriction."
				}
			]
		},
		{
			"ID": "20261024164212-6ipky6d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-6ipky6d",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Custom attributes support equality, contains, exists, and does not exist; the last two do not need a value. Match any requires automation format 3, while existing rules keep their Match all behavior."
				}
			]
		},
		{
			"ID": "20261020211145-1vqtmd6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020211145-1vqtmd6",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When document scopes are selected, Subdocument depth appears below Watch scope. Unlimited is the default and includes all descendant documents. Current document only includes each selected document itself. With Limit depth, enter a positive integer: 1 includes the selected document and its direct children, 2 also includes grandchildren, and so on."
				}
			]
		},
		{
			"ID": "20261024161816-m178sgi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-m178sgi",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "This setting is shared by all document scopes in the rule and does not limit notebook scopes; overlapping scopes are combined. Changing depth preserves existing entries and fields and does not collect existing content automatically."
				}
			]
		},
		{
			"ID": "20261024164212-b0gk3r7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-b0gk3r7",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Use collection management to preview and collect matches or review and remove unmatched entries. Limited depth requires automation format 5; older clients reject it without rewriting the database."
				}
			]
		},
		{
			"ID": "20261022092813-uxiousu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022092813-uxiousu",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Include selected documents themselves is enabled by default. Disable it to skip each selected document and all blocks inside it while continuing to watch descendant documents up to the configured depth. For example, disable this option and set depth to 1 to watch only direct child documents; combined with Current document only, each document scope is empty."
				}
			]
		},
		{
			"ID": "20261024161816-8sdv6tq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-8sdv6tq",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "This option is shared by the rule’s document scopes. Notebook scopes and other overlapping document scopes can still include the document because scopes are combined by union. Changing this option preserves existing entries and fields and does not backfill or remove entries automatically; use collection management to preview, collect, or review and remove entries."
				}
			]
		},
		{
			"ID": "20261024161816-8buyzmu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-8buyzmu",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Excluding selected documents requires automation format 7; existing formats 1–6 remain readable, and older clients reject format 7 without rewriting the database."
				}
			]
		},
		{
			"ID": "20261026103001-3cdya4m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261026103001-3cdya4m",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "To collect block references, select a reference target and paste its block ID or block link, or choose Current document. The target is saved as a fixed block ID shared by all database mirrors. A document target includes references to its internal content blocks, but not its child documents. Only body block references are included; ordinary links, embeds and references in database rich-text fields are excluded."
				}
			]
		},
		{
			"ID": "20261026103001-47dxurt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261026103001-47dxurt",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Reference sources use the same grouping rules as backlinks, including list items, blockquotes, super blocks, callouts, and document or heading propagation from a first paragraph containing only block references. Type and attribute conditions apply to the final grouped block; tag conditions apply to the reference source. The tag collection target option does not apply while a reference target is set. Clear the reference target to return to ordinary collection. Removing a reference preserves existing entries and fields; preview collection management to collect older matches. Reference targets require automation format 8; formats 1–7 remain readable, and older clients reject format 8 without rewriting the database."
				}
			]
		},
		{
			"ID": "20261021135332-1brkvpw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261021135332-1brkvpw",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Attribute name supports Equals (the default), Contains, and Regex, independently of the attribute value condition. Equals uses the full name, such as custom-state. Contains accepts a literal substring without the custom- prefix: dailynote matches custom-dailynote-20261021. Regex uses Go syntax against the full name, for example ^custom-dailynote-[0-9]{8}$."
				}
			]
		},
		{
			"ID": "20261024161816-vktvb75",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-vktvb75",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Only custom attributes are checked. Names and values are case-sensitive and must match the same attribute; Exists requires any matching name, while Does not exist requires none and ignores the value. Invalid regular expressions cannot be saved, and patterns are limited to 256 bytes."
				}
			]
		},
		{
			"ID": "20261024164212-b68s8sa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-b68s8sa",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Contains and Regex require automation format 6; existing formats 1–5 remain readable, while older clients reject format 6 without rewriting the database."
				}
			]
		},
		{
			"ID": "20261024163013-jv7dnxb",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-jv7dnxb",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Choose what to collect"
				}
			],
			"HeadingLevel": 4
		},
		{
			"ID": "20261017204817-jfdo45b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017204817-jfdo45b",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The Collect menu above Block types offers Default, Block containing the tag, and Container block. Default prefers the enclosing list item when its first content block contains the tags and it meets the type and attribute conditions; otherwise it uses the eligible tagged block. Selecting both paragraph and list-item types still produces only one target for the same tag source."
				}
			]
		},
		{
			"ID": "20261024161816-pnx07n4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-pnx07n4",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Block containing the tag filters and collects the actual tagged block by its type and attributes. Container block collects the nearest container meeting the selected type and attribute conditions, deduplicating by block ID; documents are eligible only when explicitly selected. All required tags must occur in the same source block, rather than being combined across children."
				}
			]
		},
		{
			"ID": "20261024161816-aai6uo3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-aai6uo3",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "With no tag conditions, this option has no effect. Preview shows the final collection targets. Changing this option preserves existing entries and fields without converting their bound blocks. The two explicit modes require automation format 4; older formats remain readable, and older clients reject format 4 without rewriting the database."
				}
			]
		},
		{
			"ID": "20261017195341-czg1ilm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017195341-czg1ilm",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A main block type includes all its subtypes. You can instead select heading levels H1-H6, unordered/ordered/task lists or list items, and built-in or custom callout types. Lists and list items match independently; multiple choices use OR, and an empty selection allows every type."
				}
			]
		},
		{
			"ID": "20261024164212-r662vjh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-r662vjh",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Selecting a main type replaces its selected subtypes. Changing a block subtype uses the same matching logic for automatic collection, cleanup review, and preview. Subtype filters require automation format 3; existing format 1 and 2 rules remain readable, and older clients reject format 3 without rewriting the database."
				}
			]
		},
		{
			"ID": "20261015141042-dmlyxmz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-dmlyxmz",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Tags match the block itself, without collecting all ancestor containers. A list item uses the tags in its first paragraph; that paragraph is collected separately only when paragraph blocks are explicitly selected."
				}
			]
		},
		{
			"ID": "20261024164212-hlq64ez",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-hlq64ez",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Collection binds the original block to this database without copying or moving it. Initial fields support fixed values and the trigger time for date fields; the primary field retains its original block binding."
				}
			]
		},
		{
			"ID": "20261015141042-4gexoxe",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-4gexoxe",
				"updated": "20261018000619"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When a block first matches, a new entry is added. Automatic collection only adds entries. Source changes, moving out of scope, changing conditions or collection targets, and disabling or deleting rules preserve existing entries and their field values. Matching again preserves the same entry and manually edited fields."
				}
			]
		},
		{
			"ID": "20261024163013-4bgb3is",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-4bgb3is",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Manage and collect existing blocks"
				}
			],
			"HeadingLevel": 4
		},
		{
			"ID": "20261015141042-u9c28d4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-u9c28d4",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Automations"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Collection management"
				},
				{
					"Type": "NodeText",
					"Data": " and select Database entries to check all existing entries against the union of enabled block collection rules. Manual and automatically collected entries are checked alike. Matches rules, Does not match rules, and Cannot determine have separate counts and pages; the first opening prioritizes entries that do not match."
				}
			]
		},
		{
			"ID": "20261024161816-zd3a5h8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-zd3a5h8",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Unknown entries explain why they cannot be classified. Remove unmatched entries on this page confirms the count and rechecks rules, sources, and bindings before removing only entries still confirmed unmatched. Nonmatching and unknown entries also offer individual removal. Removal keeps source blocks and supports undo and redo of the original entry IDs, fields, and ordering."
				}
			]
		},
		{
			"ID": "20261024161816-qq30r0i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-qq30r0i",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Missing source blocks are not recreated; read or authentication failures preserve the data and return an error. A later new match creates an initialized entry rather than recovering removed field values."
				}
			]
		},
		{
			"ID": "20261015141042-1ymbtr0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-1ymbtr0",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Enabling or editing a rule does not collect existing blocks. In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Automations"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Collection management"
				},
				{
					"Type": "NodeText",
					"Data": " select Rule matches and choose an enabled collection rule to inspect matching source blocks and their collected or uncollected status."
				}
			]
		},
		{
			"ID": "20261024164212-sjgygho",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-sjgygho",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Collect matches on this page adds only the displayed uncollected matches. The page controls show the current page number. Each preview page contains at most 100 blocks and may be smaller when many fields are initialized."
				}
			]
		},
		{
			"ID": "20261015141042-cael6rr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015141042-cael6rr",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Collection is evaluated after user creation, copying, content or attribute edits, content template application, global find and replace, and block or document moves into a watched scope. Document tree copies and moves include descendant documents. Existing rows keep their field values. Markdown and .sy imports, sync, history restoration, undo, and redo do not trigger new collection; use the preview to collect existing content explicitly."
				}
			]
		},
		{
			"ID": "20261024164212-vg7p0z4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-vg7p0z4",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Automatic actions do not chain into other rules. Sources and the target database must remain within the same encryption boundary; unlock an encrypted notebook before previewing or editing its rules."
				}
			]
		},
		{
			"ID": "20240818174922-r0eubvc",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20240818174922-r0eubvc",
				"updated": "20260803171606"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Note"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20240818175612-1oygtbw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240818175612-1oygtbw",
				"updated": "20260803171606"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If you need to wrap a line in a database cell, use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": "​."
				}
			]
		},
		{
			"ID": "20260613194213-n2rytff",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260613194213-n2rytff",
				"updated": "20260613194213"
			}
		}
	]
}
