							"Properties": {
								"id": "20261012014537-jjsv2yc",
								"updated": "20261012014859"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Rollup: When targeting a Relation field with Show original values or Show unique values, ordinary filters support Contains any item and Does not contain any item: search and select items from the final related database to match the entire rolled-up item set. Items with identical names are distinguished by item ID. Existing keyword filters and their Any, All, and None quantifiers keep their existing behavior"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171129-4a6yi6q",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
