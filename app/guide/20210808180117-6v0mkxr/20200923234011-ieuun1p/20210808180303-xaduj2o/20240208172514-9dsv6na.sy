								"updated": "20261016191345"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Multiple Conditions"
								},
								{
									"Type": "NodeText",
									"Data": ": Conditions can target multiple fields. They use AND by default (all must match), can switch to OR (any can match), and can be organized into nested groups"
								}
							]
						}
					]
				},
