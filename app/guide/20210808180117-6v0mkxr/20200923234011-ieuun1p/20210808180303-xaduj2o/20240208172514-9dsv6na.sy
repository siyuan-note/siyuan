			"ID": "20260920225154-tz8a00o",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260920225154-tz8a00o",
				"updated": "20261025011205"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Calendar View"
				}
			]
		},
		{
			"ID": "20260920225154-vz01ydx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920225154-vz01ydx",
				"updated": "20260923103343"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Displays dated entries by month or week. The week view has seven date columns; entries spanning multiple days continue across those days. Each editor keeps its current mode and browsing date independently. The month/week choice is saved for each calendar view in this workspace and restored when opening it in a new editor or restarting SiYuan. A new editor starts browsing from today."
				}
			]
		},
		{
			"ID": "20260920225154-qqxdh7e",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260920225154-qqxdh7e",
				"updated": "20261025011205"
			},
			"Children": [
				{
					"ID": "20260920225154-hengjf1",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-hengjf1",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-j4v2piu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-j4v2piu",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Switching: Open the view settings and select "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Layout"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Calendar"
								},
								{
									"Type": "NodeText",
									"Data": ", or insert a database calendar view from the slash menu"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-mk883o7",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-mk883o7",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-5g31u7h",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-5g31u7h",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date field: Choose one date, created time, or updated time field in the layout settings. If no suitable field exists, the calendar prompts you to choose or create one. It does not fill ordinary dates for existing entries; entries without a date stay out of the grid. With an ordinary date field, they remain available in the undated list"
								}
							]
						}
					]
				},
				{
					"ID": "20260929122307-2ixnrxo",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260929122307-2ixnrxo",
						"updated": "20260929123717"
					},
					"Children": [
						{
							"ID": "20260929122307-ftq006m",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260929122307-ftq006m",
								"updated": "20260929123717"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Template dates: When a date field has a display template, the calendar places entries on the calculated date without changing the stored date. Output a plain text date in YYYY-MM-DD, the field's selected numeric date format, or the current language's local date format (such as October 2, 2026). An optional HH:mm or HH:mm:ss time can follow a space or T. Dates use the current device's local time zone; slash-separated dates follow the field format without guessing the month/day order. Empty results, invalid dates, and other formats appear neither on the calendar nor in the undated list. Calculated dates cannot be dragged, cleared, or assigned when creating an entry on a day; change the source field or template to adjust the date. Use YYYY-MM-DD for templates shared across languages"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-vblms0p",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-vblms0p",
						"updated": "20260923095432"
					},
					"Children": [
						{
							"ID": "20260920225154-4wsrq3z",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-4wsrq3z",
								"updated": "20260923095432"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Browsing: Use the previous/next buttons, Today, or the date picker. Month view collapses crowded dates; use the more button to expand that week. Dates follow your local time zone. Month view shows four, five, or six weeks as needed. Both views show ISO week numbers at the start of each row. Use the calendar button to jump by date or by ISO week year and number. When a week starts on a day other than Monday, its row number is determined by that row's Thursday"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-ronkl9y",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-ronkl9y",
						"updated": "20260924110133"
					},
					"Children": [
						{
							"ID": "20260920225154-3lkyx9g",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-3lkyx9g",
								"updated": "20260924110133"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Editing: Click an entry to open its existing database entry editor. With an ordinary date field, use the plus button on a day to create an entry, drag an entry to move its dates, or drag its end handles to adjust its range. Use No date beside the view filter to search undated entries, then drag one onto a day or select it and choose a day, including on touch screens. This assigns an all-day date; clearing it returns the entry to the undated list. Date changes support undo. On touch screens, use the move handle on an existing calendar entry to drag it. Opening or creating an entry automatically focuses the primary field. Dragging previews the resulting dates and highlights their cells; changes are saved on release. The context menu also offers copying, creating and binding documents, adding to another database, editing fields, and creating an entry on the selected date"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-uqgqpna",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-uqgqpna",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-ql3yigi",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-ql3yigi",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "System times: Created time and updated time follow the original entry or bound block. They cannot be changed by dragging, and their calendar has no per-day creation button"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-lnjbogg",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-lnjbogg",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-l8by5pi",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-l8by5pi",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Date ranges: All-day ranges include the ending day. A timed range ending at midnight stops on the previous day. An entry with only one endpoint is shown on that date; a reversed range is marked without changing the stored value"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-3w6c98i",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-3w6c98i",
						"updated": "20260927113016"
					},
					"Children": [
						{
							"ID": "20260920225154-8p9e3ov",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-8p9e3ov",
								"updated": "20260927113016"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "View settings: Filtering, sorting, field visibility, and new-entry templates use the existing database settings. Conditional colors can set entry backgrounds. Grouping is suspended in calendar layout, and its settings are retained when switching back. Visible item rows can be set to 3, 5, 10, or all in the layout settings, with 3 as the default. This setting is saved per calendar view and only controls folding in month view; week view displays all entries, and the complete date range is still loaded"
								}
							]
						}
					]
				},
				{
					"ID": "20261025011205-dbums56",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261025011205-dbums56",
						"updated": "20261025011205"
					},
					"Children": [
						{
							"ID": "20261025011205-5ibctn0",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261025011205-5ibctn0",
								"updated": "20261025011205"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Field names: Open the view settings and enable "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Layout"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Display field name"
								},
								{
									"Type": "NodeText",
									"Data": ". Field names appear beside non-primary field values; the primary key remains the entry title. This option is off by default and saved per calendar view. Turn it off to show only values"
								}
							]
						}
					],
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					}
				}
			]
		},
