									"Children": [
										{
											"ID": "20260613171129-3c7sfh9",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20260613171129-3c7sfh9",
												"updated": "20260613171129"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Kanban View: Grouping is required; each group value generates a column. Grouping cannot be removed. When the group field is select or multi-select, dragging a card to another column automatically updates the field value (except for template, created time, and updated time fields)"
												}
											]
										}
									]
								}
							]
						}
					]
				},
				{
					"ID": "20260613171129-ksd0v5v",
