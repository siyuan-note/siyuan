				"updated": "20250615172312"
			},
			"AttributeViewID": "20240208172742-57vwxqw",
			"AttributeViewType": "gallery"
		},
		{
			"ID": "20240208172751-izg8evh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208172751-izg8evh",
				"updated": "20240208173355"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In the "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Author"
				},
				{
					"Type": "NodeText",
					"Data": "​ database, the "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Works count"
				},
				{
					"Type": "NodeText",
					"Data": "​ is summarized and statistics are made on its "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Works"
				},
				{
					"Type": "NodeText",
					"Data": "​, and the statistics method is "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Count all"
				},
				{
					"Type": "NodeText",
					"Data": "​."
				}
			]
		},
		{
			"ID": "20240208173416-t51ome2",
