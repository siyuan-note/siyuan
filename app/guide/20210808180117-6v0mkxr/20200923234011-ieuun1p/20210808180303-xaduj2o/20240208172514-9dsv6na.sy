			]
		},
		{
			"ID": "20261028100554-5uvtrxl",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261028100554-5uvtrxl",
				"updated": "20261028120132"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Database panel layout and sorting"
				}
			]
		},
		{
			"ID": "20261028100554-vymrc6v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261028100554-vymrc6v",
				"updated": "20261028120132"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Editor"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Database"
				},
				{
					"Type": "NodeText",
					"Data": " choose One column, Two columns (by row), or Two columns (by column) under Database panel field layout. The default is Two columns (by row). This applies to the database panel at the top of a document and the standalone item panel. Panels automatically use one column when space is limited. Switching layouts preserves the field order."
				}
			]
		},
		{
			"ID": "20261028100554-o8rd07g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261028100554-o8rd07g",
				"updated": "20261028110235"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The row layout reads from left to right, then top to bottom. Drag a field by its left handle to another field’s grid position to preview the resulting order, then drop to save it. The column layout reads down the left column, then down the right column; visible fields are split by count, with one extra field on the left when the count is odd. Editing field content does not move fields between columns. Column and single-column layouts use horizontal indicators for insertion above or below a field. Canceling a drag restores the original order; sorting supports undo and redo."
				}
			]
		},
		{
			"ID": "20260930175958-jgqkczm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260930175958-jgqkczm",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Database panel field visibility"
				}
			]
		},
		{
			"ID": "20260930175958-sqtxjcl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930175958-sqtxjcl",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In a database attribute panel at the top of a document, on a database entry page, or in a block attribute dialog, click a field name to set Database panel field visibility to Always show, Hide when empty, or Always hide."
				}
			]
		},
		{
			"ID": "20261024164212-45csjom",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-45csjom",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Default preserves the panel's existing display settings; the panel at the top of a document follows the global setting for hiding empty fields. Rules apply to attribute panels of that database and do not change field visibility in its views."
				}
			]
		},
		{
			"ID": "20261024164212-go3brhp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-go3brhp",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Click the panel's edit button to temporarily reveal hidden fields and edit their values or visibility rules."
				}
			]
		},
		{
			"ID": "20260929105001-jav2qb7",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260929105001-jav2qb7",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Entry icons"
				}
			]
		},
		{
			"ID": "20260929105001-d3q9qik",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260929105001-d3q9qik",
				"updated": "20260930140000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Unbound entries can have their own icons. Click the icon beside the primary-key value, in the entry details, or in a relation field to change or remove it. Item templates can preset icons for both unbound and document entries. Unbound entries without a custom icon show a short horizontal line, and the view's icon visibility setting still applies."
				}
			]
		},
		{
			"ID": "20260929105001-pdids8d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260929105001-pdids8d",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When binding or rebinding to a regular block without a custom icon, the block inherits the entry's icon. If the block already has an icon, or is an existing document, its own icon is used. A document created during binding inherits the entry's custom icon; if none is set, the document template's icon is used."
				}
			]
		},
		{
			"ID": "20261024164212-6ekhv2t",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-6ekhv2t",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Bound entries share icons with their bound blocks. Unbinding preserves the last displayed icon, which can then be changed independently."
				}
			]
		},
		{
			"ID": "20261024161058-chl2v5q",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024161058-chl2v5q",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Entry templates"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261024161058-7oa1v25",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161058-7oa1v25",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open the dropdown beside the new-entry button and choose New template. Preset the entry type, icon, primary-key content, and field values. Document entries can also have a save location, content template, and document-tree visibility setting."
				}
			]
		},
		{
			"ID": "20261024161058-6pyggzm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161058-6pyggzm",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Choose a template from the same menu to create an entry with those settings. Its More menu lets you edit it, make it the default, or delete it. Normal creation uses the default template; you can also choose an empty entry. Changes to a template do not update entries already created."
				}
			]
		},
		{
			"ID": "20261024161058-evrw9nh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161058-evrw9nh",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Entry templates fill content at creation time. Template fields calculate values for existing entries when a view is rendered. Date fields in an entry template can use a fixed time or the current time at creation."
				}
			]
		},
		{
			"ID": "20261025205717-wu88xyc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261025205717-wu88xyc",
				"updated": "20261025205717"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In an entry template, enable "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Open item in split view after creation"
				},
				{
					"Type": "NodeText",
					"Data": " to open each new bound or unbound entry on the right after creating it from a database view. A bound document focuses its title when available; otherwise, the primary key is focused. Unbound entries focus the primary key. Mobile uses the existing page or dialog."
				}
			]
		},
		{
			"ID": "20261025205717-d3xd5xk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261025205717-d3xd5xk",
				"updated": "20261025205717"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "New templates have this option off. Turn it off to stop automatic opening. Existing templates retain their previous behavior until you change this switch, including automatic opening in calendars. Empty entries created without a template keep the view’s existing behavior; to configure them, create an empty unbound-entry template and make it the default."
				}
			]
		},
		{
			"ID": "20240208172555-x0jaxkf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20240208172555-x0jaxkf",
				"updated": "20240208172555"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Mirror database"
				}
			]
		},
		{
			"ID": "20240208172555-0t0kfx3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208172555-0t0kfx3",
				"updated": "20240208172556"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Copying and pasting a database block will form a mirror database, that is, these database blocks share the same database data. Modifying the data of any database block will be synchronized to all other mirrors."
				}
			]
		},
		{
			"ID": "20240208172555-hv2afdr",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20240208172555-hv2afdr",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Relation and Rollup"
				}
			]
		},
		{
			"ID": "20240208172555-la22eum",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208172555-la22eum",
				"updated": "20240208172713"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The two databases can be connected through "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Relation"
				},
				{
					"Type": "NodeText",
					"Data": "​ to facilitate linkage management. For example, the relationship between the two databases "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Authors"
				},
				{
					"Type": "NodeText",
					"Data": "​ and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Books"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20261007101857-8yrn5q5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261007101857-8yrn5q5",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The desktop and mobile relation selection panels always offer a new-item action using the related database’s default template. When the input differs from the name generated by the primary key template, two actions show the actual names: create with the default template, or create with the input name."
				}
			]
		},
		{
			"ID": "20261024161816-8vcjcg4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-8vcjcg4",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The input-name action overrides only the primary key; field defaults, icon, content template and save location still apply. Empty input, no primary key template, or identical names produce only one action. Without a default template, creation produces a detached item. Creating the item and updating the relation can be undone together."
				}
			]
		},
		{
			"ID": "20240208172714-us6azzg",
			"Type": "NodeAttributeView",
			"Properties": {
				"id": "20240208172714-us6azzg",
				"updated": "20240208173234"
			},
			"AttributeViewID": "20240208172719-6qv16cr",
			"AttributeViewType": "table"
		},
		{
			"ID": "20240208172736-zavxwgi",
