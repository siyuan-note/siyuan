			"Children": [
				{
					"Type": "NodeText",
					"Data": "Databases organize entries into fields. An entry can be bound to an existing content block or exist independently. Table, list, calendar, kanban, and gallery views present the same data with their own layout, filtering, and sorting settings."
				}
			]
