			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Template"
				}
			]
		},
		{
			"ID": "20240208173416-hk4z3px",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208173416-hk4z3px",
				"updated": "20240208173511"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Templates can access, calculate and render the values of other fields in the same piece of data through the syntax introduced in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20201204184532-3qm9l8n",
