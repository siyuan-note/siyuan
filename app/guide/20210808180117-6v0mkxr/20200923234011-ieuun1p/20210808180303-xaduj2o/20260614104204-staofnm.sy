			"Children": [
				{
					"ID": "20260614104245-y89w1o2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260614104245-y89w1o2",
						"updated": "20261016112115"
					},
					"Children": [
						{
							"ID": "20260614104245-zro5c2g",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260614104245-zro5c2g",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Scheme: Choose Direct Connection (no proxy), Use system proxy, HTTP, HTTPS, or SOCKS5. Direct Connection and Use system proxy do not require host or port fields"
								}
							]
						}
					]
				},
				{
					"ID": "20261016112115-7c46gfq",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261016112115-7c46gfq",
						"updated": "20261022120655"
					},
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261016112115-mlgnje1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261016112115-mlgnje1",
								"updated": "20261022120655"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "System mode uses supported system settings or the proxy environment inherited when the kernel started. The kernel reads manual proxy settings on Windows, Linux GNOME, and macOS; on Linux and macOS, explicit proxy environment variables take priority. These readers do not support automatic PAC configuration; Windows and macOS automatic detection is also unsupported. On other platforms the kernel retains its initial proxy environment instead of reading OS settings"
								}
							]
						}
					]
				},
				{
					"ID": "20261022120655-quj9zir",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261022120655-quj9zir",
						"updated": "20261022120655"
					},
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261022120655-un99ra6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261022120655-un99ra6",
								"updated": "20261022120655"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "macOS supports manual HTTP, HTTPS, and SOCKS5 proxies. The bypass list is converted to NO_PROXY rules, supporting IP addresses, CIDR ranges (including 169.254/16), domains, leading *. domain patterns, and trailing IPv4 wildcards such as 10.*. Exclude simple hostnames and other wildcard patterns are unsupported; use explicit bypass entries instead. If reading or conversion fails, the kernel logs a warning and retains its startup proxy environment. To apply changed macOS proxy settings, restart the kernel or switch to another proxy mode and back to system mode"
								}
							]
						}
					]
				},
				{
					"ID": "20260614104245-4i5g8ab",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260614104245-4i5g8ab",
						"updated": "20260614104245"
					},
					"Children": [
						{
							"ID": "20260614104245-8iwvngf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260614104245-8iwvngf",
								"updated": "20260614104245"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Host"
								},
								{
									"Type": "NodeText",
									"Data": ": Enter the proxy server address in the format "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "IP"
								},
								{
									"Type": "NodeText",
									"Data": "​ or "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "username:password@IP"
								},
								{
									"Type": "NodeText",
									"Data": "​ (when authentication is required)"
								}
							]
						}
					]
				},
				{
					"ID": "20260614104245-uq7tlui",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
