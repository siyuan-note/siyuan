									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Port"
								},
								{
									"Type": "NodeText",
									"Data": ": Enter the proxy server port"
								}
							]
						}
					]
				}
			]
