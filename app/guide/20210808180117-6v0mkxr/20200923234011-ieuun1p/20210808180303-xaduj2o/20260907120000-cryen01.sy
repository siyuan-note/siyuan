						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00033",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00034",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00034",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "All encrypted notebooks share one master password, while each notebook has an independent data key. Unlocking one notebook does not unlock another"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00035",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00035",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00036",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00036",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Export a fresh key backup immediately after changing the master password. The new backup retains the key information needed to recover existing history and snapshots"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00037",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00037",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00038",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00038",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "If local configuration is lost, a new device needs recovery, or the interface reports that recovery is required, import the key backup and enter its matching master password. The key backup does not contain the master password"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00039",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00039",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00040",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00040",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "SiYuan refuses to disable encrypted notebooks while an encrypted notebook or recoverable history still depends on the current keys, preventing permanent loss of access"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00041",
			"Type": "NodeParagraph",
