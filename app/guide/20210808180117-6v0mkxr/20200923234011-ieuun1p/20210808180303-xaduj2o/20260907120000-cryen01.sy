								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "While unlocked, plugins, APIs, MCP tools, and AI agents can read content blocks, list documents, and use in-notebook full-text search"
								}
							]
						}
					]
				}
			]
		},
