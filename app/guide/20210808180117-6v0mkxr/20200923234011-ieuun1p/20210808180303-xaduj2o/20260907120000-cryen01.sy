								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "The master password cannot be recovered. If you forget it, no one can recover the content"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00007",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00007",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00008",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00008",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "A key backup does not replace the master password. Recovery usually requires both the matching key backup and master password, so keep them separately and safely"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00009",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00009",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00010",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00010",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Protection is strongest while an encrypted notebook is locked. While it is unlocked, plugins, APIs, MCP tools, and AI agents authorized by the main application can read its content"
								}
							]
						}
					]
				}
			]
		},
