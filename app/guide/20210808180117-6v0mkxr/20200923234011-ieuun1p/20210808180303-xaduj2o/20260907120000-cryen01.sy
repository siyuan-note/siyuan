	"Type": "NodeDocument",
	"Properties": {
		"id": "20260907120000-cryen01",
		"title": "Encrypted Notebook",
		"type": "doc",
		"updated": "20260908162209"
	},
	"Children": [
		{
			"ID": "20260907120000-en00001",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-en00001",
				"updated": "20260908100000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Overview"
				}
			]
		},
		{
			"ID": "20260907120000-en00002",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-en00002",
				"updated": "20260907120000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Encrypted notebooks are designed for sensitive content. Their documents, assets and original filenames, database definitions, and dedicated indexes are encrypted on disk; normal notebooks keep their existing storage format. A locked encrypted notebook requires the master password to open."
				}
			]
		},
		{
			"ID": "20260908120000-enuse01",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260908120000-enuse01",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Use cases"
				}
			]
		},
		{
			"ID": "20260908120000-enuse02",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260908120000-enuse02",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260908120000-enuse03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-enuse03",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-enuse04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-enuse04",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Personal information: Store journals, medical records, financial information, identity documents, and other content that should not remain as plaintext on disk"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-enuse05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-enuse05",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-enuse06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-enuse06",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Confidential work: Store project plans, meeting notes, client information, research materials, and other content that requires restricted local access"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-enuse07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-enuse07",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-enuse08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-enuse08",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Sensitive knowledge bases with AI assistance: After unlocking, use AI for summaries, question answering, rewriting, and organization; when using a cloud AI service, relevant content may be sent to the configured provider, so choose a model and deployment method that meet your privacy requirements"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev01",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev01",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev02",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev02",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Device and backup protection: Reduce the risk of someone directly reading locked notebook content if a device is lost or stolen or backup media is exposed"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-enuse09",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-enuse09",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-enuse10",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-enuse10",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Multi-device and long-term storage: Sync encrypted persistent data and use the master password together with a key backup to restore access on another device"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00003",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-en00003",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Before you begin"
				}
			]
		},
		{
			"ID": "20260907120000-en00004",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-en00004",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-en00005",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00005",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00006",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00006",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "The master password cannot be recovered. If you forget it, no one can recover the content"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00007",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00007",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00008",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00008",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "A key backup does not replace the master password. Recovery usually requires both the matching key backup and master password, so keep them separately and safely"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00009",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00009",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00010",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00010",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Protection is strongest while an encrypted notebook is locked. While it is unlocked, plugins, APIs, MCP tools, and AI agents authorized by the main application can read its content"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev03",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev04",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Encryption mainly protects persistent content on disk and blocks access through supported entry points after locking; metadata such as the notebook name, directory structure, file count and sizes, modification times, and asset extensions may remain visible"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev05",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev06",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Locking cleans application-controlled plaintext caches and temporary files on a best-effort basis and does not guarantee erasure of transient copies in OS swap, hibernation files, crash dumps, or storage snapshots; protect files you export, clipboard content, screenshots, and printouts yourself"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev07",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev08",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Master-password derivation usually takes about one second, and unlocking also rebuilds dedicated indexes, so large notebooks may take longer; uploading large assets uses more memory, and every request to view an asset requires decryption"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00011",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-en00011",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Enable and create"
