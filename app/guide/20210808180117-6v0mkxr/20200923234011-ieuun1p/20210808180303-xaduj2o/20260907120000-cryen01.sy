			"ID": "20260907120000-en00012",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-en00012",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Authentication"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Encrypted Notebook"
				},
				{
					"Type": "NodeText",
					"Data": ", turn on Enable encrypted notebook, set and confirm the master password, and acknowledge the risk notice. Use a password manager to generate and store a strong password of at least 12 characters with uppercase and lowercase letters, digits, and symbols."
				}
			]
		},
		{
			"ID": "20260907120000-en00013",
			"Type": "NodeList",
