								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Content block references, moves, document-to-heading conversion, and database mirroring cannot cross between normal and encrypted notebooks or between two encrypted notebooks"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00063",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00063",
