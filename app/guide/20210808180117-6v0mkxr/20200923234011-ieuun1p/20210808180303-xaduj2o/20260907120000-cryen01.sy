					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00014",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00015",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00015",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Export a key backup immediately after enabling the feature and keep an independent copy outside the workspace"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00016",
					"Type": "NodeListItem",
