							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Encrypted content is excluded from global search, the global graph, semantic search, and embedding vectorization"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00061",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
