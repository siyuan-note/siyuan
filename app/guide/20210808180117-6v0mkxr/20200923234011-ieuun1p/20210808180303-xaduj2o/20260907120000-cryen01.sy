							"Properties": {
								"id": "20260907120000-en00025",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Click a closed encrypted notebook in the document panel and enter the master password to unlock and open it. Each encrypted notebook is unlocked separately"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00026",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00026",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00027",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00027",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Closing an encrypted notebook locks it. Locking stops new content access and clears application-managed keys, indexes, and temporary data"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00028",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00028",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00029",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00029",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "All encrypted notebooks remain locked after the application restarts and require the master password again"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00030",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-en00030",
				"updated": "20260907120000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Set the idle period under "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Authentication"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Encrypted Notebook"
				},
				{
					"Type": "NodeText",
					"Data": ". Viewing, editing, or searching encrypted content resets the timer; 0 disables auto-lock."
				}
			]
		},
		{
			"ID": "20260907120000-en00031",
			"Type": "NodeHeading",
