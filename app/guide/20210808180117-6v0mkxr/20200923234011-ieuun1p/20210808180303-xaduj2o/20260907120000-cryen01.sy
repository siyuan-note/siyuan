							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Data sync stores and transfers encrypted persistent data. An unlocked state is never synced to another device, which still requires the master password"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00046",
