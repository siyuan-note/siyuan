					]
				}
			]
		},
		{
			"ID": "20260907120000-en00022",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-en00022",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Unlock and lock"
				}
			]
		},
		{
			"ID": "20260907120000-en00023",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-en00023",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-en00024",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00024",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00025",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00025",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Click a closed encrypted notebook in the document panel and enter the master password to unlock and open it. Each encrypted notebook is unlocked separately"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00026",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00026",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00027",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00027",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Closing an encrypted notebook locks it. SiYuan first saves unwritten edits and file history; locking then stops new content access, waits for or cancels in-flight work, revokes application-managed key access, closes database connections, and cleans application-managed plaintext caches, temporary files, and access tokens on a best-effort basis"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00028",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00028",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00029",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00029",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "All encrypted notebooks remain locked after the application restarts and require the master password again"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00030",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-en00030",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Set the idle period under "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Authentication"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Encrypted Notebook"
				},
				{
					"Type": "NodeText",
					"Data": ". User interface activity in the current workspace refreshes the timer for every unlocked encrypted notebook; background synchronization, indexing, and other tasks do not. Set it to 0 to disable auto-lock."
				}
			]
		},
		{
			"ID": "20260907120000-en00031",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-en00031",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Master password and key backup"
				}
			]
		},
		{
			"ID": "20260907120000-en00032",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-en00032",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-en00033",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00033",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00034",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00034",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "All encrypted notebooks share one master password, while each notebook has an independent data key. Unlocking one notebook does not unlock another"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00035",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00035",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00036",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00036",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Close every encrypted notebook before changing the master password. The change only re-protects each notebook's data key and does not re-encrypt document content; after it completes, SiYuan refreshes the key backup in the workspace automatically, and you should export a new key backup immediately"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev09",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev09",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev10",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev10",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "If an old master password is exposed together with a synced copy, backup, or historical snapshot that retains old key information, the old password may still decrypt current content that uses the same data key. If you suspect that an old password was exposed, export the content as plaintext, import it into a new encrypted notebook with a new data key, and securely delete the plaintext files after confirming the migration"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00037",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00037",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00038",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00038",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "If local configuration is lost, a new device needs recovery, or the interface reports that recovery is required, import the key backup and enter its matching master password. The key backup does not contain the master password"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev11",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-enrev11",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-enrev12",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev12",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "SiYuan can verify the integrity of a key backup but cannot determine which backup is newest. Keep an independent, versioned key backup outside the workspace"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00039",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00039",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00040",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00040",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "SiYuan refuses to disable encrypted notebooks while an encrypted notebook or recoverable history still depends on the current keys, preventing permanent loss of access"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-en00041",
