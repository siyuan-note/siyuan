					},
					"Children": [
						{
							"ID": "20260908150000-enrev14",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-enrev14",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "You can import .sy.zip and Markdown into an unlocked encrypted notebook; SiYuan encrypts the content before writing it to disk"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00048",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00048",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00049",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00049",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Export is available only while the notebook is unlocked, and exported .sy.zip, HTML, Word, PDF, Markdown, and other files are plaintext; protect, move, or delete them as ordinary sensitive files after export"
								}
							]
						}
					]
				}
			]
		},
