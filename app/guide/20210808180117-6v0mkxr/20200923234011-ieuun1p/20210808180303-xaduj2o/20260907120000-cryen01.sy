							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "After unlocking, you can edit documents and use content block references, backlinks, notebook search, databases, import, history, and export within that notebook"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00055",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
