				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Encrypted Notebook"
				},
				{
					"Type": "NodeText",
					"Data": ", turn on Enable encrypted notebook, set and confirm the master password, and acknowledge the risk notice. A password manager is recommended for generating and storing a strong password."
				}
			]
