							"Properties": {
								"id": "20260907120000-en00064",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "The publish service cannot list or read encrypted content whether the notebook is locked or unlocked, and publish passwords or visibility settings cannot enable it; flashcards, bookmarks, tags, asset renaming, raw file APIs, WebDAV, and kernel CLI operations are also unsupported"
								}
							]
						}
					]
				},
				{
					"ID": "20260908162209-25s92pb",
