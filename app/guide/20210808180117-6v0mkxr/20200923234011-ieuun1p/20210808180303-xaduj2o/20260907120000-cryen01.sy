								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Data sync stores and transfers encrypted persistent data and syncs the key backup; a new device restores the enabled state automatically, but the unlocked state is never synced and the master password is still required"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-en00046",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-en00046",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-en00047",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-en00047",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Document history supports encrypted data, and the corresponding notebook must be unlocked before viewing or rolling it back; restoring a deleted notebook also requires the matching key backup and master password"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-enrev13",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
