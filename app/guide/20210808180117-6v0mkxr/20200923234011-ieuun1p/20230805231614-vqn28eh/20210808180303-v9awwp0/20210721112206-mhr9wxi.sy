		{
			"ID": "20261026111206-481cuuh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261026111206-481cuuh",
				"updated": "20261026115057"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If exiting takes more than 12 seconds, you can choose \"Skip sync and exit\" and confirm to cancel synchronization and finish exiting. Unsynced changes remain saved on this device. Cancel the confirmation to continue waiting for synchronization."
				}
			]
		},
		{
			"ID": "20230219121305-n0v0nlb",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
