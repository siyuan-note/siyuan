									"TextMarkType": "kbd",
									"TextMarkTextContent": "Account & Sync"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Enable cloud sync"
								}
							]
						}
					]
				},
				{
