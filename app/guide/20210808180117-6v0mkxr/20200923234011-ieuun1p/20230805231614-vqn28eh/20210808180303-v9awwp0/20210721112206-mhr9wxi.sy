						{
							"ID": "20220510105000-p9xg0yf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20220510105000-p9xg0yf",
								"updated": "20261016111431"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "After the last data change, sync is scheduled using "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Settings"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Account & Sync"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Sync interval"
								},
								{
									"Type": "NodeText",
									"Data": " (30 seconds by default, adjustable from 30 to 43,200 seconds); further changes restart this wait"
								}
							]
						}
					]
				},
				{
					"ID": "20220510105000-ouj6xo5",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20220510105000-ouj6xo5",
						"updated": "20261016111431"
					},
					"Children": [
						{
							"ID": "20220510105000-eps1jp2",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20220510105000-eps1jp2",
								"updated": "20261016111431"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "When no data changes are found, the interval between automatic checks increases; new data changes schedule sync using the configured interval again"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261016111431-tjkwrig",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261016111431-tjkwrig",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Sync perception and LAN acceleration"
				}
			]
		},
		{
			"ID": "20261016111431-8v5b36n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016111431-8v5b36n",
				"updated": "20261016111710"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Account & Sync"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Sync perception"
				},
				{
					"Type": "NodeText",
					"Data": " uses SiYuan official-cloud signals to trigger synchronization sooner in automatic mode. It is unavailable in Docker kernels, does not bypass manual or full-manual mode, and does not eliminate editing conflicts."
				}
			]
		},
		{
			"ID": "20261016111431-hvkyscs",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016111431-hvkyscs",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Account & Sync"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "LAN sync acceleration"
				},
				{
					"Type": "NodeText",
					"Data": " prefers encrypted data objects from reachable LAN devices using the same repository key and cloud sync target. Cloud storage remains authoritative, with fallback to the cloud if LAN transfers are unavailable; this is not a fully offline peer-to-peer replacement."
				}
			]
		},
		{
			"ID": "20261024164212-sqpyaj7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-sqpyaj7",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Docker kernels do not provide LAN acceleration. LAN notifications trigger synchronization only in automatic mode."
				}
			]
		},
		{
			"ID": "20220307095105-is2jz8h",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20220307095105-is2jz8h",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Scenario example"
				}
			]
		},
		{
			"ID": "20220307095105-pdveh7f",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220307095105-pdveh7f",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "To reduce conflicts, finish syncing on device A, then sync device B before editing there. Simultaneous edits to the same file can conflict and cause one version to overwrite another; sync perception and LAN acceleration do not remove this risk."
				}
			]
		},
