				"updated": "20261024163013"
			},
			"Children": [
				{
					"ID": "20230220103711-5uo9kru",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230220103711-5uo9kru",
						"updated": "20230220103712"
					},
					"Children": [
						{
							"ID": "20230220103711-ur0xszr",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230220103711-ur0xszr",
								"updated": "20230220103712"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Before enabling synchronization, please ensure that the system time of all devices participating in the synchronization is consistent"
								}
							]
						}
					]
				},
				{
					"ID": "20230220103708-fmphm6k",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230220103708-fmphm6k",
						"updated": "20261024163013"
					},
					"Children": [
						{
							"ID": "20230220103708-ml52xbc",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230220103708-ml52xbc",
								"updated": "20261024163013"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "For a large dataset, export a Data archive using "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Settings"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "App"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Data"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Export Data"
								},
								{
									"Type": "NodeText",
									"Data": ", transfer it to the new device, and use "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Import Data"
								},
								{
									"Type": "NodeText",
									"Data": "​ on the same settings page there before configuring synchronization"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261011151543-4pvea6y",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261011151543-4pvea6y",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Configure third-party sync"
				}
			]
		},
		{
			"ID": "20261011151543-l4oq2bn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-l4oq2bn",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Account & Sync"
				},
				{
					"Type": "NodeText",
					"Data": ", select S3, WebDAV, or the local file system, then click the configuration button in the sync service configuration row. The local file system is available with standard desktop and Docker kernels, not mobile kernels; its path is on the kernel’s machine or inside its container, not on the device running the browser."
				}
			]
		},
		{
			"ID": "20261024164212-ztfy57c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-ztfy57c",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Complete the form and click "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Save"
				},
				{
					"Type": "NodeText",
					"Data": ". Typing does not save changes; closing an edited form asks whether to discard the draft."
				}
			]
		},
		{
			"ID": "20261020224352-z87gp3i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020224352-z87gp3i",
				"updated": "20261020224352"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Click "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Test connection"
				},
				{
					"Type": "NodeText",
					"Data": " before saving to check the current S3, WebDAV, or local filesystem draft without saving it. WebDAV checks directory creation and probe read/write access; the local filesystem checks directory read/write access. The probe is cleaned up where possible. If the test fails, follow the diagnostic and try again; your saved configuration is retained."
				}
			]
		},
		{
			"ID": "20261011151543-h1km9eh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-h1km9eh",
				"updated": "20261011151543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "To stop using a service, click "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Clear configuration"
				},
				{
					"Type": "NodeText",
					"Data": " in its configuration dialog and confirm. This removes the saved address and credentials, and disables sync if this is the current service. Local notes and cloud data remain intact."
				}
			]
		},
		{
			"ID": "20261011151543-hbd6s1c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-hbd6s1c",
				"updated": "20261011151543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If changing or clearing the current source is blocked because resources or historical snapshots are incomplete, restore access to the original source and finish downloading all resources before trying again. A failed save or clear keeps the effective configuration and the draft."
				}
			]
		},
		{
			"ID": "20261020231029-lr7z60a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020231029-lr7z60a",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Automatic sync normally runs in the background without opening a panel. Click the sync icon to view the current file, written bytes, speed, and estimated remaining time. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Hide details"
				},
				{
					"Type": "NodeText",
					"Data": " hides the details; "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Sync"
				},
				{
					"Type": "NodeText",
					"Data": " reopens them."
				}
			]
		},
		{
			"ID": "20261024164212-n2h2yit",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-n2h2yit",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Editing pauses only while local changes are applied and affected documents are refreshed, including recovery after cancellation. Click "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Cancel"
				},
				{
					"Type": "NodeText",
					"Data": " to request cancellation of preparation, network transfer, or file restoration."
				}
			]
		},
		{
			"ID": "20261020231029-kuhlekv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020231029-kuhlekv",
				"updated": "20261020231029"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Canceling keeps completed files and removes the current temporary file. Sync again to finish the remaining content. If storage is insufficient, free up space and retry. Recognizable temporary files from interrupted syncs are cleaned up on startup or before restoration, and the freed space is reported."
				}
			]
		},
		{
			"ID": "20260905184908-022q2es",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260905184908-022q2es",
				"updated": "20260905191024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Asset downloads"
				}
			]
		},
		{
			"ID": "20260905184908-jpha7l7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-jpha7l7",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Choose Download all or Download on demand in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Account & Sync"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Asset downloads"
				},
				{
					"Type": "NodeText",
					"Data": ". This setting applies only to the current device."
				}
			]
		},
		{
			"ID": "20260905184908-5jlxwbn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-5jlxwbn",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Download all is the default. On-demand mode still fully syncs documents, database definitions, and the asset list. Required assets are downloaded when displaying images, audio, video, PDFs, or other content, or when opening asset links. Encrypted notebook assets still require the notebook to be unlocked."
				}
			]
		},
		{
			"ID": "20260905184908-2t2p88b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-2t2p88b",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Downloaded assets remain on this device and continue to receive updates during subsequent syncs. Enabling on-demand downloads does not remove existing files or immediately free their storage space."
				}
			]
		},
		{
			"ID": "20260905184908-bb2w63n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-bb2w63n",
				"updated": "20260905191024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Assets that have not been downloaded are unavailable offline, and an error is reported if they cannot be retrieved. Switching to Download all first downloads the content needed by current assets and all retained local snapshots, which may include historical versions. If downloading fails, the previous mode is retained; reconnect and try again."
				}
			]
		},
		{
			"ID": "20260905184908-yzvkosv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-yzvkosv",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Local snapshots in on-demand mode may depend on cloud storage and must not be treated as complete offline backups. Downloading a complete snapshot, and exports or recovery operations that need asset content, first download the required assets and report an error if they cannot be retrieved."
				}
			]
		},
		{
			"ID": "20260905184908-1wxzlh9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-1wxzlh9",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Before changing the sync target, resetting the data repository, or opening this workspace with an older version, switch to Download all and finish downloading to preserve access to assets that are not yet stored locally."
				}
			]
		},
		{
			"ID": "20261012014537-ws3euhl",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261012014537-ws3euhl",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Themes and icons"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20260917190844-p6hrspl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260917190844-p6hrspl",
				"updated": "20260918195936"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Theme and icon package files, updates, and uninstallations sync between devices; each device chooses its own theme and icons. Images, fonts, and other package resources are always downloaded completely. Synchronization, deletion, and conflicts follow the same file-level rules as plugins, widgets, and templates. Restoring a snapshot without a package removes it."
				}
			]
		},
		{
			"ID": "20230219121305-3yj6w9y",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20230219121305-3yj6w9y",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Sync modes"
				}
			]
		},
		{
			"ID": "20230219121305-p0gorey",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230219121305-p0gorey",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Three synchronization modes are supported in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Account & Sync"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Cloud sync mode"
				},
				{
					"Type": "NodeText",
					"Data": ":"
				}
			]
		},
		{
			"ID": "20230219121305-c1bb9y3",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20230219121305-c1bb9y3",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"ID": "20230219121305-e5kvdxk",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230219121305-e5kvdxk",
						"updated": "20261016111431"
					},
					"Children": [
						{
							"ID": "20230219121305-00ui5br",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230219121305-00ui5br",
								"updated": "20230219121414"
							},
							"Children": [
								{
