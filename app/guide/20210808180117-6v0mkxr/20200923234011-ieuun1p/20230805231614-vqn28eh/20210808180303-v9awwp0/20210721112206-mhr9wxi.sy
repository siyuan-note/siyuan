			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "How Auto/Manual mode works"
				}
			]
		},
		{
			"ID": "20220703232248-hhbh17m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220703232248-hhbh17m",
				"updated": "20220703232251"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan performs corresponding operations by comparing cloud data snapshots and local data snapshots:"
				}
			]
		},
		{
			"ID": "20220703232248-j1dq9w6",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20220703232248-j1dq9w6",
				"updated": "20260918195936"
			},
			"Children": [
				{
					"ID": "20220703232248-anr56yy",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20220703232248-anr56yy",
						"updated": "20220703232248"
					},
					"Children": [
						{
							"ID": "20220703232248-sq7sqfd",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20220703232248-sq7sqfd",
								"updated": "20220703232248"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "If the snapshots are the same, ignore this synchronization"
								}
							]
						}
					]
				},
				{
					"ID": "20220703232248-nuapm43",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20220703232248-nuapm43",
						"updated": "20260918195936"
					},
					"Children": [
						{
							"ID": "20220703232248-6oj5sng",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20220703232248-6oj5sng",
								"updated": "20220703232248"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "If the snapshots are different, upload the local changes from the last sync to the cloud, and merge the latest changes from the cloud to the local"
								}
							]
						},
						{
							"ID": "20220703232248-kl3io11",
							"Type": "NodeList",
							"ListData": {},
							"Properties": {
								"id": "20220703232248-kl3io11",
								"updated": "20260918195936"
							},
							"Children": [
								{
									"ID": "20220703232248-z2ww7lp",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20220703232248-z2ww7lp",
										"updated": "20220703232248"
									},
									"Children": [
										{
											"ID": "20220703232248-qj3gsdd",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20220703232248-qj3gsdd",
												"updated": "20220703232248"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Merge directly if there is no conflict between the changes at both ends"
												}
											]
										}
									]
								},
								{
									"ID": "20220703232248-jneoxfm",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20220703232248-jneoxfm",
										"updated": "20260918195936"
									},
									"Children": [
										{
											"ID": "20220703232248-x7l12qz",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20220703232248-x7l12qz",
												"updated": "20260918195936"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "For file conflicts, including theme and icon files, the local file overwrites the cloud file, and the conflicting cloud file is preserved in data history"
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20220703232248-f48ijwk",
