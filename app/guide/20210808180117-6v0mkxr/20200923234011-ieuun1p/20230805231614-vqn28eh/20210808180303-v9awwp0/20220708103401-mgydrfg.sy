			"Children": [
				{
					"Type": "NodeText",
					"Data": "Data backup refers to uploading "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20220615120602-drz9hwc",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "data snapshots"
				},
				{
					"Type": "NodeText",
					"Data": " to the cloud for disaster recovery. Unlike data sync: the purpose of sync is to keep data consistent across multiple devices, while backup is manually uploading snapshots for safekeeping."
				}
			]
		},
