			"Children": [
				{
					"Type": "NodeText",
					"Data": "Overview"
				}
			]
		},
		{
			"ID": "20210721113914-myj5bf9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210721113914-myj5bf9",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When using SiYuan, consider both data recovery and access protection:"
				}
			]
		},
		{
			"ID": "20210721113914-eyp2qea",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20210721113914-eyp2qea",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"ID": "20210721113914-l3m6qaz",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20210721113914-l3m6qaz",
						"updated": "20230422123335"
					},
					"Children": [
						{
							"ID": "20210721113914-tv2xupw",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20210721113914-tv2xupw",
								"updated": "20230422123335"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "block-ref",
									"TextMarkBlockRefID": "20230422120504-ns837kr",
									"TextMarkBlockRefSubtype": "s",
									"TextMarkTextContent": "Availability"
								},
								{
									"Type": "NodeText",
									"Data": ": no data loss, keep the data complete and consistent"
								}
							]
						}
					]
				},
				{
					"ID": "20210721113914-4n8h1s2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20210721113914-4n8h1s2",
						"updated": "20261024161440"
					},
					"Children": [
						{
							"ID": "20210721113914-rly8yqn",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20210721113914-rly8yqn",
								"updated": "20261024161440"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Confidentiality and integrity: Restrict unauthorized access and protect data with the applicable encryption and authentication mechanisms"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20210721113914-rmgqqcr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210721113914-rmgqqcr",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The following sections explain the protection available for each storage method and the precautions to take."
				}
			]
		},
		{
			"ID": "20210721113914-z3cmj85",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210721113914-z3cmj85",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Local storage in ordinary notebooks"
				}
			]
		},
		{
			"ID": "20210721113914-3zwi0oa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210721113914-3zwi0oa",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Ordinary notebooks store their documents and assets in plaintext on the local file system. This means:"
				}
			]
		},
		{
			"ID": "20210721113914-cpc36qq",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20210721113914-cpc36qq",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"ID": "20210721113914-9g01tnu",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20210721113914-9g01tnu",
						"updated": "20261016111431"
					},
					"Children": [
						{
							"ID": "20210721113914-bkvbciw",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20210721113914-bkvbciw",
								"updated": "20261016111431"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Anyone or software with permission to read these local files can read their contents"
								}
							]
						}
					]
				},
				{
					"ID": "20210721113914-diinbpv",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20210721113914-diinbpv"
					},
					"Children": [
						{
							"ID": "20210721113914-s8qsqi2",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20210721113914-s8qsqi2"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "The availability of data depends on the availability of hardware disks and operating systems"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261016111431-s2z8kvc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016111431-s2z8kvc",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "Encrypted notebooks",
					"TextMarkBlockRefID": "20260907120000-cryen01",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " encrypt persisted documents, assets, database definitions, and indexes. This does not encrypt the entire workspace or device: unlocked content in memory, temporary files, clipboard contents, plaintext exports, and some metadata remain outside that guarantee. A trusted operating system is still required; see the encrypted-notebook guide for the full security boundary."
				}
			]
		},
		{
			"ID": "20210721113914-ccvr8nz",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210721113914-ccvr8nz",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "End-to-end encryption"
				}
			]
		},
		{
			"ID": "20210721113914-knx9uy7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210721113914-knx9uy7",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan cloud sync uses "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20210721112229-fp97j3c",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "End-to-end Encryption"
				},
				{
					"Type": "NodeText",
					"Data": " for data snapshots. The data repository key is saved locally in "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "workspace/conf/conf.json"
				},
				{
					"Type": "NodeText",
					"Data": " as Base64-encoded configuration data; Base64 is not encryption. Protect the workspace configuration and the device. This repository key is separate from the encrypted-notebook master password and key backups, and cannot replace them."
				}
			]
		},
		{
			"ID": "20210721113914-yk8x9s1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210721113914-yk8x9s1",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Suggest"
				}
			]
		},
