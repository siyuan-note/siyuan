			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan supports connections to WorkBuddy, Doubao, OpenAI, and QwenWork. Once connected, you can search, read, and edit your SiYuan notes from these apps."
				}
			]
		},
		{
