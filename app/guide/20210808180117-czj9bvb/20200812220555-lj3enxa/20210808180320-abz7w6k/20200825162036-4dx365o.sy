		{
			"ID": "20210104091228-1bq55o9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210104091228-1bq55o9",
				"updated": "20261022190543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表格"
				}
			]
		},
		{
			"ID": "20260908091355-rch0004",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260908091355-rch0004",
				"updated": "20260908091355"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "单元格默认支持编辑段落、标题、列表、引述、代码和公式，无需手动转换。已有文字中的 Markdown 标记保持原样，原有加粗、链接等格式也会保留。"
				}
			]
		},
		{
			"ID": "20260908091355-rch0005",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260908091355-rch0005",
				"updated": "20261008221006"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "点击单元格即可编辑；新建表格后可直接输入，无需再次点击。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 按正文编辑规则创建新段落、继续列表项或在代码块内换行。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 在段落内插入软换行。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab"
				},
				{
					"Type": "NodeText",
					"Data": " 和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Tab"
				},
				{
					"Type": "NodeText",
					"Data": " 切换单元格；列表和代码块保留对应的缩进与取消缩进操作。关闭提示后按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Escape"
				},
				{
					"Type": "NodeText",
					"Data": " 或点击单元格外结束编辑，内容自动保存。将表格复制为文本时，会保留单元格内段落之间的空行。"
				}
			]
		},
		{
			"ID": "20260908091355-rch0006",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260908091355-rch0006",
				"updated": "20260909090723"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "内部段落和列表项没有独立块 ID，支持引用已有块。图片及原有行级格式可以保留。不支持嵌套表格、数据库、超级块、页签、提示块、查询嵌入、分隔线、可执行图表、音视频、挂件、HTML 和自定义块。粘贴内容包含不支持的块时，会拒绝整次粘贴并提示不支持的类型，原有内容不变。标准 Markdown 导出为可读的行级内容，HTML、PDF 和 Word 导出保留富文本排版。"
				}
			]
		},
		{
			"ID": "20261022190543-t8zgv8r",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022190543-t8zgv8r",
				"updated": "20261022190543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "拖动行下边界可调整行高；移动端先轻点水平单元格分隔线，再拖动出现的手柄。设置的行高是最小高度，内容较多时仍会自动撑高。选中行后，在菜单中选择 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "自适应行高"
				},
				{
					"Type": "NodeText",
					"Data": " 可恢复自动高度。行高随文档保存，标准 Markdown 导出不保证保留行高。"
				}
			]
		},
		{
			"ID": "20210104091228-eem86ni",
			"Type": "NodeTable",
			"TableAligns": [
				0,
