				}
			]
		},
		{
			"ID": "20261024163828-z2ohzpj",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-z2ohzpj",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "新建文档并引用"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20260927091603-ca0ts26",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927091603-ca0ts26",
				"updated": "20260927183214"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "输入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": " 或 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[["
				},
				{
					"Type": "NodeText",
					"Data": " 和文档标题后，可在引用候选列表中选择 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "选择位置新建文档"
				},
				{
					"Type": "NodeText",
					"Data": "，指定笔记本根目录或父文档。确认后将在该位置创建文档，并在原位置插入引用。所选位置仅对本次创建生效，不会修改默认保存路径；取消不会创建文档。桌面端和移动端均支持此操作。数据库条目绑定或重新绑定文档时也可使用此操作。文档创建成功后才会绑定到该条目；取消或创建失败不会改变原有绑定。"
				}
			]
		},
		{
			"ID": "20261024163828-kskidea",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-kskidea",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "自动闭合与补全"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261014130425-cikkb9k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-cikkb9k",
				"updated": "20261015221015"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "编辑器"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "双向链接"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "自动闭合 [[ 或 【【"
				},
				{
					"Type": "NodeText",
					"Data": " 中可以启用自动闭合，默认关闭。启用后，输入 [[ 或 【【 会在光标后补全对应的 ]] 或 】】；输入两个闭合括号可跳过闭合符并完成引用。按 Enter 选择候选项也会替换闭合符；在空的 [[]] 或 【【】】 中按退格会删除整对括号。"
				}
			]
		},
		{
			"ID": "20261014130425-nr878bc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-nr878bc",
				"updated": "20261014223520"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "输入 ]] 或 】】 完成引用时，先查找标题完全一致的文档，再查找忽略大小写后标题一致的文档，然后使用匹配的日记；都未匹配时按块引新建文档的默认位置创建文档。行级代码、代码块和行级公式中不生效。输入法文字在提交后处理，已由输入法补全的闭合括号会保留。"
				}
			]
		},
