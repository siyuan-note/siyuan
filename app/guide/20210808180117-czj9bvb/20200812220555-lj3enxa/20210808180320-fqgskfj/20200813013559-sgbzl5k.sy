				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在编辑器中输入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": "，继续输入关键词搜索内容块。使用上下方向键选择候选项，按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 插入引用。"
				}
			]
		},
