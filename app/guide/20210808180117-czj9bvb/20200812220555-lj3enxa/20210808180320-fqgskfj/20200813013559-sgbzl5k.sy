		{
			"ID": "20210104090557-575kpbp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104090557-575kpbp",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "内容块引用用于链接到已有内容，让同一段笔记可以在不同上下文中使用。引用显示为可点击的锚文本，鼠标悬浮时可以预览被引用的内容块。"
				}
			]
		},
		{
			"ID": "20261024163828-jmzh0ft",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-jmzh0ft",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "插入引用"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261024163828-zqubvif",
			"Type": "NodeParagraph",
			"Properties": {
