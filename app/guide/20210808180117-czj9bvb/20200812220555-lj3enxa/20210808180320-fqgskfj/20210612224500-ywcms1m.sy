			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在属性面板中，多个别名分别显示为标签。点击「新增别名」添加，点击已有别名编辑，点击其关闭图标删除。输入时可用英文逗号分隔，批量添加多个别名。"
				}
			]
		},
		{
			"ID": "20261024163828-n0477b6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-n0477b6",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 或移开输入焦点保存，按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " 取消本次输入。新输入会去除首尾空白、过滤空项和完全相同的重复项。"
				}
			]
		},
		{
			"ID": "20261024163828-x8bkwsu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-x8bkwsu",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "拖动别名可调整顺序，松开后保存；触屏也支持拖动。拖动时按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " 可取消排序。"
				}
			]
		},
