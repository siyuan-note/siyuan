		{
			"ID": "20210613004135-7td7u1o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210613004135-7td7u1o",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "通过 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "块标菜单"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "属性"
				},
				{
					"Type": "NodeText",
					"Data": " 设置自定义属性。属性名须以小写英文字母开头，可包含小写英文字母、数字和连字符（-），例如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "doing"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "day1"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "project-id"
				},
				{
					"Type": "NodeText",
					"Data": "。输入的大写字母会自动转为小写。保存后，思源会在属性名前自动添加 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "custom-"
				},
				{
					"Type": "NodeText",
					"Data": " 前缀，以区别于内置属性。"
				}
			]
		},
		{
			"ID": "20210613105627-xbzpkz0",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210613105627-xbzpkz0",
				"updated": "20210613105851"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "根据属性查询内容块"
				}
			]
		},
		{
			"ID": "20210613010047-clw1kra",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210613010047-clw1kra",
				"updated": "20210613102634"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "例如，当我们为内容块设置了 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "progress=30"
				},
				{
					"Type": "NodeText",
					"Data": "、 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "priority=2"
				},
				{
					"Type": "NodeText",
					"Data": " 属性后，则可以通过 SQL 查询出所有进度为 30、优先级为 2 的内容块："
				}
			]
		},
		{
			"ID": "20210613012911-qdrxc6w",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20210613012911-qdrxc6w",
				"updated": "20210613105821"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"ID": "20220307091943-a9eflzg",
					"Type": "NodeCodeBlockCode",
					"Data": "SELECT *\nFROM blocks\nWHERE id IN (\n    SELECT block_id\n    FROM attributes AS a\n    WHERE (a.name = 'custom-progress' AND a.value = '30')\n       OR (a.name = 'custom-priority' AND a.value = '2')\n    GROUP BY block_id\n    HAVING count(block_id) = 2\n);\n",
					"Properties": {
						"id": "20220307091943-a9eflzg"
					}
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		}
	]
}
