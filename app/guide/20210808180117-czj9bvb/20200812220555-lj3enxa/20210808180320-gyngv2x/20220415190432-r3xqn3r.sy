			]
		},
		{
			"ID": "20220415212235-jon9dnr",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20220415212235-jon9dnr",
				"updated": "20261016111305"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "-- NOT 的优先级高于 OR，请使用括号明确分组。\n-- 匹配包含 \"one\" 或者 \"two\" 的块，不匹配包含 \"three\" 的块\n'(one OR two) NOT three'\n\n-- 匹配包含 \"one\" 或者包含 \"two\" 且不包含 \"three\" 的块\n'one OR (two NOT three)'\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20220415225818-8llyxls",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415225818-8llyxls",
				"updated": "20220415225927"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用空格分隔的多个短语默认使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AND"
				},
				{
					"Type": "NodeText",
					"Data": " 连接，比如："
				}
			]
		},
		{
			"ID": "20220415225927-10jqrs9",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20220415225927-10jqrs9",
				"updated": "20220502163531"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "'one two three'         -- 'one AND two AND three'\n'three \"one two\"'       -- 'three AND \"one two\"'\n'one OR two three'      -- 'one OR two AND three'\n\n'(one OR two) three'    -- 语法错误！\n'func(one two)'         -- 语法错误！\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20220415195733-gb4mj1a",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20220415195733-gb4mj1a",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技术实现"
				}
			]
		},
		{
			"ID": "20220415195737-mo3ya7g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415195737-mo3ya7g",
				"updated": "20220415230645"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "我们通过 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkAHref": "https://www.sqlite.org/fts5.html",
					"TextMarkTextContent": "SQLite FTS5"
				},
				{
					"Type": "NodeText",
					"Data": " 实现了全局搜索。"
				}
			]
		},
		{
			"ID": "20220415200915-g1un9h6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415200915-g1un9h6",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "搜索属性由 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "搜索"
				},
				{
					"Type": "NodeText",
					"Data": " 中的属性选项决定。FTS5 使用列筛选指定范围，例如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{content name alias memo}:foo"
				},
				{
					"Type": "NodeText",
					"Data": " 表示在正文、命名、别名和备注中搜索 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "foo"
				},
				{
					"Type": "NodeText",
					"Data": "。在 SQL 中，完整写法如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SELECT * FROM blocks_fts WHERE blocks_fts MATCH '{content name alias memo}:foo'"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20220415200742-2l1tkjr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415200742-2l1tkjr",
				"updated": "20220415202247"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "了解到这些以后，我们就可以通过查询语法来实现查询嵌入块，这样查询性能会更好："
				}
			]
		},
		{
			"ID": "20220415200953-ftnqiic",
			"Type": "NodeBlockQueryEmbed",
			"Properties": {
				"id": "20220415200953-ftnqiic",
				"updated": "20220415234532"
			},
			"Children": [
				{
					"Type": "NodeOpenBrace"
				},
				{
					"Type": "NodeOpenBrace"
				},
				{
					"Type": "NodeBlockQueryEmbedScript",
					"Data": "SELECT * FROM blocks_fts WHERE blocks_fts MATCH 'content:Query Syntax' AND root_id = '20220415190432-r3xqn3r' LIMIT 1"
				},
				{
					"Type": "NodeCloseBrace"
				},
				{
					"Type": "NodeCloseBrace"
				}
			]
		},
		{
			"ID": "20220415202144-mc7e5xh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415202144-mc7e5xh",
				"updated": "20220415202331"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "除此以外，API 也支持使用 FTS 查询。"
				}
			]
