			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用英文圆括号 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "()"
				},
				{
					"Type": "NodeText",
					"Data": " 可以组合查询的优先级，例如："
