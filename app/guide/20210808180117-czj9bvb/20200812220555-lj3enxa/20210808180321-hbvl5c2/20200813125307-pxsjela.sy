		"updated": "20261024163013"
	},
	"Children": [
		{
			"ID": "20201229120428-dgzkno8",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20201229120428-dgzkno8",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "导入"
				}
			]
		},
		{
			"ID": "20220511184321-um53ppo",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20220511184321-um53ppo",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown"
				}
			]
		},
		{
			"ID": "20210120161018-1mdw4fy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210120161018-1mdw4fy",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可导入 Markdown 文件或文件夹。迁移其他软件的数据时，可先导出为 Markdown；对于提供专用导入入口的来源，也可使用对应入口。导入前请核对资源文件路径和扩展语法。"
				}
			]
		},
		{
			"ID": "20261002211013-ujtdqw0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002211013-ujtdqw0",
				"updated": "20261002211013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "导入 Markdown 时，[^note]: 形式的脚注定义会转换为独立的有序列表项，正文中的 [^note] 会转换为上标块引用。点击引用可打开定义，通过定义的反向链接可返回引用它的正文块。脚注中的多个段落会保留在同一列表项内。没有对应定义的脚注不生成块引用，代码示例和转义的脚注语法保留为字面文本。"
				}
			]
		},
		{
			"ID": "20220317221825-c0ydyo2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220317221825-c0ydyo2",
				"updated": "20220317223800"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "导入时如果遇到形如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "![foo](images/bar.png)"
				},
				{
					"Type": "NodeText",
					"Data": "​ 的图片语法（本地相对路径），则思源会将 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ 转换为"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20200915214115-42b8zma",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "资源文件"
				},
				{
					"Type": "NodeText",
					"Data": "。但是如果是 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ 则不会转换，因为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "."
				},
				{
					"Type": "NodeText",
					"Data": "​ 开头的路径文件属于隐藏文件，思源不会进行处理。"
				}
			]
		},
		{
			"ID": "20240426184018-e8mz594",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240426184018-e8mz594",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "如果需要识别一些扩展语法（比如 上标 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "^foo^"
				},
				{
					"Type": "NodeText",
					"Data": "​、下标 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~foo~"
				},
				{
					"Type": "NodeText",
					"Data": "​、标签 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#foo#"
				},
				{
					"Type": "NodeText",
					"Data": "​ 和公式 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$foo$"
				},
				{
					"Type": "NodeText",
					"Data": "​ 等），请打开 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "编辑器"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Markdown 语法"
				},
				{
					"Type": "NodeText",
					"Data": " 相关开关。"
				}
			]
		},
		{
			"ID": "20220511184340-6w8o7kg",
