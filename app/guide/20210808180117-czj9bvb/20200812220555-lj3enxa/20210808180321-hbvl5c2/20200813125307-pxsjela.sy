			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220511184359-mea18d0",
				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "桌面端和移动端均可在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "应用"
				},
				{
					"Type": "NodeText",
					"Data": " 中进行数据导入和导出。该导出会完整复制 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空间/data/"
				},
				{
					"Type": "NodeText",
					"Data": " 文件夹并打包为 ZIP 压缩包。"
				}
			]
		},
		{
