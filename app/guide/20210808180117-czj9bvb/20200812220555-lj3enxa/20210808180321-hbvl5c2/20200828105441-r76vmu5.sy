			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": " 通过 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": " 指定工作空间。未指定时依次使用环境变量 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SIYUAN_WORKSPACE_PATH"
				},
				{
					"Type": "NodeText",
					"Data": "、最后一个已注册工作空间、系统默认目录：macOS 为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/Library/Application Support/SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": "，Windows 为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "%USERPROFILE%\\SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": "，其他平台为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--home-dir"
				},
				{
					"Type": "NodeText",
					"Data": " 会改变配置与默认路径使用的用户主目录。普通单次 CLI 命令的选择规则不同，详见 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260612191136-feqbi1x",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "命令行接口"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
