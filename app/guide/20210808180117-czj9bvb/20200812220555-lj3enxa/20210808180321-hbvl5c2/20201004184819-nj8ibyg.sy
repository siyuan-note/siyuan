			"Children": [
				{
					"Type": "NodeText",
					"Data": "在同一局域网的其他设备访问前，先设置锁屏密码或有效的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804190000-oidccn1",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "OIDC 登录"
				},
				{
					"Type": "NodeText",
					"Data": "，开启 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
