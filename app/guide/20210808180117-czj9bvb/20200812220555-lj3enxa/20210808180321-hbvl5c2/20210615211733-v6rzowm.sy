			]
		},
		{
			"ID": "20261024203645-jje7alu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024203645-jje7alu",
				"updated": "20261024203645"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "如果外部程序修改内容却保留文件大小和修改时间，可在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "数据历史"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "数据快照"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "完整校验"
				},
				{
					"Type": "NodeText",
					"Data": " 中填写备注并确认。该操作读取快照范围内所有本地已落盘文件，发现变化时创建快照；未下载的资源保留原版本，不会为校验主动下载。大型工作空间可能耗时较长。"
				}
			]
		},
