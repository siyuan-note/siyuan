			]
		},
		{
			"ID": "20260914101605-18n2jmp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260914101605-18n2jmp",
				"updated": "20260914101605"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "本地快照支持按文件名搜索，搜索时会为文件列表和预览留出空间。未进入批量管理时，仍可选择两个本地快照进行比较，并使用各条目的标记、上传、下载和回滚等操作。"
				}
			]
		},
		{
			"ID": "20260927191121-grjxhnz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927191121-grjxhnz",
				"updated": "20260927191121"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在搜索框中直接输入文件名或快照 ID 即可搜索本地快照。输入 7 至 40 位十六进制 ID 时，优先匹配快照 ID 前缀，字母不区分大小写。若匹配多个快照，将按创建时间从新到旧列出全部结果；若未匹配到快照 ID，则继续按文件名搜索。结果保留回滚等常规快照操作。清空搜索内容可返回完整列表。"
				}
			]
		},
