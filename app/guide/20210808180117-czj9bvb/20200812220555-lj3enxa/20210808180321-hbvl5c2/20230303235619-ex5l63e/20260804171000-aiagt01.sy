			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "发送和停止任务"
				}
			]
		},
		{
			"ID": "20260804170040-qf65tjk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170040-qf65tjk",
				"updated": "20260820190627"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "输入需求后默认按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "回车"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘回车"
				},
				{
					"Type": "NodeText",
					"Data": " 发送，也可以自定义快捷键。"
				},
				{
					"Type": "NodeText",
					"Data": "智能体运行时可以点击停止按钮中止当前任务。描述目标、范围和期望输出位置越明确，执行结果通常越稳定。"
				}
			]
		},
		{
			"ID": "20260804170041-tqg42zs",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170041-tqg42zs",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "确认操作"
				}
			]
		},
		{
			"ID": "20260804170042-39b79if",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170042-39b79if",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "读取和搜索通常直接执行。创建、修改、移动、删除或导入数据等操作会显示确认卡片，并标明可能产生的本地写入、数据外发和外部费用。可以确认执行、拒绝，或选择 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "会话允许"
				},
				{
					"Type": "NodeText",
					"Data": " 在当前会话中不再询问任何操作。"
				}
			]
		},
		{
			"ID": "20260804170043-17l9f9p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170043-17l9f9p",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "会话允许"
				},
				{
					"Type": "NodeText",
					"Data": " 前应确认当前任务范围和所用工具可信，因为后续写入操作将不再逐项确认。"
				}
			]
		},
		{
			"ID": "20260804170044-eh59up7",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170044-eh59up7",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "会话管理"
				}
			]
		},
		{
			"ID": "20260804170045-ubzsbxu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170045-ubzsbxu",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "智能体支持新建、搜索、切换、重命名和删除会话。会话会保存消息、引用、工具调用和执行结果，可在不同实例间同步查看。"
				}
			]
		},
		{
			"ID": "20260804170046-970uh7p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170046-970uh7p",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以编辑已经发送的消息并重新发送，也可以让智能体重新回答。重新发送会删除该消息之后的对话记录，但不会撤销已经执行的操作；如需恢复数据，请使用对应的数据快照。"
				}
			]
		},
		{
			"ID": "20260804170047-8e3z8dy",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170047-8e3z8dy",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "模型和思考强度"
				}
			]
		},
		{
			"ID": "20260804170048-bwsd8ah",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170048-bwsd8ah",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以在输入框下方切换已启用的模型，并为支持的模型选择思考强度。包含推理或工具调用的会话在切换模型后，回答质量和工具调用连续性可能下降。"
				}
			]
		},
		{
			"ID": "20260804170049-7p6ngv7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170049-7p6ngv7",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "上下文用量按钮会显示当前会话使用的上下文比例及分类明细。上下文接近模型上限时，智能体会尝试压缩较早的对话内容。"
				}
			]
		},
		{
			"ID": "20260804170050-qxi11l2",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170050-qxi11l2",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技能"
				}
			]
		},
		{
			"ID": "20260804170051-rx34vtk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170051-rx34vtk",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技能是一组可复用的任务说明，用于约束流程、格式或领域规则。每个技能使用一个独立目录并包含 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": "，保存在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空间/data/storage/ai/agent/skills/"
				},
				{
					"Type": "NodeText",
					"Data": "。也可以逐个启用用户主目录 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/.agents/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " 下的只读技能。"
				}
			]
		},
		{
			"ID": "20260804170052-1z6d5mn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170052-1z6d5mn",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " 可以在 YAML Front Matter 中定义 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "name"
				},
				{
					"Type": "NodeText",
					"Data": " 和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "description"
				},
				{
					"Type": "NodeText",
					"Data": "，正文用于说明智能体应遵循的步骤和要求。输入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " 可以搜索并选择已经安装的技能。"
				}
			]
		},
		{
			"ID": "20260804170053-wp08ijl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170053-wp08ijl",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以直接要求智能体列出、创建、更新、重命名或删除技能。安装技能时，可提供 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": "、完整的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": " 命令、GitHub 地址、原始 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " 地址或 ZIP 地址。技能会影响智能体的执行方式，请只安装和使用可信来源的内容。"
				}
			]
		},
		{
			"ID": "20260804170054-w5eqebc",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170054-w5eqebc",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP 服务"
				}
			]
		},
		{
			"ID": "20260804170055-qbwm9vb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170055-qbwm9vb",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP 服务可以向智能体提供外部工具。在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "人工智能"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "智能体 MCP 服务"
				},
				{
					"Type": "NodeText",
					"Data": " 中可以添加 stdio 或 HTTP 服务，配置命令、参数、环境变量、地址、HTTP 标头和超时时间，并查看连接状态和工具数量。"
				},
				{
					"Type": "NodeText",
					"Data": "这里配置的是供智能体调用的外部 MCP 服务；如果要让外部 MCP 客户端连接思源，请参阅 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804223000-mcpsv01",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "MCP 服务"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20260804170056-3aqvrqh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170056-3aqvrqh",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "stdio 服务只会继承用户勾选的内核环境变量，并在每次启动时读取当前值；还可以在环境变量条目中引用密钥和变量。引用密钥会将其明文提供给该程序及其子进程，直接填写的值会以明文存储。需要授权的 HTTP 服务会引导完成 OAuth 授权。密钥和可复用参数可以在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "设置"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "密钥和变量"
				},
				{
					"Type": "NodeText",
					"Data": " 中统一管理，具体说明请参阅 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804185000-secvr01",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "密钥和变量"
				},
				{
					"Type": "NodeText",
					"Data": "。调用外部 MCP 工具可能发送本地数据、修改外部系统或产生费用，应根据确认卡片核对具体影响。"
				}
			]
		},
