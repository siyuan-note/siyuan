		{
			"ID": "20260804170024-gjy30mg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170024-gjy30mg",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI 智能体不仅可以回答问题，还可以调用思源内置工具、技能、MCP 服务和插件能力，搜索、读取并操作知识库。它会根据任务分步骤执行，并在需要修改数据时请求确认。"
				}
			]
		},
		{
			"ID": "20260804170025-0kg9iaq",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
