				"updated": "20260820190627"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "重试失败的内容块"
				}
			]
		},
		{
			"ID": "20260804170139-hue5uqg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170139-hue5uqg",
				"updated": "20260820190627"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "索引进度中出现失败内容块时，先检查嵌入模型配置和网络连接，然后点击重试失败的内容块。该操作不会重新处理已经成功生成向量的内容块。"
				}
			]
		},
		{
			"ID": "20260804170140-2828v5b",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
