				"updated": "20260820190627"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "更换嵌入模型、修改向量维度或调整忽略规则后，应点击 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "重建嵌入索引"
				},
				{
					"Type": "NodeText",
					"Data": "。重建会清空已有向量并在后台重新计算，期间语义搜索结果可能不完整。"
				}
			]
		},
