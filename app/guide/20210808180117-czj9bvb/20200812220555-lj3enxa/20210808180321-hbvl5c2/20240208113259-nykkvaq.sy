						"updated": "20261012014859"
					},
					"Children": [
						{
							"ID": "20261012014537-084hlwy",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261012014537-084hlwy",
								"updated": "20261012014859"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "汇总：目标为关联字段且计算方式为“显示原始值”或“显示唯一值”时，支持普通筛选中的“包含任一”和“不包含任一”：可以搜索并勾选最终关联数据库的条目，按整个汇总条目集合匹配，同名条目通过条目 ID 区分；原有关键词筛选及其“任一”“所有”“没有”量词保持原有行为"
								}
							]
						}
					]
				},
				{
					"ID": "20260613170258-uwddfvi",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613170258-uwddfvi",
						"updated": "20261016191345"
					},
					"Children": [
						{
							"ID": "20260613170258-2mrv7ni",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613170258-2mrv7ni",
								"updated": "20261016191345"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "添加多条"
								},
								{
									"Type": "NodeText",
									"Data": "：可为多个字段设置条件，默认以「与」（AND）组合，要求全部满足；可切换为「或」（OR），满足任一条件即可，也可添加嵌套条件组"
								}
							]
						}
					]
				},
				{
					"ID": "20260613170258-9jsilli",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
