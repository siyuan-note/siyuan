				"updated": "20240208120133"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "镜像数据库"
				}
			]
		},
		{
			"ID": "20240208120134-fu4vdbm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240208120134-fu4vdbm",
				"updated": "20240208120322"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "复制数据库块后粘贴将形成镜像数据库，即这些数据库块共享相同的数据库数据，修改任何一个数据库块的数据会同步到其他所有镜像中。"
				}
			]
		},
