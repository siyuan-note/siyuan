								"updated": "20261025011205"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "字段名称：在视图设置中开启 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "布局"
