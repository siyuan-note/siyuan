						"id": "20260613170258-9jsilli",
						"updated": "20260613170258"
					},
					"Children": [
						{
							"ID": "20260613170258-z40uvpa",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613170258-z40uvpa",
								"updated": "20260613170258"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "移除过滤"
								},
								{
									"Type": "NodeText",
									"Data": "：点击过滤条件右侧的删除按钮移除单条；通过过滤菜单可一键清除全部"
								}
							]
						}
					]
				},
