						{
							"ID": "20260614104306-ifs0z9h",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260614104306-ifs0z9h",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "协议：可选直接连接（不使用代理）、使用系统代理、HTTP、HTTPS 或 SOCKS5；直接连接和使用系统代理无需填写主机与端口"
								}
							]
						}
					]
				},
				{
					"ID": "20261016112115-zd0i0ab",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261016112115-zd0i0ab",
						"updated": "20261016112115"
					},
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261016112115-bggswt8",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261016112115-bggswt8",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "系统模式使用受支持的系统设置，或内核启动时继承的代理环境变量。内核支持读取 Windows 手动代理和 Linux GNOME 手动代理，Linux 上显式代理环境变量优先。这些读取器不支持自动 PAC 配置，Windows 自动检测也不受支持；其他平台的内核保留启动时的代理环境，不读取操作系统代理设置"
								}
							]
						}
					]
				},
				{
					"ID": "20260614104306-vrvyzam",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
