					"Data": "回调地址"
				}
			]
		},
		{
			"ID": "20260804100025-cn0000q",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260804100025-cn0000q",
				"updated": "20260804211500"
			},
			"Children": [
				{
					"ID": "20260804100026-cn0000r",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804100026-cn0000r",
						"updated": "20260804211500"
					},
					"Children": [
						{
							"ID": "20260804100027-cn0000s",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804100027-cn0000s",
								"updated": "20260804211500"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "本机浏览器和桌面端：回调地址使用思源当前本机访问协议；启用 HTTPS 时为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "https://127.0.0.1:<端口>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "，未启用 HTTPS 时为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "http://127.0.0.1:<端口>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "。身份提供商中登记的地址必须与实际协议、主机、端口、路径和斜线完全一致"
								}
							]
						}
					]
				},
				{
					"ID": "20260804100028-cn0000t",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804100028-cn0000t",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804100029-cn0000u",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804100029-cn0000u",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "远程浏览器：在 OIDC 回调地址中填写公开 HTTPS 地址，路径必须恰好是 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "，不能包含查询参数、片段或用户信息"
								}
							]
						}
					]
				},
				{
					"ID": "20260804100030-cn0000v",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804100030-cn0000v",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804100031-cn0000w",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804100031-cn0000w",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "原生移动端：固定使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan:/oidc-callback"
								},
								{
									"Type": "NodeText",
									"Data": "；需要在身份提供商中原样登记。Google 不接受该回调格式，因此 Google 登录仅支持浏览器和桌面端"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804100032-cn0000x",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804100032-cn0000x",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "授权范围"
				}
			]
		},
		{
			"ID": "20260804100033-cn0000y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804100033-cn0000y",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "默认授权范围是 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "openid profile email"
				},
				{
					"Type": "NodeText",
					"Data": "。一般无需修改；自定义范围前应确认提供商返回的身份声明仍能满足准入规则。GitHub 会将默认范围转换为读取用户和已验证邮箱所需的权限。"
				}
			]
		},
		{
			"ID": "20260804100034-cn0000z",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804100034-cn0000z",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "准入规则"
				}
			]
		},
		{
			"ID": "20260804100035-cn00010",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804100035-cn00010",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "关闭“授予所有已认证用户管理员权限”后，必须至少配置一条准入规则。规则使用 JSON 数组：同一规则的多个 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "values"
				},
				{
					"Type": "NodeText",
					"Data": " 是“或”关系，不同规则之间是“与”关系；"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "operator"
				},
				{
					"Type": "NodeText",
					"Data": " 支持 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "equals"
				},
				{
					"Type": "NodeText",
					"Data": " 和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20260804100036-cn00011",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "anNvbg==",
			"CodeBlockCloseFence": "YGBg",
			"Properties": {
				"id": "20260804100036-cn00011",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "anNvbg=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "[\n  {\n    \"claim\": \"email\",\n    \"operator\": \"equals\",\n    \"values\": [\"alice@example.com\", \"bob@example.com\"]\n  },\n  {\n    \"claim\": \"email_verified\",\n    \"operator\": \"equals\",\n    \"values\": [\"true\"]\n  }\n]\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20260804100037-cn00012",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804100037-cn00012",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "以上示例只允许两个指定邮箱登录，并要求提供商确认邮箱已经验证。若提供商使用 "
				},
				{
