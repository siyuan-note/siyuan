			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "创建应用和注册回调地址时，可参阅 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Google OpenID Connect 文档",
					"TextMarkAHref": "https://developers.google.com/identity/openid-connect/openid-connect"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Microsoft Entra 应用注册文档",
					"TextMarkAHref": "https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app"
				},
				{
					"Type": "NodeText",
					"Data": "和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "GitHub OAuth App 文档",
					"TextMarkAHref": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
				},
				{
					"Type": "NodeText",
					"Data": "。提供商控制台的具体界面可能变化，请以其当前文档为准。"
				}
			]
		},
		{
			"ID": "20260804100024-cn0000p",
			"Type": "NodeHeading",
