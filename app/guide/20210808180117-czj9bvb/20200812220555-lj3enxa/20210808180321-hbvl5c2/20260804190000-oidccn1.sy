			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概述"
				}
			]
		},
		{
			"ID": "20260804100001-cn00002",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804100001-cn00002",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "OIDC（OpenID Connect）登录可以让思源通过已有的身份提供商完成单点登录，并与浏览器锁屏密码配合使用。支持的提供商包括 Custom、Google、Microsoft 和 GitHub。"
				}
			]
		},
		{
			"ID": "20260804100002-cn00003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804100002-cn00003",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "通过 OIDC 准入规则的身份都会获得当前工作空间的管理员权限。OIDC 不提供多用户权限隔离或角色映射，启用前应严格限制允许登录的身份。"
				}
			]
		},
		{
			"ID": "20260804100003-cn00004",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804100003-cn00004",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用前准备"
				}
			]
		},
