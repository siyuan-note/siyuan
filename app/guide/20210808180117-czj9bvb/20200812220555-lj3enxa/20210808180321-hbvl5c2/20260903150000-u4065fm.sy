					"Children": [
						{
							"ID": "20260903150000-z98z7dm",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260903150000-z98z7dm",
								"updated": "20260903150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "依赖客户端本地路径或服务器绝对路径的操作，例如在文件管理器中显示，以及按路径拖入或打开文件；通过文件选择器进行普通资源上传仍可用"
								}
							]
						}
					]
				},
				{
					"ID": "20260903150000-5k7d57t",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260903150000-5k7d57t",
						"updated": "20260908082237"
					},
					"Children": [
						{
							"ID": "20260903150000-4p58ioe",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260903150000-4p58ioe",
								"updated": "20260908082237"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "默认不支持桌面端插件、集市和自定义外观；可通过上述信任参数开启远程插件、集市、自定义主题、图标、字体和代码片段，小部件仍不可用"
								}
							]
						}
					]
				},
				{
					"ID": "20260903150000-c5tbiz0",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260903150000-c5tbiz0",
						"updated": "20260903150000"
					},
					"Children": [
						{
							"ID": "20260903150000-0ptz2p4",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260903150000-0ptz2p4",
								"updated": "20260903150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "HTML 和 SVG 块、数据库模板及 JavaScript 查询嵌入块中的脚本不会执行，iframe 块不可用；图表、图形和数学公式等渲染结果会进行安全净化"
								}
							]
						}
					]
				},
				{
					"ID": "20260903150000-up6xjxo",
