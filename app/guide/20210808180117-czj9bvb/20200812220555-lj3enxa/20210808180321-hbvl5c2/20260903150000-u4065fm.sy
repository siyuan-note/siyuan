	"Properties": {
		"id": "20260903150000-u4065fm",
		"title": "连接远程内核",
		"type": "doc",
		"updated": "20260903150000"
	},
	"Children": [
		{
			"ID": "20260903150000-7adxewf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260903150000-7adxewf",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概述"
				}
			]
		},
		{
			"ID": "20260903150000-f38iwpd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260903150000-f38iwpd",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "桌面端可以连接运行在其他设备上的思源内核，并使用本地桌面界面进行编辑。远程模式仅用于连接现有内核，不会在本机启动内核。"
				}
			]
		},
		{
			"ID": "20260903150000-15zokfv",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260903150000-15zokfv",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "启动方式"
				}
			]
		},
		{
			"ID": "20260903150000-y92771v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260903150000-y92771v",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "完全退出思源桌面客户端后，从命令行启动桌面端并添加参数 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--remote=https://host[:port]"
				},
				{
					"Type": "NodeText",
					"Data": "。如果已有实例正在运行，单实例机制不会切换当前连接。"
				}
			]
		},
		{
			"ID": "20260903150000-fjznin7",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260903150000-fjznin7",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "安全与版本"
				}
			]
		},
		{
			"ID": "20260903150000-54fwkfr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260903150000-54fwkfr",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "仅支持 HTTPS 远程地址，客户端操作系统必须信任服务器使用的 TLS 证书。请只连接你信任的服务器；桌面客户端与远程内核的版本必须完全一致，否则无法连接。桌面客户端只加载安装包内置前端，不加载远端服务器提供的 HTML、脚本等可执行前端资源，因此同源的远端 HTML 嵌入内容也不可用。"
				}
			]
		},
		{
			"ID": "20260903150000-bh8cy8d",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260903150000-bh8cy8d",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "功能限制"
				}
			]
		},
		{
			"ID": "20260903150000-w1kgmix",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260903150000-w1kgmix",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "首版远程模式暂不支持以下功能，本地模式不受影响："
				}
			]
		},
