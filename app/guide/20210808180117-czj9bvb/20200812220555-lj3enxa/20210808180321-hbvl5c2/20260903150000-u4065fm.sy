				}
			]
		},
		{
			"ID": "20260903150000-xv2k13i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260903150000-xv2k13i",
				"updated": "20260903150000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "远程内核的启动、停止、重启、升级和工作空间切换均需在服务器端完成。关闭桌面客户端不会关闭远程内核。"
				}
			]
