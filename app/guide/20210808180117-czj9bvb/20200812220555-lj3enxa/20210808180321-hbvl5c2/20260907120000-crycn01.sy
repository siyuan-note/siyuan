							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-cnrev06",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "锁定只会尽力清理应用可控的明文缓存和临时文件，不保证抹除操作系统交换区、休眠文件、崩溃转储或存储快照中的瞬时副本；主动导出的文件、剪贴板、截图和打印内容需要自行保护"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-cnrev07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
