								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "加密笔记本在锁定状态下保护最强。解锁期间，获得主应用授权的插件、API、MCP 工具和 AI 智能体可以读取其中内容"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-cnrev03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-cnrev03",
						"updated": "20260908150000"
