						{
							"ID": "20260908120000-cnuse06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-cnuse06",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "工作机密资料：保存项目规划、会议记录、客户资料、研究材料和其他需要限制本地访问的内容"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-cnuse07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
