					"Properties": {
						"id": "20260908120000-cnuse07",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-cnuse08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-cnuse08",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "敏感知识库与 AI 辅助：在解锁后使用 AI 进行总结、问答、润色和整理；使用云端 AI 服务时，相关内容可能发送给所配置的服务提供商，请根据隐私要求选择模型和部署方式"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-cnrev01",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
