							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-cnuse10",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "多设备与长期保存：通过数据同步使用加密后的持久化数据，并配合主密码和密钥备份在其他设备上恢复访问"
								}
							]
						}
					]
				}
			]
