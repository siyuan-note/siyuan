					"Children": [
						{
							"ID": "20260908150000-cnrev04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-cnrev04",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "加密主要保护磁盘上的持久化内容，并在锁定后阻止通过受支持入口访问内容；笔记本名称、目录结构、文件数量和大小、修改时间、资源扩展名等元数据仍可能可见"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-cnrev05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-cnrev05",
