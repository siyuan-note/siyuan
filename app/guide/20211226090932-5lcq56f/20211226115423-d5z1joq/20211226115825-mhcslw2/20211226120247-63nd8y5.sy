				"updated": "20261022133332"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在反向連結面板或底部反向連結中，開啟 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "篩選反向連結來源"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "資料庫欄位"
				},
				{
					"Type": "NodeText",
					"Data": "，選擇來源區塊已加入的資料庫，再設定欄位組合條件。只顯示綁定到所選資料庫且符合條件的反向連結來源；未設定欄位條件時，顯示所有綁定到該資料庫的反向連結來源。此操作不會修改資料庫原檢視的篩選，也不影響提及。桌面端和行動端均支援此功能。"
				}
			]
		},
