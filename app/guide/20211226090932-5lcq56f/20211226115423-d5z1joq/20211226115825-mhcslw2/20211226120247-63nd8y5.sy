					"Data": "概述"
				}
			]
		},
		{
			"ID": "20220623200737-sx458du",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220623200737-sx458du",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "區塊引用用於連結到既有內容，讓同一段筆記可以在不同情境中使用。引用顯示為可點擊的錨文字，滑鼠懸停時可以預覽被引用的內容區塊。"
				}
			]
		},
		{
			"ID": "20261024163828-9fltrh3",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-9fltrh3",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "插入引用"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261024163828-qflzhzm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-qflzhzm",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在編輯器中輸入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": "，繼續輸入關鍵字搜尋內容區塊。使用上下方向鍵選擇候選項，按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 插入引用。"
				}
			]
		},
		{
			"ID": "20261024163828-b4usmnr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-b4usmnr",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "內容區塊/引用"
				}
			]
		},
		{
			"ID": "20261024163828-f2xfhww",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-f2xfhww",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "新增文檔並引用"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20260927091603-savpene",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927091603-savpene",
				"updated": "20260927183214"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輸入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": " 或 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "[["
				},
				{
					"Type": "NodeText",
					"Data": " 和文件標題後，可在區塊引用候選清單中選擇 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "選擇位置新增文件"
				},
				{
					"Type": "NodeText",
					"Data": "，指定筆記本根目錄或父文件。確認後將在該位置建立文件，並在原位置插入區塊引用。所選位置僅對本次建立生效，不會修改預設儲存路徑；取消不會建立文件。桌面端和行動端均支援此操作。資料庫項目綁定或重新綁定文件時也可使用此操作。文件建立成功後才會綁定到該項目；取消或建立失敗不會改變原有綁定。"
				}
			]
		},
		{
			"ID": "20261024163828-4cro9g3",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163828-4cro9g3",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "自動閉合與補全"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261014130425-brzvwem",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-brzvwem",
				"updated": "20261015221015"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "編輯器"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "雙向連結"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "自動閉合 [[ 或 【【"
				},
				{
					"Type": "NodeText",
					"Data": " 中可以啟用自動閉合，預設關閉。啟用後，輸入 [[ 或 【【 會在游標後補全對應的 ]] 或 】】；輸入兩個閉合括號可跳過閉合符並完成區塊引用。按 Enter 選擇候選項也會替換閉合符；在空的 [[]] 或 【【】】 中按退格會刪除整組括號。"
				}
			]
		},
		{
			"ID": "20261014130425-eewkoer",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261014130425-eewkoer",
				"updated": "20261014223520"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輸入 ]] 或 】】 完成區塊引用時，先尋找標題完全一致的文件，再尋找忽略大小寫後標題一致的文件，然後使用符合條件的日記；都未符合時依區塊引用新建文件的預設位置建立文件。行內程式碼、程式碼區塊和行內公式中不生效。輸入法文字在提交後處理，已由輸入法補全的閉合括號會保留。"
				}
			]
		},
