			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用英文圓括號 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "()"
				},
				{
					"Type": "NodeText",
					"Data": " 可以組合查詢的優先級，例如："
				}
			]
		},
		{
			"ID": "20220415232130-8ymwyjm",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20220415232130-8ymwyjm",
				"updated": "20261016111305"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "-- NOT 的優先順序高於 OR，請使用括號明確分組。\n-- 匹配包含 \"one\" 或者 \"two\" 的區塊，不匹配包含 \"three\" 的區塊\n'(one OR two) NOT three'\n\n-- 匹配包含 \"one\" 或者包含 \"two\" 且不包含 \"three\" 的區塊\n'one OR (two NOT three)'\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20220415232130-7a9cd6e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415232130-7a9cd6e",
				"updated": "20220415232130"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用空格分隔的多個短語預設使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AND"
				},
				{
					"Type": "NodeText",
					"Data": " 連接，比如："
				}
			]
		},
		{
			"ID": "20220415232130-mdy457p",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20220415232130-mdy457p",
				"updated": "20220502163604"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "'one two three'         -- 'one AND two AND three'\n'three \"one two\"'       -- 'three AND \"one two\"'\n'one OR two three'      -- 'one OR two AND three'\n\n'(one OR two) three'    -- 語法錯誤！\n'func(one two)'         -- 語法錯誤！\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20220415232130-1juhjxd",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20220415232130-1juhjxd",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技術實現"
				}
			]
		},
		{
			"ID": "20220415232130-1w366ul",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415232130-1w366ul",
				"updated": "20220415232130"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "我們通過 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkAHref": "https://www.sqlite.org/fts5.html",
					"TextMarkTextContent": "SQLite FTS5"
				},
				{
					"Type": "NodeText",
					"Data": " 實現了全域搜索。"
				}
			]
		},
		{
			"ID": "20220415232130-kdii2n4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415232130-kdii2n4",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "搜尋屬性由 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "搜尋"
				},
				{
					"Type": "NodeText",
					"Data": " 中的屬性選項決定。FTS5 使用欄位篩選指定範圍，例如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{content name alias memo}:foo"
				},
				{
					"Type": "NodeText",
					"Data": " 表示在正文、命名、別名和備註中搜尋 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "foo"
				},
				{
					"Type": "NodeText",
					"Data": "。在 SQL 中，完整寫法如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SELECT * FROM blocks_fts WHERE blocks_fts MATCH '{content name alias memo}:foo'"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20220415232130-ecl8s30",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220415232130-ecl8s30",
				"updated": "20260730184353"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "了解到這些以後，我們就可以通過查詢語法來實現查詢嵌入區塊，這樣查詢性能會更好："
				}
			]
		},
