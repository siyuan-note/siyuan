		{
			"ID": "20211226122519-kdp3vo5",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20211226122519-kdp3vo5",
				"updated": "20261016202635"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "啟動入口"
				}
			]
		},
		{
			"ID": "20211226122519-ygn57k3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226122519-ygn57k3",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "映像入口為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "ENTRYPOINT [\"/opt/siyuan/entrypoint.sh\"]"
				},
				{
					"Type": "NodeText",
					"Data": "，預設指令為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "CMD [\"serve\"]"
				},
				{
					"Type": "NodeText",
					"Data": "。映像名稱後的參數會替換預設指令，因此傳入核心參數時必須明確包含 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20261016112115-ei2ulh1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016112115-ei2ulh1",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "啟動前先建立主機工作空間目錄並設定鑑權。以下範例從主機已匯出的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SIYUAN_ACCESS_AUTH_CODE"
				},
				{
					"Type": "NodeText",
					"Data": " 環境變數讀取強鎖屏密碼；新的 Docker 工作空間沒有密碼或有效的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804190001-oidctw1",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "OIDC 登入"
				},
				{
					"Type": "NodeText",
					"Data": " 時會拒絕啟動。例如，可在 Bash 中依下例私密輸入自行選擇的密碼。不要將真實密碼寫入共享檔案或指令歷史；有權限檢查容器環境的人仍可讀到該值。"
				}
			]
		},
		{
			"ID": "20261016112115-ebh8s7k",
			"Type": "NodeCodeBlock",
			"Properties": {
				"id": "20261016112115-ebh8s7k",
				"updated": "20261016112115"
			},
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "YmFzaA==",
			"CodeBlockCloseFence": "YGBg",
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YmFzaA=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "read -r -s -p \"鎖屏密碼：\" SIYUAN_ACCESS_AUTH_CODE\nprintf '\\n'\nexport SIYUAN_ACCESS_AUTH_CODE\n: \"${SIYUAN_ACCESS_AUTH_CODE:?請設定非空鎖屏密碼}\"\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20211226122519-cpmotp6",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20211226122519-cpmotp6",
				"updated": "20211226011647"
			},
			"Children": [
				{
					"ID": "20211226122519-l15oree",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20211226122519-l15oree"
					},
					"Children": [
						{
							"ID": "20211226122519-0g8i8mj",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20211226122519-0g8i8mj"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace"
								},
								{
									"Type": "NodeText",
									"Data": " 指定工作空間文件夾路徑，在宿主機上通過 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "-v"
								},
								{
									"Type": "NodeText",
									"Data": " 掛載到容器中"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20211226122519-ajimm1z",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226122519-ajimm1z",
				"updated": "20261016202635"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "更多的參數可參考"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20211226122358-hctqcn5",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "這裡"
				},
				{
					"Type": "NodeText",
					"Data": "。下面是一條啟動指令示例："
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v workspace_dir_host:workspace_dir_container -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE b3log/siyuan serve --workspace=workspace_dir_container"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeText",
					"Data": "。透過 Docker 部署並啟用發布服務時，除了伺服連接埠映射外，還需在建立容器的指令中加入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-p 6808:6808"
				},
				{
					"Type": "NodeText",
					"Data": "。Docker 連接埠映射格式為主機連接埠:容器連接埠；若修改發布服務連接埠，應同步調整容器連接埠，存取時使用主機連接埠。請使用固定的發布服務連接埠，不要設定為 0。"
				}
			]
		},
		{
			"ID": "20211226122519-5g8qw7j",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20211226122519-5g8qw7j",
				"updated": "20211226011647"
			},
			"Children": [
				{
					"ID": "20211226122519-2t1ukwf",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20211226122519-2t1ukwf"
					},
					"Children": [
						{
							"ID": "20211226122519-g8sxt5u",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20211226122519-g8sxt5u"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "workspace_dir_host"
								},
								{
									"Type": "NodeText",
									"Data": "：宿主機上的工作空間文件夾路徑"
								}
							]
						}
					]
				},
				{
					"ID": "20211226122519-kalelk8",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20211226122519-kalelk8"
					},
					"Children": [
						{
							"ID": "20211226122519-75lsh4l",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20211226122519-75lsh4l"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "workspace_dir_container"
								},
								{
									"Type": "NodeText",
									"Data": "：容器內工作空間文件夾路徑，和後面 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace"
								},
								{
									"Type": "NodeText",
									"Data": " 指定成一樣的"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20211226122519-yggdi08",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226122519-yggdi08",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "例如，在主機建立 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": " 後執行 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v /siyuan/workspace:/siyuan/workspace -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE -e PUID=1000 -e PGID=1000 b3log/siyuan serve --workspace=/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": "。主機與容器內路徑可以不同。啟動後開啟 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "http://server-ip:6806"
				},
				{
					"Type": "NodeText",
					"Data": "，使用剛才設定的密碼登入；啟動失敗時檢查容器日誌。"
				}
			]
		},
		{
			"ID": "20211226122519-s9mfeas",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20211226122519-s9mfeas",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "用戶權限"
				}
			]
		},
		{
			"ID": "20211226122519-38pgtv3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226122519-38pgtv3",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "入口指令碼需要權限來建立或重複使用使用者和群組，並遞迴設定 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/opt/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/home/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": " 和工作空間的所有權，隨後透過 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "su-exec"
				},
				{
					"Type": "NodeText",
					"Data": " 以 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "PUID:PGID"
				},
				{
					"Type": "NodeText",
					"Data": " 執行核心，兩者預設均為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "1000"
				},
				{
					"Type": "NodeText",
					"Data": "。如需符合主機擁有者，可傳入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-e PUID=1000 -e PGID=1000"
				},
				{
					"Type": "NodeText",
					"Data": " 並替換為相應數字 ID。不要加入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-u 1000:1000"
				},
				{
					"Type": "NodeText",
					"Data": "，否則入口指令碼無法準備權限。所有權調整也會作用於掛載的主機目錄。"
				}
			]
		},
		{
			"ID": "20211226122519-wwlpn5g",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
