			"Children": [
				{
					"Type": "NodeText",
					"Data": "在同一區域網路的其他裝置存取前，先設定鎖屏密碼或有效的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
