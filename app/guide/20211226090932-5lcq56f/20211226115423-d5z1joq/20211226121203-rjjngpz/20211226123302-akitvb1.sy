				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " 是思源原生文檔格式。在文檔樹中選擇目標筆記本或文檔後，使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "導入"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "SiYuan .sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " 選擇壓縮檔。導入後的文檔會保留內容、設定中指定包含的子文檔、資源文件和區塊屬性。"
				}
			]
		},
		{
