			]
		},
		{
			"ID": "20220511185953-vjaca7x",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20220511185953-vjaca7x",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown"
				}
			]
		},
		{
			"ID": "20220317223850-jevugyb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220317223850-jevugyb",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可匯入 Markdown 檔案或資料夾。遷移其他軟體的資料時，可先匯出為 Markdown；對於提供專用匯入入口的來源，也可使用對應入口。匯入前請核對資源檔案路徑和擴充語法。"
				}
			]
		},
		{
			"ID": "20261002211013-g6lzmsj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002211013-g6lzmsj",
				"updated": "20261002211013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "導入 Markdown 時，[^note]: 形式的註腳定義會轉換為獨立的有序清單項目，正文中的 [^note] 會轉換為上標區塊引用。點擊引用可開啟定義，透過定義的反向連結可返回引用它的正文區塊。註腳中的多個段落會保留在同一清單項目內。沒有對應定義的註腳不產生區塊引用，程式碼範例和跳脫的註腳語法保留為字面文字。"
				}
			]
		},
		{
			"ID": "20220317223850-hjeb6n7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220317223850-hjeb6n7",
				"updated": "20220317223926"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "導入時如果遇到形如 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "![foo](images/bar.png)"
				},
				{
					"Type": "NodeText",
					"Data": "​ 的圖片語法（本地相對路徑），則思源會將 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ 轉換為"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20211226123038-4umgpxy",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "資料文件"
				},
				{
					"Type": "NodeText",
					"Data": "。但是如果是 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ 則不會轉換，因為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "."
				},
				{
					"Type": "NodeText",
					"Data": "​ 開頭的路徑文件屬於隱藏文件，思源不會進行處理。"
				}
			]
		},
		{
			"ID": "20240426184604-4ldk0w4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240426184604-4ldk0w4",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "如果需要辨識一些擴充語法（例如上標 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "^foo^"
				},
				{
					"Type": "NodeText",
					"Data": "​、下標 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~foo~"
				},
				{
					"Type": "NodeText",
					"Data": "​、標籤 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#foo#"
				},
				{
					"Type": "NodeText",
					"Data": "​ 和公式 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$foo$"
				},
				{
					"Type": "NodeText",
					"Data": "​ 等），請開啟 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "編輯器"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Markdown 語法"
				},
				{
					"Type": "NodeText",
					"Data": " 相關開關。"
				}
			]
		},
		{
			"ID": "20220511185951-ewyusg9",
