				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "桌面端和行動端均可在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "應用"
				},
				{
					"Type": "NodeText",
					"Data": " 中進行資料導入和導出。該導出會完整複製 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空間/data/"
				},
				{
					"Type": "NodeText",
					"Data": " 資料夾並打包為 ZIP 壓縮檔。"
				}
			]
		},
		{
			"ID": "20220511185951-307ba4e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220511185951-307ba4e",
				"updated": "20220511185951"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "導入 Data"
				},
				{
					"Type": "NodeText",
					"Data": " 功能僅支持處理以上步驟導出的 Data 壓縮檔。導入按壓縮檔中的文件路徑複製到當前 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空間/data/"
				},
				{
					"Type": "NodeText",
					"Data": " 文件夾："
				}
			]
		},
