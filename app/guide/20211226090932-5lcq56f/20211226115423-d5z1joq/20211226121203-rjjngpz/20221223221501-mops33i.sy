								"updated": "20260730184353"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "在編輯器中點擊文件區塊標上的「閃卡 - 間隔重複」，複習範圍為當前文件及其子文件中的卡片"
								}
							]
						}
					]
				},
				{
					"ID": "20260614194439-4u7hw7h",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260614194439-4u7hw7h",
						"updated": "20260614194439"
					},
					"Children": [
