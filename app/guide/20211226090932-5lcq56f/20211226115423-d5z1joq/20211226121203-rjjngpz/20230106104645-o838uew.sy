							"Properties": {
								"id": "20230109113932-y9uqtyl",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "行動端可以在 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "更多"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "設定"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "應用"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "工作空間"
								},
								{
									"Type": "NodeText",
									"Data": " 中切換不同的工作空間"
								}
							]
						}
					]
				}
			]
		},
