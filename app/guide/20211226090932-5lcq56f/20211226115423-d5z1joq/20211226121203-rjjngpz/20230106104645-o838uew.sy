						{
							"ID": "20230109113932-id1bb5p",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230109113932-id1bb5p",
								"updated": "20230109113932"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "桌面端可以在頂欄左側下拉菜單中打開多個工作空間"
								}
							]
						},
						{
							"ID": "20230109113932-8g1zoun",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20230109113932-8g1zoun",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "如果你的多個工作空間需要經常啟動，可以考慮為每個工作空間建立不同的啟動入口並指定啟動參數 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;工作空間絕對路徑&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​（請使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​ 將路徑包起來）。比如 Windows 系統上可以復制多個快捷方式，並在每個快捷方式 - 屬性 - 目標後跟隨工作空間路徑參數，例如 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;F:\\SiYuan&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​。除此以外，還可以通過 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--port=12345"
								},
								{
									"Type": "NodeText",
									"Data": "​ 來指定Kernel偵聽的埠"
								}
							]
						}
					]
				},
				{
					"ID": "20230109113932-81uif34",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20230109113932-81uif34",
						"updated": "20261016112115"
					},
					"Children": [
