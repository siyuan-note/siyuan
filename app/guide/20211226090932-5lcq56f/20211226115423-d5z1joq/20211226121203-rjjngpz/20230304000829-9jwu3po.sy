							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/AI 編寫"
								},
								{
									"Type": "NodeText",
									"Data": " 喚起編寫對話框。進行 AI 編輯時，劃選文字後使用劃選工具列中的 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "智慧編輯"
								},
								{
									"Type": "NodeText",
									"Data": "，或從區塊標選單中選擇智慧編輯。結果會串流顯示在面板中，可取代、插入、複製、重試、停止或捨棄。僅支援取代單一區塊內的一般劃選；跨區塊劃選、複雜來源或產生期間發生變化的來源仍可使用插入"
								}
							]
						}
					]
				}
			]
		},
