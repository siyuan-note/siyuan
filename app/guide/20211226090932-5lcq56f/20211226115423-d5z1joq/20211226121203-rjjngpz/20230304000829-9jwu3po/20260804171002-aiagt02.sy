		{
			"ID": "20260804170110-v76ve3i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170110-v76ve3i",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "智能體在一輪任務中首次寫入工作空間資料前會自動建立資料快照，每輪最多建立一次。確認修改結果不符合預期時，可以在會話中的快照提示上執行回滾。"
				}
			]
		},
		{
			"ID": "20260804170111-p98zgxp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170111-p98zgxp",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "快照涵蓋工作空間資料，但不涵蓋外部 MCP 服務或外掛對外部系統所做的修改。重新回答、停止任務或刪除會話也不會自動撤銷已完成的寫入操作。"
				}
			]
		},
