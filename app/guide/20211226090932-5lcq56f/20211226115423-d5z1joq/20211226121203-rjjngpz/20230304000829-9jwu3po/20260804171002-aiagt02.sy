			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170029-pspglb3",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在桌面端點選右側停靠列中的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "智能體"
				},
				{
					"Type": "NodeText",
					"Data": "，在行動端透過主選單中的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "智能體"
				},
				{
					"Type": "NodeText",
					"Data": " 開啟面板。可以建立新會話，也可以從會話管理中搜尋並繼續歷史會話。"
				}
			]
		},
		{
			"ID": "20260804170030-0cg87jl",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170030-0cg87jl",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "提供上下文"
				}
			]
		},
		{
			"ID": "20260804170031-0eo8ulo",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170031-0eo8ulo",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "傳送訊息時，智能體會感知目前文件、聚焦區塊、選中的區塊和視窗內可見的區塊，並按需讀取相關內容。需要明確指定材料時，可以使用以下方式加入區塊引用："
				}
			]
		},
