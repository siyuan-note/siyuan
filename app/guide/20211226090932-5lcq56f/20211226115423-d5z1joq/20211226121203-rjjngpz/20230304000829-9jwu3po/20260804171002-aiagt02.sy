			]
		},
		{
			"ID": "20260804170039-1z57i1s",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170039-1z57i1s",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "傳送和停止任務"
				}
			]
		},
		{
			"ID": "20260804170040-98fzzbm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170040-98fzzbm",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輸入需求後預設按 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "回車"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘回車"
				},
				{
					"Type": "NodeText",
					"Data": " 傳送，也可以自訂快捷鍵。"
				},
				{
					"Type": "NodeText",
					"Data": "智能體執行時可以點選停止按鈕中止目前任務。描述目標、範圍和預期輸出位置越明確，執行結果通常越穩定。"
				}
			]
		},
		{
			"ID": "20260804170041-t9reg9k",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170041-t9reg9k",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "確認操作"
				}
			]
		},
		{
			"ID": "20260804170042-mk2k1ns",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170042-mk2k1ns",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "讀取和搜尋通常會直接執行。建立、修改、移動、刪除或匯入資料等操作會顯示確認卡片，並標明可能產生的本機寫入、資料外傳和外部費用。可以確認執行、拒絕，或選擇 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "會話允許"
				},
				{
					"Type": "NodeText",
					"Data": " 在目前會話中不再詢問任何操作。"
				}
			]
		},
		{
			"ID": "20260804170043-geqztqz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170043-geqztqz",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "會話允許"
				},
				{
					"Type": "NodeText",
					"Data": " 前應確認目前任務範圍和所用工具可信，因為後續寫入操作將不再逐項確認。"
				}
			]
		},
		{
			"ID": "20260804170044-b8hd4oh",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170044-b8hd4oh",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "會話管理"
				}
			]
		},
		{
			"ID": "20260804170045-5i7es7a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170045-5i7es7a",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "智能體支援建立、搜尋、切換、重新命名和刪除會話。會話會儲存訊息、引用、工具呼叫和執行結果，可在不同實例間同步檢視。"
				}
			]
		},
		{
			"ID": "20260804170046-ulzggmc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170046-ulzggmc",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以編輯已傳送的訊息並重新傳送，也可以讓智能體重新回答。重新傳送會刪除該訊息之後的對話記錄，但不會撤銷已執行的操作；如需還原資料，請使用對應的資料快照。"
				}
			]
		},
		{
			"ID": "20260804170047-hl0cou2",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170047-hl0cou2",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "模型和思考強度"
				}
			]
		},
		{
			"ID": "20260804170048-fiorekq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170048-fiorekq",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以在輸入框下方切換已啟用的模型，並為支援的模型選擇思考強度。包含推理或工具呼叫的會話在切換模型後，回答品質和工具呼叫連續性可能下降。"
				}
			]
		},
		{
			"ID": "20260804170049-f0m1uju",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170049-f0m1uju",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "上下文用量按鈕會顯示目前會話使用的上下文比例及分類明細。上下文接近模型上限時，智能體會嘗試壓縮較早的對話內容。"
				}
			]
		},
		{
			"ID": "20260804170050-vzu9h83",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170050-vzu9h83",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技能"
				}
			]
		},
		{
			"ID": "20260804170051-ygu80rw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170051-ygu80rw",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "技能是一組可重複使用的任務說明，用於約束流程、格式或領域規則。每個技能使用一個獨立目錄並包含 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": "，儲存在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空間/data/storage/ai/agent/skills/"
				},
				{
					"Type": "NodeText",
					"Data": "。也可以逐一啟用使用者主目錄 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/.agents/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " 下的唯讀技能。"
				}
			]
		},
		{
			"ID": "20260804170052-edczb3s",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170052-edczb3s",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " 可以在 YAML Front Matter 中定義 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "name"
				},
				{
					"Type": "NodeText",
					"Data": " 和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "description"
				},
				{
					"Type": "NodeText",
					"Data": "，正文用於說明智能體應遵循的步驟和要求。輸入 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " 可以搜尋並選擇已安裝的技能。"
				}
			]
		},
		{
			"ID": "20260804170053-5bb3f3k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170053-5bb3f3k",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可以直接要求智能體列出、建立、更新、重新命名或刪除技能。安裝技能時，可提供 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": "、完整的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": " 指令、GitHub 位址、原始 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " 位址或 ZIP 位址。技能會影響智能體的執行方式，請只安裝和使用可信來源的內容。"
				}
			]
		},
		{
			"ID": "20260804170054-vppxnqj",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170054-vppxnqj",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP 服務"
				}
			]
		},
		{
			"ID": "20260804170055-yibcbj8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170055-yibcbj8",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP 服務可以向智能體提供外部工具。在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "人工智能"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "智能體 MCP 服務"
				},
				{
					"Type": "NodeText",
					"Data": " 中可以新增 stdio 或 HTTP 服務，設定指令、參數、環境變數、位址、HTTP 標頭和逾時時間，並檢視連線狀態和工具數量。"
				},
				{
					"Type": "NodeText",
					"Data": "這裡設定的是供智能體呼叫的外部 MCP 服務；如果要讓外部 MCP 用戶端連線思源，請參閱 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804223001-mcpsv02",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "MCP 服務"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20260804170056-84olaaf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170056-84olaaf",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "stdio 服務只會繼承使用者勾選的核心環境變數，並在每次啟動時讀取目前值；還可以在環境變數項目中引用金鑰和變數。引用金鑰會將其明文提供給該程式及其子程序，直接填寫的值會以明文儲存。需要授權的 HTTP 服務會引導完成 OAuth 授權。金鑰和可重複使用的參數可以在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "金鑰和變數"
				},
				{
					"Type": "NodeText",
					"Data": " 中統一管理，具體說明請參閱 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804185001-secvr02",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "金鑰和變數"
				},
				{
					"Type": "NodeText",
					"Data": "。呼叫外部 MCP 工具可能傳送本機資料、修改外部系統或產生費用，應根據確認卡片核對具體影響。"
				}
			]
		},
