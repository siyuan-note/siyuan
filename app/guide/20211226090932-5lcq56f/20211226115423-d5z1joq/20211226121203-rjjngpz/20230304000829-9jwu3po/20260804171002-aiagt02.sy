			"Children": [
				{
					"Type": "NodeText",
					"Data": "概述"
				}
			]
		},
		{
			"ID": "20260804170024-ygqr86s",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170024-ygqr86s",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI 智能體不僅可以回答問題，還可以呼叫思源內建工具、技能、MCP 服務和外掛能力，搜尋、讀取並操作知識庫。它會根據任務分步執行，並在需要修改資料時請求確認。"
				}
			]
		},
		{
			"ID": "20260804170025-arr6px9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170025-arr6px9",
				"updated": "20260804180000"
			},
			"Children": [
