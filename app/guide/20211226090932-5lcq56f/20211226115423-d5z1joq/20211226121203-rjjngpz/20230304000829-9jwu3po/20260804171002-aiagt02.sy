				"updated": "20260804180001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "智能體可以分析文件中的圖片，圖片理解能力取決於目前模型。如需產生圖片，請在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "人工智能"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "圖片生成"
				},
				{
					"Type": "NodeText",
					"Data": " 中設定支援圖片輸出的模型。"
				}
			]
		},
