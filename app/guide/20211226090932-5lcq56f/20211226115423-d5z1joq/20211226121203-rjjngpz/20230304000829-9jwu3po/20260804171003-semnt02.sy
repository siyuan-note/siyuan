			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170128-ing3tl6",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "人工智能"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "嵌入模型"
				},
				{
					"Type": "NodeText",
					"Data": " 中啟用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "語意搜尋"
				},
				{
					"Type": "NodeText",
					"Data": "，並設定 API 基礎位址、API 金鑰、模型、向量維度和逾時時間。設定完成後可使用連線測試確認模型是否可用。"
				}
			]
		},
		{
			"ID": "20260804170129-7fit0vr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170129-7fit0vr",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "向量維度設為 0 時使用模型預設值。僅在目標模型支援自訂向量維度時填寫其他值；修改模型或向量維度後需要重建嵌入索引。"
				}
			]
		},
		{
			"ID": "20260804170130-wwn24t7",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170130-wwn24t7",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "重排模型"
				}
			]
		},
		{
			"ID": "20260804170131-2bkcw7d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170131-2bkcw7d",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "重排模型為選用設定。啟用後，系統會對向量召回的候選內容再次評分，以提高結果排序的準確性。候選數量越大，通常越準確，但延遲和費用也會增加。"
				}
			]
		},
		{
			"ID": "20260804170132-sxaeb6u",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170132-sxaeb6u",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用方式"
				}
			]
		},
		{
			"ID": "20260804170133-d2hod00",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170133-d2hod00",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "開啟全文搜尋，在搜尋選單的 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "搜索方式"
				},
				{
					"Type": "NodeText",
					"Data": " 中選擇 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "語意搜尋"
				},
				{
					"Type": "NodeText",
					"Data": "，然後使用自然語言描述要尋找的內容。筆記本、路徑和區塊類型等篩選條件仍然有效。"
				}
			]
		},
		{
			"ID": "20260804170134-7c8jjnb",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
