								"updated": "20260613171246"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "移除過濾"
								},
								{
									"Type": "NodeText",
									"Data": "：點擊過濾條件右側的刪除按鈕移除單條；通過過濾選單可一鍵清除全部"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171246-t0vxhaq",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
