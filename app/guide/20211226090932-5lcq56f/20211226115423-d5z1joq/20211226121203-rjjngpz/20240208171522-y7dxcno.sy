					"Children": [
						{
							"ID": "20261012014537-q4cjhuu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261012014537-q4cjhuu",
								"updated": "20261012014859"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "彙總：目標為關聯欄位且計算方式為「顯示原始值」或「顯示唯一值」時，支援一般篩選中的「包含任一項」與「不包含任一項」：可搜尋並勾選最終關聯資料庫的項目，依整個彙總項目集合比對，同名項目透過項目 ID 區分；既有關鍵字篩選及其「任一」「所有」「沒有」量詞維持原有行為"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171246-7d13uv1",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613171246-7d13uv1",
						"updated": "20261016191345"
					},
					"Children": [
						{
							"ID": "20260613171246-8hb6p7s",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613171246-8hb6p7s",
								"updated": "20261016191345"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "添加多條"
								},
								{
									"Type": "NodeText",
									"Data": "：可為多個欄位設定條件，預設以「與」（AND）組合，要求全部滿足；可切換為「或」（OR），滿足任一條件即可，也可新增巢狀條件群組"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171246-l23khwe",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613171246-l23khwe",
						"updated": "20260613171246"
					},
					"Children": [
						{
							"ID": "20260613171246-4z4y9q3",
							"Type": "NodeParagraph",
							"Properties": {
