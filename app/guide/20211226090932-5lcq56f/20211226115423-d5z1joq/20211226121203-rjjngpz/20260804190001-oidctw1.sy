				}
			]
		},
		{
			"ID": "20260804130025-tw0000q",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260804130025-tw0000q",
				"updated": "20260804211501"
			},
			"Children": [
				{
					"ID": "20260804130026-tw0000r",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804130026-tw0000r",
						"updated": "20260804211501"
					},
					"Children": [
						{
							"ID": "20260804130027-tw0000s",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804130027-tw0000s",
								"updated": "20260804211501"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "本機瀏覽器和桌面端：回呼位址使用思源目前的本機存取通訊協定；啟用 HTTPS 時為 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "https://127.0.0.1:<連接埠>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "，未啟用 HTTPS 時為 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "http://127.0.0.1:<連接埠>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "。身分提供者中登記的位址必須與實際通訊協定、主機、連接埠、路徑和斜線完全一致"
								}
							]
						}
					]
				},
				{
					"ID": "20260804130028-tw0000t",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804130028-tw0000t",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804130029-tw0000u",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804130029-tw0000u",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "遠端瀏覽器：在 OIDC 回呼位址中填寫公開 HTTPS 位址，路徑必須恰好是 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "，不能包含查詢參數、片段或使用者資訊"
								}
							]
						}
					]
				},
				{
					"ID": "20260804130030-tw0000v",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804130030-tw0000v",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804130031-tw0000w",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804130031-tw0000w",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "原生行動端：固定使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan:/oidc-callback"
								},
								{
									"Type": "NodeText",
									"Data": "；需要在身分提供者中原樣登記。Google 不接受此回呼格式，因此 Google 登入僅支援瀏覽器和桌面端"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804130032-tw0000x",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804130032-tw0000x",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "授權範圍"
				}
			]
		},
		{
			"ID": "20260804130033-tw0000y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804130033-tw0000y",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "預設授權範圍是 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "openid profile email"
				},
				{
					"Type": "NodeText",
					"Data": "。一般不需要修改；自訂範圍前應確認提供者回傳的身分宣告仍能滿足准入規則。GitHub 會將預設範圍轉換為讀取使用者和已驗證電子郵件所需的權限。"
				}
			]
		},
		{
			"ID": "20260804130034-tw0000z",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804130034-tw0000z",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "准入規則"
				}
			]
		},
		{
			"ID": "20260804130035-tw00010",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804130035-tw00010",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "關閉「授予所有已驗證使用者管理員權限」後，必須至少設定一條准入規則。規則使用 JSON 陣列：同一規則的多個 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "values"
				},
				{
					"Type": "NodeText",
					"Data": " 是「或」關係，不同規則之間是「與」關係；"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "operator"
				},
				{
					"Type": "NodeText",
					"Data": " 支援 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "equals"
				},
				{
					"Type": "NodeText",
					"Data": " 和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20260804130036-tw00011",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "anNvbg==",
			"CodeBlockCloseFence": "YGBg",
			"Properties": {
				"id": "20260804130036-tw00011",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "anNvbg=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "[\n  {\n    \"claim\": \"email\",\n    \"operator\": \"equals\",\n    \"values\": [\"alice@example.com\", \"bob@example.com\"]\n  },\n  {\n    \"claim\": \"email_verified\",\n    \"operator\": \"equals\",\n    \"values\": [\"true\"]\n  }\n]\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
