			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "建立應用程式和註冊回呼位址時，可參閱 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Google OpenID Connect 說明文件",
					"TextMarkAHref": "https://developers.google.com/identity/openid-connect/openid-connect"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Microsoft Entra 應用程式註冊說明文件",
					"TextMarkAHref": "https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app"
				},
				{
					"Type": "NodeText",
					"Data": "和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "GitHub OAuth App 說明文件",
					"TextMarkAHref": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
				},
				{
					"Type": "NodeText",
					"Data": "。提供者主控台的具體介面可能變更，請以其目前文件為準。"
				}
			]
		},
		{
			"ID": "20260804130024-tw0000p",
			"Type": "NodeHeading",
