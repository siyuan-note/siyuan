			"Children": [
				{
					"Type": "NodeText",
					"Data": "以上範例只允許兩個指定電子郵件登入，並要求提供者確認電子郵件已經驗證。若提供者使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "groups"
				},
				{
					"Type": "NodeText",
					"Data": " 等陣列宣告，可以使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": " 比對其中的群組名稱。規則名稱和值必須與提供者實際回傳的宣告完全對應。"
				}
			]
		},
