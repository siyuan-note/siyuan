					"Data": "使用前須知"
				}
			]
		},
		{
			"ID": "20260907120000-tw00004",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-tw00004",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-tw00005",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-tw00005",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-tw00006",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-tw00006",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "主密碼無法找回。忘記主密碼後，任何人都無法復原內容"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-tw00007",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-tw00007",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-tw00008",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-tw00008",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "金鑰備份不能取代主密碼。復原資料時通常需要相符的金鑰備份和主密碼，請分別妥善保管"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-tw00009",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-tw00009",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-tw00010",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-tw00010",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "加密筆記本在鎖定狀態下提供最強的保護。解鎖期間，獲得主應用程式授權的插件、API、MCP 工具和 AI 智能體可以讀取其中內容"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-twrev03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-twrev03",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-twrev04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-twrev04",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "加密主要保護磁碟上的持久化內容，並在鎖定後阻止透過受支援入口存取內容；筆記本名稱、目錄結構、檔案數量和大小、修改時間、資料文件副檔名等中繼資料仍可能可見"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-twrev05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-twrev05",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-twrev06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-twrev06",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "鎖定只會盡力清理應用程式可控制的明文快取和暫存檔案，不保證抹除作業系統交換區、休眠檔案、當機傾印或儲存快照中的瞬時副本；主動導出的檔案、剪貼簿、螢幕截圖和列印內容需要自行保護"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-twrev07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-twrev07",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-twrev08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-twrev08",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "主密碼派生通常需要約 1 秒，解鎖時還會重建專用索引，大型筆記本可能需要更久；上傳大型資料文件會占用更多記憶體，瀏覽資料文件時每次請求都需要重新解密"
								}
							]
						}
					]
				}
			]
		},
