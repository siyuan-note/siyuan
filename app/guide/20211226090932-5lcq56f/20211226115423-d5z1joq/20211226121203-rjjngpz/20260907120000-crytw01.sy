					"Children": [
						{
							"ID": "20260907120000-tw00036",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-tw00036",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "修改主密碼前必須關閉所有加密筆記本。修改操作只會重新保護各筆記本的資料金鑰，不會重新加密文檔內容；完成後系統會自動更新工作空間中的金鑰備份，還應立即導出新的金鑰備份"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-twrev09",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
