								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "所有加密筆記本共用一個主密碼，但每個筆記本使用獨立的資料金鑰。解鎖一個筆記本不會解鎖其他筆記本"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-tw00035",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
