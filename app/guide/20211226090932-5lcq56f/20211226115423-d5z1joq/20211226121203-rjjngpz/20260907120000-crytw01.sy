		"title": "加密筆記本",
		"type": "doc",
		"updated": "20260908150000"
	},
	"Children": [
		{
			"ID": "20260907120000-tw00001",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-tw00001",
				"updated": "20260908100000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概述"
				}
			]
		},
		{
			"ID": "20260907120000-tw00002",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-tw00002",
				"updated": "20260907120000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "加密筆記本用於儲存敏感內容。其文檔、資料文件及原始檔名、資料庫定義和專用索引會加密儲存在磁碟上；一般筆記本維持原有儲存方式。鎖定後，必須使用主密碼才能開啟。"
				}
			]
		},
		{
			"ID": "20260908120000-twuse01",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260908120000-twuse01",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用情境"
				}
			]
		},
		{
			"ID": "20260908120000-twuse02",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260908120000-twuse02",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260908120000-twuse03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-twuse03",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-twuse04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-twuse04",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "個人隱私資料：儲存日記、醫療記錄、財務資訊、證件資料等不希望以明文留在磁碟上的內容"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-twuse05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-twuse05",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-twuse06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-twuse06",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "工作機密資料：儲存專案規劃、會議記錄、客戶資料、研究材料和其他需要限制本機存取的內容"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-twuse07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-twuse07",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-twuse08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-twuse08",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "敏感知識庫與 AI 輔助：解鎖後使用 AI 進行摘要、問答、潤飾和整理；使用雲端 AI 服務時，相關內容可能傳送給所設定的服務供應商，請依隱私需求選擇模型和部署方式"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-twrev01",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-twrev01",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-twrev02",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-twrev02",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "裝置與備份防護：在裝置遺失、遭竊或備份媒體外洩時，降低他人直接讀取鎖定筆記本內容的風險"
								}
							]
						}
					]
				},
				{
					"ID": "20260908120000-twuse09",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908120000-twuse09",
						"updated": "20260908120000"
					},
					"Children": [
						{
							"ID": "20260908120000-twuse10",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908120000-twuse10",
								"updated": "20260908120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "多裝置與長期保存：透過資料同步使用加密後的持久化資料，並配合主密碼和金鑰備份在其他裝置上復原存取"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-tw00003",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-tw00003",
