				{
					"Type": "NodeText",
					"Data": "概述"
				}
			]
		},
		{
			"ID": "20211226121454-2wnvrmj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226121454-2wnvrmj",
				"updated": "20260917202413"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "資料同步指的是在多個設備上保持 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "工作空間/data/"
				},
				{
					"Type": "NodeText",
					"Data": "​ 資料夾中的資料在邏輯上保持一致，包括資源檔案、自訂圖示、第三方主題和圖示套件、外掛程式、程式碼片段、範本、掛件和文件資料。按需下載模式允許資源檔案的內容暫不儲存於本機。"
				}
			]
		},
		{
			"ID": "20211226121454-g3niy0i",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20211226121454-g3niy0i",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用方式"
				}
			]
		},
		{
			"ID": "20220703231425-knmdjxb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20220703231425-knmdjxb",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "先 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20220615120134-y8wnvbq",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "初始化資料倉庫金鑰"
				},
				{
					"Type": "NodeText",
					"Data": "，再選擇雲端儲存、設定同步目標並啟用同步。不熟悉設定時，可點擊同步按鈕開啟精靈，依提示完成設定。"
				}
			]
		},
