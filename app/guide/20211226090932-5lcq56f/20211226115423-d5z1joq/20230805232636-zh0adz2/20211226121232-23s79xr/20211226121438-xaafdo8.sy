							"Properties": {
								"id": "20230220103640-gpbn39m",
								"updated": "20261024163013"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "如果資料量較大，建議透過 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "設定"
