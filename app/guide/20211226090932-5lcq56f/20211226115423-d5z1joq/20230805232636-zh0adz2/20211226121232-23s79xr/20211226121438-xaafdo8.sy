								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "資料"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "匯出 Data"
								},
								{
									"Type": "NodeText",
									"Data": " 匯出資料包，傳輸到新裝置後，在該裝置的同一設定頁面使用 "
