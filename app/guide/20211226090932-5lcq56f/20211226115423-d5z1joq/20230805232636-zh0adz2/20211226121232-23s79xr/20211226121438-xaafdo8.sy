			]
		},
		{
			"ID": "20261011151543-1587etm",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261011151543-1587etm",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定第三方同步"
				}
			]
		},
		{
			"ID": "20261011151543-j3donul",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-j3donul",
				"updated": "20261016111431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "帳號與同步"
				},
				{
					"Type": "NodeText",
					"Data": " 中選擇 S3、WebDAV 或本地檔案系統，再點擊同步服務設定一列的設定按鈕。本地檔案系統支援桌面標準核心和 Docker 核心，行動核心不提供此選項；路徑屬於核心所在機器或容器，不是瀏覽器所在裝置的目錄。填寫完整後點擊 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "保存"
				},
				{
					"Type": "NodeText",
					"Data": "。輸入過程不會儲存，關閉已修改的表單時會詢問是否放棄草稿。"
				}
			]
		},
		{
			"ID": "20261020224352-a5ax2ei",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020224352-a5ax2ei",
				"updated": "20261020224352"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "儲存前可點選 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "測試連線"
				},
				{
					"Type": "NodeText",
					"Data": " 檢查目前 S3、WebDAV 或本機檔案系統設定草稿，測試不會儲存設定。WebDAV 會檢查建立目錄和探針讀寫權限，本機檔案系統會檢查目錄讀寫權限，結束後盡力清理探針。測試失敗時可依提示修改後重試，已儲存的設定會保留。"
				}
			]
		},
		{
			"ID": "20261011151543-tvc378w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-tvc378w",
				"updated": "20261011151543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "停止使用某個服務時，可在其設定對話框中點擊 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "清除設定"
				},
				{
					"Type": "NodeText",
					"Data": " 並確認。這會刪除已儲存的位址和憑證；若它是目前的同步服務，也會關閉同步。本地筆記和雲端資料會保留。"
				}
			]
		},
		{
			"ID": "20261011151543-ard7rnq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261011151543-ard7rnq",
				"updated": "20261011151543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "若目前來源的資源或歷史快照尚未補齊，變更來源或清除設定會被阻止。請恢復原同步來源的存取並完成全部下載後重試。儲存或清除失敗時，生效設定和草稿都會保留。"
				}
			]
		},
		{
			"ID": "20261020231029-8zr82uz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020231029-8zr82uz",
				"updated": "20261021104922"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "自動同步通常在背景執行，不會彈出面板或中斷編輯。點選同步圖示可查看目前檔案、已寫入位元組數、速度和預計剩餘時間。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "收起詳細資訊"
				},
				{
					"Type": "NodeText",
					"Data": " 可收起進度詳細資訊，點選 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "同步"
				},
				{
					"Type": "NodeText",
					"Data": " 可重新展開。僅在套用本機變更、復原索引及重新整理相關文件期間暫停編輯；取消後也需等待復原完成才能繼續編輯。點選 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "取消"
				},
				{
					"Type": "NodeText",
					"Data": " 可請求取消準備、網路傳輸或檔案復原。"
				}
			]
		},
		{
			"ID": "20261020231029-6xu32w1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020231029-6xu32w1",
				"updated": "20261020231029"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "取消後會保留已完成的檔案並清理目前暫存檔，可以再次同步以完成剩餘內容。空間不足時，請釋放空間後重試。啟動或還原檔案前會清理可確認歸屬的中斷同步暫存檔，並提示釋放的容量。"
				}
			]
		},
		{
			"ID": "20260905184908-43b5is5",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260905184908-43b5is5",
				"updated": "20260905191024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "資源檔案下載"
				}
			]
		},
		{
			"ID": "20260905184908-r2oumjv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-r2oumjv",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "可在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "帳號與同步"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "資源檔案下載"
				},
				{
					"Type": "NodeText",
					"Data": " 中選擇全部下載或按需下載，設定僅套用於目前裝置。"
				}
			]
		},
		{
			"ID": "20260905184908-ydno2ri",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-ydno2ri",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "全部下載是預設模式。按需下載仍會完整同步文件、資料庫定義和資源檔案清單，在顯示圖片、音訊、影片、PDF 等內容或開啟資源連結時下載所需資源檔案。加密筆記本資源仍需解鎖後存取。"
				}
			]
		},
		{
			"ID": "20260905184908-u69286b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-u69286b",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "已下載的資源檔案會保留於本機，並在後續同步時繼續更新。啟用按需下載不會清理現有檔案，也不會立即釋放已佔用的空間。"
				}
			]
		},
		{
			"ID": "20260905184908-nspliig",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-nspliig",
				"updated": "20260905191024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "尚未下載的資源檔案無法離線使用，無法取得時會回報錯誤。切換為全部下載會先補齊目前資源檔案及所有保留的本機快照所需內容，因此也可能下載歷史版本；下載失敗時保留原模式，可以恢復連線後重試。"
				}
			]
		},
		{
			"ID": "20260905184908-ihj48vx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-ihj48vx",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "按需模式的本機快照可能依賴雲端，不能視為完整離線備份。完整快照下載，以及需要資源檔案內容的匯出和復原操作，會先補齊對應資源檔案，無法取得時明確回報錯誤。"
				}
			]
		},
		{
			"ID": "20260905184908-qskt7h0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260905184908-qskt7h0",
				"updated": "20260905184908"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "更換同步目標、重設資料倉庫或使用舊版本開啟此工作空間前，請先切換為全部下載並完成下載，避免失去取得尚未下載資源檔案的途徑。"
				}
			]
		},
		{
			"ID": "20261012014537-nwm5grr",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261012014537-nwm5grr",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "主題和圖示"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20260917190844-m610sh8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260917190844-m610sh8",
				"updated": "20260918195936"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "主題和圖示套件的檔案、更新和解除安裝會在裝置間同步，各裝置獨立選擇使用的主題和圖示。套件內圖片、字型等資源一律完整下載。同步、刪除及衝突與外掛程式、掛件、範本共用檔案層級規則。還原的快照中沒有某個套件時，該套件會被刪除。"
				}
			]
		},
