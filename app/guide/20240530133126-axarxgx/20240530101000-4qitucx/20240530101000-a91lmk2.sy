			"Properties": {
				"id": "20260613193509-703emtd",
				"updated": "20260803163243"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": "​ - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "検索"
				},
				{
					"Type": "NodeText",
					"Data": "​ - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "繁簡を区別"
				},
				{
					"Type": "NodeText",
					"Data": " ​ で設定できます。デフォルトはオンで、「经济」を検索しても「經濟」には一致しません。オフにすると、「经济」の検索で「经济」と「經濟」の両方に一致します。このオプションを切り替えた後、インデックスの再構築が完了するまで有効になりません。"
				}
			]
		},
		{
			"ID": "20260613193509-byuidqn",
