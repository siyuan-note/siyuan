				"updated": "20260803163243"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": "​ - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "検索"
				},
				{
					"Type": "NodeText",
					"Data": "​ - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "大文字/小文字を区別"
				},
				{
					"Type": "NodeText",
					"Data": " ​ で設定できます。デフォルトはオフで、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Hello"
				},
				{
					"Type": "NodeText",
					"Data": "​ と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "hello"
				},
				{
					"Type": "NodeText",
					"Data": "​ の検索結果は同じになります。オンにすると検索は大文字/小文字を厳密に区別します。このオプションを切り替えた後、インデックスの再構築が完了するまで有効になりません。"
				}
			]
		},
		{
			"ID": "20260613193509-eeostl9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
