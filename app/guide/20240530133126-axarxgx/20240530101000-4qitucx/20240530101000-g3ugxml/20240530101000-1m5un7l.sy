				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "画像のタイトルが指定されていると、タイトルがキャプションとして画像の下に表示されます。"
				}
			]
		},
		{
			"ID": "20240530101000-ev9oag3",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-v13sz9b",
