			]
		},
		{
			"ID": "20240530101000-9ovewni",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-s3hfflb",
				"id": "20240530101000-9ovewni",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意事項"
				},
				{
					"Type": "NodeText",
					"Data": "​: 挿入された画像やファイルの圧縮処理は行われず、すべて元のデータのまま保存されます。"
				}
			]
		},
		{
			"ID": "20260930085927-1t89t26",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930085927-1t89t26",
				"updated": "20260930085927"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "既存のアセットを挿入するときは、画像のタイトル、ツールチップのテキスト、既存の OCR テキストでも検索できます。同じ画像にドキュメントごとに異なるタイトルや説明が付いている場合、いずれかの参照が一致すればアセットを検索できます。このグローバル検索には暗号化ノートブックのアセットは含まれません。"
				}
			]
		},
		{
			"ID": "20260930092043-zd8vt2u",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930092043-zd8vt2u",
				"updated": "20260930092043"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画像のファイル名を表示"
				},
				{
					"Type": "NodeText",
					"Data": " を有効にすると、ローカル画像の上にパスと生成 ID を除いたファイル名が拡張子付きで表示されます。名前をクリックすると名前変更ダイアログが開きます。変更を確定すると、このアセットを参照するすべてのリンクが更新され、キャンセルすると元の名前が保持されます。読み取り専用表示と暗号化ノートブックでは、画像のファイル名から名前を変更できません。"
				}
			]
		},
		{
			"ID": "20260930092955-e9bzngv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930092955-e9bzngv",
				"updated": "20260930092955"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画像のツールチップのテキストを表示"
				},
				{
					"Type": "NodeText",
					"Data": " を有効にすると、画像の説明がタイトルの下に表示されます。この設定が無効でも、画像にマウスを合わせるとタイトルとツールチップテキストの両方が表示されます。説明には既存の代替テキストを使用し、アセットの挿入時に検索できます。"
				}
			]
		},
		{
			"ID": "20260930093600-nnyntle",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930093600-nnyntle",
				"updated": "20260930093600"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "画像にマウスを合わせると、タイトルがなくてもファイル名、形式、読み込み済み画像の元のサイズ、タイトル、ツールチップテキストを確認できます。ローカルワークスペースの画像では、取得できる場合にファイルサイズも表示されます。ネットワーク画像と暗号化ノートブックの画像ではファイルサイズは表示されません。"
				}
			]
		},
		{
			"ID": "20240530101000-m2u22gy",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-ta4h1wk",
				"id": "20240530101000-m2u22gy",
				"updated": "20260803163243"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "参照されていないアセットのクリーンアップ"
				}
			]
		},
		{
			"ID": "20240530101000-hx9syvd",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-hpz8nlf",
				"id": "20240530101000-hx9syvd",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "「参照」とは、ハイパーリンク、挿入された画像、または HTML タグの "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "src"
				},
				{
					"Type": "NodeText",
					"Data": "​ 属性 ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;img&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;iframe&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​ など) を介したアセットファイルへのリンクを指します。ここで考慮すべきケースが 2 つあります:"
				}
			]
		},
		{
			"ID": "20240530101000-koz90j5",
