					},
					"Children": [
						{
							"ID": "20240530101000-0sjc1uk",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20240530101000-0sjc1uk",
								"updated": "20241027164357"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "アセットフォルダ ("
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "assets"
								},
								{
									"Type": "NodeText",
									"Data": "​ フォルダ内のサブフォルダ) への参照は末尾に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/"
								},
								{
									"Type": "NodeText",
									"Data": "​ を付ける必要があります (例: "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "foo: assets/bar/"
								},
								{
									"Type": "NodeText",
									"Data": "​)。参照されているアセットフォルダ内のすべてのアセットファイルは、個別に参照されているかどうかに関わらず参照済みとみなされます"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-vt936mb",
			"Type": "NodeParagraph",
