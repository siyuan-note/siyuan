				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意事項"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20240530101000-qmvr8rd",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"ID": "20240530101000-mbaa8ar",
				"id": "20240530101000-qmvr8rd",
				"updated": "20261001013550"
			},
			"Children": [
				{
					"ID": "20240530101000-vuyib46",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-lw8ri1k",
						"id": "20240530101000-vuyib46",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20240530101000-ciyew7k",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-9ucri2d",
								"id": "20240530101000-ciyew7k",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Tesseract OCR をインストールする際は、インストールした Tesseract-OCR のパスを環境変数 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "PATH"
								},
								{
									"Type": "NodeText",
									"Data": "​ に追加してください。これにより、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "tesseract"
								},
								{
									"Type": "NodeText",
									"Data": "​ コマンドを呼び出して画像から OCR でテキストを抽出できるようになります。正常にインストールされた場合は、カーネルの起動ログで "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "tesseract-ocr enabled"
								},
								{
									"Type": "NodeText",
									"Data": "​ と表示されます。Tesseract を無効にしたい場合は、環境変数に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_ENABLED=false"
								},
								{
									"Type": "NodeText",
									"Data": "​ を設定してください。"
								}
							]
						}
					]
				},
				{
					"ID": "20240530101000-yp8d881",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-xjhk4ih",
						"id": "20240530101000-yp8d881",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20240530101000-juctxsf",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-04xwhm0",
								"id": "20240530101000-juctxsf",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "SiYuan はインストールされたすべての言語パックを有効にするわけではありません。言語パックが多すぎると、OCR が遅くなったり、タイムアウトしたり、システムリソースを過剰に消費する可能性があるためです。そのため、デフォルトでは、最大で "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "eng"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "chi*"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "fra"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "spa"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "deu"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "rus"
								},
								{
									"Type": "NodeText",
									"Data": "​、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "osd"
								},
								{
									"Type": "NodeText",
									"Data": "​ のみが有効になります。より正確な言語サポートが必要な場合は、環境変数 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_LANGS"
								},
								{
									"Type": "NodeText",
									"Data": "​ で言語パックを指定します (例: "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_LANGS=chi_sim+eng"
								},
								{
									"Type": "NodeText",
									"Data": "​)。"
								}
							]
						}
					]
				},
				{
					"ID": "20240530101000-8vlvsns",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-prezj3g",
						"id": "20240530101000-8vlvsns",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20240530101000-ack0scp",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-9as1nfh",
								"id": "20240530101000-ack0scp",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "両方のプロバイダーは PNG、JPEG、TIFF、BMP、GIF、WebP 画像をサポートし、Tesseract は PBM、PGM、PPM、PNM もサポートします"
								}
							]
						}
					]
				},
				{
					"ID": "20240530101000-5mse6p6",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-w91nsfc",
						"id": "20240530101000-5mse6p6",
						"updated": "20261001013550"
					},
					"Children": [
						{
							"ID": "20240530101000-vsrr7lg",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-oiv9z77",
								"id": "20240530101000-vsrr7lg",
								"updated": "20261001013550"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Tesseract は、デフォルトでは 2MB 以下の画像のみが処理されます。変更する場合は環境変数 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_MAX_SIZE"
								},
								{
									"Type": "NodeText",
									"Data": "​ で設定します。値の単位はバイトです (例: "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "SIYUAN_TESSERACT_MAX_SIZE=4000000"
								},
								{
									"Type": "NodeText",
									"Data": "​ は上限を 4MB に変更します)。PaddleOCR は 32 MiB 以下、2400 万画素以下の画像をサポートします"
								}
							]
						}
					]
				}
			]
		},
