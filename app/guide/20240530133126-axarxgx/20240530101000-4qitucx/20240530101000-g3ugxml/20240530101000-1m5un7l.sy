				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "動作"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "リソースの開き方"
				},
				{
					"Type": "NodeText",
					"Data": " で、クリック、Ctrl+クリック / ⌘クリック、Alt+クリック、Shift+クリック時のリソースの開き方を設定できます。"
				}
			]
		},
