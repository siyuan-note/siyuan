				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意事項"
				},
				{
					"Type": "NodeText",
					"Data": "​: 絶対パス (ローカルパスまたはネットワークパス) によって参照されているものはクリーンアップの対象外です。"
				}
			]
