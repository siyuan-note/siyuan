							"Children": [
								{
									"Type": "NodeText",
									"Data": "アセットとして挿入: 画像やファイルをリソースファイルとして挿入します。ショートカットキーは "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Ctrl"
								},
								{
									"Type": "NodeText",
