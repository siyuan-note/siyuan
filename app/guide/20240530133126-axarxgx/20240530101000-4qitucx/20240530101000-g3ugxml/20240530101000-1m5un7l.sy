								"updated": "20250115152709"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "絶対パス ("
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "file://"
								},
								{
									"Type": "NodeText",
									"Data": "​) によるリンク: 画像やファイルをローカルの絶対パスとしてハイパーリンクに挿入します。ショートカットキーは "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Ctrl"
								},
								{
									"Type": "NodeText",
									"Data": "​+"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Shift"
								},
								{
									"Type": "NodeText",
									"Data": "​+"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "V"
								},
								{
									"Type": "NodeText",
									"Data": "​ です。または、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Alt"
								},
								{
									"Type": "NodeText",
									"Data": "​ キーを押しながらドラッグ＆ドロップします。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-7gcm5fs",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-ytxdf4a",
