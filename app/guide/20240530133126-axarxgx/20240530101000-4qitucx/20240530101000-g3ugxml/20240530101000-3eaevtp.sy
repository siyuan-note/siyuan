		{
			"ID": "20261012014537-7x5eyyg",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261012014537-7x5eyyg",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテキストフィルター"
				}
			],
			"HeadingLevel": 4
		},
		{
			"ID": "20260904022100-mif3i0m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260904022100-mif3i0m",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データベースブロックのツールバーから "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "コンテキストフィルター"
				},
				{
					"Type": "NodeText",
					"Data": " を開き、設定済みのリレーションフィールド、またはリレーションフィールドを対象とし、計算方法が「元の値を表示」か「一意の値を表示」のロールアップフィールドを1つ選択します。"
				}
			]
		},
		{
			"ID": "20261024164212-s4byeld",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-s4byeld",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "パネルにはデータベース内の条件を満たすフィールドがすべて表示されますが、一度に有効にできるのは1つだけです。別のフィールドを選択すると切り替わり、チェック済みのフィールドをもう一度選択するとコンテキストフィルターが無効になります。"
				}
			]
		},
		{
			"ID": "20261012014737-39ifatj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261012014737-39ifatj",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "有効にすると、固定条件「いずれかを含む - 現在の文書」がこのデータベースブロックのすべてのビューに適用されます。通常のビューフィルターは各ビューで独立したままで、コンテキストフィルターとは AND で組み合わせられます。"
				}
			]
		},
		{
			"ID": "20261012014737-9rujy6w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261012014737-9rujy6w",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "現在の文書は、最終的な関連先データベースの項目としてあらかじめ紐付けられている必要があります。紐付けられていない場合、一致する項目は表示されず、このデータベースブロックから項目を追加することもできません。直接のリレーションフィールドを選択した場合、新しい項目は現在の文書に自動的に関連付けられます。"
				}
			]
		},
		{
			"ID": "20261024164212-9s6csze",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-9s6csze",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ロールアップを選択した場合、計算値の入力や中間データベースの関連付けの変更は行われず、新しい項目がフィルターによって非表示になることがあります。"
				}
			]
		},
		{
			"ID": "20260613171234-qx49xnf",
			"Type": "NodeHeading",
			"HeadingLevel": 4,
			"Properties": {
