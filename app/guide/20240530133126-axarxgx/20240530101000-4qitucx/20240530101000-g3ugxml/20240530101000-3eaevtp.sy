				{
					"ID": "20260904022100-hzqmv7b",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260904022100-hzqmv7b",
						"updated": "20261012014859"
					},
					"Children": [
						{
							"ID": "20261012014537-eqoxgx7",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261012014537-eqoxgx7",
								"updated": "20261012014859"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ロールアップ：リレーションフィールドを対象とし、計算方法が「元の値を表示」か「一意の値を表示」の場合、通常のフィルターで「いずれかを含む」「いずれも含まない」を使用できます。最終的な関連先データベースの項目を検索して選択し、集計された項目全体と照合します。同名の項目は項目 ID で区別されます。既存のキーワードフィルターと 「いずれか」「すべて」「なし」の量化子の動作は変わりません"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171234-y9o6lwt",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613171234-y9o6lwt",
						"updated": "20261016191345"
					},
					"Children": [
						{
							"ID": "20260613171234-d3igeac",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613171234-d3igeac",
								"updated": "20261016191345"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "複数条件"
								},
								{
									"Type": "NodeText",
									"Data": "：複数のフィールドに条件を設定できます。デフォルトは AND（すべての条件を満たす）ですが、OR（いずれかの条件を満たす）に切り替えたり、条件グループを入れ子にしたりできます"
								}
							]
						}
					]
				},
				{
					"ID": "20260613171234-2ypqooc",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613171234-2ypqooc",
						"updated": "20260613171234"
					},
					"Children": [
						{
							"ID": "20260613171234-kvvf8ia",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613171234-kvvf8ia",
								"updated": "20260613171234"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "フィルターの解除"
								},
								{
									"Type": "NodeText",
									"Data": "：フィルター条件右側の削除ボタンで個別解除、フィルターメニューで全解除"
								}
							]
						}
					]
				},
				{
