							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "フィルター、ソート、グループ化：同じデータベースのほかのビューとデータを共有し、フィルター、ソート、グループ化を個別に設定できます"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260920225154-vntgfc2",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260920225154-vntgfc2",
				"updated": "20261025011205"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カレンダービュー"
				}
			]
		},
		{
			"ID": "20260920225154-m98kczu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920225154-m98kczu",
				"updated": "20260923103343"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "日付のあるエントリを月または週ごとに表示します。週表示には7つの日付列があり、複数日にわたるエントリは各日に連続して表示されます。各エディターの現在の表示モードと閲覧日付は互いに影響しません。月・週の表示モードはカレンダービューごとにこのワークスペースへ保存され、新しいエディターで開いたときや SiYuan の再起動後に復元されます。新しいエディターでは今日から閲覧を始めます。"
				}
			]
		},
		{
			"ID": "20260920225154-wh2lupo",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260920225154-wh2lupo",
				"updated": "20261025011205"
			},
			"Children": [
				{
					"ID": "20260920225154-bqni3yl",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-bqni3yl",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-5h99m0g",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-5h99m0g",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "切り替え：ビュー設定で "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "レイアウト"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "カレンダー"
								},
								{
									"Type": "NodeText",
									"Data": " を選択します。スラッシュメニューからデータベースのカレンダービューを挿入することもできます"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-fbmp8he",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-fbmp8he",
						"updated": "20260920225154"
					},
					"Children": [
						{
							"ID": "20260920225154-5j74pzy",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-5j74pzy",
								"updated": "20260920225154"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "日付フィールド：レイアウト設定で日付、作成日時、更新日時のいずれかのフィールドを1つ選択します。対象のフィールドがない場合は、選択または作成を案内します。既存のエントリに通常の日付を自動入力することはなく、日付のないエントリは日付欄に表示されません。通常の日付フィールドを使用する場合は、日付なしの一覧に表示されます"
								}
							]
						}
					]
				},
				{
					"ID": "20260929122307-wsjglj5",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260929122307-wsjglj5",
						"updated": "20260929123717"
					},
					"Children": [
						{
							"ID": "20260929122307-aw4496z",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260929122307-aw4496z",
								"updated": "20260929123717"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "テンプレートによる日付：日付フィールドに表示テンプレートを設定すると、保存された日付は変更せず、計算結果の日付にエントリを表示します。YYYY-MM-DD、フィールドで選択した数字の日付形式、または現在の言語のローカル日付形式（例：2026年10月2日）でプレーンテキストを出力してください。空白または T の後に HH:mm または HH:mm:ss の時刻を付けることもできます。現在の端末のローカルタイムゾーンで解釈され、スラッシュ区切りの日付はフィールドの形式に従い、月と日の順序は推測しません。空の結果、無効な日付、その他の形式はカレンダーにも日付なしリストにも表示されません。計算された日付のドラッグ、クリア、指定日の新規作成はできません。調整には参照元のフィールドまたはテンプレートを変更してください。異なる言語間で共有するテンプレートには YYYY-MM-DD をおすすめします"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-z254pew",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-z254pew",
						"updated": "20260923095432"
					},
					"Children": [
						{
							"ID": "20260920225154-6vyud50",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-6vyud50",
								"updated": "20260923095432"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "日付の移動：前へ、次へ、今日のボタンや日付選択で移動します。月表示でエントリが多い日は折りたたまれ、追加表示ボタンでその週を展開できます。日付は端末のローカルタイムゾーンで表示されます。月表示は、その月に必要な4、5、6週を表示します。月表示と週表示では各行の先頭に ISO 週番号が表示されます。カレンダーボタンから日付、または ISO 週年と週番号を指定して移動できます。週の開始曜日が月曜日以外の場合は、その行の木曜日で週番号を決定します"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-cng1h41",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-cng1h41",
						"updated": "20260924110133"
					},
					"Children": [
						{
							"ID": "20260920225154-ibvcks0",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260920225154-ibvcks0",
								"updated": "20260924110133"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "編集：エントリをクリックすると既存のデータベースエントリ編集画面が開きます。通常の日付フィールドでは、日付欄のプラスボタンで作成し、エントリのドラッグで日付を移動し、両端のドラッグで範囲を変更できます。ビューのフィルターの横にある日付なしボタンから未設定のエントリを検索し、日付欄へドラッグするか、エントリを選択して日付欄を選ぶと予定を設定できます。後者はタッチ画面でも使用できます。終日の予定として設定され、日付を消すと一覧に戻ります。日付の変更は元に戻せます。タッチ画面ではカレンダー内の既存エントリの移動ハンドルをドラッグします。エントリをクリックするか作成すると、主キーフィールドに自動でフォーカスします。ドラッグ中は変更後の日付範囲をプレビューし、対象の日付欄を強調表示します。変更は放したときに保存されます。右クリックメニューからコピー、文書の作成と関連付け、別のデータベースへの追加、フィールドの編集、選択した日付での新規作成も行えます"
								}
							]
						}
					]
				},
				{
					"ID": "20260920225154-d8n7q67",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260920225154-d8n7q67",
