								"updated": "20260613164213"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "切り替え"
								},
								{
									"Type": "NodeText",
									"Data": "：データベース作成時はデフォルトでテーブルビュー。他のビューから切り替える場合は、ドロップダウンメニューで「テーブルビュー」を選択"
								}
							]
						}
					]
				},
				{
					"ID": "20260613164213-icc6um7",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613164213-icc6um7",
						"updated": "20260613164213"
					},
					"Children": [
						{
							"ID": "20260613164213-5lvv5ka",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613164213-5lvv5ka",
								"updated": "20260613164213"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "列管理"
								},
								{
									"Type": "NodeText",
									"Data": "：各列はフィールドを表します。列幅の調整や列順序の入れ替えはドラッグで行えます。列ヘッダーを右クリックでフィールドの編集、削除、非表示が可能"
								}
							]
						}
					]
				},
				{
					"ID": "20260613164213-81cr4p5",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260613164213-81cr4p5",
						"updated": "20260613164213"
					},
					"Children": [
						{
							"ID": "20260613164213-ycnw7o9",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260613164213-ycnw7o9",
								"updated": "20260613164213"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "行操作"
								},
								{
									"Type": "NodeText",
									"Data": "：行の先頭をクリックで行詳細を展開。ドラッグで行の順序を入れ替え可能。行を右クリックで削除、複製、他データベースへの移動が可能"
								}
							]
						}
					]
				},
				{
					"ID": "20260613164213-q1mup7f",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
