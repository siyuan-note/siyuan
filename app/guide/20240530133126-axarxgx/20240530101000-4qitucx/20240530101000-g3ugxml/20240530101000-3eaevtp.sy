							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260612204659-b5thlw2",
								"updated": "20260612204659"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "​"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{ index . \"entryCreated\" }"
								},
								{
									"Type": "NodeText",
									"Data": "​ で行のバインドされたブロックの作成時間にアクセスします"
								}
							]
						}
					]
				},
				{
					"ID": "20260612204659-2nzr675",
