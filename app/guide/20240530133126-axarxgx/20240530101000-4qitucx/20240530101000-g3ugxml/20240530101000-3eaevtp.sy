		{
			"ID": "20251224101829-j0vtpnz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20251224101829-j0vtpnz",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データベースは、エントリをフィールドごとに整理します。エントリは既存のブロックにバインドすることも、独立して作成することもできます。同じデータをテーブル、リスト、カレンダー、かんばん、カードの各ビューで表示し、レイアウト、フィルタ、並べ替えを個別に設定できます。"
				}
			]
		},
		{
			"ID": "20261012014537-fg8d16i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261012014537-fg8d16i",
				"updated": "20261024161058"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "各フィールドの用途と機能は"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260613155453-sncbsow",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "フィールドタイプ"
				},
				{
					"Type": "NodeText",
					"Data": "、列の下部に表示する統計は"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260617123701-ju7eee5",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "テーブル計算"
				},
				{
					"Type": "NodeText",
					"Data": "を参照してください。"
				}
			]
		},
		{
			"ID": "20251224101829-lva3op2",
