								},
								{
									"Type": "NodeText",
									"Data": "​ で行のバインドされたブロックの更新時間にアクセスします"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-3cev50z",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-30nwm53",
				"id": "20240530101000-3cev50z",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "たとえば、以下の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "請求書"
				},
				{
					"Type": "NodeText",
					"Data": "​ データベースの "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "テンプレート"
				},
				{
					"Type": "NodeText",
					"Data": "​ 属性は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "食事代"
				},
				{
					"Type": "NodeText",
					"Data": "​ と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "衣装代"
				},
				{
					"Type": "NodeText",
					"Data": "​ の合計を算出しています:"
				}
			]
		},
		{
			"ID": "20240530101000-f2texj8",
			"Type": "NodeAttributeView",
			"Properties": {
				"ID": "20240530101000-aw1m47o",
				"id": "20240530101000-f2texj8",
				"updated": "20250101093828"
			},
			"AttributeViewID": "20240530133134-wlxgyny",
			"AttributeViewType": "table"
		},
		{
			"ID": "20260830120300-a1dspja",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260830120300-a1dspja",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表示テンプレート"
				}
			]
		},
		{
			"ID": "20260830120301-b2dspja",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120301-b2dspja",
				"updated": "20260830120301"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "通常のフィールドは、フィールドタイプを変更せずに表示テンプレートを設定できます。列ヘッダーからフィールドメニューを開き、下部のテンプレート入力欄にテンプレートを入力します。表示テンプレートは表示内容だけを変更し、セルの編集では元の保存値を読み書きします。テンプレート、ロールアップ、行番号、作成日時、更新日時フィールドは表示テンプレートに対応していません。"
				}
			]
		},
		{
			"ID": "20260830120302-c3dspja",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120302-c3dspja",
				"updated": "20260830124002"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表示テンプレートはテンプレートスニペットと同じ Go テンプレート構文を使用し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{"
				},
				{
					"Type": "NodeText",
					"Data": " と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": " を区切り文字として HTML を含めることもできます。たとえば、進捗フィールドの保存値が 42 の場合、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;progress value=\".action{.進捗}\" max=\"100\"&gt;&lt;/progress&gt; .action{.進捗}%"
				},
				{
					"Type": "NodeText",
					"Data": " は進捗 42% のプログレスバーとテキスト 42% を表示します。HTML はデフォルトでサニタイズされます。"
				}
			]
		},
		{
			"ID": "20260830120303-d4dspja",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120303-d4dspja",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "同じ行の他のフィールドを名前で参照できます。たとえば、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;strong&gt;.action{.名前}&lt;/strong&gt;: .action{.進捗}%"
				},
				{
					"Type": "NodeText",
					"Data": " は名前と進捗フィールドを組み合わせます。フィールド名に空白や記号が含まれる場合は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index . \"プロジェクト 名\"}"
				},
				{
					"Type": "NodeText",
					"Data": " を使用します。"
				}
			]
		},
		{
			"ID": "20261024164212-wtpzle8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-wtpzle8",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "フィールドの重複名や名前変更による曖昧さを避けるには、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index .id_mod \"フィールドID\"}"
				},
				{
					"Type": "NodeText",
					"Data": " でフィールド ID を指定します。"
				}
			]
		},
		{
			"ID": "20260830120304-e5dspja",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260830120304-e5dspja",
				"updated": "20260902120000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表示テンプレートが読み取るのは各フィールドの元の保存値であり、他の表示テンプレートが生成した表示結果ではありません。フィルター、ソート、グループ化では、元の値またはテンプレートレンダリング値を選択できます。表示テンプレートを空にすると、フィールド本来の表示に戻ります。リレーションフィールドには、関連先データベースの主キーの表示テンプレートの結果が表示されます。結果が空の場合もそのまま表示され、元の主キーの値と関連付けは変更されません。"
				}
			]
		},
		{
			"ID": "20261002224707-2ctdjhm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261002224707-2ctdjhm",
				"updated": "20261026103001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "自動化"
				}
			]
		},
		{
			"ID": "20261024163013-z06cqjz",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-z06cqjz",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ルールの設定"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-ffzbedy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-ffzbedy",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データベースビューで "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "自動化"
				},
				{
					"Type": "NodeText",
					"Data": " からルールを追加します。変更は自動保存され、テキストはフォーカスを外すか Enter を押すと保存されます。新しいルールは既定で無効です。設定が不完全な場合は自動的に無効になり、不足項目が表示されます。設定を完了してから手動で有効にしてください。"
				}
			]
		},
		{
			"ID": "20261024161816-t4fbzh2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-t4fbzh2",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ルールはデータベース全体で共有され、どのビューやミラーでの項目変更でも実行できます"
				},
				{
					"Type": "NodeText",
					"Data": "。参照するフィールドが削除されたり型が変更されたり、対象データベースが削除された場合、次の項目の書き込み時に該当ルールが自動的に無効になり、ルール名と無効な参照が表示されます。ユーザーの編集は保存され、ルール設定も保持されます。"
				}
			]
		},
		{
			"ID": "20261024161816-ts93hlz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-ts93hlz",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定を修復した後、手動で有効にしてください。データベースのロック、認証失敗、データ破損、書き込み失敗の場合は、編集と自動操作が引き続き一緒にロールバックされます。"
				}
			]
		},
		{
			"ID": "20261017202044-wiy1os1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017202044-wiy1os1",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "「実行成功時に通知」は既定で有効で、ルールごとに設定できます。自動追加・更新・収集による実際の変更を、トランザクション全体の確定後に通知します。同じトランザクションの結果は一つにまとめ、通知を有効にしたルールだけを集計します。"
				}
			]
		},
		{
			"ID": "20261024164212-dnb8i1a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-dnb8i1a",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "一つの項目の複数フィールド更新は一項目として数えます。通知を無効にしても実行を止めず、エラーも隠しません。条件不一致、対象なし、値の変更なし、継続した一致、手動収集や整理、元に戻す、やり直し、失敗時は成功通知を送りません。"
				}
			]
		},
		{
			"ID": "20261024163013-bawrkji",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-bawrkji",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "トリガー"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-1kdcd41",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-1kdcd41",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定は「次のイベントが発生したとき」「かつ、トリガー項目が次の条件を満たす場合（任意）」「次のアクションを実行」の三つの区分に分かれています。まず項目の追加またはフィールドの変更を選びます。変更の監視対象は特定のフィールド、または編集可能な任意のフィールドです。同じ値を再度書き込んでも実行されません。二つ目の区分では変更後のトリガー項目の値で判定し、条件を設定しない場合は制限しません。"
				}
			]
		},
		{
			"ID": "20261024163013-t37equ9",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-t37equ9",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "アクションと値の設定"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261002224707-uotpkn8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-uotpkn8",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "各ルールでは複数のアクションを順番に実行できます。操作と対象を選び、設定するフィールドと値の設定方法を追加します。編集の対象にはトリガー項目、関連項目、選択したデータベース内で条件に一致する項目を指定できます。アクション内の条件は変更する項目を絞り込み、トリガー項目の条件とは別に設定します。対象の条件を設定しない場合は、その対象のすべての項目が一致します。追加操作では現在または別のデータベースに未バインド項目を作成します。"
				}
			]
		},
		{
			"ID": "20261002224707-odr4vof",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002224707-odr4vof",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "アクションの値には固定値、互換性のある型のソースフィールド、トリガー時刻、トリガー項目への関連、または計算用テンプレートを指定できます。トリガー時刻は日付フィールドに使用します。トリガー項目への関連には、ソースデータベースを参照する関連フィールドが必要です。主キーのテキストを編集しても既存のバインドとアイコンは維持されます。"
				}
			]
		},
		{
			"ID": "20261024163013-8jxmfku",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-8jxmfku",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "テンプレートによる値の設定"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261016165601-3mbpi7s",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-3mbpi7s",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "値の設定方法で「テンプレート」を選ぶと、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{...}"
				},
				{
					"Type": "NodeText",
					"Data": " をインラインで編集できます。テンプレートを編集するとルールが一時停止するため、編集後に再度有効にしてください。編集可能なすべてのフィールドに対応しますが、作成日時、更新日時、行番号、ロールアップ、テンプレートなどの計算フィールドには代入できません。主キーは既存のバインドを維持します。"
				}
			]
		},
		{
			"ID": "20261016165601-udw7gbs",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-udw7gbs",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "例えば、水やりタスクを完了したときに次のタスクを追加し、日付を "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{((now).AddDate 0 0 7).Format \"2006-01-02\"}"
				},
				{
					"Type": "NodeText",
					"Data": " に設定します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "now"
				},
				{
					"Type": "NodeText",
					"Data": " はトリガー時刻に固定され、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate 0 0 7"
				},
				{
					"Type": "NodeText",
					"Data": " は暦上の七日後を計算します。テンプレートを初めて使用するときにフロントエンドのタイムゾーンを保存し、他の端末でも同じタイムゾーンで実行します。"
				}
			]
		},
		{
			"ID": "20261016165601-8ub6ywb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-8ub6ywb",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "field \"フィールドID\""
				},
				{
					"Type": "NodeText",
					"Data": " はソース項目の保存値を読み取り、日付では "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate"
				},
				{
					"Type": "NodeText",
					"Data": " を使用できます。フィールド名を変更しても ID 参照は維持されます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "value \"フィールドID\""
				},
				{
					"Type": "NodeText",
					"Data": " は構造化データを読み取り、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "toJson"
				},
				{
					"Type": "NodeText",
					"Data": " は JSON を出力します。例えば "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{toJson (dateAdd 0 0 7 (value \"フィールドID\"))}"
				},
				{
					"Type": "NodeText",
					"Data": " は日付範囲の開始と終了を進め、日付のみか時刻付きかの設定も維持します。"
				}
			]
		},
		{
			"ID": "20261016165601-vimxvf5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-vimxvf5",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "テキスト、リンク、メール、電話には文字列を使用し、数値には有限の値、チェックボックスには "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "true"
				},
				{
					"Type": "NodeText",
					"Data": " または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "false"
				},
				{
					"Type": "NodeText",
					"Data": " を使用します。日付には ISO 日付、日時、既存の日付データの JSON を使用できます。単一選択は既存の選択肢名、複数選択は名前または選択肢オブジェクトの JSON 配列、関連は既存項目 ID の配列を使用します。アセットと位置には既存のデータ構造の JSON を使用します。選択肢、関連項目、アセットは自動作成しません。"
				}
			]
		},
		{
			"ID": "20261016165601-4qrtsdm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016165601-4qrtsdm",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "「プレビューに使用するデータ」を開き、実際の項目を選び、日付や参照フィールドを変更してから結果を確認します。入力はプレビュー専用で、項目を変更しません。空の出力はフィールドを消去し、変数の不足、空のソース日付、型や参照のエラーは元の編集と全アクションを取り消します。結果は一度だけ保存し、やり直しでも再利用します。"
				}
			]
		},
		{
			"ID": "20261024161816-74qc87t",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-74qc87t",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SQL、ファイル、ネットワーク、ループ、再帰は使用できません。ソースは最大 8 KiB、各入力と出力は最大 64 KiB です。テンプレート保存後は自動化形式 2 に対応したクライアントが必要で、旧版はデータベースの読み込みを明示的に拒否します。既存の形式 1 のルールは引き続き使用できます。"
				}
			]
		},
		{
			"ID": "20261016174753-54vbc83",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261016174753-54vbc83",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "テンプレートの使用例"
				}
			]
		},
		{
			"ID": "20261016174753-fyb1nlk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016174753-fyb1nlk",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用例全体をテンプレート入力欄にコピーしてください。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "FIELD_ID"
				},
				{
					"Type": "NodeText",
					"Data": " はプレースホルダーです。フィールド名ではなく、トリガー元アイテムのデータベースにあるソースフィールドの ID に置き換えます。コピー元とコピー先のフィールドは同じ型にしてください。リレーションをコピーする場合は、両方のリレーションフィールドが同じデータベースを参照している必要があります。"
				}
			]
		},
