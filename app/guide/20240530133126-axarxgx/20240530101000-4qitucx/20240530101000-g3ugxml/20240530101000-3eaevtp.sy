							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "行の追加"
								},
								{
									"Type": "NodeText",
									"Data": "：テーブル下部の空白行をクリック、またはプラスボタンで新規エントリを追加"
								}
							]
						}
					]
				},
				{
					"ID": "20260613164213-mpxrajz",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
