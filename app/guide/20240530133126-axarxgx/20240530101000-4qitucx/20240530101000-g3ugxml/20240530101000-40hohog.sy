				"id": "20260804190503-oidcrf4",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "プロバイダー、コールバック URL、クレームルール、各クライアントでのログイン、Docker 設定、トラブルシューティングについては、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804190003-oidcja1",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "OIDC ログイン"
				},
				{
