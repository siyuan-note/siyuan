				}
			]
		},
		{
			"ID": "20240530101000-xf6aq6t",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-irzzx5o",
				"id": "20240530101000-xf6aq6t",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "認証"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ログインとトークン"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画面ロックパスワード"
				},
				{
					"Type": "NodeText",
					"Data": " で画面ロックパスワードを設定します。空欄にするとパスワードログインは無効になりますが、通常のローカル以外からのアクセスにはパスワードまたは有効な OIDC 設定が必要です。他の端末にカーネルを公開する前に認証を設定してください。"
				}
			]
		},
		{
			"ID": "20240530101000-4ocdywp",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-83ekc6g",
				"id": "20240530101000-4ocdywp"
			}
		},
		{
			"ID": "20261022093855-2gm31el",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022093855-2gm31el",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "認証"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ログインとトークン"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ロック画面の壁紙"
				},
				{
					"Type": "NodeText",
					"Data": " で JPEG、PNG、WebP の画像を1枚アップロードすると（最大 10 MiB、1600万画素）、起動時やロック後の認証画面の背景を変更できます。「組み込み」から、カテゴリ別の題頭画像ギャラリーで画像を1枚選ぶこともできます。"
				}
			]
		},
		{
			"ID": "20261024161816-rrelcdw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-rrelcdw",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "組み込み画像は横長で、画面全体を埋めるように中央で切り抜かれるため、縦画面では切り抜かれる範囲が広くなります。別の画像を選択またはアップロードすると置き換わります。「リセット」で既定の背景に戻せます。パスワードの設定後、または OIDC ログインを有効にすると、壁紙の設定項目が表示されます。"
				}
			]
		},
		{
			"ID": "20261024161816-iv63z4k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-iv63z4k",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタム壁紙を設定すると、認証ページに壁紙と端末の時刻が先に表示されます。クリック、タップ、キー操作でログインパネルを表示します。パスワードを直接入力すると、最初の文字も入力欄に入ります。壁紙が未設定の場合や画像の読み込みに失敗した場合は、通常のログイン画面を直接表示します。"
				},
				{
					"Type": "NodeText",
					"Data": "ログインパネルの表示中に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと壁紙と時刻の画面に戻り、入力済みのパスワードと画像認証コードは保持されます。表示と復帰には短いアニメーションが付き、システムで視差効果を減らす設定が有効な場合は直接切り替わります。"
				}
			]
		},
		{
			"ID": "20261022093855-jx42i28",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022093855-jx42i28",
				"updated": "20261022093855"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "壁紙は現在のワークスペースに保存され、ノートの同期や設定のエクスポートには含まれません。認証ページにアクセスできる人はログイン前でも画像を見られるため、機密情報を含む画像は選ばないでください。"
				}
			]
		},
		{
			"ID": "20260804120301-oidclog",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
