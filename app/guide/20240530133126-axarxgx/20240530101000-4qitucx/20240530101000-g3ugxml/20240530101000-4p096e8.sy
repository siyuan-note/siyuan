								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "モバイル版では "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "詳細"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "設定"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "アプリ"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "ワークスペース"
								},
								{
									"Type": "NodeText",
									"Data": " でワークスペースを切り替えられます"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261021005120-tctin10",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
