							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261021005120-8xrfoks",
								"updated": "20261021005205"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "思源を再起動し、ワークスペース選択ウィンドウで名前を変更したフォルダを選択する。別のワークスペースが開いている場合は、画面左上のメニューの "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "ワークスペース"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "新規作成 / 開く"
								},
								{
									"Type": "NodeText",
									"Data": " からそのフォルダを選択する"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261021005120-4kuuf26",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261021005120-4kuuf26",
				"updated": "20261021005205"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ウィンドウを閉じたり、別のワークスペースを開いたりするだけでは、元のワークスペースが終了するとは限りません。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": " パラメータでワークスペースを指定している場合は、再起動する前に起動コマンドやショートカットのパスも変更後のフォルダのパスに更新してください。"
				}
			]
		},
