					},
					"Children": [
						{
							"ID": "20240530101000-jr5t0r5",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-329zfla",
								"id": "20240530101000-jr5t0r5",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "デスクトップ版では画面左上にあるドロップダウンメニューから複数のワークスペースを開けます"
								}
							]
						},
						{
							"ID": "20240530101000-bthacdl",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20240530101000-bthacdl",
								"updated": "20261016112115"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "複数のワークスペースを頻繁に起動する必要がある場合は、それぞれのワークスペースに対して異なる起動プログラムを作成し、起動パラメータ "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;ワークスペースの絶対パス&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​ (パスを囲むには"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​を使用してください)を指定することを検討してください。たとえば、Windows で SiYuan のショートカットをいくつか作成して、各ショートカットのプロパティを開き、\"ショートカット\" タブの \"リンク先\" の後に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;F:\\SiYuan&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​ のようにワークスペースのパスを追記します。さらに、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--port=ポート番号"
								},
								{
									"Type": "NodeText",
									"Data": "​ を指定することでカーネルがリッスンするポートを指定できます"
								}
							]
						}
					]
				},
				{
					"ID": "20240530101000-26qtta1",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-x400lts",
						"id": "20240530101000-26qtta1",
						"updated": "20261016112115"
					},
					"Children": [
						{
							"ID": "20240530101000-owkbmon",
