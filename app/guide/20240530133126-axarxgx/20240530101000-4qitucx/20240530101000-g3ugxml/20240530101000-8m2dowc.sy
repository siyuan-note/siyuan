				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ドキュメントに独立したツールを埋め込む場合は"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-5gi76ax",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "ウィジェット"
				},
				{
					"Type": "NodeText",
					"Data": "を使います。SiYuan の画面や操作と連携する機能には、対応するプラグインを選んでください。"
				}
			]
		},
		{
