		{
			"ID": "20260614201227-7ux3rmo",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260614201227-7ux3rmo",
				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " 形式では、ドキュメントのコンテンツ、アセット、ブロック属性が保持されます。サブドキュメントと関連ドキュメントを含めるかどうかは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エクスポート"
				},
				{
					"Type": "NodeText",
					"Data": " の各オプションによって決まります。"
				}
			]
		},
		{
			"ID": "20261015174914-g5qqzk2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015174914-g5qqzk2",
				"updated": "20261015174914"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "「画像としてエクスポート」ダイアログで「題頭画像をエクスポート」をオフにすると、本文の画像を保持したまま題頭画像を除外できます。このスイッチは初期状態でオンになっており、「ドキュメントのタイトルを追加」とは独立しています。選択は保存され、プレビュー、エクスポートファイル、ダイアログ内の「PNG としてコピー」に適用されます。元のドキュメントは変更されません。"
				}
			]
		},
		{
			"ID": "20261016200946-7tpddii",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016200946-7tpddii",
				"updated": "20261016200946"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "PDF のエクスポートにも独立した「題頭画像をエクスポート」スイッチがあります。初期状態ではオンで、画像のエクスポートとは別に選択が保存されます。ドキュメントのタイトルや本文の画像には影響しません。デスクトップでは PDF のプレビューウィンドウで設定し、エクスポート時に保存されます。モバイルでは印刷設定ダイアログで設定し、確認時に保存されます。"
				}
			]
		},
