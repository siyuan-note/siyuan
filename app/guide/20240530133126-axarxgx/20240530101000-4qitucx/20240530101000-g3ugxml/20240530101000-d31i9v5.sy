		},
		{
			"ID": "20240530101000-gtpeavm",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-ol3e31k",
				"id": "20240530101000-gtpeavm",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown のファイルやフォルダをインポートできます。他のアプリから移行する場合は、Markdown でエクスポートするか、対応する専用インポーターを使ってください。事前にアセットのパスと拡張構文を確認してください。"
				}
			]
		},
		{
			"ID": "20261002211013-0k8wpj6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002211013-0k8wpj6",
				"updated": "20261002211013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown をインポートすると、[^note]: 形式の脚注定義は独立した番号付きリスト項目に、本文中の [^note] は上付きのブロック参照に変換されます。参照をクリックすると定義を開くことができ、定義のバックリンクから参照元のブロックに戻れます。脚注内の複数の段落は同じリスト項目内に保持されます。定義のない脚注はブロック参照に変換されません。コード例とエスケープされた脚注構文は、そのままのテキストとして保持されます。"
				}
			]
		},
		{
			"ID": "20240530101000-u9v0mpo",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-wuqy5yq",
				"id": "20240530101000-u9v0mpo",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "インポート時に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "![foo](images/bar.png)"
				},
				{
					"Type": "NodeText",
					"Data": "​ のような画像構文 (ローカルの相対パス) が検出されると、SiYuan は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ を"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-1m5un7l",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "アセット"
				},
				{
					"Type": "NodeText",
					"Data": "に変換します。ただし、パスが "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ の場合は変換されません。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "."
				},
				{
					"Type": "NodeText",
					"Data": "​ で始まるパスは隠しファイルと判断され、SiYuan では処理されないためです。"
				}
			]
		},
		{
			"ID": "20240530101000-prvfsde",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-l9j58c3",
				"id": "20240530101000-prvfsde",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "上付き文字 ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "^foo^"
				},
				{
					"Type": "NodeText",
					"Data": "​)、下付き文字 ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~foo~"
				},
				{
					"Type": "NodeText",
					"Data": "​)、タグ ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#foo#"
				},
				{
					"Type": "NodeText",
					"Data": "​)、数式 ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$foo$"
				},
				{
					"Type": "NodeText",
					"Data": "​) の拡張構文を認識する場合は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " の関連する Markdown 構文の項目を有効にしてください。"
				}
			]
		},
		{
			"ID": "20240530101000-ya71y3y",
