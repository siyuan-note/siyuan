			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップとモバイルのどちらでも、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "アプリ"
				},
				{
					"Type": "NodeText",
					"Data": " からデータをインポートおよびエクスポートできます。このエクスポートでは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "ワークスペース/data/"
				},
				{
					"Type": "NodeText",
					"Data": " フォルダー全体がコピーされ、ZIP アーカイブとして作成されます。"
				}
			]
		},
		{
			"ID": "20240530101000-57k5fbq",
