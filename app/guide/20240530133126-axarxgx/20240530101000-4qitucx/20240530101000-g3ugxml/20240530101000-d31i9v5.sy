		},
		{
			"ID": "20240530101000-3x80zxy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240530101000-3x80zxy",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意事項"
				},
				{
					"Type": "NodeText",
					"Data": "​: 既存のデータが上書きされて復元できなくなる可能性があるため、インポートの実行は十分注意して行ってください。"
				}
			]
		},
		{
			"ID": "20261020220502-x9fsafc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020220502-x9fsafc",
				"updated": "20261020225315"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Data.zip は別のワークスペースを作成せずに、現在のワークスペースを更新できます。インポート前にアーカイブを解析し、暗号化ノートブックが競合する場合は、初期選択の「競合をスキップ」、「競合を上書き」、またはキャンセルを選べます。画面の再読み込み前に、スキップしたノートブックの ID が結果に表示されます。実行前はキャンセルできます。処理中はキャンセルやダイアログの終了はできません。"
				}
			]
		},
		{
			"ID": "20261020220502-196kynq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020220502-196kynq",
				"updated": "20261020220502"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "暗号化された内容のインポートには、互換性のあるマスターパスワードが必要です。パスワード変更前のバックアップは、互換性のある履歴キーを使用して読み取ることができ、現在のパスワードは元に戻りません。暗号化状態やデータキーが異なるノートブックは直接結合できません。上書きは同じパスのファイルを置き換え、取り込み先だけにあるファイルを保持し、削除を伝播しません。取り込まれた暗号化ノートブックはロックされたままなので、再度ロックを解除してください。"
				}
			]
		},
		{
			"ID": "20261020220502-c9dn1ha",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020220502-c9dn1ha",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "選択した内容を検証してからデータを書き込み、失敗や中断が発生した場合はロールバックできます。元のアーカイブ、上書き前のファイル、キー情報はワークスペースの conf/data-imports/ ディレクトリに保持されます。"
				}
			]
		},
		{
			"ID": "20261024164212-9etzjlm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-9etzjlm",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "取り込まれた内容と必要な履歴を確認するまでは、これらの復旧ファイルを保持してください。復旧に失敗した場合は、復旧が成功するまで書き込みと同期を停止します。未実行の事前解析は 30 分で期限切れになり、起動時または次のインポート時に削除されます。期限切れ後もキャンセルでき、実行済みの復旧ファイルは保持されます。"
				}
			]
		},
		{
			"ID": "20260614201218-j16bj6l",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260614201218-j16bj6l",
				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": ".sy.zip"
				}
			]
		},
		{
			"ID": "20260614201218-7jwr68y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260614201218-7jwr68y",
				"updated": "20260809232000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " は SiYuan のネイティブドキュメント形式です。ドキュメントツリーで対象のノートブックまたはドキュメントを選択し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "インポート"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "SiYuan .sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " からアーカイブを選択します。インポート後のドキュメントには、コンテンツ、設定で含めるよう指定したサブドキュメント、アセット、ブロック属性が保持されます。"
				}
			]
		},
		{
