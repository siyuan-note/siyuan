		},
		{
			"ID": "20260804170012-a3xh59b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170012-a3xh59b",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェントは、現在のエディターコンテキストとツールを組み合わせ、ナレッジベースの検索、整理、作成、変更を行います。エージェントの返信の下にあるコピーボタンを押すと、本文の前に「AI 生成」という行が追加されます。使用方法については "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "AI エージェント",
					"TextMarkBlockRefID": "20260804171006-aiagt04",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260804170013-8jjszzo",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170013-8jjszzo",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "意味検索"
				}
			]
		},
		{
			"ID": "20260804170014-lqjf1yr",
			"Type": "NodeParagraph",
			"Properties": {
