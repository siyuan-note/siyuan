				},
				{
					"ID": "20260804170009-bubnkd1",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 3,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20260804170009-bubnkd1",
						"updated": "20261016202856"
					},
					"Children": [
						{
							"ID": "20260804170010-5uzk823",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804170010-5uzk823",
								"updated": "20261016202856"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/AIライティング"
								},
								{
									"Type": "NodeText",
									"Data": " でライティングダイアログを開きます。AI 編集では、テキストを選択して選択ツールバーの "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "AI Edit"
								},
								{
									"Type": "NodeText",
									"Data": " を使うか、ブロックメニューから AI Edit を選びます。結果はパネルにストリーミング表示され、置換、挿入、コピー、再試行、停止、破棄ができます。置換できるのは、単一ブロック内の対応した選択範囲だけです。ブロックをまたぐ選択範囲、複雑な元データ、生成中に変更された元データには、引き続き挿入を使用できます"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804170011-l78fgec",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170011-l78fgec",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェント"
				}
			]
		},
		{
			"ID": "20260804170012-a3xh59b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170012-a3xh59b",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェントは、現在のエディターコンテキストとツールを組み合わせ、ナレッジベースの検索、整理、作成、変更を行います。使用方法については "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "AI エージェント",
					"TextMarkBlockRefID": "20260804171006-aiagt04",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260804170013-8jjszzo",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170013-8jjszzo",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "意味検索"
				}
			]
		},
		{
			"ID": "20260804170014-lqjf1yr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170014-lqjf1yr",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "意味検索はテキストの意味に基づいて関連コンテンツを検索し、表現が異なっていても同じ話題を扱うノートを見つけられます。設定と使用方法については "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "意味検索",
					"TextMarkBlockRefID": "20260804171007-semnt04",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260920123707-ejudvzu",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260920123707-ejudvzu",
				"updated": "20261023110951"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "判定モデル"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20260920123707-x2ixv5y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920123707-x2ixv5y",
				"updated": "20261023110951"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントは TypeSafe System One（Jev）または OpenAI Decisions API を使って分類、絞り込み、評価を行えます。設定と使い方は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "判定モデル",
					"TextMarkBlockRefID": "20260920123707-im3t4o6",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260804233230-mcpjah1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804233230-mcpjah1",
				"updated": "20260804233000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービス"
				}
			]
		},
		{
			"ID": "20260804233231-mcpjap1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804233231-mcpjap1",
				"updated": "20260804233000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービスを使用すると、MCP 対応クライアントから標準プロトコル経由で SiYuan が提供するツールを呼び出せます。設定方法と使用方法については、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "MCP サービス",
					"TextMarkBlockRefID": "20260804223003-mcpsv04",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20261029051700-dcvcxii",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261029051700-dcvcxii",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "長期記憶"
				}
			]
		},
		{
			"ID": "20261029051700-411n6e4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-411n6e4",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "長期記憶"
				},
				{
					"Type": "NodeText",
					"Data": " でワークスペースの共有記憶を設定します。処理用モデルと対応する推論強度を個別に選択します。会話モデルの切り替えではこの選択は変わりません。許可された内容が選択した提供者に送信され、料金が発生する場合があります。"
				}
			]
		},
		{
			"ID": "20261029051700-r7h2tty",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-r7h2tty",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "記憶の利用と自動整理は別々の設定です。自動整理は初期状態では無効です。許可するノートブックを選んでから有効にしてください。有効化で過去の全ノートが走査されることはなく、暗号化されたノートブックはロック解除済みでも対象外です。"
				},
				{
					"Type": "NodeText",
					"Data": " 自動整理を有効にしたうえでユーザーメッセージを個別に許可すると、今後正常に確定したユーザーメッセージだけが収集されます。AI の返信や過去の会話履歴は対象外です。"
				}
			]
		},
		{
			"ID": "20261029051700-y2qvicf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-y2qvicf",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "管理画面で記録の検索、本文、根拠、適用範囲の確認ができます。明示的に確認した新規記録は active 状態にします。モデルの提案は candidate のまま保存される場合があります。主体、範囲、条件、根拠を確認してから active を選択して保存してください。訂正は管理画面から正式な記録に反映し、派生した概要を直接編集しないでください。"
				}
			]
		},
		{
			"ID": "20261029051700-agak2u2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-agak2u2",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "無効化では記録を残したまま利用を停止します。忘れる操作では撤回情報を保存してから本文を削除します。過去のバックアップには原文が残る場合があります。他の端末は撤回情報を同期した後に保護されるため、忘れる操作はすべての過去のバックアップの消去を意味しません。"
				}
			]
		},
		{
			"ID": "20261029051700-lkk4iyn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-lkk4iyn",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "USER.md と MEMORY.md は読み取り専用の派生概要で、別の編集可能な正式記録ではありません。概要の生成失敗で保存済みの記録は取り消されません。競合や検索未完了は明示され、保存成功や関連記憶がない証拠として扱われません。"
				}
			]
		},
		{
			"ID": "20261029051700-6iyzw5m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261029051700-6iyzw5m",
				"updated": "20261029051700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "モデルで整理すると、入力した文章が処理され、各結果が表示されます。タスクの状態は更新やキャンセルができます。キャンセル前に保存された変更は取り消されません。モデルが未設定または利用不能でも、手動の閲覧、訂正、無効化、忘れる操作は可能です。"
				}
			]
		},
		{
			"ID": "20260804170015-wj99wzy",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170015-wj99wzy",
				"updated": "20260804180000"
