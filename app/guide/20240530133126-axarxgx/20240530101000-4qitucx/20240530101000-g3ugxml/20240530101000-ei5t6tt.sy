	"Children": [
		{
			"ID": "20260804170000-bsl73zy",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170000-bsl73zy",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概要"
				}
			]
		},
		{
			"ID": "20260804170001-0a6ujuy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170001-0a6ujuy",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan では、AI 編集、AI エージェント、意味検索を利用できます。使用する前に、用途に応じた API プロバイダーとモデルを設定してください。"
				}
			]
		},
		{
			"ID": "20261015225720-y3mi68c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261015225720-y3mi68c",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ChatGPT アカウントを使用するには、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " で ChatGPT プロバイダーの設定を開き、この端末のワークスペースで使用するアカウントを選択して保存してください。ログイン認証情報とアカウントの関連付けは端末内に保存され、conf.json や設定のエクスポートファイルには含まれません。"
				}
			]
		},
		{
			"ID": "20261024161816-osxf10i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-osxf10i",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "各端末で個別にログインし、一度アカウントを選択してください。その後に設定をコピーしても、既存のプロバイダーはコピー先の端末の関連付けを使用します。プロバイダーの追加やワークスペースディレクトリの移動後は、再度アカウントを選択してください。アップグレード後も再選択が必要ですが、既存のログイン認証情報は保持されます。"
				}
			]
		},
		{
			"ID": "20260804170002-b4z0hyu",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170002-b4z0hyu",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI 編集"
				}
			]
		},
		{
			"ID": "20260804170003-20kw3md",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170003-20kw3md",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI 編集は、文章の続きを書く、要約する、翻訳する、推敲するなど、指定したテキストを処理します。"
				}
			]
		},
