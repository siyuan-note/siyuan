					},
					"Properties": {
						"id": "20260804170035-plyrm10",
						"updated": "20260804180000"
					},
					"Children": [
						{
							"ID": "20260804170036-6nh0i14",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804170036-6nh0i14",
								"updated": "20260804180000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "入力欄に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "[["
								},
								{
									"Type": "NodeText",
									"Data": " と入力してブロックを検索します"
								}
							]
						}
					]
				},
				{
					"ID": "20260804170037-cxc5kmu",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 3,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20260804170037-cxc5kmu",
						"updated": "20260804180000"
					},
					"Children": [
						{
							"ID": "20260804170038-j9x6ajz",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804170038-j9x6ajz",
								"updated": "20260804180000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ブロックを選択し、ブロックメニューから "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "エージェント会話に追加"
								},
								{
									"Type": "NodeText",
