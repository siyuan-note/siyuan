							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ブロックをエージェントの入力欄にドラッグします"
								}
							]
						}
					]
				},
				{
					"ID": "20260804170035-plyrm10",
					"Type": "NodeListItem",
					"ListData": {
