	"Children": [
		{
			"ID": "20260804170023-1x6ifkw",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170023-1x6ifkw",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概要"
				}
			]
		},
		{
			"ID": "20260804170024-9lvjy1x",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170024-9lvjy1x",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェントは質問に答えるだけでなく、SiYuan の組み込みツール、スキル、MCP サービス、プラグイン機能を利用してナレッジベースを検索、読み取り、操作できます。タスクを段階的に実行し、データを変更する前に確認を求めます。"
				}
			]
		},
		{
			"ID": "20260804170025-r2m4o0b",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170025-r2m4o0b",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定方法"
				}
			]
		},
		{
			"ID": "20260804170026-vh2f8ng",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170026-vh2f8ng",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "API プロバイダー"
				},
				{
					"Type": "NodeText",
					"Data": " で API プロバイダーとモデルを設定して有効にし、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント"
				},
				{
					"Type": "NodeText",
					"Data": " でエージェントが使用するモデルを選択します。ツール呼び出しを安定して実行でき、十分なコンテキストウィンドウを持つモデルを推奨します。"
				}
			]
		},
		{
			"ID": "20260804180003-imgja01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804180003-imgja01",
				"updated": "20260804180003"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントはドキュメント内の画像を分析できます。画像理解の能力は現在のモデルによって異なります。画像を生成するには、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画像生成"
				},
				{
					"Type": "NodeText",
					"Data": " で画像出力に対応するモデルを設定します。"
				}
			]
		},
		{
			"ID": "20260926163337-49n3p0a",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260926163337-49n3p0a",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタム指示"
				}
			]
		},
		{
			"ID": "20260926163337-nrlrrlv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926163337-nrlrrlv",
				"updated": "20260926163337"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "カスタム指示"
				},
				{
					"Type": "NodeText",
					"Data": " で、文体、引用方法、ノートの整理ルールなどの長期的な設定を編集します。デスクトップ版とモバイル版は同じワークスペースの指示を使用します。"
				}
			]
		},
		{
			"ID": "20260926163337-f5ixseu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926163337-f5ixseu",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "指示はワークスペース内の data/storage/ai/AGENTS.md に最大 32 KiB の UTF-8 テキストとして保存されます。データ同期が有効で、同期の除外ルールに該当しなければ、ワークスペースとともに同期されます。テキストエディターで直接編集することもできます。"
				}
			]
		},
		{
			"ID": "20261024161816-v4wiksm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-v4wiksm",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ファイルが存在しない場合や空の場合、カスタム指示は追加されません。旧パスの data/ai/AGENTS.md も引き続き読み込めます。設定で保存すると新しい場所に移行します。旧パスに対する同期の除外ルールがある場合は、保存前に更新してください。両方のファイルの内容が異なる場合は、新しいファイルに内容を統合し、古いファイルを削除してから続行してください。"
				}
			]
		},
		{
			"ID": "20260926163337-ycm8nwf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926163337-ycm8nwf",
				"updated": "20260926163337"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "保存した変更は次の会話ターンから適用されます。実行中のツール呼び出しとコンテキスト圧縮には、そのターンの開始時に読み込んだ指示が引き続き使用されます。指示はモデルのコンテキストを消費します。現在のメッセージは一般的な設定より優先されますが、指示でツール権限、承認、アクセス制御を回避することはできません。ノートブックやドキュメント単位の継承には対応しておらず、同名のノートや添付ファイルも自動では読み込みません。"
				}
			]
		},
		{
			"ID": "20260926163337-e2pfywv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926163337-e2pfywv",
				"updated": "20260926163337"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "読み込み失敗、文字コードの問題、サイズ超過があると、エラーを表示してそのターンを停止します。元のファイルは上書きも切り詰めもされません。保存前に別のウィンドウや同期によってファイルが変更された場合は、未保存の編集内容をコピーし、エディターを開き直して変更を統合してから保存してください。"
				}
			]
		},
		{
			"ID": "20260804170027-2jaadkf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170027-2jaadkf",
				"updated": "20261027140312"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使い方"
				}
			]
		},
		{
			"ID": "20260804170028-3m7byvz",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170028-3m7byvz",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントを開く"
				}
			]
		},
		{
			"ID": "20260804170029-w19ke9r",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170029-w19ke9r",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップでは右側のドックにある "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント"
				},
				{
					"Type": "NodeText",
					"Data": " を選択します。モバイルではメインメニューから "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント"
				},
				{
					"Type": "NodeText",
					"Data": " を開きます。新しいセッションを開始するか、セッション管理から過去のセッションを検索して続行できます。"
				}
			]
		},
		{
			"ID": "20260804170030-0i7g7hj",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170030-0i7g7hj",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテキストを提供する"
				}
			]
		},
		{
			"ID": "20260804170031-zf4yu7x",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170031-zf4yu7x",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "メッセージを送信すると、エージェントは現在のドキュメント、フォーカス中のブロック、選択したブロック、表示中のブロックを認識し、必要に応じて関連コンテンツを読み取ります。参照元のブロックを明示するには、次の方法を使用します。"
				}
			]
		},
		{
			"ID": "20260804170032-ynp1yag",
			"Type": "NodeList",
			"ListData": {
				"Typ": 1
			},
			"Properties": {
