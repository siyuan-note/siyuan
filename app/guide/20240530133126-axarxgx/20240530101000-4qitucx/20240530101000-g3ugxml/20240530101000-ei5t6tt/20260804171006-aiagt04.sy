						"updated": "20260804180000"
					},
					"Children": [
						{
							"ID": "20260804170036-6nh0i14",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804170036-6nh0i14",
								"updated": "20260804180000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "入力欄に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "[["
								},
								{
									"Type": "NodeText",
									"Data": " と入力してブロックを検索します"
								}
							]
						}
					]
				},
				{
					"ID": "20260804170037-cxc5kmu",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 3,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20260804170037-cxc5kmu",
						"updated": "20260804180000"
					},
					"Children": [
						{
							"ID": "20260804170038-j9x6ajz",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804170038-j9x6ajz",
								"updated": "20260804180000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ブロックを選択し、ブロックメニューから "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "エージェント会話に追加"
								},
								{
									"Type": "NodeText",
									"Data": " を選択します"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804170039-9kcdqv4",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170039-9kcdqv4",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タスクを送信、停止する"
				}
			]
		},
		{
			"ID": "20260804170040-m2zcmhf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170040-m2zcmhf",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デフォルトでは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘Enter"
				},
				{
					"Type": "NodeText",
					"Data": " で送信します。ショートカットはカスタマイズできます。"
				},
				{
					"Type": "NodeText",
					"Data": "エージェントの実行中は停止ボタンで現在のタスクを中断できます。目的、範囲、出力先を明確に指定すると、通常はより安定した結果が得られます。"
				}
			]
		},
		{
			"ID": "20260804170041-sri5ln6",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170041-sri5ln6",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "操作を確認する"
				}
			]
		},
		{
			"ID": "20260804170042-fuwjiju",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170042-fuwjiju",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "読み取りと検索は通常そのまま実行されます。データの作成、変更、移動、削除、インポートを行う操作では確認カードが表示され、ローカルへの書き込み、データ送信、外部料金などの影響が示されます。実行、拒否、または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "セッション許可"
				},
				{
					"Type": "NodeText",
					"Data": " を選択できます。"
				}
			]
		},
		{
			"ID": "20260804170043-c3mrdfs",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170043-c3mrdfs",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "セッション許可"
				},
				{
					"Type": "NodeText",
					"Data": " を使用すると、現在のセッションでは以降の書き込み操作が個別に確認されません。使用する前に、タスクの範囲とツールが信頼できることを確認してください。"
				}
			]
		},
		{
			"ID": "20260804170044-0dekacs",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170044-0dekacs",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セッション管理"
				}
			]
		},
		{
			"ID": "20260804170045-86n1950",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170045-86n1950",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セッションの作成、検索、切り替え、名前変更、削除ができます。メッセージ、参照、ツール呼び出し、実行結果はセッションに保存され、同期された別のインスタンスからも確認できます。"
				}
			]
		},
		{
			"ID": "20260804170046-2kcx5sj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170046-2kcx5sj",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "送信済みのメッセージを編集して再送信したり、回答を再生成したりできます。再送信すると後続の会話は削除されますが、実行済みの操作は元に戻りません。復元が必要な場合は、対応するデータスナップショットを使用してください。"
				}
			]
		},
		{
			"ID": "20260804170047-d4bjmew",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170047-d4bjmew",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "モデルと思考強度"
				}
			]
		},
		{
			"ID": "20260804170048-km5oy76",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170048-km5oy76",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "入力欄の下で有効なモデルを切り替え、対応するモデルでは思考強度を選択できます。推論やツール呼び出しを含むセッションでモデルを切り替えると、回答品質やツール呼び出しの連続性が低下する場合があります。"
				}
			]
		},
		{
			"ID": "20260804170049-vtr56ro",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170049-vtr56ro",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテキスト使用量では、現在使用しているコンテキストの割合と分類別の内訳を確認できます。モデルの上限に近づくと、エージェントは以前の会話内容を圧縮しようとします。"
				}
			]
		},
		{
			"ID": "20260804170050-7cf4sou",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170050-7cf4sou",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スキル"
				}
			]
		},
		{
			"ID": "20260804170051-4l1ozje",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170051-4l1ozje",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スキルは、ワークフロー、形式、分野固有のルールを定義する再利用可能なタスク手順です。各スキルは独立したディレクトリを使用し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " を "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "workspace/data/storage/ai/agent/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " の下に配置します。ユーザーディレクトリ "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/.agents/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " の読み取り専用スキルを個別に有効にすることもできます。"
				}
			]
		},
		{
			"ID": "20260804170052-ecqhexr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170052-ecqhexr",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " では YAML Front Matter に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "name"
				},
				{
					"Type": "NodeText",
					"Data": " と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "description"
				},
				{
					"Type": "NodeText",
					"Data": " を定義し、その後にエージェントが従う手順を記述できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " と入力すると、インストール済みのスキルを検索して選択できます。"
				}
			]
		},
		{
			"ID": "20260804170053-2kk8p7q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170053-2kk8p7q",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントに、スキルの一覧表示、作成、更新、名前変更、削除を依頼できます。インストール元には "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": "、完全な "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": " コマンド、GitHub URL、未加工の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " URL、ZIP URL を指定できます。スキルはエージェントの動作に影響するため、信頼できる提供元だけを使用してください。"
				}
			]
		},
		{
			"ID": "20260804170054-qfoixg9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170054-qfoixg9",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービス"
				}
			]
		},
		{
			"ID": "20260804170055-a7wg3um",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170055-a7wg3um",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービスはエージェントに外部ツールを提供します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント MCP サービス"
				},
				{
					"Type": "NodeText",
					"Data": " で stdio または HTTP サービスを追加し、コマンド、引数、環境変数、URL、HTTP ヘッダー、タイムアウトを設定して、接続状態とツール数を確認できます。"
				},
				{
					"Type": "NodeText",
					"Data": "ここで設定するのは、エージェントが呼び出す外部 MCP サービスです。外部 MCP クライアントを SiYuan に接続する方法については、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804223003-mcpsv04",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "MCP サービス"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260804170056-7d7fak1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170056-7d7fak1",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "stdio サービスは、ユーザーが選択したカーネル環境変数だけを継承し、起動するたびに現在の値を読み取ります。環境変数の各項目ではシークレットと変数も参照できます。シークレットを参照すると、その平文がこのプログラムと子プロセスに渡され、直接入力した値は平文で保存されます。認証が必要な HTTP サービスでは OAuth 認証が案内されます。再利用するシークレットとパラメーターは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "シークレットと変数"
				},
				{
					"Type": "NodeText",
					"Data": " で管理できます。詳しくは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804185003-secvr04",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "シークレットと変数"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。外部 MCP ツールはローカルデータの送信、外部システムの変更、料金の発生を伴う場合があるため、確認カードの影響を確認してください。"
				}
			]
		},
