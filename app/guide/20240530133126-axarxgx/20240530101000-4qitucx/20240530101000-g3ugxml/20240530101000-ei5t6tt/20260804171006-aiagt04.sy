							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804170039-9kcdqv4",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170039-9kcdqv4",
				"updated": "20261027140312"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タスクを送信、停止する"
				}
			]
		},
		{
			"ID": "20260804170040-m2zcmhf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170040-m2zcmhf",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デフォルトでは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘Enter"
				},
				{
					"Type": "NodeText",
					"Data": " で送信します。ショートカットはカスタマイズできます。"
				},
				{
					"Type": "NodeText",
					"Data": "エージェントの実行中は停止ボタンで現在のタスクを中断できます。目的、範囲、出力先を明確に指定すると、通常はより安定した結果が得られます。"
				}
			]
		},
		{
			"ID": "20261022182404-hxp98ok",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022182404-hxp98ok",
				"updated": "20261027140312"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "入力欄は文字や画像に合わせて自動的に高くなり、パネルで利用可能な高さの上限に達するとスクロールします。デスクトップでは入力欄にマウスポインターを合わせると上端に小さなハンドルが表示され、タッチ画面では常に表示されます。ハンドルを上下にドラッグすると、現在のメッセージの入力中は高さが固定され、空の入力欄も広げられます。"
				}
			]
		},
		{
			"ID": "20261024164212-5kzoj2e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-5kzoj2e",
				"updated": "20261027140312"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "最小の高さはテキストを一行すべて表示できる大きさで、最大の高さはパネルの利用可能なスペースに応じて決まります。メッセージを送信すると、空になった入力欄は初期の高さに戻り、次のメッセージでは再び自動調整されます。入力中にハンドルをダブルクリックして自動調整に戻すこともできます。内容の前後にはスクロール用の余白があり、最初と最後の行を確認しやすくなっています。"
				}
			]
		},
		{
			"ID": "20261022182404-yecrc0p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022182404-yecrc0p",
				"updated": "20261024153700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "高さのハンドルにキーボードフォーカスがあるときは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "↑"
				},
				{
					"Type": "NodeText",
					"Data": " または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "↓"
				},
				{
					"Type": "NodeText",
					"Data": " で高さを増減し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Home"
				},
				{
					"Type": "NodeText",
					"Data": " で最小、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "End"
				},
				{
					"Type": "NodeText",
					"Data": " で現在利用できる最大の高さに変更できます。ドラッグ中に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと調整を取り消します。"
				}
			]
		},
		{
			"ID": "20260804170041-sri5ln6",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804170041-sri5ln6",
				"updated": "20261016191953"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "操作を確認する"
				}
			]
		},
		{
			"ID": "20260804170042-fuwjiju",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170042-fuwjiju",
				"updated": "20261016191953"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "読み取りと検索は通常そのまま実行されます。データの作成、変更、移動、削除、インポートを行う操作では確認カードが表示され、ローカルへの書き込み、データ送信、外部料金などの影響が示されます。実行、拒否、または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "セッション許可"
				},
				{
					"Type": "NodeText",
					"Data": " を選択できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "セッション許可"
				},
				{
					"Type": "NodeText",
					"Data": " を選ぶと、このセッションでの通常の操作について個別の確認を省略できます。確認必須に設定された機能とコードスニペットの変更には、引き続き確認が必要です。"
				}
			]
		},
		{
			"ID": "20260804170043-c3mrdfs",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170043-c3mrdfs",
				"updated": "20261016191345"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "セッション許可"
				},
				{
					"Type": "NodeText",
					"Data": " を使う前に、タスクの範囲とツールが信頼できることを確認してください。通常の書き込み操作では個別の確認が省略されますが、上記の必須確認は引き続き行われます。"
				}
			]
		},
		{
			"ID": "20260804170044-0dekacs",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170044-0dekacs",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セッション管理"
				}
			]
		},
		{
			"ID": "20260804170045-86n1950",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170045-86n1950",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セッションの作成、検索、切り替え、名前変更、削除ができます。メッセージ、参照、ツール呼び出し、実行結果はセッションに保存され、同期された別のインスタンスからも確認できます。"
				}
			]
		},
		{
			"ID": "20260804170046-2kcx5sj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170046-2kcx5sj",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "送信済みのメッセージを編集して再送信したり、回答を再生成したりできます。再送信すると後続の会話は削除されますが、実行済みの操作は元に戻りません。復元が必要な場合は、対応するデータスナップショットを使用してください。"
				}
			]
		},
		{
			"ID": "20260804170047-d4bjmew",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170047-d4bjmew",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "モデルと思考強度"
				}
			]
		},
		{
			"ID": "20260804170048-km5oy76",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170048-km5oy76",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "入力欄の下で有効なモデルを切り替え、対応するモデルでは思考強度を選択できます。推論やツール呼び出しを含むセッションでモデルを切り替えると、回答品質やツール呼び出しの連続性が低下する場合があります。"
				}
			]
		},
		{
			"ID": "20260804170049-vtr56ro",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170049-vtr56ro",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテキスト使用量では、現在使用しているコンテキストの割合と分類別の内訳を確認できます。モデルの上限に近づくと、エージェントは以前の会話内容を圧縮しようとします。"
				}
			]
		},
		{
			"ID": "20260804170050-7cf4sou",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170050-7cf4sou",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スキル"
				}
			]
		},
		{
			"ID": "20260804170051-4l1ozje",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170051-4l1ozje",
				"updated": "20260816130653"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スキルは、ワークフロー、形式、分野固有のルールを定義する再利用可能なタスク手順です。各スキルは独立したディレクトリを使用し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " を "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "workspace/data/storage/ai/agent/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " の下に配置します。ユーザーディレクトリ "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/.agents/skills/"
				},
				{
					"Type": "NodeText",
					"Data": " の読み取り専用スキルを個別に有効にすることもできます。"
				}
			]
		},
		{
			"ID": "20260804170052-ecqhexr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170052-ecqhexr",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " では YAML Front Matter に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "name"
				},
				{
					"Type": "NodeText",
					"Data": " と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "description"
				},
				{
					"Type": "NodeText",
					"Data": " を定義し、その後にエージェントが従う手順を記述できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " と入力すると、インストール済みのスキルを検索して選択できます。"
				}
			]
		},
		{
			"ID": "20260804170053-2kk8p7q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170053-2kk8p7q",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントに、スキルの一覧表示、作成、更新、名前変更、削除を依頼できます。インストール元には "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": "、完全な "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": " コマンド、GitHub URL、未加工の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " URL、ZIP URL を指定できます。スキルはエージェントの動作に影響するため、信頼できる提供元だけを使用してください。"
				}
			]
		},
		{
			"ID": "20260804170054-qfoixg9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170054-qfoixg9",
				"updated": "20261026182137"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービス"
				}
			]
		},
		{
			"ID": "20261026182137-bhff56j",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261026182137-bhff56j",
				"updated": "20261026182137"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "外部 MCP ツールは必要に応じて読み込まれます。エージェントは最初にサービス一覧のみを受け取り、必要なサービスのツール定義を読み込むと、次のモデルリクエストから利用できます。メッセージで使用するサービスを指定することもできます。読み込み状態は現在のユーザーリクエストとそのツール実行中のみ保持され、次のメッセージではリセットされます。複数のサービスを同時に読み込め、固定の数の上限はありません。モデルは不要なサービスを解除してコンテキストを節約できます。無効なツールは読み込まれず、実行の確認ポリシーも適用されます。エージェントの機能設定で組み込み mcp ツールを無効にすると外部ツール定義をすべて送信する方式に戻り、再度有効にすると必要に応じた読み込みに戻ります。"
				}
			]
		},
		{
			"ID": "20260804170055-a7wg3um",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170055-a7wg3um",
				"updated": "20260812170000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "MCP サービスはエージェントに外部ツールを提供します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント MCP サービス"
				},
				{
					"Type": "NodeText",
					"Data": " で stdio または HTTP サービスを追加し、コマンド、引数、環境変数、URL、HTTP ヘッダー、タイムアウトを設定して、接続状態とツール数を確認できます。"
				},
				{
					"Type": "NodeText",
					"Data": "ここで設定するのは、エージェントが呼び出す外部 MCP サービスです。外部 MCP クライアントを SiYuan に接続する方法については、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804223003-mcpsv04",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "MCP サービス"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20260804170056-7d7fak1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170056-7d7fak1",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "stdio サービスは、ユーザーが選択したカーネル環境変数だけを継承し、起動するたびに現在の値を読み取ります。環境変数の各項目ではシークレットと変数も参照できます。シークレットを参照すると、その平文がこのプログラムと子プロセスに渡され、直接入力した値は平文で保存されます。認証が必要な HTTP サービスでは OAuth 認証が案内されます。"
				}
			]
		},
		{
			"ID": "20261024161816-ub5ldhk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-ub5ldhk",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "再利用するシークレットとパラメーターは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "シークレットと変数"
				},
				{
					"Type": "NodeText",
					"Data": " で管理できます。詳しくは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804185003-secvr04",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "シークレットと変数"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。外部 MCP ツールはローカルデータの送信、外部システムの変更、料金の発生を伴う場合があるため、確認カードの影響を確認してください。"
				}
			]
		},
		{
			"ID": "20261018102417-5r3z242",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261018102417-5r3z242",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Web 検索と取得"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261018102417-kbspy6l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261018102417-kbspy6l",
				"updated": "20261018104335"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "公開 Web ページを検索し、本文を読み取って要約したりノートに保存したりするようエージェントに依頼できます。web_search はリンクと要約を返し、web_fetch は指定した URL を読み取ります。直接取得では HTTP を使用し、JavaScript は実行しません。デスクトップアプリでは、JavaScript で生成される本文を取得するための独立したレンダリング取得ツールも利用できます。"
				}
			]
		},
		{
			"ID": "20261018104335-h974oif",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261018104335-h974oif",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Web 検索と取得"
				},
				{
					"Type": "NodeText",
					"Data": " で検索サービスと取得サービスを個別に選択できます。既定では Exa 検索と直接取得を使用します。DeepSeek を使用する場合は、Search と Fetch で共有する DeepSeek API キーを入力します。"
				}
			]
		},
		{
			"ID": "20261024164212-omb0uex",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-omb0uex",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "この設定は対話モデルとは独立しています。DeepSeek Search は本文なしで 5 件の結果を要求し、各要約を 800 文字、出力全体を 8,000 文字に制限します。全文が必要な場合にページを取得してください。"
				}
			]
		},
		{
			"ID": "20261018104335-6bib27g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261018104335-6bib27g",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "DeepSeek Search は検索語を、DeepSeek Fetch は対象 URL を DeepSeek に送信します。ブラウザーの Cookie やログイン状態は送信しません。これらのリクエストには料金が発生する場合があります。"
				}
			]
		},
		{
			"ID": "20261024164212-2r4ag5i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-2r4ag5i",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "DeepSeek Fetch はページ本文のみを取得するため、ファイルのダウンロードには直接取得を選択してください。キーが無効、残高不足、レート制限、ページの取得不可などの場合はエラーを返し、サービスを自動で切り替えません。ツールの権限設定に従って外部リクエストを確認してください。"
				}
			]
		},
		{
			"ID": "20261018102417-zew7i8y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261018102417-zew7i8y",
				"updated": "20261018102417"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "レンダリングによる取得では、ページのスクリプトを実行し、ローカルのデスクトップからネットワークリクエストを送信します。リモートカーネルへの接続時も同様です。現在のウィンドウのプロキシ設定を使い、既存の Cookie やログイン状態を引き継がない独立した一時セッションを使用します。対象の URL を確認し、ツールの権限設定に従って操作を承認してください。内部アドレスへのアクセスとダウンロードは拒否されます。"
				}
			]
		},
		{
			"ID": "20261018102417-o7p27lp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261018102417-o7p27lp",
				"updated": "20261018104335"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "レンダリング取得には、デスクトップインスタンスの接続を維持する必要があります。ブラウザー版、モバイル版、外部 MCP クライアントは、設定された取得サービスを使用します。本文が空の場合やタイムアウト時はエラーを返し、長い結果は 50,000 文字で切り詰めます。ログイン、埋め込みページ、ワーカー、継続的なブラウザー接続が必要なページは、取得できない場合があります。"
				}
			]
		},
		{
			"ID": "20261010113646-e4bfwsj",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261010113646-e4bfwsj",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SQL クエリ、検索、動的埋め込み"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261010113646-71xuifp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261010113646-71xuifp",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントに、ブロックの種類、行内書式、親子関係、複数の条件でノートを検索し、結果を集計するよう依頼できます。"
				}
			]
		},
		{
			"ID": "20261010172554-3gmocso",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261010172554-3gmocso",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "例：「過去1週間に更新されたタスクを集計して」「プロジェクト文書内の未完了のタスク項目を探して」。"
				}
			]
		},
		{
			"ID": "20261010172554-los4ny5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261010172554-los4ny5",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "結果を確認して移動するには検索ウィンドウでの表示を、文書内に一致するブロックを継続的に表示するには動的な SQL 埋め込みの作成を依頼します。集計結果は回答に使用できますが、埋め込みブロックとして直接表示することはできません。"
				}
			]
		},
		{
			"ID": "20261010172554-nkhymve",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261010172554-nkhymve",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "既存の埋め込みを変更するときは、変更したい検索条件を伝え、元のブロックと表示設定を保持するよう依頼してください。"
				}
			]
		},
		{
			"ID": "20261010173100-j0996f2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261010173100-j0996f2",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "暗号化ノートブックは、ロックを解除して対象を指定してから検索してください。そのノートブック内の埋め込みは、同じノートブックの内容だけを検索できます。"
				}
			]
		},
		{
			"ID": "20260804170109-yrnzqjt",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170109-yrnzqjt",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データスナップショットとロールバック"
				}
			]
		},
		{
			"ID": "20260804170110-e38e283",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170110-e38e283",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "各ターンで最初にワークスペースのデータへ書き込む前に、エージェントはデータスナップショットを自動作成します。作成されるスナップショットは 1 ターンにつき最大 1 つです。結果が適切でない場合は、セッション内のスナップショット通知からロールバックできます。"
				}
			]
		},
		{
			"ID": "20260804170111-8dl6p54",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170111-8dl6p54",
				"updated": "20260804205607"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スナップショットはワークスペースのデータを対象としますが、外部 MCP サービスやプラグインが外部システムに加えた変更は対象外です。回答の再生成、タスクの停止、セッションの削除でも、完了済みの書き込み操作は自動的に元に戻りません。"
				}
			]
		},
		{
			"ID": "20261008115720-n4ciuhi",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261008115720-n4ciuhi",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "CSS/JS コードスニペット"
				}
			]
		},
		{
			"ID": "20261008115720-jxawckb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008115720-jxawckb",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェントに CSS/JS コードスニペットの一覧表示、読み取り、作成、変更、有効化、無効化、削除を依頼できます。例えば、「画面の文字サイズを大きくする CSS スニペットを作成し、確認できるよう無効のままにしてください」と伝えます。"
				}
			]
		},
		{
			"ID": "20261008115720-2cca2wa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008115720-2cca2wa",
				"updated": "20261008115720"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セッション全体の許可や自動承認を有効にしていても、スニペットの変更は毎回確認が必要です。確認カードに表示される変更予定のコードと現在のスニペットを確認してください。新しいスニペットは無効な状態で作成され、公開サービスでは読み込まれません。CSS/JS の全体スイッチと既存スニペットの公開設定は維持されます。"
				}
			]
		},
		{
			"ID": "20261008115720-zx5ldnm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008115720-zx5ldnm",
				"updated": "20261008115720"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "JS を有効にする場合や、有効な JS スニペットを変更する場合、接続中のウィンドウでコードが実行されることがあります。無効化や削除では実行済みコードの効果を取り消せないため、フロントエンドの再起動が必要になる場合があります。確認中にスニペットが変更された場合、操作は拒否され、エージェントは再度読み取って確認を求めます。"
				}
			]
		},
		{
			"ID": "20261008125238-mzmf6je",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261008125238-mzmf6je",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スニペットの名前とコードを検索し、名前の変更や一部分の修正を依頼できます。管理ダイアログを開いている間にスニペットが変更された場合、保存は拒否され、下書きは保持されます。編集内容をコピーしてダイアログを開き直し、最新のスニペットと統合してください。"
				}
			]
		},
		{
			"ID": "20260804170057-6r79kj4",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
