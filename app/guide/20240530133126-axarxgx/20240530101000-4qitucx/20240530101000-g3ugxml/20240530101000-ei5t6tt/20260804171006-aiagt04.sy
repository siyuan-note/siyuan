	"Children": [
		{
			"ID": "20260804170023-1x6ifkw",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170023-1x6ifkw",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "概要"
				}
			]
		},
		{
			"ID": "20260804170024-9lvjy1x",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170024-9lvjy1x",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "AI エージェントは質問に答えるだけでなく、SiYuan の組み込みツール、スキル、MCP サービス、プラグイン機能を利用してナレッジベースを検索、読み取り、操作できます。タスクを段階的に実行し、データを変更する前に確認を求めます。"
				}
			]
		},
		{
			"ID": "20260804170025-r2m4o0b",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170025-r2m4o0b",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定方法"
				}
			]
		},
		{
			"ID": "20260804170026-vh2f8ng",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170026-vh2f8ng",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "API プロバイダー"
				},
				{
					"Type": "NodeText",
					"Data": " で API プロバイダーとモデルを設定して有効にし、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エージェント"
				},
				{
					"Type": "NodeText",
					"Data": " でエージェントが使用するモデルを選択します。ツール呼び出しを安定して実行でき、十分なコンテキストウィンドウを持つモデルを推奨します。"
				}
			]
		},
		{
			"ID": "20260804180003-imgja01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804180003-imgja01",
				"updated": "20260804180003"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エージェントはドキュメント内の画像を分析できます。画像理解の能力は現在のモデルによって異なります。画像を生成するには、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "AI を呼び出す"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画像生成"
				},
				{
					"Type": "NodeText",
					"Data": " で画像出力に対応するモデルを設定します。"
				}
			]
		},
		{
			"ID": "20260804170027-2jaadkf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804170027-2jaadkf",
				"updated": "20260816114944"
			},
			"Children": [
				{
					"Type": "NodeText",
