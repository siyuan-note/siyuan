		{
			"ID": "20260804170149-kvdqvm5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804170149-kvdqvm5",
				"updated": "20260804180000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ファイルを保存した後、埋め込みインデックスを再構築してください。このファイルは埋め込みベクトルだけに影響し、コンテンツは通常の全文インデックスには残ります。通常のインデックスから完全に除外する方法については "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "インデックスから除外",
					"TextMarkBlockRefID": "20240530101000-mrlr6e9",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
