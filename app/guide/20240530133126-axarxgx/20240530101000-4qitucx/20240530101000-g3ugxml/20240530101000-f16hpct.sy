									"Type": "NodeText",
									"Data": "​ で指定するものと同じです"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-b8tylhp",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-k8rte7r",
				"id": "20240530101000-b8tylhp",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "たとえば、ホストに "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": " を作成してから "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v /siyuan/workspace:/siyuan/workspace -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE -e PUID=1000 -e PGID=1000 b3log/siyuan serve --workspace=/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": " を実行します。ホストとコンテナのパスは異なっていても構いません。起動後に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "http://server-ip:6806"
				},
				{
					"Type": "NodeText",
					"Data": " を開き、入力したパスワードでログインします。起動に失敗した場合はコンテナログを確認してください。"
				}
			]
		},
		{
			"ID": "20240530101000-cifxjjw",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-elwalz1",
				"id": "20240530101000-cifxjjw",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ユーザーパーミッション"
				}
			]
		},
		{
			"ID": "20240530101000-os9yh35",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-hsf648s",
				"id": "20240530101000-os9yh35",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "入口スクリプトは、ユーザーとグループの作成または再利用、および "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/opt/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/home/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": "、ワークスペースの所有権の再帰的な設定に必要な権限で起動します。その後 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "su-exec"
				},
				{
					"Type": "NodeText",
					"Data": " で "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "PUID:PGID"
				},
				{
					"Type": "NodeText",
					"Data": " としてカーネルを実行します。両方のデフォルトは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "1000"
				},
				{
					"Type": "NodeText",
					"Data": " です。ホストの所有者に合わせるには "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-e PUID=1000 -e PGID=1000"
				},
				{
					"Type": "NodeText",
					"Data": " の数値を適切な ID に置き換えて指定します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-u 1000:1000"
				},
				{
					"Type": "NodeText",
					"Data": " を付けると入口スクリプトが権限を準備できなくなるため、付けないでください。所有権の変更はマウントしたホストディレクトリにも反映されます。"
				}
			]
		},
		{
			"ID": "20240530101000-8viay1g",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
