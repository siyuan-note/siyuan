			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エントリポイント"
				}
			]
		},
		{
			"ID": "20240530101000-5xcd2gc",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-tv9g19f",
				"id": "20240530101000-5xcd2gc",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "イメージの入口は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "ENTRYPOINT [\"/opt/siyuan/entrypoint.sh\"]"
				},
				{
					"Type": "NodeText",
					"Data": "、デフォルトコマンドは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "CMD [\"serve\"]"
				},
				{
					"Type": "NodeText",
					"Data": " です。イメージ名の後の引数はデフォルトコマンド全体を置き換えるため、カーネル引数を指定するときは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": " を明示してください。"
				}
			]
		},
		{
			"ID": "20261016112115-xr14c1k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016112115-xr14c1k",
				"updated": "20261016112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "起動前にホスト側のワークスペースディレクトリを作成し、認証を設定してください。以下の例は、ホストでエクスポートした "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SIYUAN_ACCESS_AUTH_CODE"
				},
				{
					"Type": "NodeText",
					"Data": " 環境変数から強力な画面ロックパスワードを受け取ります。新しい Docker ワークスペースは、パスワードまたは有効な"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20260804190003-oidcja1",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "OIDC ログイン"
				},
				{
					"Type": "NodeText",
					"Data": "がなければ起動を拒否します。たとえば、Bash では次の手順で自分で選んだパスワードを非表示で入力できます。実際のパスワードを共有ファイルやコマンド履歴に残さないでください。コンテナ環境を検査できる人は、この値を読み取れます。"
				}
			]
		},
		{
			"ID": "20261016112115-xqmnr5v",
			"Type": "NodeCodeBlock",
			"Properties": {
				"id": "20261016112115-xqmnr5v",
				"updated": "20261016112115"
			},
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "YmFzaA==",
			"CodeBlockCloseFence": "YGBg",
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YmFzaA=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "read -r -s -p \"画面ロックパスワード：\" SIYUAN_ACCESS_AUTH_CODE\nprintf '\\n'\nexport SIYUAN_ACCESS_AUTH_CODE\n: \"${SIYUAN_ACCESS_AUTH_CODE:?空でない画面ロックパスワードを設定してください}\"\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20240530101000-2hkopvx",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"ID": "20240530101000-78ygqh7",
				"id": "20240530101000-2hkopvx",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"ID": "20240530101000-gj0apkj",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"ID": "20240530101000-8by8qen",
						"id": "20240530101000-gj0apkj",
						"updated": "20240530101000"
					},
					"Children": [
						{
							"ID": "20240530101000-3hej98c",
							"Type": "NodeParagraph",
							"Properties": {
								"ID": "20240530101000-z9fmnae",
								"id": "20240530101000-3hej98c",
								"updated": "20240530101000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "​"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace"
								},
								{
									"Type": "NodeText",
									"Data": "​ でワークスペースディレクトリのパスを指定し、ホストマシンから "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "-v"
								},
								{
									"Type": "NodeText",
									"Data": "​ でコンテナにマウントします"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-tusg4ak",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-cld3snp",
				"id": "20240530101000-tusg4ak",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "その他のパラメータは"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-xq26o73",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "こちら"
				},
				{
					"Type": "NodeText",
					"Data": "を参照してください。次に起動コマンドの例を示します: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v workspace_dir_host:workspace_dir_container -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE b3log/siyuan serve --workspace=workspace_dir_container"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeText",
					"Data": "。Docker で公開サービスを有効にする場合は、通常のサーバーポートのマッピングに加えて、コンテナ作成コマンドに "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-p 6808:6808"
				},
				{
					"Type": "NodeText",
					"Data": " を追加してください。Docker のポートマッピングはホスト側ポート:コンテナ側ポートの形式です。公開サービスのポートを変更した場合はコンテナ側ポートも変更し、アクセス時にはホスト側ポートを使用してください。公開サービスには固定ポートを指定し、0 に設定しないでください。"
				}
			]
		},
		{
			"ID": "20240530101000-7s32tna",
			"Type": "NodeList",
			"ListData": {
				"Tight": true,
