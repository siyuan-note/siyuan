				}
			]
		},
		{
			"ID": "20260928085827-0dy3tdl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260928085827-0dy3tdl",
				"updated": "20260928091724"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップ版では "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ショートカット"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "一般"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "タブの切り替え"
				},
				{
					"Type": "NodeText",
					"Data": " でタブ切り替えメニューのショートカットを設定できます。既定では割り当てられていません。メニューには、アクティブな分割ペインのタブがタブバーと同じ順序で表示されます。上下の矢印キーで選択し、Enter で切り替え、Esc で閉じます。コマンドパネルからも実行できます。"
				}
			]
		},
		{
			"ID": "20260928091724-64moixh",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260928091724-64moixh",
				"updated": "20260928091724"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテキストメニュー"
				}
			]
		},
		{
			"ID": "20260925174006-lw5d4uc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260925174006-lw5d4uc",
				"updated": "20260928091724"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ショートカット"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "一般"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "コンテキストメニューを開く"
				},
				{
					"Type": "NodeText",
					"Data": " でショートカットを変更または解除できます。既定値は Windows/Linux では Ctrl+/、macOS では Cmd+/ です。現在のフォーカスに応じて、エディター内のコンテンツ、データベースの行、検索結果、ナビゲーション項目のコンテキストメニューを開きます。文字 / の入力によるスラッシュメニューの表示は変わりません。"
				}
			]
		},
		{
			"ID": "20260928091724-pbrjucc",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260928091724-pbrjucc",
				"updated": "20260928091724"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "設定画面のキーボード操作"
				}
			]
		},
		{
			"ID": "20260923233001-0vynujv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260923233001-0vynujv",
				"updated": "20260928091724"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップ版の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " ウィンドウでは、検索欄から "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと、表示中のカテゴリに順番にフォーカスが移り、その後、右側の設定項目に移ります。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Tab"
				},
				{
					"Type": "NodeText",
					"Data": " で逆方向に移動し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " または "
				},
