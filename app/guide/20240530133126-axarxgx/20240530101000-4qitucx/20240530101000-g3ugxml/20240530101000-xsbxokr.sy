		{
			"ID": "20261026090134-ly6n91j",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261026090134-ly6n91j",
				"updated": "20261026090134"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ノードの最初の段落を編集中に Enter を押すと、同階層のノードを作成して編集を続けます。カーソル以降の文字と後続のコンテンツブロックは新しいノードに移ります。空でない最初の段落の先頭では、現在のノードの前に空のノードを挿入します。Tab と Shift+Tab は子ノードを保持したまま分岐全体の階層を変更します。先頭で Backspace、末尾で Delete を押すと隣接ノードの本文を結合でき、1つのノードに複数の段落を保持できます。他のコンテンツブロックでは通常の Enter の動作を使います。コードブロック、表、入力メソッド、候補メニューの編集操作は維持され、既存のカスタム編集ショートカットが優先されます。"
				}
			]
		},
		{
			"ID": "20261020162345-6y84piz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020162345-6y84piz",
				"updated": "20261020162345"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "キャンバスの空白部分をマウスの左ボタンでドラッグすると、複数のノードを範囲選択できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": "（macOS では "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Command"
				},
				{
					"Type": "NodeText",
					"Data": "）を押しながらノードをクリックすると、選択状態を切り替えられます。タッチ画面ではノードを選択し、下部の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "複数選択"
				},
				{
					"Type": "NodeText",
					"Data": " を有効にしてからノードを個別にタップします。もう一度ボタンを押すか "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと、このモードを終了します。コピーと切り取りには子ツリー全体が含まれ、親と子を同時に選択しても重複しません。ノードのスタイル、分岐内の関連線、範囲全体が含まれる要約も保持します。ルートノードは切り取れません。クリップボードへの書き込みが失敗した場合やプレーンテキストしか扱えない環境では、元のノードを残します。"
				}
			]
		},
		{
			"ID": "20260930234403-cyh3qk6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260930234403-cyh3qk6",
				"updated": "20261020162345"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ノードを 1 つ選択して "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl+V"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘V"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと子ノードとして、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl+Shift+V"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⇧⌘V"
				},
				{
					"Type": "NodeText",
					"Data": " を押すと同階層のノードとして貼り付けます。下部の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " メニューからもコピー、切り取り、これらの貼り付けを実行できます。マインドマップのノードは元の階層を保持し、通常のテキスト、画像、コンテンツブロックは新しいノードのエディタを通して挿入します。ノードのテキスト編集中は、通常の本文編集と同じ貼り付け動作になります。画像のアップロード中は完了を待ってからノードの編集を終了してください。"
				}
			]
		},
		{
			"ID": "20260926152753-5vwcnw1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260926152753-5vwcnw1",
				"updated": "20261024124323"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "1 つ以上のノードを選択してから、下部のノードメニューで "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "要約"
				},
				{
					"Type": "NodeText",
					"Data": " を実行すると、有効な全グループを一度に作成し、最初の新しい要約を編集できます。作成は一度の取り消しで元に戻せます。キャンバス上で Esc を押すと複数選択モードを終了します。要約テキストの編集中は Enter で保存、Esc でテキストの編集をキャンセルします。選択中の要約は Delete または Backspace で削除できます。"
				},
				{
					"Type": "NodeText",
					"Data": "色または幅のパネルが開いているときは、Esc でパネルを閉じ、未保存の幅のプレビューを取り消します。"
				}
			]
		},
		{
			"ID": "20261001015635-i5efca0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261001015635-i5efca0",
				"updated": "20261001015635"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "マインドマップのサイズ変更ハンドルにキーボードのフォーカスがあるとき、矢印キーで対応する幅または高さを 10 px ずつ変更できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " を押しながら矢印キーを押すと 1 px ずつ変更します。これらのキーはフォーカス中のサイズ変更ハンドルにのみ作用します。ドラッグ中に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " を押すとサイズ変更をキャンセルします。"
				}
			]
		},
