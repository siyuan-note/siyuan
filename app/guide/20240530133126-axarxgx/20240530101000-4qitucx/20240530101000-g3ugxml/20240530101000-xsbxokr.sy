									"TextMarkTextContent": "Shift+Tab"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261002230607-6fbe978",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261002230607-6fbe978",
				"updated": "20261016013311"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コードブロックに個別の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab スペースの数"
				},
				{
					"Type": "NodeText",
					"Data": " が設定されていない場合、インデントの追加・削除時に2行以上の空でないコードから一貫したインデントを検出し、そのブロックの設定として保存します。タブ、または最小幅が2・4・6・8個のスペースで、ほかのインデントもその幅の整数倍になっている場合に検出できます。タブとスペースが混在している場合や判定材料が不足している場合は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "動作"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab スペースの数"
				},
				{
					"Type": "NodeText",
					"Data": " の値を使います。明示的なブロック設定が優先されます。検出によって既存のコードが再整形されることはありません。"
				}
			]
		},
