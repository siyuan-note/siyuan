							"Children": [
								{
									"Type": "NodeText",
									"Data": "カーソル位置にインデントを挿入する、または選択行のインデントを増やす"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Data": "td",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Tab"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Data": "tr",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Data": "td",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "現在の行または選択行のインデントを減らす：行頭のタブを1つ、または "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Tab スペースの数"
								},
								{
									"Type": "NodeText",
									"Data": " の設定数を上限として行頭のスペースを削除する（0の場合は最大4個）"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Data": "td",
							"Children": [
