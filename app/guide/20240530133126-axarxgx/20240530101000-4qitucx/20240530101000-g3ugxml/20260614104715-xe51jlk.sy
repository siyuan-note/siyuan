							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260614104730-kwo2uzv",
								"updated": "20260614104730"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "ホスト"
								},
								{
									"Type": "NodeText",
									"Data": "：プロキシサーバーのアドレスを入力。形式は "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "IP"
								},
								{
									"Type": "NodeText",
									"Data": "​ または "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "ユーザー名:パスワード@IP"
								},
								{
									"Type": "NodeText",
									"Data": "​（認証が必要な場合）"
								}
							]
