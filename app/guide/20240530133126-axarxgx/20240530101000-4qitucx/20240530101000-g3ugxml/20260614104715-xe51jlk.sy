							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "ポート"
								},
								{
									"Type": "NodeText",
									"Data": "：プロキシサーバーのポートを入力"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260614104730-fwszfos",
			"Type": "NodeParagraph",
