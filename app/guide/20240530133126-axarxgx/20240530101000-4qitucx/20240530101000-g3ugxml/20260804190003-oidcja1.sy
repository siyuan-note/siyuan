				}
			]
		},
		{
			"ID": "20260804190049-ja0001e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190049-ja0001e",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Docker では、以下の環境変数でワークスペースの OIDC 設定を上書きできます。少なくとも OIDC の有効化、プロバイダー、クライアント ID が必要です。その他の変数はプロバイダー、コールバック、アクセス方針に応じて設定します。"
				}
			]
		},
		{
			"ID": "20260804190050-ja0001f",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "dGV4dA==",
			"CodeBlockCloseFence": "YGBg",
			"Properties": {
				"id": "20260804190050-ja0001f",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "dGV4dA=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "SIYUAN_OIDC_ENABLED\nSIYUAN_OIDC_PROVIDER\nSIYUAN_OIDC_ISSUER_URL\nSIYUAN_OIDC_CLIENT_ID\nSIYUAN_OIDC_CLIENT_SECRET\nSIYUAN_OIDC_SCOPES\nSIYUAN_OIDC_REDIRECT_URL\nSIYUAN_OIDC_ALLOW_ALL\nSIYUAN_OIDC_CLAIM_RULES\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20260804190051-ja0001g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190051-ja0001g",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "環境変数はカーネル起動時に適用されます。リモートの Docker 配置では、画面ロックパスワード、有効な OIDC 設定、または明示的な認証バイパスのいずれかも必要です。いずれもない場合、認証なしでワークスペースが公開されることを防ぐため、思源は起動を拒否します。"
				}
			]
		},
