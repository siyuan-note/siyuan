			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190001-ja00002",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "OIDC（OpenID Connect）ログインを使用すると、既存の ID プロバイダーによるシングルサインオンを、ブラウザの画面ロックパスワードと併用できます。Custom、Google、Microsoft、GitHub に対応しています。"
				}
			]
		},
		{
			"ID": "20260804190002-ja00003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190002-ja00003",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "OIDC のクレームルールで許可された ID には、現在のワークスペースの管理者権限が付与されます。OIDC はユーザーごとの権限分離やロールマッピングを提供しないため、ログインを許可する ID を厳密に制限してください。"
				}
			]
		},
		{
			"ID": "20260804190003-ja00004",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260804190003-ja00004",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "事前準備"
				}
			]
		},
