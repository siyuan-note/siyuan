		{
			"ID": "20260804190023-ja0000o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190023-ja0000o",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "アプリケーションとコールバックの登録については、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Google OpenID Connect ドキュメント",
					"TextMarkAHref": "https://developers.google.com/identity/openid-connect/openid-connect"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "Microsoft Entra アプリ登録ドキュメント",
					"TextMarkAHref": "https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "GitHub OAuth App ドキュメント",
					"TextMarkAHref": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
				},
				{
					"Type": "NodeText",
					"Data": "を参照してください。プロバイダーの管理画面は変更される場合があるため、最新の公式ドキュメントに従ってください。"
				}
			]
		},
		{
			"ID": "20260804190024-ja0000p",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804190024-ja0000p",
