			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コールバック URL"
				}
			]
		},
		{
			"ID": "20260804190025-ja0000q",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260804190025-ja0000q",
				"updated": "20260804211503"
			},
			"Children": [
				{
					"ID": "20260804190026-ja0000r",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804190026-ja0000r",
						"updated": "20260804211503"
					},
					"Children": [
						{
							"ID": "20260804190027-ja0000s",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804190027-ja0000s",
								"updated": "20260804211503"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ローカルブラウザとデスクトップ：コールバックには SiYuan への現在のローカルアクセスと同じスキームを使用します。HTTPS が有効な場合は "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "https://127.0.0.1:<ポート>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": "、HTTPS が無効な場合は "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "http://127.0.0.1:<ポート>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": " を使用します。登録 URL は実際のスキーム、ホスト、ポート、パス、スラッシュと完全に一致する必要があります"
								}
							]
						}
					]
				},
				{
					"ID": "20260804190028-ja0000t",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804190028-ja0000t",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804190029-ja0000u",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804190029-ja0000u",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "リモートブラウザ：OIDC リダイレクト URL に公開 HTTPS URL を入力します。パスは "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": " と完全に一致し、クエリ、フラグメント、ユーザー情報を含めることはできません"
								}
							]
						}
					]
				},
				{
					"ID": "20260804190030-ja0000v",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20260804190030-ja0000v",
						"updated": "20260804193000"
					},
					"Children": [
						{
							"ID": "20260804190031-ja0000w",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260804190031-ja0000w",
								"updated": "20260804193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ネイティブモバイル：常に "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan:/oidc-callback"
								},
								{
									"Type": "NodeText",
									"Data": " を使用します。プロバイダーにそのまま登録してください。Google はこの形式を受け付けないため、Google ログインはブラウザとデスクトップでのみ使用できます"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260804190032-ja0000x",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804190032-ja0000x",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スコープ"
				}
			]
		},
		{
			"ID": "20260804190033-ja0000y",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190033-ja0000y",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "既定のスコープは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "openid profile email"
				},
				{
					"Type": "NodeText",
					"Data": " です。通常は変更する必要はありません。カスタムスコープを使用する場合は、アクセスルールに必要なクレームが引き続き返されることを確認してください。GitHub では、ユーザー情報と検証済みメールアドレスの取得に必要な権限へ自動的に変換されます。"
				}
			]
		},
		{
			"ID": "20260804190034-ja0000z",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260804190034-ja0000z",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "クレームルール"
				}
			]
		},
		{
			"ID": "20260804190035-ja00010",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190035-ja00010",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "「認証済みのすべてのユーザーに管理者権限を付与」を無効にした場合、1 つ以上のクレームルールが必要です。ルールは JSON 配列で記述します。同じルール内の複数の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "values"
				},
				{
					"Type": "NodeText",
					"Data": " は OR、異なるルール間は AND として評価されます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "operator"
				},
				{
					"Type": "NodeText",
					"Data": " には "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "equals"
				},
				{
					"Type": "NodeText",
					"Data": " または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": " を使用できます。"
				}
			]
		},
		{
			"ID": "20260804190036-ja00011",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "anNvbg==",
			"CodeBlockCloseFence": "YGBg",
			"Properties": {
				"id": "20260804190036-ja00011",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "anNvbg=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "[\n  {\n    \"claim\": \"email\",\n    \"operator\": \"equals\",\n    \"values\": [\"alice@example.com\", \"bob@example.com\"]\n  },\n  {\n    \"claim\": \"email_verified\",\n    \"operator\": \"equals\",\n    \"values\": [\"true\"]\n  }\n]\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20260804190037-ja00012",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260804190037-ja00012",
				"updated": "20260804193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "この例では、指定した 2 つのメールアドレスだけを許可し、プロバイダーがメールアドレスを検証済みとして返すことも要求します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "groups"
				},
				{
					"Type": "NodeText",
					"Data": " などの配列クレームでは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": " を使用してグループ名を照合できます。クレーム名と値は、プロバイダーの実際の応答と一致させてください。"
				}
			]
		},
		{
