	"Children": [
		{
			"ID": "20260907120000-ja00001",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-ja00001",
				"updated": "20260907120000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "暗号化ノートブックとは"
				}
			]
		},
		{
			"ID": "20260907120000-ja00002",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-ja00002",
				"updated": "20260907120000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "暗号化ノートブックは機密コンテンツの保存に使用します。ドキュメント、アセットと元のファイル名、データベース定義、専用インデックスはディスク上で暗号化されます。通常のノートブックの保存形式は変わりません。ロック中の暗号化ノートブックを開くには、マスターパスワードが必要です。"
				}
			]
		},
		{
			"ID": "20260907120000-ja00003",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-ja00003",
				"updated": "20260907120000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用前の注意事項"
				}
			]
		},
		{
			"ID": "20260907120000-ja00004",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-ja00004",
				"updated": "20260907120000"
			},
			"Children": [
				{
					"ID": "20260907120000-ja00005",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00005",
						"updated": "20260907120000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00006",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00006",
								"updated": "20260907120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "マスターパスワードは復元できません。忘れた場合、誰もコンテンツを復元できません。"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00007",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00007",
						"updated": "20260907120000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00008",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00008",
								"updated": "20260907120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "キーバックアップはマスターパスワードの代わりにはなりません。復元には通常、対応するキーバックアップとマスターパスワードの両方が必要なため、別々の安全な場所に保管してください。"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00009",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00009",
						"updated": "20260907120000"
					},
					"Children": [
