							"ID": "20260907120000-ja00027",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00027",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "暗号化ノートブックを閉じるとロックされます。最初に未書き込みの編集内容とファイル履歴を保存し、その後、新しいコンテンツアクセスを停止して進行中の処理を待機またはキャンセルし、アプリケーションが管理するキーへのアクセスを無効化してデータベース接続を閉じ、管理対象の平文キャッシュ、一時ファイル、アクセストークンを可能な範囲で消去します"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00028",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00028",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00029",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00029",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "アプリケーションの再起動後、すべての暗号化ノートブックはロック状態になり、マスターパスワードの再入力が必要です"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20260907120000-ja00030",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260907120000-ja00030",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "認証"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "暗号化ノートブック"
				},
				{
					"Type": "NodeText",
					"Data": " で自動ロックまでのアイドル時間（分）を設定できます。現在のワークスペースでの画面操作は、ロック解除されているすべての暗号化ノートブックのタイマーを更新しますが、バックグラウンドの同期やインデックス作成などは自動更新しません。0 に設定すると自動ロックが無効になります。"
				}
			]
		},
		{
			"ID": "20260907120000-ja00031",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20260907120000-ja00031",
				"updated": "20260908150000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "マスターパスワードとキーバックアップ"
				}
			]
		},
		{
			"ID": "20260907120000-ja00032",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-ja00032",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-ja00033",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00033",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00034",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00034",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "すべての暗号化ノートブックで 1 つのマスターパスワードを共有しますが、各ノートブックは独立したデータキーを使用します。1 つをロック解除しても、ほかのノートブックはロック解除されません"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00035",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00035",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00036",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00036",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "マスターパスワードを変更する前に、すべての暗号化ノートブックを閉じる必要があります。変更では各ノートブックのデータキーを再保護するだけで、ドキュメント内容は再暗号化されません。完了後、ワークスペース内のキーバックアップは自動的に更新されますが、新しいキーバックアップもすぐにエクスポートしてください"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-jarev09",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-jarev09",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-jarev10",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-jarev10",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "古いマスターパスワードと、古いキー情報を保持する同期コピー、バックアップ、履歴スナップショットが同時に漏えいすると、同じデータキーを使用する現在の内容を古いパスワードで復号できる可能性があります。古いパスワードの漏えいが疑われる場合は、内容を平文でエクスポートして新しいデータキーを持つ新規暗号化ノートブックへインポートし、移行を確認した後に平文ファイルを安全に削除してください"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00037",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00037",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00038",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00038",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ローカル設定が失われた場合、新しいデバイスで復元する場合、または設定の復元が必要と表示された場合は、キーバックアップをインポートして対応するマスターパスワードを入力します。キーバックアップにマスターパスワードは含まれません"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-jarev11",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
