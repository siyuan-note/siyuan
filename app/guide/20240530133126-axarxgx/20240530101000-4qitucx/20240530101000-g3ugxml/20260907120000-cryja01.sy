							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00047",
								"updated": "20260907120000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ドキュメント履歴と削除済みノートブックの復元は暗号化データに対応していますが、復元には対応するキーバックアップとマスターパスワードが必要です。"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00048",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
