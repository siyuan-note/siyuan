			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "使用前の注意事項"
				}
			]
		},
		{
			"ID": "20260907120000-ja00004",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20260907120000-ja00004",
				"updated": "20260908150000"
			},
			"Children": [
				{
					"ID": "20260907120000-ja00005",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00005",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00006",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00006",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "マスターパスワードは復元できません。忘れた場合、誰もコンテンツを復元できません"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00007",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00007",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00008",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00008",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "キーバックアップはマスターパスワードの代わりにはなりません。復元には通常、対応するキーバックアップとマスターパスワードの両方が必要なため、別々の安全な場所に保管してください"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00009",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260907120000-ja00009",
						"updated": "20260908100000"
					},
					"Children": [
						{
							"ID": "20260907120000-ja00010",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260907120000-ja00010",
								"updated": "20260908100000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "暗号化ノートブックはロック中に最も強く保護されます。ロック解除中は、メインアプリケーションによって許可されたプラグイン、API、MCP ツール、AI エージェントがコンテンツを読み取れます"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-jarev03",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-jarev03",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-jarev04",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-jarev04",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "暗号化が主に保護するのは、ディスク上の永続データと、ロック後にサポート対象の入口からアクセスできない状態です。ノートブック名、ディレクトリ構造、ファイル数とサイズ、更新時刻、アセットの拡張子などのメタデータは引き続き見える場合があります"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-jarev05",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-jarev05",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-jarev06",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-jarev06",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "ロックはアプリケーションが制御できる平文キャッシュと一時ファイルを可能な範囲で消去しますが、OS のスワップ、休止状態ファイル、クラッシュダンプ、ストレージスナップショットに残る一時的なコピーの消去は保証しません。ユーザーがエクスポートしたファイル、クリップボード、スクリーンショット、印刷物は自分で保護する必要があります"
								}
							]
						}
					]
				},
				{
					"ID": "20260908150000-jarev07",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260908150000-jarev07",
						"updated": "20260908150000"
					},
					"Children": [
						{
							"ID": "20260908150000-jarev08",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260908150000-jarev08",
								"updated": "20260908150000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "マスターパスワードの派生には通常約 1 秒かかり、ロック解除時には専用インデックスも再構築されるため、大きなノートブックではさらに時間がかかる場合があります。大きなアセットのアップロードはより多くのメモリを使用し、アセットを表示するたびに復号が必要です"
								}
							]
						}
					]
				}
			]
		},
