							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "データ同期では、暗号化された永続データを保存、転送します。ロック解除状態はほかのデバイスに同期されないため、新しいデバイスでもマスターパスワードが必要です。"
								}
							]
						}
					]
				},
				{
					"ID": "20260907120000-ja00046",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
