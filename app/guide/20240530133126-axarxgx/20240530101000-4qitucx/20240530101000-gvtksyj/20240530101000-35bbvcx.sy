					},
					"Properties": {
						"id": "20260928225427-hbgeetu",
						"updated": "20260928225427"
					},
					"Children": [
						{
							"ID": "20260928225427-e9kqvn5",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260928225427-e9kqvn5",
								"updated": "20260928225427"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "/"
								},
								{
									"Type": "NodeText",
									"Data": " を入力し、"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "横向きスーパーブロック"
								},
								{
									"Type": "NodeText",
									"Data": " または "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "縦向きスーパーブロック"
								},
								{
									"Type": "NodeText",
									"Data": " を選ぶと、空の段落を左右または上下に２つ配置し、最初の段落から入力できます。「columns」で検索しても見つかります。モバイルではキーボードツールバーの挿入パネルからも選べます"
								}
							]
						}
					]
				},
				{
					"ID": "20260928225427-yj8hs5v",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260928225427-yj8hs5v",
						"updated": "20260928225427"
					},
					"Children": [
						{
							"ID": "20260928225427-o90dbbh",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260928225427-o90dbbh",
								"updated": "20260928225427"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "スーパーブロックのブロックアイコンメニューで "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "スーパーブロック"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "現在のスーパーブロックの先頭に列を追加"
								},
								{
									"Type": "NodeText",
									"Data": " または "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "スーパーブロック"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "現在のスーパーブロックの末尾に列を追加"
								},
								{
									"Type": "NodeText",
									"Data": " を選ぶと、横向きレイアウトの先頭または末尾に空の段落を追加できます。縦向きレイアウトでは対応する操作でブロックを追加します。既存の子ブロックの種類や内容は複製しません"
								}
							]
						}
					]
				},
				{
					"ID": "20260928225427-szdbffm",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20260928225427-szdbffm",
						"updated": "20260928225427"
					},
					"Children": [
						{
							"ID": "20260928225427-ddjfwhu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20260928225427-ddjfwhu",
								"updated": "20260928225427"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "縦向きスーパーブロックの直下の子ブロックのメニューで "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "左側に局所的な段組みを作成"
								},
								{
									"Type": "NodeText",
									"Data": " または "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "右側に局所的な段組みを作成"
								},
								{
									"Type": "NodeText",
									"Data": " を選ぶと、そのブロックと新しい空の段落を内側の横向きスーパーブロックにまとめます。他のブロックの配置は維持され、既存の左右への列挿入ショートカットの対象範囲も変わりません"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-gtx9sbs",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
