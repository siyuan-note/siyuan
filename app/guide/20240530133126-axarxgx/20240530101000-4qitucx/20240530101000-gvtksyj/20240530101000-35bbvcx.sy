			]
		},
		{
			"ID": "20260921215916-odykie5",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20260921215916-odykie5",
				"updated": "20261016111305"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "マインドマップブロック"
				}
			]
		},
		{
			"ID": "20260921215248-kduw3ym",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260921215248-kduw3ym",
				"updated": "20260923221935"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "マインドマップブロックは独立したブロックタイプです。箇条書き、番号付きリスト、タスクリストから変換でき、リストに戻すこともできます。変換時には項目の内容、番号、タスクの状態が保持されます。リストとして保存された以前のマインドマップは、文書を編集用に開いたときに更新されます。"
				}
			]
		},
		{
			"ID": "20261016111305-5075456",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261016111305-5075456",
				"updated": "20261016111305"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "マインドマップブロックには、マインドマップ項目ブロックのみを格納できます。各項目は独自のブロック ID を持ち、通常のコンテンツブロックや入れ子のマインドマップを格納できますが、リストブロック、リスト項目ブロック、別のマインドマップ項目ブロックを直接格納することはできません。"
				}
			]
		},
		{
			"ID": "20261012014537-okp6gop",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261012014537-okp6gop",
				"updated": "20261012014859"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "詳しくは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-1ev7xub",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "マインドマップブロック"
				},
				{
					"Type": "NodeText",
					"Data": " を参照してください。"
				}
			]
		},
		{
			"ID": "20240530101000-y5kx7kx",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20240530101000-y5kx7kx",
