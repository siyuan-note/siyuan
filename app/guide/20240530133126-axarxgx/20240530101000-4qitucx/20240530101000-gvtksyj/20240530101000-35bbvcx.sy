					},
					"Children": [
						{
							"ID": "20240530101000-znnyg92",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20240530101000-znnyg92",
								"updated": "20261016202856"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Markdown の仕様では HTML ブロックの解析ルールが複雑なため、HTML コード全体を "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "&lt;div&gt;&lt;/div&gt;"
								},
								{
									"Type": "NodeText",
									"Data": "​ で囲み、空の行は削除することを推奨します"
								}
							]
						}
					]
				}
			]
		},
