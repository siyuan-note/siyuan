				"updated": "20261016111305"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## ",
					"Properties": {
						"id": ""
					}
				},
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックのメタタイプ",
					"Properties": {
						"id": ""
					}
				}
			]
		},
		{
			"ID": "20240530101000-jfogj0f",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-fcrdpb7",
				"id": "20240530101000-jfogj0f",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックは、論理的にリーフブロックとコンテナブロックに分けられます。リーフブロックは他のブロックを含めず、コンテナブロックは他のブロックを含めることができます:"
				}
			]
		},
