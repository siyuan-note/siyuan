			"Properties": {
				"ID": "20240530101000-vz4sede",
				"id": "20240530101000-9pt3z47",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ドキュメントブロックは",
					"Properties": {
						"id": ""
					}
				},
				{
					"Type": "NodeTextMark",
					"Properties": {
						"id": ""
					},
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-yy3nfa8",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "コンテナブロック"
				},
				{
					"Type": "NodeText",
					"Data": "の一種です。",
					"Properties": {
						"id": ""
					}
				}
			]
		},
		{
			"ID": "20261023112115-4rumyue",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261023112115-4rumyue",
				"updated": "20261023133001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ドキュメントタイトルでは、設定の切り替えなしに半角スラッシュ / を使用できます。例えば A/B は 1 つのドキュメントのタイトルにでき、A の中にある子ドキュメント B とは別です。既存のタイトルとドキュメントリンクは変わらず、／ と %2F も元の文字のまま扱われます。"
				}
			]
		},
		{
			"ID": "20261023112115-31enzcv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261023112115-31enzcv",
				"updated": "20261023112115"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表示パスは閲覧用です。特定のドキュメントに移動するには、ドキュメントリンクまたはブロック参照を使用してください。タイトルのパスを分割してドキュメントを探すプラグインは、構造化されたアドレス指定に対応する必要があります。"
				}
			]
		},
		{
			"ID": "20261023112115-sb4a5iu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261023112115-sb4a5iu",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "新しいバージョンでワークスペースを開く前に、すべての端末で古いバージョンの SiYuan を終了し、同じワークスペースにアクセスする端末やそのデータを同期する端末をすべて、新しいタイトル形式に対応したバージョンに更新してください。プラグインの互換性も確認し、全端末の更新が完了するまでワークスペースを開いたり同期を再開したりしないでください。"
				}
			]
		},
		{
			"ID": "20261024161816-m6s4xpz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-m6s4xpz",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "一時的にオフラインになっている端末も、これらのデータへのアクセスや同期の前に更新が必要です。移行は自動で行われ、中断後も復旧を継続します。更新後は、古いバージョンで同じデータを開いたり、編集・復元・同期したりしないでください。古いバージョンは新しいタイトル形式（Spec 6）のドキュメントを開けなくても、旧形式のままのドキュメントを読み書きできる場合があります。"
				}
			]
		},
		{
			"ID": "20261024161816-3e18e9a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-3e18e9a",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "また、すでに開いていた画面に残る古い編集内容を書き戻し、新しいタイトルや内容を上書きして、その結果をほかの端末へ同期するおそれがあります。一部のドキュメントが開けないことは、データが保護されているという意味ではありません。"
				}
			]
		},
		{
			"ID": "20261024163013-ah0zz8v",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-ah0zz8v",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタムブロック"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261024163013-zhe5fk6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163013-zhe5fk6",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタムブロックの表示や操作は、対応する"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-8m2dowc",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "プラグイン"
				},
				{
					"Type": "NodeText",
					"Data": "が提供します。利用するにはインストールして有効にしてください。プラグインが利用できない場合や、その環境で描画できない場合は、保存済みの元の内容が表示されます。プラグインを無効にしても、その内容は自動では削除されません。"
				}
			]
		},
		{
			"ID": "20240530101000-yy3nfa8",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-f8xitg4",
