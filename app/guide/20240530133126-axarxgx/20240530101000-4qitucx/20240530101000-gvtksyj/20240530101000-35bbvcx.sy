		{
			"ID": "20240818180047-zgu22l5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240818180047-zgu22l5",
				"updated": "20240818180047"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "テーブルブロックで "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "|"
				},
				{
					"Type": "NodeText",
					"Data": "​ を使用する必要がある場合は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
					"Data": "​ でエスケープしてください。つまり、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\|"
				},
				{
					"Type": "NodeText",
					"Data": "​ を入力する必要があります。"
				}
			]
		},
		{
			"ID": "20240818180047-hluqmta",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240818180047-hluqmta",
				"updated": "20260222162348"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セル内に改行を追加するには、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "​ + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": "​ を使用します。"
				}
			]
		},
		{
			"ID": "20260222161957-z5l9kwc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260222161957-z5l9kwc",
				"updated": "20261024162311"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "結合セルや複数行のヘッダーを含むテーブルは、構造を保持するため、コピーやエクスポートした Markdown 内で HTML テーブルとして表現されます。"
				}
			]
		},
		{
			"ID": "20261017142635-kll3m6b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017142635-kll3m6b",
				"updated": "20261017170001"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "モバイル端末ではセルをタップして文字を編集できます。編集中ではないセルを長押しするか、キーボードツールバーのブロックメニューを使うと、セル範囲の選択に入ります。選択範囲の両端のハンドルをドラッグして範囲を変更でき、画面の端までドラッグすると表が自動的にスクロールします。セル内をスワイプするとスクロールします。文字の編集中は、長押しで文字を選択できます。"
				}
			]
		},
		{
			"ID": "20261017142635-udb0p1z",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017142635-udb0p1z",
				"updated": "20261017174053"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "セルをタップすると、その行と列の枠線上に青いドットのハンドルが表示されます。列の上または行の左にあるハンドルをタップすると、列全体または行全体を選択できます。上部ツールバーで複数選択を有効にすると、離れたセル、行、列をタップして選択に追加したり、選択から外したりできます。「詳細」からセルの結合、スタイルや配置の設定、選択した行や列の一括操作を行えます。「閉じる」をタップすると選択を終了します。"
				}
			]
		},
		{
			"ID": "20261017142635-99sm3ym",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261017142635-99sm3ym",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "任意の行にある列の区切り線をタップすると強調表示されます。強調表示された線を横にドラッグして列幅を変更できます。縦にスワイプすると表がスクロールし、線の外をタップすると調整を終了します。列を選択して「詳細」を開くと、内容に合わせて列幅を自動調整したり、均等に配分したりできます。"
				}
			]
		},
		{
			"ID": "20261024164212-c08x4vc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-c08x4vc",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表の端のプラスボタンをタップすると行や列を追加できます。端のコントロールをドラッグすると複数の行や列を追加したり、末尾の空の行や列を削除したりできます。表を縮めても、内容のあるセルや結合セルは保持されます。"
				}
			]
		},
