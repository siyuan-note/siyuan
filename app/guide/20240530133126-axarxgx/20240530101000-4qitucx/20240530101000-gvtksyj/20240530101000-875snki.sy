		{
			"ID": "20261012014537-f0itvsm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261012014537-f0itvsm",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "属性パネルでは、エイリアスが個別のチップとして表示されます。「エイリアスを追加」で追加し、既存のエイリアスをクリックして編集し、閉じるアイコンで削除できます。半角カンマで区切ると、複数のエイリアスをまとめて追加できます。"
				}
			]
		},
		{
			"ID": "20261024163828-makfsjk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-makfsjk",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " キーを押すか入力欄からフォーカスを移すと保存され、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " キーで今回の入力を取り消せます。新しい入力では、前後の空白、空の項目、完全に一致する重複項目が除去されます。"
				}
			]
		},
		{
			"ID": "20261024163828-6mp36pl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024163828-6mp36pl",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "エイリアスをドラッグして順序を変更でき、離すと保存されます。タッチスクリーンでもドラッグできます。ドラッグ中に "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " キーを押すと並べ替えを取り消せます。"
				}
			]
		},
		{
			"ID": "20240530101000-41pnskz",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-i0jnklc",
				"id": "20240530101000-41pnskz",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタム属性"
				}
			]
		},
		{
			"ID": "20240530101000-qc6ciit",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240530101000-qc6ciit",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ブロックメニュー"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "属性"
				},
				{
					"Type": "NodeText",
					"Data": " でカスタム属性を設定します。属性名は英小文字で始め、英小文字、数字、ハイフン（-）を使えます。例は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "doing"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "day1"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "project-id"
				},
				{
					"Type": "NodeText",
					"Data": " です。英大文字は小文字に変換されます。保存時に、組み込み属性と区別するための "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "custom-"
				},
				{
					"Type": "NodeText",
					"Data": " 接頭辞が自動で付きます。"
				}
			]
		},
		{
			"ID": "20240530101000-st9ddhf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-8f6g4da",
				"id": "20240530101000-st9ddhf",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "属性に基づいたコンテンツブロックのクエリ"
				}
			]
		},
		{
			"ID": "20240530101000-u0w998w",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-kk2mm9o",
				"id": "20240530101000-u0w998w",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "たとえば、コンテンツブロックに "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "progress=30"
				},
				{
					"Type": "NodeText",
					"Data": "​ と "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "priority=2"
				},
				{
					"Type": "NodeText",
					"Data": "​ という属性が設定されている場合、SQL クエリで進捗度が 30 で優先度が 2 のコンテンツブロックをすべて抽出できます:"
				}
			]
		},
		{
			"ID": "20240530101000-pxon2dr",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"ID": "20240530101000-a3mtczr",
				"id": "20240530101000-pxon2dr",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"ID": "20240530101000-j4r5epe",
					"Type": "NodeCodeBlockCode",
					"Data": "SELECT *\nFROM blocks\nWHERE id IN (\n    SELECT block_id\n    FROM attributes AS a\n    WHERE (a.name ='custom-progress' AND a.value = '30')\n       OR (a.name ='custom-priority' AND a.value = '2')\n    GROUP BY block_id\n    HAVING count(block_id) = 2\n);\n",
					"Properties": {
						"ID": "20240530101000-db431ob",
						"id": "20240530101000-j4r5epe"
					}
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		}
	]
}
