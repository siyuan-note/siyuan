{
	"ID": "20240530101000-96n5y9v",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"ID": "20240530101000-h59t8rn",
		"id": "20240530101000-96n5y9v",
		"title": "コンテンツブロックの紹介",
		"type": "doc",
		"updated": "20261024160716"
	},
	"Children": [
		{
			"ID": "20240530101000-6twvrmm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-dtkix1p",
				"id": "20240530101000-6twvrmm",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックの定義"
				}
			]
		},
		{
			"ID": "20240530101000-jysl0s6",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-8hhg459",
				"id": "20240530101000-jysl0s6",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックは、SiYuan で個別に編集、参照、整理できるコンテンツの単位です。各ブロックには、プログラムが自動生成する一意の ID があります。たとえば "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "20200825000000-a1b2c3d"
				},
				{
					"Type": "NodeText",
					"Data": " は、14 桁のタイムスタンプ（"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "YYYYMMDDHHMMSS"
				},
				{
					"Type": "NodeText",
					"Data": "）、ハイフン、7 文字のランダムな英小文字または数字で構成されます。"
				}
			]
		},
		{
			"ID": "20240530101000-abjdtfa",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-at8899i",
				"id": "20240530101000-abjdtfa",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックの種類"
				}
			]
		},
		{
			"ID": "20240530101000-r951ojk",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-yvxmi71",
				"id": "20240530101000-r951ojk",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "最も一般的なブロックは、本文を書くための段落です。各段落は独立したブロックなので、個別に移動したり、属性を設定したり、別の場所から参照したりできます。"
				}
			]
		},
		{
			"ID": "20240530101000-zacsv9a",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-tgz6wto",
				"id": "20240530101000-zacsv9a",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "見出し、リスト、テーブル、引用などのブロックは、それぞれ異なる構造を表します。見出しは章や節を区切り、順序なしリストは関連する項目をまとめ、順序付きリストは手順や順序を示します。適切な種類を選ぶと、見た目だけでなく内容の関係も伝わりやすくなります。"
				}
			]
		},
		{
			"ID": "20240530101000-oo64kii",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-ny42ldg",
				"id": "20240530101000-oo64kii",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "各種類の特徴と包含規則は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-35bbvcx",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "コンテンツブロックの種類"
				},
				{
					"Type": "NodeText",
					"Data": "を参照してください。"
				}
			]
		},
		{
			"ID": "20240530101000-qqf6y4r",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-7b4udkk",
				"id": "20240530101000-qqf6y4r",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックの組み合わせ"
				}
			]
		},
		{
			"ID": "20240530101000-m226k80",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-wu8n3rj",
				"id": "20240530101000-m226k80",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ドキュメントは複数のブロックで構成されます。リストや引用など、ほかのブロックを含められる種類をコンテナブロックと呼びます。"
				}
			]
		},
		{
			"ID": "20240530101000-m8ovgeq",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-zb3qw5d",
				"id": "20240530101000-m8ovgeq",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ドキュメント自体もブロックです。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-uxno1yp",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "ブロック参照"
				},
				{
					"Type": "NodeText",
					"Data": "を使えば、ドキュメント全体にも個々の段落にもリンクできます。段落を参照するために、別のドキュメントへ切り分ける必要はありません。"
				}
			]
		},
		{
			"ID": "20240530101000-48s3dyy",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-8pqai5f",
				"id": "20240530101000-48s3dyy",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "名前、エイリアス、メモ"
				}
			]
		},
		{
			"ID": "20240530101000-387o7xk",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-5va6t1x",
				"id": "20240530101000-387o7xk",
				"memo": "メモは通常短い一文です",
				"updated": "20261024160716"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ブロックには名前、エイリアス、メモを設定できます。名前とエイリアスは"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-b39286y",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "バックリンクのメンション"
				},
				{
					"Type": "NodeText",
					"Data": "検索に使われ、メモには本文に表示しない補足情報を記録できます。"
				}
			]
		},
		{
			"ID": "20240530101000-m064mpu",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-vh9kuvt",
				"id": "20240530101000-m064mpu",
				"updated": "20261016013311"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": ""
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "動作"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "コンテンツブロックのコーナーアイコン"
				},
				{
					"Type": "NodeText",
					"Data": " を有効にすると、名前、エイリアス、メモがエディタに表示されます。ドキュメントブロックに名前またはメモを設定すると、ドキュメントツリーでそのドキュメントにマウスカーソルを合わせて確認できます。"
				}
			]
		},
		{
			"ID": "20240530101000-gnopzk9",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-qvn6ih2",
				"id": "20240530101000-gnopzk9",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20240530101000-1vvnhju",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "埋め込みコンテンツブロック"
				},
				{
					"Type": "NodeText",
					"Data": "を使用すると、名前とメモを検索して要約できます。以下は、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "短い"
				},
				{
					"Type": "NodeText",
					"Data": "​ というキーワードを含むメモを持つコンテンツブロックをリストする例です:"
				}
			]
		},
		{
			"ID": "20240530101000-jpeddkv",
			"Type": "NodeBlockQueryEmbed",
			"Properties": {
				"id": "20240530101000-jpeddkv",
				"style": "height: 64px;",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeOpenBrace"
				},
				{
					"Type": "NodeOpenBrace"
				},
				{
					"Type": "NodeBlockQueryEmbedScript",
					"Data": "SELECT * FROM blocks WHERE memo LIKE '%短い%'"
				},
				{
					"Type": "NodeCloseBrace"
				},
				{
					"Type": "NodeCloseBrace"
				}
			]
		},
		{
			"ID": "20240530101000-194ws7l",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-ffge784",
