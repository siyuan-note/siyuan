									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "バックリンク"
								},
								{
									"Type": "NodeText",
									"Data": ": 現在のコンテンツブロックをリンク (参照) している他のコンテンツブロック"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20240530101000-zxan094",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-g3aca9j",
				"id": "20240530101000-zxan094",
				"updated": "20261024163828"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "フォワードリンクは現在の内容に直接表示されます。バックリンクでは、現在のブロックをどの内容が参照しているかを確認できます。次の 2 通りの方法で関係を調べられます。"
				}
			]
		},
		{
			"ID": "20240530101000-hs9esji",
