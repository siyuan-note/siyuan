								},
								{
									"Type": "NodeText",
									"Data": ": 現在のコンテンツブロックのバックリンクと逆参照を一覧表示する"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261022133332-0jxmx6d",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261022133332-0jxmx6d",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データベースのフィールドでバックリンクを絞り込む"
				}
			]
		},
		{
			"ID": "20261022133332-do55tkp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022133332-do55tkp",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "バックリンクパネルまたは下部のバックリンクで "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "バックリンク元を絞り込む"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "データベースのフィールド"
				},
				{
					"Type": "NodeText",
					"Data": " を開き、参照元ブロックが登録されているデータベースを選択して、フィールド条件を組み合わせます。選択したデータベースにバインドされ、条件を満たす参照元のみが表示されます。"
				}
			]
		},
		{
			"ID": "20261024164212-bvzggba",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-bvzggba",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "フィールド条件を設定しない場合は、そのデータベースにバインドされた参照元がすべて表示されます。データベースの元のビューのフィルタやメンションは変更されません。デスクトップ版とモバイル版の両方で利用できます。"
				}
			]
		},
		{
			"ID": "20261022133332-68vgkre",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261022133332-68vgkre",
				"updated": "20261022133332"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "データベースのメニューで "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "リセット"
				},
				{
					"Type": "NodeText",
					"Data": " を選択すると、データベースの条件だけを解除できます。他の参照元フィルタは保持されます。"
				}
			]
		},
		{
			"ID": "20240530101000-k5rp4xa",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-j9s9jy7",
				"id": "20240530101000-k5rp4xa",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "アンカーテキスト"
				}
			]
		},
		{
			"ID": "20240530101000-xxnblmf",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-6ierqnl",
				"id": "20240530101000-xxnblmf",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "アンカーテキストとは、参照をレンダリングした際に表示されるテキストで、静的アンカーテキストと動的アンカーテキストの 2 種類があります:"
				}
			]
		},
		{
			"ID": "20240530101000-1g2xgik",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"ID": "20240530101000-8aawvbp",
