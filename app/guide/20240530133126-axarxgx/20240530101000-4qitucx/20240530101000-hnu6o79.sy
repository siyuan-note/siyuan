		},
		{
			"ID": "20260920102915-j2vppoi",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260920102915-j2vppoi",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スペルチェック"
				}
			]
		},
		{
			"ID": "20260920102915-bqpxzto",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-bqpxzto",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "この機能は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "スペルチェック"
				},
				{
					"Type": "NodeText",
					"Data": " で有効にできます。スペルミスのある単語には波線が表示されます。"
				}
			]
		},
		{
			"ID": "20260920102915-bwh61nt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-bwh61nt",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップ版：波線のある単語を右クリックし、思源のメニューから修正候補を選択します。正しい単語を辞書に追加することもできます。通常の右クリックを使用し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " キーを押す必要はありません。"
				}
			]
		},
		{
			"ID": "20260920102915-jffww3e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-jffww3e",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ブラウザ版：ブラウザの設定でスペルチェックを有効にし、チェックする言語を選択してください。Chrome では、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " キーを押しながら波線のある単語を右クリックすると、ブラウザ標準のスペル修正メニューが開きます。"
				}
			]
		},
		{
			"ID": "20260920102915-5z2g0ww",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260920102915-5z2g0ww",
				"updated": "20260920102915"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スペルチェックが始まるタイミングは実行環境によって異なります。ドキュメントを開いてカーソル位置が復元されても、波線が表示されるまで本文をクリックして少し待つ必要がある場合があります。"
				}
			]
		},
		{
			"ID": "20260928091724-dfq9c2s",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260928091724-dfq9c2s",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "スラッシュメニューとツールバーの設定"
				}
			]
		},
		{
			"ID": "20260927164841-exxixvw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927164841-exxixvw",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "モバイルでは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "スタイル"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "メニューとボタンの表示と順序"
				},
				{
					"Type": "NodeText",
					"Data": " を開き、カスタムプロファイルを編集してスラッシュメニューの分類を選択します。モバイルとデスクトップは、有効・無効、候補の表示・非表示、順序を同じプロファイル設定で管理します。"
				}
			]
		},
		{
			"ID": "20261024164212-qb4c8nq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024164212-qb4c8nq",
				"updated": "20261024164212"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "初期値はデスクトップでは有効、モバイルでは無効です。スイッチを有効にして確認・保存し、そのプロファイルを有効にすると、/ を入力してコンテンツブロックを検索でき、候補を選択すると元のカーソル位置に挿入されます。"
				}
			]
		},
		{
			"ID": "20261024163013-4f7o94j",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261024163013-4f7o94j",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "プロファイルの編集と保存"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20260927164841-2wtv9yz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260927164841-2wtv9yz",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "カスタムプロファイルでは、分類の選択欄でツールバーとスラッシュメニューを切り替えます。項目の左側にある6つの点のハンドルをドラッグして順序を変更し、スイッチで表示・非表示を設定します。リストの端までドラッグするとスクロールします。並べ替える前に検索欄を空にし、変更後は確認してプロファイルを保存します。"
				}
			]
		},
		{
			"ID": "20261024161816-acdt21p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-acdt21p",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "組み込みプロファイルは読み取り専用です。複製してカスタマイズし、保存したプロファイルを有効にしてください。プロファイルはこの端末に保存され、端末間では同期されません。シンプルまたは完全を基に作成した新しいカスタムプロファイルでは、変更していない項目の表示・非表示は今後のバージョンの初期値に従います。"
				}
			]
		},
		{
			"ID": "20261024161816-mctgcb0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-mctgcb0",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "手動で切り替えた項目は、その選択を維持します。既存のプロファイルは従来の表示動作を維持し、複製または現在の設定を基に作成する場合は、継承方法と明示的な選択を引き継ぎます。シンプルまたは完全を基に作成した新しいプロファイルでは、カスタマイズしていない階層の並び順はバージョンごとの初期順序に従います。"
				}
			]
		},
		{
			"ID": "20261024161816-430o9r7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-430o9r7",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "現在の設定を基に作成する場合や複製する場合は、既存のカスタム順序を引き継ぎます。検索欄を空にし、列またはドックグループの見出しにあるリセットアイコンを押すと、その階層をリセットできます。全階層をリセットするには、デスクトップでは「位置」列の見出し右側にある更新アイコン（「すべての並び順をリセット」）、モバイルでは下部の「すべての並び順をリセット」ボタンを押します。"
				}
			]
		},
		{
			"ID": "20261024161816-370nwqi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261024161816-370nwqi",
				"updated": "20261024161816"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "確認すると保存され、キャンセルすると変更を破棄します。並び順のリセットでは表示設定とドック項目の配置場所は維持され、リセットした階層は今後の初期順序の変更にも従います。"
				}
			]
		},
		{
			"ID": "20261020212341-qz5a74f",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261020212341-qz5a74f",
				"updated": "20261020212341"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "文書末尾のバックリンク"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261020212341-41di2j5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261020212341-41di2j5",
				"updated": "20261020212341"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "デスクトップとモバイルの両方で "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "双方向リンク"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "文書の下部にバックリンクパネルを表示"
				},
				{
					"Type": "NodeText",
					"Data": " を有効にすると、文書末尾にバックリンクとメンションを表示できます。パネルに近づくと読み込まれます。本文の末尾が読み込まれた後に表示され、結果がない場合は非表示になります。"
				}
			]
		}
	]
}
