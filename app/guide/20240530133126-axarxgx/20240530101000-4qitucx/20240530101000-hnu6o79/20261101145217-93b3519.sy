{
	"ID": "20261101145217-93b3519",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"id": "20261101145217-93b3519",
		"title": "独立した Markdown エディタ",
		"type": "doc",
		"updated": "20261103203708"
	},
	"Children": [
		{
			"ID": "20261101145217-50f3785",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261101145217-50f3785",
				"updated": "20261102140531"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "開いて編集する"
				}
			]
		},
		{
			"ID": "20261101145217-4305c24",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-4305c24",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Windows、macOS、Linux のデスクトップ版では、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "メインメニュー"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Markdown エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " から独立したウィンドウを開けます。ワークスペースを開いたり、ローカルカーネルを起動したりする必要はありません。"
				}
			]
		},
		{
			"ID": "20261101153939-adaf2b3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101153939-adaf2b3",
				"updated": "20261101153939"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Android、iOS、HarmonyOS のモバイル版では、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "メインメニュー"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Markdown エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " から独立した編集画面を開けます。システムのファイル管理アプリに Markdown ファイルの「プログラムから開く」がある場合は、思源を選択することもできます。文書へのアクセス権はシステムの選択画面から取得します。一時的な権限しか付与しないファイルプロバイダーでは、再起動後にファイルを選び直す必要があります。"
				}
			]
		},
		{
			"ID": "20261101154840-d38034b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101154840-d38034b",
				"updated": "20261102172500"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ウィンドウ名には現在のファイル名を表示し、未保存の新規文書には「無題ドキュメント」を表示します。タイトル行にはファイルパネルボタン、ファイル名、元に戻す、やり直し、および "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " メニューを表示します。本文の書式ツールバーは表示せず、デスクトップではタイトルバーを統合したウィンドウを使用します。新規作成、開く、保存、名前を付けて保存、編集モード、画像の挿入、リソースの許可、下書きの復元、テーマ、文字サイズはこのメニューにまとめています。ステータスバーの操作は必要なときだけ表示します。デスクトップでは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl+Shift+I"
				},
				{
					"Type": "NodeText",
					"Data": " で開発者ツールを開閉します。macOS では "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Cmd+Alt+I"
				},
				{
					"Type": "NodeText",
					"Data": " を使用します。"
				}
			]
		},
		{
			"ID": "20261102172700-0pi7ezr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261102172700-0pi7ezr",
				"updated": "20261102172700"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ローカルワークスペースの通常の Markdown リソースリンクでは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "開く"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "内蔵 Markdown エディターで開く"
				},
				{
					"Type": "NodeText",
					"Data": " メニューから元のリソースファイルを直接編集できます。リモートワークスペース、暗号化ノートブックのリソース、外部ファイルリンクにはこの項目を表示しません。リモートのパスや復号された一時コピーを元のファイルとして編集しないためです。"
				}
			]
		},
		{
			"ID": "20261101145217-eb6880e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-eb6880e",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "このエディタは通常の UTF-8 の .md と .markdown ファイルを直接編集します。ノートブックへのインポート、.sy 文書への変換、ワークスペースの検索・ブロック参照・同期への追加は行いません。"
				}
			]
		},
		{
			"ID": "20261101145217-69a5cf7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-69a5cf7",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ファイル関連付けに対応したデスクトップパッケージをインストールすると、システムの「プログラムから開く」で思源を選べます。候補を追加するだけで、既存の既定アプリは変更しません。デスクトップ実行ファイルに --markdown を渡すと空の文書を、--markdown=\"ファイルのパス.md\" を渡すと指定ファイルを開けます。エディタ内の "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "開く"
				},
				{
					"Type": "NodeText",
					"Data": " や Markdown ファイルのドロップも使用できます。別の編集ウィンドウが使用中のファイルを開くと、そのウィンドウに切り替わります。"
				}
			]
		},
		{
			"ID": "20261101145217-a6f4517",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-a6f4517",
				"updated": "20261101171827"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "編集モード"
				},
				{
					"Type": "NodeText",
					"Data": " から即時レンダリング、WYSIWYG、分割プレビューを選べます。現在のモードにはチェックが付きます。モードを切り替えるだけでは保存しません。実際の編集では内容を保ちながら Markdown の書式が整理される場合があります。テーマと文字サイズも "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "スタイル"
				},
				{
					"Type": "NodeText",
					"Data": " の同様のチェック付きサブメニューで選び、ワークスペースとは別に保存します。"
				}
			]
		},
		{
			"ID": "20261101171827-75ca5fd",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261101171827-75ca5fd",
				"updated": "20261102140531"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown ファイルを参照する"
				}
			]
		},
		{
			"ID": "20261101171827-98304f4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101171827-98304f4",
				"updated": "20261102140531"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "A.md を開くと、そのファイルがあるフォルダーをファイルツリーの既定のルートにします。ツリーには実際のフォルダーと .md、.markdown ファイルを表示し、フォルダーを展開したときに内容を読み込みます。フォルダーを先に並べ、名前は自然順で並べます。たとえば file2.md は file10.md より前に表示します。フォルダーの展開と折りたたみには滑らかなアニメーションを使用し、システムの動きを減らす設定に従います。空のフォルダーにはプレースホルダーの子行を表示しません。"
				}
			]
		},
		{
			"ID": "20261101171827-ef6d43b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101171827-ef6d43b",
				"updated": "20261102172500"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "左上のファイルパネルボタンで、デスクトップのサイドバーやモバイルのファイルドロワーを開閉できます。ファイル名でパネルを切り替えられるのは、モバイルまたは画面幅が狭い場合のドロワーレイアウトだけです。デスクトップのサイドバーレイアウトでは、ファイル名はクリック操作の対象になりません。デスクトップでは境界線をドラッグして幅を調整できます。モバイルのファイルプロバイダーが単一ファイルへのアクセスだけを許可した場合は、案内に従ってそのファイルがあるフォルダーを選び、ツリーを有効にしてください。フォルダーの許可をキャンセルしても、現在の文書の編集には影響しません。ツリーへのアクセス許可でローカル画像へのアクセスは許可されません。"
				}
			]
		},
		{
			"ID": "20261101171827-efa0c2b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101171827-efa0c2b",
				"updated": "20261101171827"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ファイルを一度クリックすると、同じ編集画面内で切り替えます。先に対象ファイルを確認し、保存または復元用下書きの保持によって現在の文書を保護します。キャンセルすると現在の文書にとどまります。ルート内での切り替えではルートを維持します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "フォルダーを開く"
				},
				{
					"Type": "NodeText",
					"Data": " から文書を変更せずに参照先のルートを選び直せます。現在の文書が選んだルートの外にあっても、その選択を維持します。「名前を付けて保存」の保存先がルート内ならルートを維持し、外なら新しいファイルの親フォルダーに切り替えます。"
				}
			]
		},
		{
			"ID": "20261101171827-7e0e1ef",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101171827-7e0e1ef",
				"updated": "20261101171827"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "フォルダーの展開状態とデスクトップパネルの幅を記憶します。ディレクトリの変更やエディタへのフォーカス復帰時にツリーを更新します。項目が多すぎる場合は、より小さいフォルダーを選んでください。このパネルはファイルの参照用で、名前の変更、削除、ドラッグによる整理は行いません。"
				}
			]
		},
		{
			"ID": "20261101145217-6ef3118",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261101145217-6ef3118",
				"updated": "20261101174206"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "保存と競合の解決"
				}
			]
		},
		{
			"ID": "20261101145217-2eb1090",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-2eb1090",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "書き込み可能なファイルは入力が止まると自動保存します。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "保存"
				},
				{
					"Type": "NodeText",
					"Data": " はすぐに保存を要求し、新規文書では最初に保存先を選びます。ステータスバーには保存済み、未保存、競合、失敗を区別して表示します。保存済みの表示だけが、対象ファイルの内容を確認できた状態を示します。"
				}
			]
		},
		{
			"ID": "20261101153939-f0b0125",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101153939-f0b0125",
				"updated": "20261101174206"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Android の「名前を付けて保存」では、システムのファイル選択画面で保存場所とファイル名を選びます。iOS と HarmonyOS では保存先フォルダーを選んでからファイル名を入力します。保存に成功すると「ファイルに保存済み」と表示します。クラウド同期は利用するクラウドストレージ側で管理します。アプリがバックグラウンドに移ると、確定済みの最新入力と保存待ちの変更の保存を試みます。システムがプロセスを終了した場合は、既に保存された内容だけを復元できます。iOS の Markdown 画面とワークスペースは同じアプリプロセスを使用するため、プロセスのクラッシュや終了は両方に影響します。"
				}
			]
		},
		{
			"ID": "20261101145217-cfb63ed",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-cfb63ed",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "他のアプリがファイルを変更した場合、ローカルの編集がなければ再読み込みできます。編集済み、または保存処理中の場合は自動書き戻しを停止します。内容を確認してから、再読み込み、明示的な上書き確認、名前を付けて保存を選んでください。権限の喪失、ファイルの削除、書き込み結果の不確定時も停止します。提示された操作に応じて再試行または名前を付けて保存を使用してください。再読み込み結果が読み取り中の新しい入力を置き換えることはありません。"
				}
			]
		},
		{
			"ID": "20261101145217-2b87ec2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-2b87ec2",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "名前を付けて保存では、書き込み前に保存先を確保し、保存成功を確認してから現在のセッションを切り替えます。別の編集ウィンドウが使用中の保存先を直接上書きできません。別のフォルダーに保存しても相対リソースリンクを維持し、リソースは自動コピーしません。表示される注意を確認し、必要に応じてリソースの移動やリンクの変更を行ってください。"
				}
			]
		},
		{
			"ID": "20261101145217-4901f26",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-4901f26",
				"updated": "20261101175356"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "保存時は元の UTF-8 BOM と選択された改行方式を維持します。複数の改行方式が混在するファイルは、最初の実際の編集で統一される場合があります。開く、表示する、モードを切り替える操作だけでは原本を書き換えません。未対応の文字コードや 8 MiB を超えるファイルは、変更せずに拒否します。"
				}
			]
		},
		{
			"ID": "20261101145217-93451cb",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261101145217-93451cb",
				"updated": "20261103141758"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "画像とプレビュー"
				}
			]
		},
		{
			"ID": "20261101145217-506dee6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-506dee6",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "画像を挿入する前に Markdown 文書を保存し、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "画像を挿入"
				},
				{
					"Type": "NodeText",
					"Data": " から元の画像と新しい保存先ファイルを選択してください。コピーの成功を確認してから相対参照を挿入します。既存の画像は上書きせず、別ドライブの保存先には対応しません。この操作は選択した画像だけを許可し、フォルダー全体へのアクセスを許可するものではありません。 Android では元の画像を選び、必要に応じて Markdown 文書の親フォルダーを許可してから、そのフォルダー内で未使用のファイル名を入力します。挿入した画像には個別のプレビュー権限を付与します。"
				}
			]
		},
		{
			"ID": "20261101145217-18724c4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-18724c4",
				"updated": "20261101145217"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "リソースフォルダーへのアクセスを許可"
				},
				{
					"Type": "NodeText",
					"Data": " から、相対パスで参照する画像のローカルフォルダーを選択します。明示的に許可したフォルダー内の対応画像だけを表示します。画像がない場合や許可されていない場合は、元の Markdown 参照を残し、リソースを利用できないことを通知します。一時的なプレビュー用アドレスを本文に保存することはありません。フォルダーの許可は現在の編集セッションに限られます。 Android では Markdown 文書の直接の親フォルダーを選びます。そのフォルダーと配下のサブフォルダーにある対応画像を表示できますが、.. を含む親ディレクトリへの参照は利用できません。"
				}
			]
		},
		{
			"ID": "20261101145217-0744eab",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-0744eab",
				"updated": "20261103141758"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "HTTP と HTTPS のネットワーク画像は、SVG バッジを含め、フォルダーの許可なしで直接表示します。プロトコル相対の画像 URL には HTTPS を使用します。画像を読み込んでも Markdown 内の元のリンクは変更しません。音声、動画、埋め込みページ、スクリプト、リモート図表サービスは引き続きブロックします。通常の HTTP、HTTPS、メールのリンクはクリック後にだけシステムで開きます。数式にはローカルリソースを使用し、動的な図表のソースはコードとして表示します。"
				}
			]
		},
		{
			"ID": "20261101145217-3c74ec0",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261101145217-3c74ec0",
				"updated": "20261103203708"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ローカル復元とプライバシー"
				}
			]
		},
		{
			"ID": "20261101145217-04fadf3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-04fadf3",
				"updated": "20261101162448"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "新規作成後、一度も編集していない空白の文書は、確認なしで閉じられ、復元用下書きも作成しません。編集後に本文をすべて削除した場合を含む未保存の変更、内容のあるコピー、復元した下書きは、引き続き復元と終了時の保護の対象です。これらの文書を閉じる際に保存に失敗した場合やファイル名が未設定の場合は、復元可能な下書きを保持する、名前を付けて保存する、閉じる操作をキャンセルする、のいずれかを選べます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "詳細"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "下書きを復元"
				},
				{
					"Type": "NodeText",
					"Data": " から記録を確認して復元できます。復元時に原本を無断で上書きしません。"
				}
			]
		},
		{
			"ID": "20261101145217-c2b7b8f",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-c2b7b8f",
				"updated": "20261101153939"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "復元用下書きは、ワークスペース外にある Markdown エディタ専用のディレクトリに、この端末上で暗号化せず保存します。暗号化ノートブックの保護対象ではなく、思源の同期にも含まれません。デスクトップでは OS や別のバックアップソフトがこのディレクトリを保存する場合があります。モバイル版では専用ディレクトリをシステムバックアップから除外しますが、ユーザーが選択した元のファイルには、そのファイルプロバイダーのバックアップと同期の規則が適用されます。"
				}
			]
		},
		{
			"ID": "20261101145217-071daa3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101145217-071daa3",
				"updated": "20261103203708"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "UTF-8 データで 8 MiB 以下のファイルを開いて保存できます。256 KiB を超えると自動的にソース編集に切り替わり、プレビューを無効にします。内容を閾値以下に減らすとリッチ編集を再び利用できます。自動切り替えは現在の文書にのみ適用され、既定の編集モードは変更しません。ユーザーが明示的に選択したモードだけを記憶します。ファイル上限には BOM とエンコード後の改行を含みます。復元用下書きの本文上限は別途 1 件あたり 16 MiB、復元記録は合計 256 MiB、最大 1024 件です。ファイル上限を超える下書きもコピーや削減ができ、上限以下にしてから書き戻せます。上限に達した場合はエラーを表示し、未復元の下書きを削除したり、自動的に期限切れにしたりしません。"
				}
			]
		},
		{
			"ID": "20261101154840-d0fba0b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261101154840-d0fba0b",
				"updated": "20261101154840"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "表やコードが密集した複雑な文書では、描画、モード切り替え、保存に時間がかかる場合があります。サイズ上限は、すべての文書を滑らかに操作できることを保証するものではありません。"
				}
			]
		}
	]
}
