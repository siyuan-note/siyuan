		{
			"ID": "20261122113000-mcpbrn2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-mcpbrn2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В macOS SiYuan проверяет папки «Рабочий стол», «Документы» и iCloud Drive исключительно для того, чтобы определить, не находится ли рабочее пространство в пути синхронизации iCloud; SiYuan никогда не просматривает ваши личные данные."
				}
			]
		},
		{
			"ID": "20261122113000-s8vcyr3",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-s8vcyr3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Является ли SiYuan открытым ПО?"
				}
			]
		},
		{
			"ID": "20261122113000-umdner6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-umdner6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan — полностью открытое программное обеспечение; полный исходный код доступен на GitHub."
				}
			]
		},
		{
			"ID": "20261122113000-tsyat7y",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-tsyat7y",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Как обновиться до новой версии?"
				}
			]
		},
		{
			"ID": "20261122113000-ymbx0el",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-ymbx0el",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-zl9qmds",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-zl9qmds",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-3ok5o9x",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-3ok5o9x",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если приложение установлено через магазин приложений, обновляйте его через магазин приложений"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-b0ojbhu",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-b0ojbhu"
					},
					"Children": [
						{
							"ID": "20261122113000-kegyoq1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-kegyoq1",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если настольная версия установлена через установщик, можно включить "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Настройки"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "О программе"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Автоматически загружать пакет обновления"
								},
								{
									"Type": "NodeText",
									"Data": " — тогда SiYuan автоматически загрузит последнюю версию установщика и предложит установку. При выходе можно просмотреть примечания к выпуску и выбрать «Установить сейчас» или «Не сейчас»"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-lxhue6s",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-lxhue6s"
					},
					"Children": [
						{
							"ID": "20261122113000-wgt5fh2",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-wgt5fh2",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если установка выполнялась вручную через установщик, скачайте новый установщик и установите его повторно"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-dklfxji",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-dklfxji",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Диапазон поиска ключевых слов можно настроить в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "О программе"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Текущая версия"
				},
				{
					"Type": "NodeText",
					"Data": " в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Проверить обновления"
				},
				{
					"Type": "NodeText",
					"Data": "​ или следить за новыми версиями на "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkAHref": "https://b3log.org/siyuan/",
					"TextMarkTextContent": "официальном сайте"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-q14y59b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-q14y59b",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Документы, записанные более новой версией, если их свойства ещё можно прочитать, отображаются в дереве документов бледным заполнителем с заголовком и значком. Обновите SiYuan перед их открытием или редактированием; вложенные документы по-прежнему можно просматривать через стрелку раскрытия."
				}
			]
		},
		{
			"ID": "20261122113000-i6adnqx",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-i6adnqx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Что делать, если у некоторых блоков (например, абзацев в элементах списка) не отображается значок блока?"
				}
			]
		},
		{
			"ID": "20261122113000-cbjdnmb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-cbjdnmb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "По умолчанию используется упрощённое отображение значков блоков. Даже при одном элементе списка сохраняются значки блока списка и элемента списка. Чтобы отображать скрытые при упрощении значки текущего блока и его последовательных первых дочерних блоков, включите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поведение"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать все значки блоков"
				},
				{
					"Type": "NodeText",
					"Data": " и открывайте меню нужного блока или перетаскивайте его напрямую за значок."
				}
			]
		},
		{
			"ID": "20261122113000-bfuqe9a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-bfuqe9a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если значок блока содержимого не отображается, поместите курсор в этот блок, несколько раз нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "↑"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы выделить блок, а затем нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы открыть меню значка блока; в macOS используйте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20261122113000-jt49h0l",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-jt49h0l",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Почему после удаления изображения или файла из заметки файл ресурса всё ещё остаётся?"
				}
			]
		},
		{
			"ID": "20261122113000-h96isz4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-h96isz4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Вставленные в заметку изображения или файлы являются ссылками на файлы ресурсов. Удаление содержимого из заметки удаляет только ссылку в текущем месте и не удаляет сам файл ресурса, так как на тот же ресурс могут ссылаться другие документы, базы данных, обложки или HTML-блоки."
				}
			]
		},
		{
			"ID": "20261122113000-u81gg7o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-u81gg7o",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Чтобы убедиться, что файл ресурса больше нигде не используется, нужно проверить всё рабочее пространство. Проверка при каждом удалении ссылки снизила бы производительность редактирования; кроме того, автоматическое удаление файлов ресурсов сделало бы ненадёжными отмену действий и многоустройственную синхронизацию и могло бы привести к случайной потере данных. Поэтому SiYuan не удаляет файлы ресурсов автоматически при удалении ссылок и не предоставляет такой опции."
				}
			]
		},
		{
			"ID": "20261122113000-wy2iztl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wy2iztl",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Убедившись, что эти файлы больше не нужны, их можно проверить и очистить в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ресурсы"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Неиспользуемые ресурсы"
				},
				{
					"Type": "NodeText",
					"Data": ". Очистка создаёт "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-36a05no",
					"TextMarkBlockRefSubtype": "d",
					"TextMarkTextContent": "История данных"
				},
				{
					"Type": "NodeText",
					"Data": "; при случайном удалении можно выбрать файл ресурса в истории данных и откатить его."
				}
			]
		},
		{
			"ID": "20261122113000-2weexim",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-2weexim",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Что делать при утере ключа репозитория данных?"
				}
			]
		},
		{
			"ID": "20261122113000-ihlw0ol",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ihlw0ol",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Ключ репозитория данных используется для снимков и синхронизации и отличается от мастер-пароля и резервной копии ключа зашифрованного блокнота. Сброс репозитория данных не восстанавливает утерянный мастер-пароль зашифрованного блокнота и не заменяет соответствующую резервную копию ключа шифрования."
				}
			]
		},
		{
			"ID": "20261122113000-appxg0i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-appxg0i",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед сбросом корректно закройте SiYuan и сделайте резервную копию всего рабочего пространства; при наличии зашифрованных блокнотов также отдельно сохраните соответствующую резервную копию ключа шифрования и убедитесь, что мастер-пароль работает. После завершения новой синхронизации и проверки целостности данных и сохранности материалов восстановления при необходимости удалите старый каталог синхронизации и облачные снимки."
				}
			]
		},
