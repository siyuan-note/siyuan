	"Children": [
		{
			"ID": "20261122113000-ql4slpl",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-ql4slpl",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Как сбросить настройки?"
				}
			]
		},
		{
			"ID": "20261122113000-4rbbh01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-4rbbh01",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Приложение"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Обслуживание"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сбросить настройки"
				},
				{
					"Type": "NodeText",
					"Data": " можно восстановить обычные пользовательские настройки текущего рабочего пространства, встроенные горячие клавиши, настройки меню и мобильной панели инструментов, а также текущую компоновку окон."
				}
			]
		},
		{
			"ID": "20261122113000-jaaopaq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-jaaopaq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Заметки, ресурсы, история, снимки, прогресс изучения флеш-карт и текущее количество дней хранения истории сохраняются. Аккаунт, аутентификация, ключи синхронизации и шифрования, подключения AI/MCP, ключи, переменные, язык и сетевые настройки также сохраняются."
				}
			]
		},
		{
			"ID": "20261122113000-s3gwrcx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-s3gwrcx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Установленные темы и значки не удаляются, но оформление переключается на стандартное. Плагины, фрагменты кода и их состояние включения, горячие клавиши плагинов и сохранённые компоновки сохраняются. Глобальные настройки приложения (канал обновлений, специальные возможности, метод ввода Linux, автозапуск и т. д.) остаются без изменений."
				}
			]
		},
		{
			"ID": "20261122113000-ngcnreo",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ngcnreo",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед сбросом все клиенты, подключённые к этому рабочему пространству, должны завершить сохранение; при сбое сохранения сброс отменяется. Затем клиенты перезагружаются. При запуске из локального настольного приложения оно завершит работу после перезагрузки — запустите его снова; мобильное приложение и браузерная версия просто перезагрузятся."
				}
			]
		},
		{
			"ID": "20261122113000-ab9mrrj",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-ab9mrrj",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Как экспортировать системный журнал?"
				}
			]
		},
