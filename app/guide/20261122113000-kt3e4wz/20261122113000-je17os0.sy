				},
				{
					"Type": "NodeText",
					"Data": "Локальное хранение обычных блокнотов"
				}
			]
		},
		{
			"ID": "20261122113000-09cs188",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-09cs188",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Документы и файлы ресурсов обычных блокнотов сохраняются в локальной файловой системе в открытом виде, что означает:"
				}
			]
		},
		{
			"ID": "20261122113000-ircdl5z",
