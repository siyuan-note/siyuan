							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-e9fzaoz",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Доступность данных зависит от исправности диска и операционной системы"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-23ah67b",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-23ah67b",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkTextContent": "Шифрование блокнотов",
					"TextMarkBlockRefID": "20261122113000-3uk67ci",
					"TextMarkBlockRefSubtype": "s"
				},
				{
					"Type": "NodeText",
					"Data": " шифрует сохраняемые документы, файлы ресурсов, определения баз данных и индексы. Это не равносильно шифрованию всего рабочего пространства или устройства: содержимое памяти после разблокировки, временные файлы, буфер обмена, экспортированные в открытом виде файлы и часть метаданных не входят в эту гарантию. По-прежнему требуется доверенная операционная система; полные границы безопасности см. в разделе о зашифрованных блокнотах."
				}
			]
		},
		{
			"ID": "20261122113000-7f3y00m",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-7f3y00m",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "сквозное шифрование"
				}
			]
		},
		{
			"ID": "20261122113000-6a7sxgb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-6a7sxgb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Облачная синхронизация SiYuan использует для снимков данных "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-nyyg5ku",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "сквозное шифрование"
				},
				{
					"Type": "NodeText",
					"Data": ". Ключ репозитория данных хранится в кодировке Base64 в локальном файле конфигурации "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "рабочая область/conf/conf.json"
				},
				{
					"Type": "NodeText",
					"Data": "; кодировка Base64 не является шифрованием, поэтому защищайте конфигурацию рабочего пространства и устройство. Ключ репозитория данных независим от мастер-пароля и резервной копии ключа зашифрованного блокнота и не может их заменить."
				}
			]
		},
