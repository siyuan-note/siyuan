					},
					"Children": [
						{
							"ID": "20261122113000-4cf82vf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-4cf82vf",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Любой человек или программа, имеющие права на чтение этих локальных файлов, могут прочитать их содержимое"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-j3eeu6v",
					"Type": "NodeListItem",
					"Data": "*",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Padding": 2,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
