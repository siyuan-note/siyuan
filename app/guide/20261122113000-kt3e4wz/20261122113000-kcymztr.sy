						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "Ссылка — это указатель на другое содержимое, позволяющий читателю перейти к цитируемому месту."
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-gaiir70",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-gaiir70",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В SiYuan ссылка на блок — это ссылка на другой блок содержимого, вызываемая через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "(("
				},
				{
					"Type": "NodeText",
					"Data": "​; поддерживаются статический и динамический текст ссылки. Нажатие переходит к целевому блоку, а наведение открывает предпросмотр."
				}
			]
		},
		{
			"ID": "20261122113000-4uqj7te",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-4uqj7te",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Обратные ссылки"
				}
			]
		},
		{
			"ID": "20261122113000-4tlp9uq",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20261122113000-4tlp9uq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": ">"
				},
				{
					"ID": "20261122113000-2nzzd1u",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20261122113000-2nzzd1u",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "Обратная ссылка (Backlink) — это ссылка с другой страницы на текущую, важная часть системы двунаправленных ссылок."
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-etl5bbx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-etl5bbx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В SiYuan панель обратных ссылок показывает все блоки, ссылающиеся на текущий блок. Обратные ссылки делятся на две части: связи (прямые ссылки на блоки) и упоминания (потенциальные связи по текстовому совпадению)."
				}
			]
		},
		{
			"ID": "20261122113000-k9sbis9",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-k9sbis9",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Упоминания"
				}
			]
		},
		{
			"ID": "20261122113000-qltwdvh",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20261122113000-qltwdvh",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": ">"
				},
				{
					"ID": "20261122113000-zoyrtxa",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20261122113000-zoyrtxa",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "Упоминание (Mention) — это совпадение ключевых слов в тексте, помогающее выявлять потенциальные связи."
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-95z1bm3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-95z1bm3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В SiYuan упоминания похожи на раздел связей в обратных ссылках, но создаются не через ссылки на блоки, а путём автоматического сопоставления текста по названиям, псевдонимам и текстам ссылок блоков. Упоминание можно в один клик преобразовать в ссылку на блок."
				}
			]
		},
		{
			"ID": "20261122113000-rpfky6k",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-rpfky6k",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Виртуальные ссылки"
				}
			]
		},
		{
			"ID": "20261122113000-30q65cp",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20261122113000-30q65cp",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": ">"
				},
				{
					"ID": "20261122113000-2nnd9ax",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20261122113000-2nnd9ax",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "Виртуальная ссылка — это технология автоматического обнаружения потенциальных ссылочных связей, позволяющая выделять в тексте возможно связанные блоки без ручного создания ссылок."
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-atjqzr4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-atjqzr4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В SiYuan виртуальные ссылки автоматически определяются по названиям, псевдонимам и текстам ссылок блоков и отмечаются в редакторе пунктирным подчёркиванием. При наведении открывается предпросмотр блока, а нажатие преобразует их в обычную ссылку на блок. Включить или отключить их можно в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Двусторонние ссылки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Виртуальные ссылки"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
