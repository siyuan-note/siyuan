						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "kbd",
							"TextMarkTextContent": "Руководство пользователя"
						},
						{
							"Type": "NodeText",
							"Data": "."
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-0zvzh6d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0zvzh6d",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если вы используете SiYuan впервые, рекомендуем сначала выполнить следующие шаги, а затем при необходимости перейти к подробным разделам руководства."
				}
			]
		},
