			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Резервное копирование данных — это загрузка "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-n08nhqf",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "снимков данных"
				},
				{
					"Type": "NodeText",
					"Data": " в облако для аварийного восстановления. В отличие от синхронизации данных (цель которой — поддерживать согласованность данных на нескольких устройствах), резервное копирование — это ручная загрузка снимков в архив на случай непредвиденных ситуаций."
				}
			]
		},
