									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Снимок данных"
								},
								{
									"Type": "NodeText",
									"Data": ", найдите нужный снимок на вкладке локальных снимков, нажмите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
