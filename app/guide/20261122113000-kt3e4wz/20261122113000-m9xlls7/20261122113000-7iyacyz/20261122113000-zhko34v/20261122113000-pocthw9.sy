			},
			"Children": [
				{
					"ID": "20261122113000-86jnjoh",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-86jnjoh",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-zh3g84x",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-zh3g84x",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Перед включением синхронизации убедитесь, что системное время на всех участвующих устройствах совпадает"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-0kk9m69",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-0kk9m69",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-72esvif",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-72esvif",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При большом объёме данных рекомендуется через "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Настройки"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Приложение"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Данные"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Экспорт Data"
								},
								{
									"Type": "NodeText",
									"Data": " экспортировать пакет данных, перенести его на новое устройство, выполнить на той же странице настроек "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Импорт Data"
								},
								{
									"Type": "NodeText",
									"Data": "​, а затем настроить синхронизацию"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-gtr9ja8",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-gtr9ja8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Настройка сторонней синхронизации"
				}
			]
		},
		{
			"ID": "20261122113000-y81rcd1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-y81rcd1",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аккаунт и синхронизация"
				},
				{
					"Type": "NodeText",
					"Data": " выберите S3, WebDAV или локальную файловую систему, затем нажмите кнопку настройки в строке конфигурации сервиса синхронизации. Локальная файловая система поддерживается в стандартном настольном ядре и ядре Docker; в мобильном ядре этот вариант недоступен. Путь относится к машине или контейнеру, где работает ядро, а не к устройству, на котором открыт браузер. После заполнения полей нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сохранить"
				},
				{
					"Type": "NodeText",
					"Data": ". В процессе ввода изменения не сохраняются; при закрытии изменённой формы появится запрос, нужно ли отменить черновик."
				}
			]
		},
		{
			"ID": "20261122113000-q1oatkb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-q1oatkb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед сохранением можно нажать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Проверить подключение"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы проверить текущий черновик конфигурации S3, WebDAV или локальной файловой системы без сохранения. Для WebDAV проверяются права на создание каталогов и чтение/запись тестового файла, для локальной файловой системы — права на чтение и запись в каталог; по завершении тестовый файл по возможности удаляется. Если проверка не удалась, исправьте параметры по подсказке и повторите попытку; ранее сохранённая конфигурация останется без изменений."
				}
			]
		},
		{
			"ID": "20261122113000-5llk7tm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5llk7tm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если в адресе конечной точки S3 или WebDAV не указан протокол, для имён хостов с точкой по умолчанию используется HTTPS, а для IP-адресов, localhost и одноуровневых имён хостов — HTTP. Если сервис с доменным именем, содержащим точку, поддерживает только HTTP, укажите http:// явно. Явно указанные адреса http:// и https:// сохраняются без изменений, а у ранее сохранённых конфигураций протокол автоматически не меняется."
				}
			]
		},
		{
			"ID": "20261122113000-h956kl2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-h956kl2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед сменой провайдера синхронизации, конечной точки или каталога SiYuan сохраняет открытые редакторы и создаёт полный снимок текущих данных. Если новый источник не пуст, автоматическое слияние останавливается. Нажмите кнопку синхронизации, чтобы просмотреть количество файлов с обеих сторон, время и устройство источника, а также число файлов для загрузки, перезаписи или удаления, а затем выберите загрузку локальных данных в источник или восстановление из источника (ни одно из направлений не выбрано по умолчанию). Загрузка публикует текущий локальный снимок в источник, не удаляя лишние объекты в хранилище; восстановление заменяет локальные данные содержимым источника. Пустой источник сразу принимает локальные данные. Если первая синхронизация прервалась до сохранения возобновляемого прогресса или фиксации данных, потребуется снова выполнить предпросмотр и подтвердить источник. При наличии возобновляемого прогресса обработка продолжится в выбранном направлении; при ошибке загрузки ресурсов после фиксации данных операцию можно просто повторить. Снимок, созданный перед переключением, можно восстановить в истории данных. Такое же подтверждение требуется при несовпадении записанного источника синхронизации или базовой точки — это не обязательно означает смену сервиса хранения."
				}
			]
		},
		{
			"ID": "20261122113000-v4hzpbg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-v4hzpbg",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Чтобы прекратить использование сервиса, откройте окно его настроек, нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Очистить настройки"
				},
				{
					"Type": "NodeText",
					"Data": " и подтвердите действие. Это удалит сохранённый адрес и учётные данные; если сервис используется для текущей синхронизации, синхронизация также будет отключена. Локальные заметки и облачные данные сохранятся."
				}
			]
		},
		{
			"ID": "20261122113000-1rj9kdp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-1rj9kdp",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если ресурсы или исторические снимки из текущего источника ещё не докачаны, смена источника или очистка конфигурации будут заблокированы. Восстановите доступ к прежнему источнику синхронизации, завершите полную загрузку и повторите попытку. При ошибке сохранения или очистки и активная конфигурация, и черновик сохраняются."
				}
			]
		},
		{
			"ID": "20261122113000-uaveqrz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-uaveqrz",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Автоматическая синхронизация обычно выполняется в фоне, не открывая панель и не прерывая редактирование. Нажмите значок синхронизации, чтобы увидеть текущий файл, число записанных байт, скорость и оставшееся время. Во время восстановления индекса после записи файлов на панели отображается текущий статус индексации и непрерывный индикатор выполнения. В свёрнутой панели кнопка разворачивания отображается только при наличии дополнительной информации."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Скрыть подробности"
				},
				{
					"Type": "NodeText",
					"Data": " сворачивает подробный прогресс, а нажатие "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Синхронизация"
				},
				{
					"Type": "NodeText",
					"Data": " разворачивает его снова. Редактирование приостанавливается только на время применения локальных изменений, восстановления индекса и обновления затронутых документов; после отмены также нужно дождаться завершения восстановления, прежде чем продолжить редактирование. Нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Отмена"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы запросить отмену подготовки, сетевой передачи или восстановления файлов."
				},
				{
					"Type": "NodeText",
					"Data": "Значок синхронизации сохраняет результат последнего завершённого сеанса: галочка означает успех, значок ошибки — сбой или приостановку автосинхронизации, обычное облако — неизвестный результат. Этот статус сохраняется после перезапуска и обновляется после следующей завершённой синхронизации. Во время синхронизации значок вращается, а при отключённой синхронизации отображается значок отключения."
				}
			]
		},
		{
			"ID": "20261122113000-td5avgy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-td5avgy",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После отмены уже завершённые файлы сохраняются, а текущие временные файлы удаляются — вы можете снова запустить синхронизацию, чтобы завершить оставшуюся часть. При нехватке места на диске освободите место и повторите попытку. Перед запуском или восстановлением файлов приложение очищает временные файлы прерванных синхронизаций с подтверждённой принадлежностью и сообщает объём освобождённого пространства."
				}
			]
		},
		{
			"ID": "20261122113000-beiukhh",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-beiukhh",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Загрузка ресурсов"
				}
			]
		},
		{
			"ID": "20261122113000-pmupavz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pmupavz",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Диапазон поиска ключевых слов можно настроить в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аккаунт и синхронизация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Загрузка файлов ресурсов"
				},
				{
					"Type": "NodeText",
					"Data": " выберите «Загрузить всё» или «Загружать по требованию»; настройка действует только на текущем устройстве."
				}
			]
		},
		{
			"ID": "20261122113000-nhcmwgk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-nhcmwgk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "«Загрузить всё» — режим по умолчанию. В режиме «Загружать по требованию» документы, определения баз данных и список файлов ресурсов по-прежнему синхронизируются полностью, а сами файлы ресурсов загружаются при отображении изображений, аудио, видео, PDF и т. п. или при открытии ссылки на ресурс. Для доступа к ресурсам зашифрованных блокнотов по-прежнему требуется разблокировка."
				}
			]
		},
		{
			"ID": "20261122113000-hxbfpyu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-hxbfpyu",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Уже загруженные файлы ресурсов остаются на устройстве и продолжают обновляться при последующих синхронизациях. Включение режима «Загружать по требованию» не удаляет существующие файлы и не освобождает занятое ими место немедленно."
				}
			]
		},
		{
			"ID": "20261122113000-n84wmlq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-n84wmlq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Незагруженные файлы ресурсов недоступны офлайн, и при невозможности их получить выводится ошибка. Переключение на режим «Загрузить всё» сначала докачивает текущие файлы ресурсов и всё содержимое, необходимое для сохранённых локальных снимков, поэтому могут загружаться и исторические версии; при ошибке загрузки сохраняется прежний режим, и после восстановления соединения можно повторить попытку."
				}
			]
		},
		{
			"ID": "20261122113000-4kl21ts",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-4kl21ts",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Локальные снимки в режиме загрузки по требованию могут зависеть от облака и не могут считаться полной автономной резервной копией. Полная загрузка снимка, а также экспорт и восстановление, требующие содержимого файлов ресурсов, сначала докачивают соответствующие файлы ресурсов и явно сообщают об ошибке, если их не удалось получить."
				}
			]
		},
		{
			"ID": "20261122113000-m8txjj1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-m8txjj1",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед сменой цели синхронизации, сбросом репозитория данных или открытием этой рабочей области в старой версии приложения сначала переключитесь на режим «Загрузить всё» и дождитесь завершения загрузки, чтобы не потерять доступ к незагруженным ресурсам. Если после выхода из аккаунта вы лишь выбрали неверный аккаунт или облачный регион, не меняя остальные настройки синхронизации, войдите в исходный аккаунт в исходном облачном регионе и переключитесь на «Загрузить всё». Если состояние загрузки корректно, а все фрагменты текущих ресурсов и сохранённых снимков уже находятся на устройстве, переключение можно выполнить даже без входа в аккаунт или при отключённой синхронизации. Если облачный каталог или ключ репозитория изменились, либо состояние загрузки ресурсов утеряно или повреждено, сохраните рабочую область и исходную резервную копию и не удаляйте файлы состояния или маркеры репозитория для обхода проверки — повторный вход сам по себе не исправит это состояние."
				}
			]
		},
		{
			"ID": "20261122113000-z7r9i8s",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-z7r9i8s",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Темы и значки"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261122113000-t6ul76m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-t6ul76m",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Файлы, обновления и удаление тем и наборов значков синхронизируются между устройствами, при этом каждое устройство независимо выбирает активную тему и набор значков. Изображения, шрифты и другие ресурсы внутри пакетов всегда загружаются полностью. Для синхронизации, удаления и разрешения конфликтов действуют те же файловые правила, что и для плагинов, виджетов и шаблонов. Если в восстанавливаемом снимке какой-либо пакет отсутствует, он будет удалён."
				}
			]
		},
		{
			"ID": "20261122113000-rkuwldg",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
