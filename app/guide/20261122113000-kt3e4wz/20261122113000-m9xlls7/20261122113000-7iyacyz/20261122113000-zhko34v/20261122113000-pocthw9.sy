				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Режим облачной синхронизации"
				},
				{
					"Type": "NodeText",
					"Data": " поддерживает три режима:"
				}
			]
		},
