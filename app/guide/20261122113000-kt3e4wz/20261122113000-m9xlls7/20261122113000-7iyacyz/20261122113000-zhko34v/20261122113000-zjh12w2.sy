							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-ysol9e7",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Не загружайте незаконные или запрещённые материалы: загружаемые файлы ресурсов проверяются сторонним сервисом модерации (порнография, насилие, запрещённый контент и т. д.). При выявлении нарушений аккаунт пользователя будет заблокирован навсегда, а сам пользователь понесёт соответствующую юридическую ответственность"
								}
							]
						}
