			"Children": [
				{
					"Type": "NodeText",
					"Data": "Диапазон поиска ключевых слов можно настроить в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поиск"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Различать упрощённые и традиционные иероглифы"
				},
				{
					"Type": "NodeText",
					"Data": " — настраивается здесь. По умолчанию включено, то есть поиск «经济» не найдёт «經濟». При отключении поиск «经济» найдёт и «经济», и «經濟». После переключения этого параметра дождитесь завершения перестроения индекса, чтобы изменения вступили в силу."
				}
			]
		},
		{
			"ID": "20261122113000-qc3ben1",
