		{
			"ID": "20261122113000-kkczapk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-kkczapk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Мы реализовали глобальный поиск с помощью "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkAHref": "https://www.sqlite.org/fts5.html",
					"TextMarkTextContent": "SQLite FTS5"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-b23tilu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-b23tilu",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Атрибуты поиска определяются параметрами в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поиск"
				},
				{
					"Type": "NodeText",
					"Data": ". FTS5 использует фильтр столбцов, например "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{content name alias memo}:foo"
				},
				{
					"Type": "NodeText",
					"Data": " означает поиск в тексте, имени, псевдонимах и примечании "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "foo"
				},
				{
					"Type": "NodeText",
					"Data": ". В SQL полная запись выглядит как "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SELECT * FROM blocks_fts WHERE blocks_fts MATCH '{content name alias memo}:foo'"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20261122113000-7iiponk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7iiponk",
