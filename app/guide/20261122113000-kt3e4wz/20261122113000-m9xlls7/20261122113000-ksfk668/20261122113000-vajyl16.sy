		{
			"ID": "20261122113000-ymzfvpu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ymzfvpu",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите на треугольник слева от заголовка, чтобы свернуть или развернуть текущий заголовок; удерживайте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": " (на macOS — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌥"
				},
				{
					"Type": "NodeText",
					"Data": ") и нажмите на треугольник, чтобы свернуть или развернуть прямые подзаголовки; удерживайте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": " (на macOS — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌥"
				},
				{
					"Type": "NodeText",
					"Data": ") и нажмите на маркер блока, чтобы свернуть или развернуть заголовки того же уровня. Также можно использовать пункты «Свернуть/развернуть прямые подзаголовки» и «Свернуть/развернуть заголовки того же уровня» в меню маркера блока."
				}
			]
		},
