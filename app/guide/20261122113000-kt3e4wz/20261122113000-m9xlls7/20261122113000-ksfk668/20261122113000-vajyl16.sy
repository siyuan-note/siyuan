					"TextMarkTextContent": "\\(...\\)"
				},
				{
					"Type": "NodeText",
					"Data": " как строчную формулу, а "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\[...\\]"
				},
				{
					"Type": "NodeText",
					"Data": " на отдельной строке — как блочную формулу. Вставленный HTML также распознаётся. Код остаётся без изменений, а экспорт Markdown продолжает использовать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
