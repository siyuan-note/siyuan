		{
			"ID": "20261122113000-18j5y15",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-18j5y15",
				"updated": "20261122113000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Блок вкладок"
				}
			]
		},
		{
			"ID": "20261122113000-2xctcx6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-2xctcx6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Введите / и выберите блок вкладок, чтобы создать контейнер с двумя вкладками. Нажмите на заголовок для переключения вкладок, дважды нажмите или используйте меню вкладки для редактирования заголовка."
				}
			]
		},
		{
			"ID": "20261122113000-p72b1x7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-p72b1x7",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Используйте меню справа от вкладок для добавления, дублирования, удаления или сортировки вкладок, а также переключения расположения сверху или слева."
				}
			]
		},
		{
			"ID": "20261122113000-bfgo7a3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-bfgo7a3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В меню элемента вкладки выберите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Увеличить"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы отобразить только этот элемент и его заголовок, а обратные ссылки ограничить этим элементом. Выбор "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Выйти из фокуса"
				},
				{
					"Type": "NodeText",
					"Data": " восстанавливает всю группу вкладок."
				}
			]
		},
