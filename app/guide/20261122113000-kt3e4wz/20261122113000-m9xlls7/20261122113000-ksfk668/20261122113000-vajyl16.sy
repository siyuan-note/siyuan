				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Встраиваемый блок"
				},
				{
					"Type": "NodeText",
					"Data": " можно настроить отображение навигационной цепочки во встроенном блоке, а также включение в неё родительского пути документа. При скрытии родительского пути сохраняются имя документа и его внутренняя структура."
				}
			]
		},
		{
			"ID": "20261122113000-z96k8j8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-z96k8j8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В меню маркера блока "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Встраиваемый блок"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Встраиваемые блоковые крошки"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Встраиваемый блок"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать родительский путь в навигационной цепочке"
				},
				{
					"Type": "NodeText",
					"Data": " имеют варианты «Включить», «Отключить» и «По умолчанию». Выбор «По умолчанию» удаляет атрибут уровня блока и наследует глобальную настройку."
				}
			]
		},
		{
			"ID": "20261122113000-sourmld",
			"Type": "NodeHeading",
