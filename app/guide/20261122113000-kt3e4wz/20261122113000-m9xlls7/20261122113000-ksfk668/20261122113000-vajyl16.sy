		{
			"ID": "20261122113000-1xb8uta",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-1xb8uta",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Кроме того, в качестве языка блока кода поддерживаются "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "siyuan-template"
				},
				{
					"Type": "NodeText",
					"Data": "​ и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "template"
				},
				{
					"Type": "NodeText",
					"Data": "​, они эквивалентны. После выбора включается"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-9f33l0j",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "шаблон SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": " подсветка синтаксиса; при экспорте в шаблон этот блок кода преобразуется в обычный текст абзаца."
				}
			]
		},
		{
			"ID": "20261122113000-lil7tcf",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-lil7tcf",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Таблица"
				}
			]
		},
		{
			"ID": "20261122113000-0m76ana",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0m76ana",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Ячейки по умолчанию поддерживают редактирование абзацев, заголовков, списков, цитат, кода и формул без ручного преобразования. Существующая разметка Markdown в тексте остаётся без изменений, а исходное форматирование (жирный шрифт, ссылки и т. д.) сохраняется. При вводе отдельно стоящего разделителя вроде --- он сохраняется как обычный текст. Через меню «/» или меню «+» можно вставлять изображения, создавать и ссылаться на новые документы, а также задавать строчные стили."
				}
			]
		},
		{
			"ID": "20261122113000-hhdkyd7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-hhdkyd7",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите на ячейку для редактирования; после создания таблицы можно сразу вводить текст."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " создаёт новый абзац, продолжает элемент списка или переносит строку в блоке кода."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Enter"
				},
				{
					"Type": "NodeText",
					"Data": " вставляет мягкий перенос строки внутри абзаца."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Tab"
				},
				{
					"Type": "NodeText",
					"Data": " переключает ячейки; в списках и блоках кода сохраняются отступы. После закрытия подсказки нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Escape"
				},
				{
					"Type": "NodeText",
					"Data": " или нажмите вне ячейки для завершения редактирования; содержимое сохраняется автоматически."
				}
			]
		},
		{
			"ID": "20261122113000-mkson1c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-mkson1c",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Внутренние абзацы и элементы списков не имеют отдельных ID блоков, поддерживается цитирование существующих блоков. Вложенные таблицы, базы данных, суперблоки, вкладки и некоторые другие сложные блоки не поддерживаются."
				}
			]
		},
		{
			"ID": "20261122113000-pfuqsdb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pfuqsdb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перетащите нижнюю границу строки для изменения высоты; на мобильных устройствах сначала коснитесь горизонтального разделителя ячеек. Заданная высота является минимальной. Выберите строку и в меню нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Автоподбор высоты строки"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы восстановить автоматическую высоту."
				}
			]
		},
