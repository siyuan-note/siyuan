		{
			"ID": "20261122113000-o7hv9ic",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-o7hv9ic",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Оптимизация форматирования добавляет пробелы вокруг строчных элементов и между китайскими и латинскими символами для единообразия отступов в документе. Она также обрабатывает текст в ячейках таблицы с расширенным форматированием."
				}
			]
		},
		{
			"ID": "20261122113000-e3hvepk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-e3hvepk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Эта операция изменяет содержимое документа. Используйте её по необходимости; область обработки описана ниже."
				}
			]
		},
		{
			"ID": "20261122113000-ik24itl",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-ik24itl",
				"updated": "20261122113000"
			},
			"Children": [
