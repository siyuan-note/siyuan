			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В правом верхнем углу редактора в меню "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "︙"
				},
				{
					"Type": "NodeText",
					"Data": "​ в правом верхнем углу вкладки редактора выберите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Оптимизировать типографику"
				},
				{
					"Type": "NodeText",
					"Data": "​; после обработки пробел будет автоматически вставлен до и после следующих элементов:"
				}
			]
		},
