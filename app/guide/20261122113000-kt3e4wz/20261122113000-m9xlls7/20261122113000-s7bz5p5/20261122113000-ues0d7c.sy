			]
		},
		{
			"ID": "20261122113000-essa575",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-essa575",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При онлайн-просмотре плагинов, тем, иконок, шаблонов и виджетов нажмите на значок фильтра слева от строки поиска и отметьте в меню по отдельности или вместе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Скрыть пакеты, требующие более новой версии приложения"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Скрыть пакеты, несовместимые с платформой"
				},
				{
					"Type": "NodeText",
					"Data": ". По умолчанию оба пункта не отмечены; выбор сохраняется отдельно для каждого типа пакетов и влияет только на онлайн-список, не затрагивая списки загруженных пакетов и обновлений."
				}
			]
		},
		{
			"ID": "20261122113000-kgk21c5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-kgk21c5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Можно выбрать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Дата публикации (сначала новые)"
				},
				{
					"Type": "NodeText",
					"Data": " или "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Дата публикации (сначала старые)"
				},
				{
					"Type": "NodeText",
					"Data": ". Дата публикации определяется по времени первого добавления в каталог маркета; пакеты с отсутствующей или некорректной датой размещаются в конце списка."
				}
			]
		},
