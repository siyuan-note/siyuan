								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-r6ebf7p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-r6ebf7p",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Подробное примечание поможет позже опознать снимок, но оно не защищает его от очистки. Снимкам, которые нужно хранить долго, следует добавить метку и сделать отдельную независимую резервную копию."
				}
			]
		},
		{
			"ID": "20261122113000-0xkv7xh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0xkv7xh",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если внешняя программа изменила содержимое, сохранив размер и время изменения файла, можно заполнить примечание и подтвердить в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "История данных"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Снимок данных"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Полная проверка содержимого"
				},
				{
					"Type": "NodeText",
					"Data": ". Эта операция считывает все локально сохранённые файлы в области снимка и при обнаружении изменений создаёт снимок; незагруженные ресурсы сохраняют прежнюю версию и не загружаются специально для проверки. В больших рабочих пространствах это может занять много времени."
				}
			]
		},
		{
			"ID": "20261122113000-5i1tbmv",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-5i1tbmv",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Просмотр снимков данных"
				}
			]
		},
		{
			"ID": "20261122113000-0g0hxuk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0g0hxuk",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "История данных"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Снимок данных"
				},
				{
					"Type": "NodeText",
					"Data": " широкое окно отображает локальный и облачный списки рядом друг с другом с раздельной пагинацией; в узких окнах и на мобильных устройствах переключение выполняется через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Локальный снимок"
				},
				{
					"Type": "NodeText",
					"Data": ", "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Облачный снимок"
				},
				{
					"Type": "NodeText",
					"Data": ". Кнопки "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Снимок данных"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Помеченные снимки"
				},
				{
					"Type": "NodeText",
					"Data": " вверху служат для смены категории снимков. В списке отображаются время создания, примечание и метка снимка для удобного сравнения."
				}
			]
		},
		{
			"ID": "20261122113000-ph1v03a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ph1v03a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Локальные снимки поддерживают поиск по имени файла; при поиске выделяется место для списка файлов и предпросмотра. При выборе файла документа в деталях снимка предпросмотр покажет заголовок, сохранённый в этом снимке, над основным текстом. Вне режима массового управления по-прежнему можно выбрать два локальных снимка для сравнения и использовать действия пометки, загрузки, скачивания и отката для каждой записи."
				}
			]
		},
		{
			"ID": "20261122113000-57jmy3n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-57jmy3n",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Введите имя файла или ID снимка прямо в поле поиска для поиска по локальным снимкам. При вводе от 7 до 40 шестнадцатеричных символов ID приоритетно ищется совпадение с префиксом ID снимка без учёта регистра букв. Если совпало несколько снимков, все результаты выводятся от новых к старым; если совпадений по ID снимка нет, поиск продолжается по имени файла. Для результатов сохраняются обычные операции со снимками, включая откат. Очистите поле поиска, чтобы вернуться к полному списку."
				}
			]
		},
		{
			"ID": "20261122113000-5x0yqrx",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-5x0yqrx",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Пакетное управление помеченными снимками"
				}
			]
		},
		{
			"ID": "20261122113000-11jfh47",
			"Type": "NodeList",
			"ListData": {
				"Typ": 1
			},
			"Properties": {
