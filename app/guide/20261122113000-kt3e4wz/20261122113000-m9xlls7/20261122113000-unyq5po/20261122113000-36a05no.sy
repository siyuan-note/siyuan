							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Нажмите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Создать снимок"
								},
								{
									"Type": "NodeText",
