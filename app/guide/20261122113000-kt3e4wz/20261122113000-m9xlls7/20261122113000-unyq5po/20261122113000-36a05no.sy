			"Children": [
				{
					"Type": "NodeText",
					"Data": "Снимки плагинов"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261122113000-xi4c5av",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-xi4c5av",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "История данных"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Снимок данных"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Снимки плагинов"
				},
				{
					"Type": "NodeText",
					"Data": ": переключитесь на снимки плагинов на существующей панели снимков данных, выберите установленный плагин (ввод отображаемого имени или имени пакета фильтрует выпадающий список в реальном времени, также можно вручную ввести полное имя пакета удалённого плагина). В списке отдельно показаны количество файлов и читаемый размер для программы и стандартных данных; кнопки открытия данных и программы открывают соответствующие каталоги, а предпросмотр файлов выполняется на той же панели. При восстановлении плагин автоматически отключается и создаётся резервный снимок, затем тем же снимком заменяются каталоги data/plugins/<имя_пакета>/ и data/storage/petal/<имя_пакета>/, а отсутствующие в снимке файлы удаляются. Перед восстановлением закройте другие клиенты, а после восстановления включите плагин вручную. Другие каталоги и общие настройки не входят в область восстановления."
				}
			]
		}
	]
}