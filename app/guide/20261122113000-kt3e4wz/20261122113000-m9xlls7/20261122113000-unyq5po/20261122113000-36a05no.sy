					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "MS4=",
						"Num": 1
					},
					"Properties": {
						"id": "20261122113000-e56hvud",
						"updated": "20261126150544"
					},
					"Children": [
						{
							"ID": "20261122113000-h1dsgil",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-h1dsgil",
								"updated": "20261126150544"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Переключитесь на "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Помеченные снимки"
								},
								{
									"Type": "NodeText",
									"Data": ", нажмите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Групповое управление"
								},
								{
									"Type": "NodeText",
									"Data": ", чтобы отобразить флажки"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-f1nxrud",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "Mi4=",
						"Num": 2
					},
					"Properties": {
						"id": "20261122113000-f1nxrud",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-t3mwmt3",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-t3mwmt3",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Отметьте локальные и облачные метки, которые нужно удалить; кнопка "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Выбрать все"
								},
								{
									"Type": "NodeText",
									"Data": " в каждом столбце выбирает только метки текущего списка этого столбца, а внизу отображается количество выбранных элементов с каждой стороны"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-a84i5gf",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20261122113000-a84i5gf",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-bl0u627",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-bl0u627",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Нажмите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Удалить выбранные метки"
								},
								{
									"Type": "NodeText",
									"Data": ", проверьте имена и количество локальных и облачных меток и подтвердите; удаляются только явно отмеченные метки, одноимённые метки на другой стороне автоматически не удаляются"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-bv7qbvo",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "NC4=",
						"Num": 4
					},
					"Properties": {
						"id": "20261122113000-bv7qbvo",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-imkmuvs",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-imkmuvs",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "После операции проверьте результат: элементы, завершившиеся с ошибкой или не подтверждённые, останутся отмеченными — можно снова нажать "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Удалить выбранные метки"
								},
								{
									"Type": "NodeText",
									"Data": " для повтора;"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Снять выделение"
								},
								{
									"Type": "NodeText",
									"Data": " сбрасывает выбор,"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Готово"
								},
								{
									"Type": "NodeText",
									"Data": " выходит из массового управления"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-59mu8ap",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-59mu8ap",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Удаление метки не удаляет данные снимка немедленно и не очищает репозиторий данных автоматически. Чтобы освободить место, можно отдельно очистить локальный репозиторий данных; ручная очистка облака применима только для хранилищ синхронизации S3, WebDAV и локальной файловой системы."
				}
			]
		},
		{
			"ID": "20261122113000-h9jdyuc",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-h9jdyuc",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откат снимка данных"
				}
			]
		},
		{
			"ID": "20261122113000-skwplfq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-skwplfq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Справа от каждой записи в списке снимков есть кнопка отката; при нажатии появится диалог подтверждения, и после подтверждения текущие данные будут полностью заменены данными из снимка."
				}
			]
		},
		{
			"ID": "20261122113000-9wybyge",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9wybyge",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откат снимка приостанавливает синхронизацию. Если до сбоя удалось подтвердить, что файлы ещё не перезаписаны, исходный переключатель синхронизации будет восстановлен, а полная перестройка индекса пропущена; если файлы могли измениться, синхронизация останется на паузе, а в сообщении об ошибке будет указано, как включить её снова — сначала проверьте восстановленные данные. Сообщение об ошибке также показывает этап сбоя и доступные детали объекта. Резервный снимок, созданный перед откатом, сохраняется."
				}
			]
		},
		{
			"ID": "20261122113000-n6qgmtd",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-n6qgmtd",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Очистка снимков данных"
				}
			]
		},
		{
			"ID": "20261122113000-t2ioa2l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-t2ioa2l",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Локальные снимки автоматически очищаются в соответствии с настройками в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аккаунт и синхронизация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Очистка локального репозитория данных"
				},
				{
					"Type": "NodeText",
					"Data": "; по умолчанию срок хранения составляет 180 дней, по 2 снимка в день. Прошлые снимки в пределах срока хранения сохраняются разреженно по дневному лимиту, а снимки текущего дня и снимки, на которые указывают ссылки вроде меток, не подвергаются автоматическому удалению. Это локальное правило хранения, оно не гарантирует хранение каждого снимка полные 180 дней и отличается от политики облачного резервного копирования. Описанная ниже ручная очистка удаляет все неиспользуемые снимки без защиты этим сроком хранения."
				}
			]
		},
