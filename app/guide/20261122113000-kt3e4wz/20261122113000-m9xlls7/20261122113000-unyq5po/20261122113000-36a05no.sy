								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Снимки данных: сохраняются поблочно, в зашифрованном и сжатом виде в папке "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Рабочее_пространство/repo/"
								},
								{
									"Type": "NodeText",
									"Data": "; восстанавливать следует через SiYuan, нельзя напрямую копировать отдельные файлы репозитория в data для восстановления"
								}
							]
						}
					]
				}
			]
		},
