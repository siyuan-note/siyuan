								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "История файлов: сохраняется побайтово в исходном виде в папке "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Рабочее_пространство/history/"
								},
								{
									"Type": "NodeText",
									"Data": ". История обычных блокнотов хранится в открытом виде, а история зашифрованных блокнотов — в зашифрованном; предпочтительно восстанавливать через SiYuan, сверяясь с требованиями к блокнотам и ключам ниже"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-47fybop",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
