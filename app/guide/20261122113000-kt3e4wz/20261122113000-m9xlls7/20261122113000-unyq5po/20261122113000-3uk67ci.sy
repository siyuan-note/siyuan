								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Поддерживается импорт .sy.zip и Markdown в разблокированный зашифрованный блокнот — содержимое шифруется перед записью на диск"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-5qvb3vn",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-5qvb3vn",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-73o6tee",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-73o6tee",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если в импортируемом пакете есть документы с флеш-карточками, импорт будет отклонён, а в сообщении об ошибке будут указаны эти документы; удалите флеш-карточки в исходном блокноте и повторите экспорт либо импортируйте пакет в обычный блокнот"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-t8ea4aw",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-t8ea4aw",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-cwj1woi",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-cwj1woi",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Ссылки на блоки за пределами пакета в импортируемых документах преобразуются в обычный текст, а привязки баз данных за пределами пакета — в непривязанные записи"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-xpyzc40",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-xpyzc40",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-sxaoqcc",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-sxaoqcc",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Экспорт поддерживается только в разблокированном состоянии; экспортированные файлы .sy.zip, HTML, Word, PDF, Markdown и др. сохраняются в открытом виде — после экспорта защищайте, перемещайте или удаляйте их как обычные конфиденциальные файлы"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-qezbmq0",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-qezbmq0",
				"updated": "20261122113000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Архивация и восстановление блокнотов, которые невозможно разблокировать"
				}
			]
		},
		{
			"ID": "20261122113000-h1dtux1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-h1dtux1",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Шифрование блокнотов"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Упаковать и извлечь"
				},
				{
					"Type": "NodeText",
					"Data": ", выберите заблокированные блокноты для архивации — вводить мастер-пароль не требуется. Архив содержит исходный шифротекст, связанную историю, локальные снимки репозитория данных и имеющиеся материалы для восстановления ключа."
				}
			]
		},
		{
			"ID": "20261122113000-e8bm3t6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-e8bm3t6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Сохраните архив за пределами рабочего пространства и только после явного подтверждения сохранения извлеките выбранные блокноты. Отмена сохранения не удаляет данные. Извлечение затронет другие устройства при обычной синхронизации и не удалит автоматически снимки репозитория данных."
				}
			]
		},
		{
			"ID": "20261122113000-7fmu0lc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7fmu0lc",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если из 5 блокнотов, которые невозможно разблокировать, извлечь только 3, остальные 2 и старая конфигурация ключа сохранятся. В рабочем пространстве, не связанном с синхронизацией, после архивации и извлечения всех старых блокнотов и данных, необходимых для восстановления, можно отключить и снова включить зашифрованные блокноты, задав новый мастер-пароль. Программа также сохраняет копию для восстановления, но обязательно надёжно храните и самостоятельно экспортированный архив."
				}
			]
		},
		{
			"ID": "20261122113000-nvammq0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-nvammq0",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После восстановления подходящего старого ключа и пароля создайте новое независимое рабочее пространство без настроенного ключа шифрования, отключите синхронизацию и откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Шифрование блокнотов"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Восстановить зашифрованный архив"
				},
				{
					"Type": "NodeText",
					"Data": ". Выберите архив и введите старый мастер-пароль; если в архиве нет пригодной резервной копии ключа, можно отдельно указать найденную подходящую резервную копию ключа. Импорт такого архива в рабочее пространство, где уже настроен ключ шифрования, запрещён."
				}
			]
		},
		{
			"ID": "20261122113000-7exa8qg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7exa8qg",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При восстановлении сначала проверяются ключ и шифротекст, и только после успешной проверки всех данных выполняется запись; блокноты при этом остаются заблокированными. Связанная история восстанавливается вместе с ними, а снимки репозитория из архива становятся доступны в истории удаления блокнотов. Повреждённый архив, неверный пароль или неподдерживаемая версия не перезапишут существующие данные. Архив не заменяет утраченный пароль или материалы для восстановления."
				}
			]
		},
		{
			"ID": "20261122113000-1buxl8f",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-1buxl8f",
				"updated": "20261122113000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Поддерживаемые и неподдерживаемые возможности"
				}
			]
		},
