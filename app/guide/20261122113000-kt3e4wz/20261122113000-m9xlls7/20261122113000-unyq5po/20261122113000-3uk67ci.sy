					},
					"Children": [
						{
							"ID": "20261122113000-usl00av",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-usl00av",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Пока блокнот разблокирован, плагины, API, инструменты MCP и ИИ-агенты могут читать блоки контента, получать список документов и выполнять полнотекстовый поиск внутри блокнота"
								}
							]
						}
					]
				}
			]
		},
		{
