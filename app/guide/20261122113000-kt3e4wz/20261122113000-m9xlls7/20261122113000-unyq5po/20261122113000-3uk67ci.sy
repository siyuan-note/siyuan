			},
			"Children": [
				{
					"ID": "20261122113000-mhmisaj",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-mhmisaj",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-sz72ejf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-sz72ejf",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Нажмите на закрытый зашифрованный блокнот в панели документов и введите мастер-пароль, чтобы разблокировать и открыть его. Каждый зашифрованный блокнот разблокируется отдельно"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-5xm7yyj",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-5xm7yyj",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-dtdmto1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-dtdmto1",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Закрытие зашифрованного блокнота автоматически блокирует его. Перед закрытием сохраняются несохранённые правки и история файлов; блокировка прекращает новый доступ к содержимому, дожидается завершения или отменяет выполняющиеся задачи, отзывает доступ к ключам, закрывает подключения к базе данных и по возможности очищает управляемые приложением открытые кэши, временные файлы и токены доступа"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-lzobs8j",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-lzobs8j",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-opkeofn",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-opkeofn",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "После перезапуска приложения все зашифрованные блокноты остаются заблокированными, и для их открытия нужно заново ввести мастер-пароль"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-x5s6slk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-x5s6slk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Шифрование блокнотов"
				},
				{
					"Type": "NodeText",
					"Data": " можно задать время простоя в минутах до автоматической блокировки. Действия в интерфейсе текущей рабочей области сбрасывают таймер всех разблокированных зашифрованных блокнотов, тогда как фоновая синхронизация, индексация и другие фоновые задачи не сбрасывают его; значение 0 отключает автоблокировку."
				}
			]
		},
		{
			"ID": "20261122113000-s6pt5yr",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-s6pt5yr",
				"updated": "20261122113000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Мастер-пароль и резервное копирование ключей"
				}
			]
		},
		{
			"ID": "20261122113000-prk1elo",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-prk1elo",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-ilhiee2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-ilhiee2",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-y67w9ay",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-y67w9ay",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Все зашифрованные блокноты используют один общий мастер-пароль, но каждый блокнот имеет собственный ключ данных. Разблокировка одного блокнота не разблокирует остальные"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-zq6l1il",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-zq6l1il",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-5o456f5",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-5o456f5",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Перед сменой мастер-пароля необходимо закрыть все зашифрованные блокноты. Смена мастер-пароля лишь повторно защищает ключи данных каждого блокнота, не перешифровывая содержимое документов; по завершении система автоматически обновляет резервную копию ключа в рабочей области — рекомендуется также сразу экспортировать новую резервную копию ключа"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-fnc0mo7",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-fnc0mo7",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-wloi3zf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-wloi3zf",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если одновременно скомпрометированы старый мастер-пароль и синхронизированная копия, резервная копия или исторический снимок со старой ключевой информацией, старый мастер-пароль всё ещё сможет расшифровать существующие данные, использующие тот же ключ данных. При подозрении на утечку старого мастер-пароля экспортируйте содержимое в открытом виде, импортируйте его в новый зашифрованный блокнот с новым ключом данных и после проверки переноса надёжно удалите открытые файлы"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-n0v29oq",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-n0v29oq",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-a1t17lg",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-a1t17lg",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При утере локальной конфигурации, восстановлении на новом устройстве или появлении в интерфейсе сообщения о необходимости восстановления конфигурации импортируйте резервную копию ключа и введите соответствующий мастер-пароль. Сама резервная копия ключа не содержит мастер-пароль"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-kxf7q9d",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-kxf7q9d",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-75w9zw5",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-75w9zw5",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Система может проверить целостность резервной копии ключа, но не может определить, какая копия является самой новой. Храните за пределами рабочей области отдельные резервные копии ключа с указанием версии"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-st7fqiz",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-st7fqiz",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-09urerq",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-09urerq",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если существуют зашифрованные блокноты или восстанавливаемая история, всё ещё зависящая от текущего ключа, система не позволит отключить функцию зашифрованных блокнотов. Рабочую область с подключённой синхронизацией нельзя отключить от шифрования даже при приостановленной синхронизации, чтобы защитить резервную копию ключа, от которой могут зависеть другие устройства"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-ywieyn2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ywieyn2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Изменение, экспорт и импорт ключа выполняются в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
