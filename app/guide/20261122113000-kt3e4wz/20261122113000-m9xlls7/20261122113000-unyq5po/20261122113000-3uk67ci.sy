					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-e2sbjob",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-8nf8i8m",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-8nf8i8m",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Синхронизация сохраняет и передаёт зашифрованные данные вместе с резервной копией ключа; на новом устройстве состояние включения шифрования восстанавливается автоматически, но состояние разблокировки не синхронизируется — всё равно потребуется ввести мастер-пароль"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-ixj6o30",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-ixj6o30",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-hll7p9f",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-hll7p9f",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "История документов поддерживает зашифрованные данные: для просмотра или отката сначала нужно разблокировать соответствующий блокнот, а для восстановления удалённого блокнота дополнительно требуются подходящая резервная копия ключа и мастер-пароль"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-e9i6p8d",
					"Type": "NodeListItem",
					"ListData": {
