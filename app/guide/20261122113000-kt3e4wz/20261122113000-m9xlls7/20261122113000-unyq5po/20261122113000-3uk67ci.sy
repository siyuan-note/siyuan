								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Зашифрованное содержимое не попадает в глобальный поиск, глобальный граф связей, семантический поиск и векторные эмбеддинги"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-s0ve3tn",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
