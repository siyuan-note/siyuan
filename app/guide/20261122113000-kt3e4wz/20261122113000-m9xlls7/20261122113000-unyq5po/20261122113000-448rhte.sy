		{
			"ID": "20261122113000-la2lpt9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-la2lpt9",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Настройка "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Щелчок по значку документа"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Щелчок по заголовку родительского документа"
				},
				{
					"Type": "NodeText",
					"Data": " позволяет определить действие при одиночном щелчке или касании в дереве документов или области закреплённых документов: при выборе «Развернуть или свернуть дочерние документы» ожидание двойного щелчка не требуется; при выборе «Развернуть или свернуть дочерние документы по одиночному щелчку, открыть родительский документ по двойному» двойной щелчок или двойное касание открывает родительский документ с сохранением состояния развёрнутости или свёрнутости, а одиночный щелчок ожидает около 300 мс для определения двойного щелчка (открыть родительский документ по-прежнему можно через меню документа). При разворачивании сначала загружаются дочерние документы, а затем отображаются по мере готовности данных; при длительном ожидании на месте стрелки показывается индикатор загрузки, и повторное нажатие на стрелку во время загрузки отменяет разворачивание. При отсутствии дочерних документов одиночный щелчок или касание заголовка сразу открывает документ; щелчок по значку документа с открываемым документом открывает документ, иначе изменяет значок; значок блокнота всегда служит для изменения значка."
				}
			]
		},
