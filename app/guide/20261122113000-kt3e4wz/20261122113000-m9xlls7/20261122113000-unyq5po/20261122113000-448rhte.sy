				{
					"Type": "NodeText",
					"Data": "Навигация с клавиатуры в окне настроек"
				}
			]
		},
		{
			"ID": "20261122113000-m8qq1qp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-m8qq1qp",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В настольной версии в окне "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " из поля поиска нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Tab"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы последовательно переводить фокус на видимые категории, а затем перейти к элементам управления справа. Нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift+Tab"
				},
				{
					"Type": "NodeText",
					"Data": " для перемещения назад и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " или "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Space"
				},
				{
					"Type": "NodeText",
					"Data": " для открытия текущей выбранной категории."
				}
			]
		},
