		{
			"ID": "20261122113000-6hy9oh7",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-6hy9oh7",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажатие клавиши со стрелкой на границе ячейки таблицы перемещает фокус в соседнюю ячейку; если в этом направлении ячейки нет, фокус переходит к соседнему содержимому документа за пределами таблицы. На границе документа фокус остаётся внутри ячейки."
				}
			]
		},
