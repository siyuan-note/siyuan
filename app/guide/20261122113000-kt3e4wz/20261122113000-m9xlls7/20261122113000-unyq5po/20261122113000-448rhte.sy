		{
			"ID": "20261122113000-c1y2uqi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-c1y2uqi",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если для блока кода ещё не задано отдельно "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Количество пробелов табуляции"
				},
				{
					"Type": "NodeText",
					"Data": ", при выполнении отступа или его уменьшения единый стиль отступов определяется минимум по двум непустым строкам кода и сохраняется как настройка этого блока кода. Поддерживается распознавание табуляции или пробельных отступов с минимальной шириной 2, 4, 6 или 8 пробелов, кратных этому значению. При смешанных отступах или недостатке данных используется "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поведение"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Количество пробелов табуляции"
				},
				{
					"Type": "NodeText",
					"Data": ". Явные настройки уровня блока имеют приоритет. Автоопределение не переформатирует существующий код."
				}
			]
		},
