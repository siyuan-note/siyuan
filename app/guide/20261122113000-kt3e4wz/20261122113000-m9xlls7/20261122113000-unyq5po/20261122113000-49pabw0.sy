				}
			]
		},
		{
			"ID": "20261122113000-j9s9tcn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-j9s9tcn",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После выделения содержимого используйте сочетание клавиш для копирования "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "C"
				},
				{
					"Type": "NodeText",
					"Data": "​ — в буфер обмена будет скопирован стандартный текст Markdown."
				}
			]
		},
		{
			"ID": "20261122113000-r0fzg13",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-r0fzg13",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если вам нужно скопировать содержимое в формате HTML, откройте меню "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "︙"
				},
				{
					"Type": "NodeText",
					"Data": "​ в правом верхнем углу вкладки редактора, выберите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Переключить режим"
				},
				{
					"Type": "NodeText",
					"Data": "​, переключитесь в режим "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Предварительный экспорт"
				},
				{
					"Type": "NodeText",
					"Data": "​ и затем выполните копирование."
				}
			]
		},
		{
