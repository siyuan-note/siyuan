				}
			]
		},
		{
			"ID": "20261122113000-80jsnig",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-80jsnig",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Markdown"
				}
			]
		},
		{
			"ID": "20261122113000-gf2s6kq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-gf2s6kq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Можно импортировать файлы или папки Markdown. При переносе данных из других программ их можно предварительно экспортировать в Markdown; для источников со специальным разделом импорта также можно воспользоваться соответствующим пунктом. Перед импортом проверьте пути к файлам ресурсов и расширенный синтаксис."
				}
			]
		},
		{
			"ID": "20261122113000-ojob1id",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ojob1id",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При импорте Markdown определения сносок вида [^note]: преобразуются в отдельные элементы нумерованного списка, а [^note] в основном тексте — в надстрочные ссылки на блоки. Нажатие на ссылку открывает определение, а обратная ссылка в определении позволяет вернуться к ссылающемуся блоку текста. Несколько абзацев внутри сноски сохраняются в одном элементе списка. Для сносок без соответствующего определения ссылки на блоки не создаются, а примеры кода и экранированный синтаксис сносок сохраняются как буквальный текст."
				}
			]
		},
		{
			"ID": "20261122113000-4ijo8pt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-4ijo8pt",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если при импорте встречается синтаксис изображения вида "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "![foo](images/bar.png)"
				},
				{
					"Type": "NodeText",
					"Data": "​ (локальный относительный путь), SiYuan преобразует "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​ в"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-mg7cuep",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "ресурсов"
				},
				{
					"Type": "NodeText",
					"Data": ". Однако если это "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".images/bar.png"
				},
				{
					"Type": "NodeText",
					"Data": "​, преобразование не выполняется, так как файлы по путям, начинающимся с "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "."
				},
				{
					"Type": "NodeText",
					"Data": "​, относятся к скрытым файлам, и SiYuan их не обрабатывает."
				}
			]
		},
		{
			"ID": "20261122113000-giszb8h",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-giszb8h",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если необходимо распознавать элементы расширенного синтаксиса (например, надстрочный индекс "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "^foo^"
				},
				{
					"Type": "NodeText",
					"Data": "​, подстрочный индекс "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~foo~"
				},
				{
					"Type": "NodeText",
					"Data": "​, теги "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#foo#"
				},
				{
					"Type": "NodeText",
					"Data": "​ и формулы "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$foo$"
				},
				{
					"Type": "NodeText",
					"Data": "​ и т. п.), включите в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Синтаксис Markdown"
				},
				{
					"Type": "NodeText",
					"Data": " соответствующие переключатели."
				}
			]
		},
		{
			"ID": "20261122113000-gcojo87",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-gcojo87",
