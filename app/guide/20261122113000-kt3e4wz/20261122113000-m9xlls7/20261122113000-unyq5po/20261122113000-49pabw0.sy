								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Экспорт"
								},
								{
									"Type": "NodeText",
									"Data": " параметр «Включать автонумерацию блоков заголовков при экспорте Markdown» по умолчанию отключён: при копировании и экспорте Markdown нумерация опускается без изменения документа или настроек редактора. Когда он включён, при наличии нумерации в документе вывод Markdown будет содержать номера. Копирование сразу использует эту сохранённую настройку без показа окна выбора нумерации; на другие форматы экспорта это не влияет."
								}
							]
						}
					]
