		},
		{
			"ID": "20261122113000-q5ibiwg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-q5ibiwg",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Как на настольных, так и на мобильных устройствах в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Приложение"
				},
				{
					"Type": "NodeText",
					"Data": " можно выполнять импорт и экспорт данных. При этом экспорт полностью копирует папку "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "рабочее пространство/data/"
				},
				{
					"Type": "NodeText",
					"Data": " и упаковывает её в архив ZIP."
				}
			]
		},
		{
			"ID": "20261122113000-8nm9ncj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-8nm9ncj",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Импорт Data"
				},
				{
					"Type": "NodeText",
					"Data": " поддерживает только архивы Data, экспортированные описанным выше способом. Импорт копирует файлы по путям из архива в текущую папку "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "рабочее пространство/data/"
				},
				{
					"Type": "NodeText",
					"Data": " рабочего пространства:"
				}
			]
		},
