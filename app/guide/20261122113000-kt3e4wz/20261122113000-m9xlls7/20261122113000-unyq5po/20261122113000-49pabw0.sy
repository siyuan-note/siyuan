					]
				}
			]
		},
		{
			"ID": "20261122113000-es7ouq4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-es7ouq4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Примечание"
				},
				{
					"Type": "NodeText",
					"Data": "​: будьте внимательны перед использованием, чтобы избежать безвозвратной перезаписи существующих данных."
				}
			]
		},
		{
			"ID": "20261122113000-r5826h2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-r5826h2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Архив Data.zip позволяет напрямую обновить текущее рабочее пространство без создания нового. Перед импортом архив анализируется; при конфликте зашифрованных блокнотов можно выбрать вариант по умолчанию «Пропустить конфликты», «Перезаписать конфликты» или отменить операцию. Перед перезагрузкой интерфейса в результатах импорта отображаются ID пропущенных блокнотов. Операцию можно отменить до подтверждения; во время выполнения подтверждённого импорта отменить его или закрыть диалоговое окно импорта нельзя."
				}
			]
		},
		{
			"ID": "20261122113000-6zdda63",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-6zdda63",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Для импорта зашифрованного содержимого требуется ввести совместимый мастер-пароль. Резервные копии, созданные до смены пароля, можно прочитать с помощью совместимого предыдущего ключа без отката текущего пароля. Блокноты с разным состоянием шифрования или разными ключами данных нельзя объединить напрямую. Перезапись заменяет только файлы с совпадающими путями, сохраняет уникальные файлы в целевом расположении и не распространяет удаления; импортированные зашифрованные блокноты остаются заблокированными и требуют повторной разблокировки."
				}
			]
		},
		{
			"ID": "20261122113000-b5au1mg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-b5au1mg",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При импорте сначала проверяется выбранное содержимое, затем записываются данные; при сбое или прерывании возможен откат. Загруженный исходный архив, перезаписанные файлы и ключевые данные сохраняются в каталоге рабочего пространства conf/data-imports/; сохраняйте эти файлы восстановления до проверки импортированного содержимого и необходимой истории. При сбое восстановления запись и синхронизация приостанавливаются до успешного восстановления. Неподтверждённая предварительная проверка истекает через 30 минут и очищается при запуске или следующем импорте, при этом отменить её можно даже после истечения срока; файлы восстановления для подтверждённых пакетов сохраняются."
				}
			]
		},
		{
			"ID": "20261122113000-5ixbhhx",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-5ixbhhx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": ".sy.zip"
				}
			]
		},
		{
			"ID": "20261122113000-c28maf9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-c28maf9",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " — это собственный формат документов SiYuan. Выбрав целевой блокнот или документ в дереве документов, используйте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Импорт"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "SiYuan .sy.zip"
				},
				{
					"Type": "NodeText",
					"Data": " для выбора архива. Импортированные документы сохраняют содержимое, указанные в настройках дочерние документы, файлы ресурсов и атрибуты блоков."
				}
			]
		},
		{
			"ID": "20261122113000-s5qtepk",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
