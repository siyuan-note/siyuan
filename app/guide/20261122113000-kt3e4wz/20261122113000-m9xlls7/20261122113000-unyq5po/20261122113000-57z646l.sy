									"TextMarkTextContent": "workspace_dir_host"
								},
								{
									"Type": "NodeText",
									"Data": ": путь к папке рабочего пространства на хосте"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-ham88py",
					"Type": "NodeListItem",
					"Data": "*",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Padding": 2,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-ham88py",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-91bueq6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-91bueq6",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "workspace_dir_container"
								},
								{
									"Type": "NodeText",
									"Data": ": путь к папке рабочего пространства внутри контейнера (укажите таким же, как далее в "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace"
								},
								{
									"Type": "NodeText",
									"Data": ")"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-m6bw6jp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-m6bw6jp",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Например, создайте на хосте каталог "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": ", а затем выполните "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v /siyuan/workspace:/siyuan/workspace -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE -e PUID=1000 -e PGID=1000 b3log/siyuan serve --workspace=/siyuan/workspace"
				},
				{
					"Type": "NodeText",
					"Data": ". Пути на хосте и внутри контейнера могут различаться. После запуска откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "http://server-ip:6806"
				},
				{
					"Type": "NodeText",
					"Data": " и войдите с заданным ранее паролем; при сбое запуска проверьте журналы контейнера."
				}
			]
		},
		{
			"ID": "20261122113000-4cqw917",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-4cqw917",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Права пользователя"
				}
			]
		},
		{
			"ID": "20261122113000-9mot9r9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9mot9r9",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Скрипту точки входа требуются права на создание или повторное использование пользователя и группы, а также на рекурсивную установку владельца для "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/opt/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": ", "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/home/siyuan"
				},
				{
					"Type": "NodeText",
					"Data": " и рабочего пространства, после чего он запускает ядро через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "su-exec"
				},
				{
					"Type": "NodeText",
					"Data": " от имени "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "PUID:PGID"
				},
				{
					"Type": "NodeText",
					"Data": ", причём оба идентификатора по умолчанию равны "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "1000"
				},
				{
					"Type": "NodeText",
					"Data": ". Чтобы сопоставить владельца с хостом, можно передать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-e PUID=1000 -e PGID=1000"
				},
				{
					"Type": "NodeText",
					"Data": ", заменив их на соответствующие числовые ID. Не добавляйте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-u 1000:1000"
				},
				{
					"Type": "NodeText",
					"Data": ", иначе скрипт точки входа не сможет настроить права. Изменение владельца также затрагивает примонтированный каталог хоста."
				}
			]
		},
		{
			"ID": "20261122113000-2n30cbi",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-2n30cbi",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Скрытие порта"
				}
			]
		},
		{
			"ID": "20261122113000-buhj1xf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-buhj1xf",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Порт 6806 можно скрыть с помощью обратного прокси NGINX. Обратите внимание на следующее:"
				}
			]
		},
		{
			"ID": "20261122113000-p5dkfnq",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-p5dkfnq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-4jidfci",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-4jidfci",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-vfxbcn7",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-vfxbcn7",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Настройка обратного прокси для WebSocket "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/ws"
								},
								{
									"Type": "NodeText",
									"Data": "​"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-ce8oita",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261122113000-spd9j9r",
							"Type": "NodeParagraph",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Обратный прокси как для обычных запросов, так и для "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/ws"
								},
								{
									"Type": "NodeText",
									"Data": " должен сохранять исходный заголовок "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Host"
								},
								{
									"Type": "NodeText",
									"Data": " вместе с портом — задайте в обеих секциях проксирования NGINX параметр "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "proxy_set_header Host $http_host;"
								},
								{
									"Type": "NodeText",
									"Data": ". Использование "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "$host"
								},
								{
									"Type": "NodeText",
									"Data": " приведёт к потере нестандартного порта (например, "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "8443"
								},
								{
									"Type": "NodeText",
									"Data": "), что может вызвать ошибку проверки источника: после входа страница застрянет на логотипе с бесконечной перезагрузкой, API будет возвращать "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "401"
								},
								{
									"Type": "NodeText",
									"Data": " либо подключение WebSocket завершится сбоем"
								}
							],
							"Properties": {
								"id": "20261122113000-spd9j9r",
								"updated": "20261122113000"
							}
						}
					],
					"Properties": {
						"id": "20261122113000-ce8oita",
						"updated": "20261122113000"
					}
				},
				{
					"ID": "20261122113000-lgadt1v",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261122113000-pr1t8a9",
							"Type": "NodeParagraph",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Задайте в обеих секциях проксирования параметр "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "proxy_set_header X-Forwarded-For $remote_addr;"
								},
								{
									"Type": "NodeText",
									"Data": ", чтобы ядро получало реальный адрес клиента. Не передавайте без изменения заголовок "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "X-Forwarded-For"
								},
								{
									"Type": "NodeText",
									"Data": ", предоставленный вызывающей стороной, иначе удалённый клиент может быть ошибочно принят за локального администратора"
								}
							],
							"Properties": {
								"id": "20261122113000-pr1t8a9",
								"updated": "20261122113000"
							}
						}
					],
					"Properties": {
						"id": "20261122113000-lgadt1v",
						"updated": "20261122113000"
					}
				}
			]
		},
