		{
			"ID": "20261122113000-6ksx2t9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-6ksx2t9",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Точка входа"
				}
			]
		},
		{
			"ID": "20261122113000-7q1cduh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7q1cduh",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Точка входа образа — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "ENTRYPOINT [\"/opt/siyuan/entrypoint.sh\"]"
				},
				{
					"Type": "NodeText",
					"Data": ", а команда по умолчанию — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "CMD [\"serve\"]"
				},
				{
					"Type": "NodeText",
					"Data": ". Аргументы, переданные после имени образа, заменяют команду по умолчанию, поэтому при передаче параметров ядра необходимо явно указывать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-sbqfsev",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-sbqfsev",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если основной сервис использует порт, отличный от 6806, SiYuan также запускает обратный прокси на порту 6806 (когда он свободен), чтобы расширения браузера могли подключаться по фиксированному адресу. Если в команду "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": " добавить флаг "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--fixed-port=false"
				},
				{
					"Type": "NodeText",
					"Data": ", этот дополнительный обратный прокси будет отключён; значение по умолчанию — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--fixed-port=true"
				},
				{
					"Type": "NodeText",
					"Data": ". Основной сервис по-прежнему прослушивает порт, указанный в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--port"
				},
				{
					"Type": "NodeText",
					"Data": " (включая 6806), и сервис публикации также не затрагивается. После отключения клиенты, подключавшиеся через этот обратный прокси, должны переключиться на фактический порт основного сервиса. Чтобы вернуть обратный прокси, удалите этот параметр или задайте ему значение true и перезапустите ядро."
				}
			]
		},
		{
			"ID": "20261122113000-l92bz58",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-l92bz58",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед запуском создайте каталог рабочего пространства на хосте и настройте аутентификацию. В следующем примере надёжный пароль блокировки экрана считывается из экспортированной на хосте переменной окружения "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SIYUAN_ACCESS_AUTH_CODE"
				},
				{
					"Type": "NodeText",
					"Data": "; новое рабочее пространство Docker откажется запускаться без пароля или корректной настройки "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-8q8xgxj",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Вход через OIDC"
				},
				{
					"Type": "NodeText",
					"Data": ". Например, вы можете конфиденциально ввести выбранный пароль в Bash, как показано ниже. Не записывайте реальные пароли в общие файлы или историю команд; пользователи с правами просмотра окружения контейнера всё равно смогут прочитать это значение."
				}
			]
		},
		{
			"ID": "20261122113000-40qj7gr",
			"Type": "NodeCodeBlock",
			"Properties": {
				"id": "20261122113000-40qj7gr",
				"updated": "20261122113000"
			},
			"IsFencedCodeBlock": true,
			"CodeBlockFenceChar": 96,
			"CodeBlockFenceLen": 3,
			"CodeBlockOpenFence": "YGBg",
			"CodeBlockInfo": "YmFzaA==",
			"CodeBlockCloseFence": "YGBg",
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YmFzaA=="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "read -r -s -p \"Пароль блокировки: \" SIYUAN_ACCESS_AUTH_CODE\nprintf '\\n'\nexport SIYUAN_ACCESS_AUTH_CODE\n: \"${SIYUAN_ACCESS_AUTH_CODE:?Задайте непустой пароль блокировки}\"\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```",
					"CodeBlockFenceLen": 3
				}
			]
		},
		{
			"ID": "20261122113000-52un5ie",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-52un5ie",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-sdkcme3",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-sdkcme3",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-o9ez2wi",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-o9ez2wi",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace"
								},
								{
									"Type": "NodeText",
									"Data": " задаёт путь к папке рабочего пространства, которая на хосте с помощью флага "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "-v"
								},
								{
									"Type": "NodeText",
									"Data": " монтируется внутрь контейнера"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-ycxjemd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ycxjemd",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Дополнительные параметры см. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-9thjz6g",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "здесь"
				},
				{
					"Type": "NodeText",
					"Data": ". Ниже приведён пример команды запуска: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "docker run -d -v workspace_dir_host:workspace_dir_container -p 6806:6806 -e SIYUAN_ACCESS_AUTH_CODE b3log/siyuan serve --workspace=workspace_dir_container"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeText",
					"Data": ". При развёртывании через Docker с включённым сервисом публикации, помимо проброса основного порта сервера, в команду создания контейнера необходимо добавить "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "-p 6808:6808"
				},
				{
					"Type": "NodeText",
					"Data": ". Формат проброса портов Docker — «порт_хоста:порт_контейнера»; при изменении порта сервиса публикации нужно синхронно изменить порт контейнера, а для доступа использовать порт хоста. Указывайте фиксированный порт сервиса публикации и не задавайте 0."
				}
			]
		},
		{
			"ID": "20261122113000-8ztrm6c",
			"Type": "NodeList",
			"ListData": {
				"Tight": true,
				"BulletChar": 42,
				"Padding": 2,
				"Marker": "Kg==",
				"Num": -1
			},
			"Properties": {
