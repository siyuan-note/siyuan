								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Microsoft: укажите URL издателя для вашего клиента (tenant), ID клиента и при необходимости секрет клиента согласно настройкам приложения"
								}
