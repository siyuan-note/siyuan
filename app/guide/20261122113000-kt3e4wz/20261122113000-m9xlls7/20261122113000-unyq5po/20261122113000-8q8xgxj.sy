			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "URL обратного вызова"
				}
			]
		},
		{
			"ID": "20261122113000-q9puvy5",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-q9puvy5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-ksp8611",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-ksp8611",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-t3b4517",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-t3b4517",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Локальный браузер и десктопное приложение: URL обратного вызова использует текущий локальный протокол доступа SiYuan; при включённом HTTPS это "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "https://127.0.0.1:<порт>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": ", а без HTTPS — "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "http://127.0.0.1:<порт>/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": ". Адрес, зарегистрированный у провайдера удостоверений, должен в точности совпадать по протоколу, хосту, порту, пути и завершающему слешу"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-u99rn79",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-u99rn79",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-v9m9j2v",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-v9m9j2v",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Удалённый браузер: укажите публичный HTTPS-адрес в поле URL обратного вызова OIDC; путь должен быть ровно "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/api/system/oidc/callback"
								},
								{
									"Type": "NodeText",
									"Data": ", без параметров запроса, фрагментов или учётных данных"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-v8hpoaw",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-v8hpoaw",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-7yyu1g8",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-7yyu1g8",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Нативные мобильные клиенты: всегда используется "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan:/oidc-callback"
								},
								{
									"Type": "NodeText",
									"Data": "; этот адрес нужно зарегистрировать у провайдера удостоверений без изменений. Google не принимает такой формат обратного вызова, поэтому вход через Google поддерживается только в браузере и на десктопе"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-r4fhpd9",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-r4fhpd9",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Область действия (Scope)"
				}
			]
		},
		{
			"ID": "20261122113000-dsjse2r",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-dsjse2r",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Область действия по умолчанию — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "openid profile email"
				},
				{
					"Type": "NodeText",
					"Data": ". Обычно изменять её не требуется; перед настройкой собственной области убедитесь, что возвращаемые провайдером утверждения (claims) по-прежнему удовлетворяют правилам допуска. Для GitHub область по умолчанию автоматически преобразуется в права, необходимые для чтения профиля пользователя и подтверждённого адреса электронной почты."
				}
			]
		},
		{
			"ID": "20261122113000-g1r252k",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-g1r252k",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Правила допуска"
				}
			]
		},
		{
			"ID": "20261122113000-m7mdk5n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-m7mdk5n",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если отключить параметр «Предоставить права администратора всем аутентифицированным пользователям», необходимо настроить хотя бы одно правило допуска. Правила задаются в виде JSON-массива: несколько "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "values"
				},
				{
					"Type": "NodeText",
					"Data": " внутри одного правила объединяются логикой «ИЛИ», а разные правила между собой — логикой «И»; "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "operator"
				},
				{
					"Type": "NodeText",
					"Data": " поддерживает "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "equals"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "contains"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
