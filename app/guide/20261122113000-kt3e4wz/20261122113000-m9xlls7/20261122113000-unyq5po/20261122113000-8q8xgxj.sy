								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Зарегистрируйте приложение у провайдера удостоверений, получите ID клиента и при необходимости создайте секрет клиента"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-wkeqi0i",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-wkeqi0i",
						"updated": "20261122113000"
					},
					"Children": [
						{
