					},
					"Children": [
						{
							"ID": "20261122113000-ioiqvbe",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-ioiqvbe",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "GitHub: укажите ID клиента и секрет клиента OAuth App; SiYuan автоматически скорректирует область действия (scope) по умолчанию"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-eg594kt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-eg594kt",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При создании приложения и регистрации URL обратного вызова обратитесь к "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "документации Google OpenID Connect",
					"TextMarkAHref": "https://developers.google.com/identity/openid-connect/openid-connect"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "документации по регистрации приложений Microsoft Entra",
					"TextMarkAHref": "https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "a",
					"TextMarkTextContent": "документации GitHub OAuth App",
					"TextMarkAHref": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
				},
				{
					"Type": "NodeText",
					"Data": ". Интерфейс консоли провайдера может меняться — ориентируйтесь на его актуальную документацию."
				}
			]
		},
		{
			"ID": "20261122113000-ztjvnz1",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
