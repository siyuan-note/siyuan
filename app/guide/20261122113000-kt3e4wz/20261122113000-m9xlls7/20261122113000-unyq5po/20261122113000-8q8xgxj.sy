							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-3t4bspr",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Google: укажите ID клиента и секрет клиента Google OAuth; URL издателя SiYuan подставит автоматически (фиксированный адрес Google)"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-73cw888",
