		},
		{
			"ID": "20261122113000-3ietfpq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-3ietfpq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После включения OIDC нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Проверить и сохранить"
				},
				{
					"Type": "NodeText",
					"Data": ". SiYuan откроет системный браузер, и новая конфигурация активируется только после одного успешного реального входа с прохождением правил допуска; при ошибке проверки продолжит действовать прежняя конфигурация. Изменение настроек OIDC аннулирует все текущие сессии OIDC — пользователям потребуется войти заново."
				}
			]
		},
