							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-jq2lmpo",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Определите необходимые URL обратного вызова для браузера, десктопного и мобильного приложений и зарегистрируйте каждый из них у провайдера удостоверений"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-cwfjfrc",
					"Type": "NodeListItem",
					"ListData": {
						"Tight": true,
						"BulletChar": 42,
						"Marker": "Kg==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-cwfjfrc",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-u4ltips",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-u4ltips",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Сохраните рабочий пароль блокировки браузера или локальный способ доступа, чтобы из-за ошибки конфигурации не заблокировать себе удалённый доступ"
								}
							]
						}
					]
				}
			]
		},
