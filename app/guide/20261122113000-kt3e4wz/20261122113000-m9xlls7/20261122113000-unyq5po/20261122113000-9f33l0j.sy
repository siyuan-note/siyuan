					"Children": [
						{
							"ID": "20261122113000-16ecuad",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-16ecuad",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "​"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "markdown2content"
								},
								{
									"Type": "NodeText",
									"Data": "​ преобразует значение поля в формате Markdown в текстовое содержимое (сохраняя код, формулы и т. п., со вставкой переносов строк между блочными узлами)"
								}
