				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "dGVtcGxhdGU="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": ".action{define \"child-review\"}\n## Разбор\n.action{end}\n\n.action{createDocTree (list\n  (dict \"title\" \"Материалы\" \"template\" \"children/material.md\"\n    \"children\" (list (dict \"title\" \"Выдержки\")))\n  (dict \"title\" \"Разбор\" \"define\" \"child-review\")\n)}\n\n.action{range $doc := renderDocRef \"children\" .id}\n- ((.action{$doc.RootID} \".action{$doc.HPath}\"))\n.action{end}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
