					]
				},
				{
					"ID": "20261122113000-4oqjwv1",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-4oqjwv1",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-kksery3",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-kksery3",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "​"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "countif"
								},
								{
									"Type": "NodeText",
									"Data": "​ подсчитывает количество элементов в списке чисел, удовлетворяющих заданному условию сравнения: первый аргумент — список чисел, второй — оператор сравнения ("
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "gt"
								},
								{
									"Type": "NodeText",
									"Data": "​/"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "lt"
								},
								{
									"Type": "NodeText",
									"Data": "​/"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "eq"
								},
								{
									"Type": "NodeText",
									"Data": "​/"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "ge"
								},
								{
									"Type": "NodeText",
									"Data": "​/"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "le"
								},
								{
									"Type": "NodeText",
									"Data": "​), третий — пороговое значение для сравнения. Например:"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "countif .values \"gt\" 0"
								},
								{
									"Type": "NodeText",
									"Data": "​"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-hrbxetq",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261122113000-hrbxetq",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-kxa10gq",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-kxa10gq",
