		{
			"ID": "20261122113000-nv5qn1n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-nv5qn1n",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "serve"
				},
				{
					"Type": "NodeText",
					"Data": " — параметр "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": " задаёт рабочее пространство. Если оно не указано, последовательно используются переменная окружения "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SIYUAN_WORKSPACE_PATH"
				},
				{
					"Type": "NodeText",
					"Data": ", последнее зарегистрированное рабочее пространство и системный каталог по умолчанию: в macOS — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/Library/Application Support/SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": ", в Windows — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "%USERPROFILE%\\SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": ", на остальных платформах — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/SiYuan"
				},
				{
					"Type": "NodeText",
					"Data": ". "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--home-dir"
				},
				{
					"Type": "NodeText",
					"Data": " изменяет домашний каталог пользователя, используемый для конфигурации и путей по умолчанию. Правила выбора для обычных разовых команд CLI отличаются; подробнее см. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-ytl8rub",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Интерфейс командной строки"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
