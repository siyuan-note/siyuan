			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Каталог ресурсов программы, содержащий "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "appearance/"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "stage/"
				},
				{
					"Type": "NodeText",
					"Data": "; если не указан, определяется автоматически по исполняемому файлу ядра. Он отличается от пути, который задаёт параметр "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": " для каталога данных."
				}
			]
		},
