				{
					"ID": "20261122113000-foru211",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 3,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20261122113000-foru211",
						"updated": "20261122172348"
					},
					"Children": [
						{
							"ID": "20261122113000-o11d2l1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-o11d2l1",
								"updated": "20261122172348"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При использовании "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "/Написать с ИИ"
								},
								{
									"Type": "NodeText",
									"Data": ", чтобы открыть диалог написания. При ИИ-редактировании выделите текст и нажмите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Редактирование с ИИ"
								},
								{
									"Type": "NodeText",
									"Data": ", или выберите «Редактирование с ИИ» в меню блока. Результат можно скопировать или вставить после исходного блока. Генерацию можно перезапустить или остановить. При редактировании модель получает ID исходных блоков, а для выделенного фрагмента — также ближайший контекст. Перетащите панель за заголовок, чтобы переместить её, или за правый нижний угол, чтобы изменить размер. Двойной щелчок по заголовку восстанавливает исходный размер и привязку к блоку. На мобильном устройстве перетащите верхний край нижней панели, чтобы изменить её высоту. Чтобы продолжить работу над результатом, нажмите «Продолжить в чате с агентом». В новый сеанс будут переданы исходная инструкция, исходный текст и текущий результат. Продолжив диалог, вы сможете вставить ответ в исходное место, пока редактор открыт"
								}
							]
						}
					]
				}
			]
		},
