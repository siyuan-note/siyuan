			"Children": [
				{
					"Type": "NodeText",
					"Data": "Игнорирование содержимого"
				}
			]
		},
		{
			"ID": "20261122113000-ena1v2a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ena1v2a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Чтобы исключить часть документов, создайте или отредактируйте в файловой системе текстовый файл "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Рабочее_пространство/data/.siyuan/embeddingignore"
				},
				{
					"Type": "NodeText",
					"Data": ". В каждой строке укажите путь для игнорирования с поддержкой синтаксиса gitignore. Например:"
				}
			]
		},
