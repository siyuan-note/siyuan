						"Marker": "MS4=",
						"Num": 1
					},
					"Properties": {
						"id": "20261122113000-fjl4pd6",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-vbxp2oz",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-vbxp2oz",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Перетащите блок контента из документа в поле ввода агента, чтобы вставить ссылку на блок"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-qb0f0zb",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 2,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "Mi4=",
						"Num": 2
					},
					"Properties": {
						"id": "20261122113000-qb0f0zb",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-acd2mid",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-acd2mid",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Ввести "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "[["
								},
								{
									"Type": "NodeText",
									"Data": " в поле ввода и найти блок содержимого"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-634bjjo",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
						"Start": 3,
						"Delimiter": 46,
						"Padding": 3,
						"Marker": "My4=",
						"Num": 3
					},
					"Properties": {
						"id": "20261122113000-634bjjo",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-i99or2y",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-i99or2y",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Выделить блок содержимого и добавить через "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Добавить в чат агента"
								},
								{
									"Type": "NodeText",
									"Data": " в меню значка блока"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-w8uonw7",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-w8uonw7",
				"updated": "20261122172348"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Отправка и остановка задач"
				}
			]
		},
		{
			"ID": "20261122113000-okhvdbm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-okhvdbm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После ввода запроса по умолчанию нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Ctrl"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌘Enter"
				},
				{
					"Type": "NodeText",
					"Data": " для отправки; горячую клавишу также можно настроить."
				},
				{
					"Type": "NodeText",
					"Data": "Во время работы агента можно нажать кнопку остановки, чтобы прервать текущую задачу. При автоматическом повторе исходная карточка размышлений сохраняется и дополняется. После остановки уже отображённое содержимое сохраняется, пока сервер завершает сохранение и восстановление, но уже выполненные операции не отменяются. При слишком медленном соединении генерация может прерваться — переоткройте сеанс, чтобы восстановить сохранённое содержимое. Чем точнее описаны цель, область и желаемое место вывода, тем стабильнее результат."
				}
			]
		},
		{
			"ID": "20261122172348-mqlu8zj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122172348-mqlu8zj",
				"updated": "20261122172348"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Выделите текст в заметке и выберите «Процитировать в чате с агентом». Чтобы процитировать сообщение в чате, нажмите кнопку цитирования рядом с ним. Чтобы процитировать фрагмент, выделите его, отпустите кнопку мыши или поднимите палец и нажмите «Цитировать текст» рядом с выделением. Цитаты отображаются прямо в тексте инструкции. Можно добавить несколько цитат и удалить любую из них. Нажмите на отправленную цитату, чтобы перейти к источнику."
				}
			]
		},
		{
			"ID": "20261122172348-lf0sbgi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122172348-lf0sbgi",
				"updated": "20261122172348"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите «Быстрые фразы» рядом с полем ввода и выберите фразу, чтобы отправить её вместе с текущим черновиком. Быстрые фразы и редактирование с ИИ используют общие пользовательские действия. Кнопка «Управлять» позволяет добавлять, изменять и удалять их. В шаблоне {{input}} обозначает текущий черновик."
				}
			]
		},
		{
			"ID": "20261122113000-6ixyw88",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-6ixyw88",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "И на настольной, и на мобильной версии можно продолжать ввод во время работы локального сеанса. Отправка в этот момент добавляет сообщение и снимок ссылок в очередь, которую можно просматривать над полем ввода и отменять по одному элементу. После завершения обычного ответа сообщения отправляются по порядку с использованием модели и настроек подтверждения на момент отправки. Остановка, ошибка или переключение сеанса приостанавливают очередь; после возврата в сеанс её можно продолжить кнопкой отправки над очередью. Сообщения в очереди хранятся только в памяти текущего интерфейса и теряются при обновлении или выходе. Если сеанс выполняется в другом экземпляре, на этом устройстве можно редактировать черновик, но нельзя добавлять в очередь отправки."
				}
			]
		},
		{
			"ID": "20261122113000-5hk6ha2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5hk6ha2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Когда приложение не в фокусе или скрыто, операции, ожидающие подтверждения, вопросы, ожидающие ответа, и успешно завершённые ответы могут вызывать системные уведомления; их доставка зависит от клиента и системных разрешений на уведомления. При блокировке экрана или разрыве соединения продолжение выполнения задачи не гарантируется."
				}
			]
		},
		{
			"ID": "20261122113000-lpdjf8a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-lpdjf8a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При работе настольного приложения Windows нажатие на уведомление о подтверждении восстанавливает исходное окно рабочего пространства, открывает соответствующий сеанс агента и подсвечивает карточку подтверждения или вопроса. Нажатие служит только для навигации и не отправляет черновик или подтверждение операции; черновик и неотправленные правки сообщения до переключения сохраняются и восстанавливаются при возврате. Если изображения ещё загружаются, переход дождётся завершения загрузки. Если цель уже обработана, устарела или недоступна, появится подсказка без восстановления прав подтверждения. Эта функция не включает запуск приложения после выхода и не поддерживает переходы по уведомлениям на мобильных устройствах или в браузере."
				}
			]
		},
		{
			"ID": "20261122113000-8ptm8x3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-8ptm8x3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В текущем раунде диалога агент проверяет подходящие встроенные операции чтения, а также повторяющиеся вызовы с ошибкой или пустым возвратом в окне наблюдения за последние 10 подходящих вызовов. Если один и тот же инструмент с одинаковыми параметрами возвращает одинаковый результат 3 раза суммарно, модели предлагается скорректировать стратегию; при 5 повторах вызов инструментов останавливается. При изменении результата для той же цели счётчик цели сбрасывается, а успешная запись или взаимодействие пользователя сбрасывает окно наблюдения. Эта защита охватывает лишь ограниченный спектр повторяющихся вызовов и не распознаёт все случаи отсутствия прогресса."
				}
			]
		},
		{
			"ID": "20261122113000-q4tezhr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-q4tezhr",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После достижения лимита раундов вызова инструментов или остановки из-за повторяющихся вызовов, если модель не дала содержательного текстового ответа, система отобразит и сохранит явное уведомление о прерывании, указывая, что текущая задача может быть не завершена. Остановка вызова инструментов не означает завершение задачи и не отменяет уже выполненные операции."
				}
			]
		},
		{
			"ID": "20261122113000-urxdwit",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-urxdwit",
				"updated": "20261122115000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В клиенте для Android нажатие кнопки «Вставить изображение» под полем ввода в первую очередь открывает системную галерею. Кнопка «Выбрать изображение из файлов» рядом позволяет выбрать файлы из папок. Оба способа поддерживают множественный выбор и загрузку изображений в форматах PNG, JPEG, GIF и WebP."
				}
			]
		},
		{
			"ID": "20261122113000-gevx0m3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-gevx0m3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Поле ввода по умолчанию автоматически увеличивается по высоте с текстом и изображениями, а после достижения доступного предела высоты панели появляется прокрутка. На настольной версии при наведении курсора на область ввода сверху отображается небольшой маркер, на сенсорных устройствах он виден постоянно. Перетаскивание маркера задаёт фиксированную высоту для текущего сообщения, даже пустое поле ввода можно растянуть вверх; минимальная высота полностью вмещает одну строку текста, максимальная ограничена доступным пространством панели. После отправки сообщения очищенное поле ввода возвращается к исходной высоте, а следующее сообщение снова автоматически увеличивается. В процессе редактирования можно дважды щёлкнуть по маркеру для возврата к автоматическому увеличению высоты. В начале и конце содержимого сохраняется запас прокрутки для полного просмотра первой и последней строк."
				}
			]
		},
		{
			"ID": "20261122113000-wqb03u2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wqb03u2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Когда маркер высоты получает фокус с клавиатуры, нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "↑"
				},
				{
					"Type": "NodeText",
					"Data": " или "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "↓"
				},
				{
					"Type": "NodeText",
					"Data": " для увеличения или уменьшения высоты, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Home"
				},
				{
					"Type": "NodeText",
					"Data": " для установки минимальной высоты, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "End"
				},
				{
					"Type": "NodeText",
					"Data": " для установки текущей максимально доступной высоты; во время перетаскивания нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " для отмены изменения."
				}
			]
		},
		{
			"ID": "20261122113000-1nafawg",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-1nafawg",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Подтверждение операций"
				}
			]
		},
		{
			"ID": "20261122113000-a782gy5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-a782gy5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Операции только локального чтения и поиска обычно выполняются сразу. Создание, изменение, перемещение, удаление, импорт данных или отправка сетевых запросов отображают карточку подтверждения в соответствии с настройками возможностей и указывают возможную локальную запись, передачу данных вовне и внешние расходы. Онлайн-поиск, извлечение веб-страниц, облачные входящие и онлайн-запросы к маркету также отправляют внешние запросы; прямое извлечение веб-страниц и HTTP-запросы могут также записывать загруженные файлы в рабочее пространство. Метка расходов означает, что может использоваться платная служба, а не обязательную оплату каждого вызова. Дозагрузка ресурсов по требованию или создание снимка перед записью также могут обращаться к поставщику синхронизации и записывать локальные ресурсы. Если после подтверждения добавляется локальная запись, передача данных вовне или расходы, вызов прерывается и требует повторного подтверждения по текущей конфигурации. Можно подтвердить выполнение, отклонить или выбрать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Разрешить сессию"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы отменить пошаговое подтверждение обычных операций в этом сеансе. Возможности, для которых задано обязательное подтверждение, и изменения фрагментов кода по-прежнему требуют подтверждения."
				}
			]
		},
		{
			"ID": "20261122113000-5bvgiln",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5bvgiln",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При использовании "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Разрешить сессию"
				},
				{
					"Type": "NodeText",
					"Data": " следует убедиться, что область текущей задачи и используемые инструменты надёжны, так как обычные операции записи больше не будут подтверждаться по одной; указанные выше обязательные подтверждения сохраняют силу."
				}
			]
		},
		{
			"ID": "20261122113000-jigchgw",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-jigchgw",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Управление сеансами"
				}
			]
		},
		{
			"ID": "20261122113000-1g0lujx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-1g0lujx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Агент поддерживает создание, поиск, переключение, переименование и удаление сеансов. В сеансах сохраняются сообщения, ссылки, вызовы инструментов и результаты выполнения, которые можно синхронно просматривать между разными экземплярами."
				}
			]
		},
		{
			"ID": "20261122113000-3n7xi5n",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-3n7xi5n",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Можно отредактировать уже отправленное сообщение и отправить его заново или попросить агента ответить повторно. Повторная отправка удаляет историю диалога после этого сообщения, но не отменяет уже выполненные операции; для восстановления данных используйте соответствующий снимок данных."
				}
			]
		},
		{
			"ID": "20261122113000-bj0ddof",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-bj0ddof",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Модель и уровень размышлений"
				}
			]
		},
		{
			"ID": "20261122113000-aucl98l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-aucl98l",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Под полем ввода можно переключать включённые модели и выбирать уровень размышлений для поддерживаемых моделей. В сеансах с рассуждениями или вызовами инструментов после смены модели качество ответов и непрерывность вызовов инструментов могут снизиться."
				}
			]
		},
		{
			"ID": "20261122113000-qmsdqby",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-qmsdqby",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Кнопка использования контекста показывает долю использованного контекста в текущем сеансе и детализацию по категориям. Когда контекст приближается к лимиту модели, агент пытается сжать более раннюю часть диалога."
				}
			]
		},
		{
			"ID": "20261122113000-5sgb92y",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-5sgb92y",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Навыки"
				}
			]
		},
		{
			"ID": "20261122113000-8et7a16",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-8et7a16",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Навыки — это набор переиспользуемых инструкций для задач, задающих процесс, формат или предметные правила. Каждый навык использует отдельный каталог и содержит "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": ", сохраняемый в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Рабочее_пространство/data/storage/ai/agent/skills/"
				},
				{
					"Type": "NodeText",
					"Data": ". Также можно по отдельности включать навыки только для чтения из домашнего каталога пользователя "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~/.agents/skills/"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-w7os7sx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-w7os7sx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " может определять "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "name"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "description"
				},
				{
					"Type": "NodeText",
					"Data": " в YAML Front Matter, а основной текст описывает шаги и требования, которым должен следовать агент. При включённом меню слэша ввод "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " позволяет искать и выбирать установленные навыки. На мобильных устройствах меню слэша по умолчанию отключено, а навыки можно выбрать через панель плюса на панели инструментов клавиатуры; на панель плюса переключатель меню слэша не влияет."
				}
			]
		},
		{
			"ID": "20261122113000-7m6obtm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7m6obtm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Можно напрямую попросить агента вывести список, создать, обновить, переименовать или удалить навык. При установке навыка можно указать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": ", полную команду "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": ", адрес GitHub, исходный адрес "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "SKILL.md"
				},
				{
					"Type": "NodeText",
					"Data": " или адрес ZIP. Навыки влияют на способ выполнения задач агентом, поэтому устанавливайте и используйте содержимое только из надёжных источников."
				}
			]
		},
		{
			"ID": "20261122113000-hb9lcyw",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-hb9lcyw",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Установка внешних навыков"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-volmrz8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-volmrz8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "npx skills add owner/repo -g"
				},
				{
					"Type": "NodeText",
					"Data": " и адреса репозиториев (например, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "https://github.com/owner/repo"
				},
				{
					"Type": "NodeText",
					"Data": ") устанавливаются целиком как весь репозиторий: сначала пробуется "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "main"
				},
				{
					"Type": "NodeText",
					"Data": ", при ошибке загрузки — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "master"
				},
				{
					"Type": "NodeText",
