				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Правила обнаружения"
				}
			]
		},
		{
			"ID": "20261122113000-tv1ezut",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-tv1ezut",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Поиск выполняется по ключевым словам из текста якоря/текста целевого блока существующих ссылок, имён и псевдонимов блоков; если эти ключевые слова найдены в обычных текстовых элементах текущего блока содержимого, они отмечаются как виртуальные ссылки."
				}
			]
		},
		{
			"ID": "20261122113000-emww9hu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-emww9hu",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Диапазон поиска ключевых слов можно настроить в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поиск"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Виртуальные ссылки"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-pyjlgw8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pyjlgw8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "На опубликованной странице виртуальные ссылки ведут только на те блоки, к которым у вас есть доступ. При сопоставлении по якорному тексту ссылки у вас также должен быть доступ к документу, в котором находится ссылка."
				}
			]
		},
		{
