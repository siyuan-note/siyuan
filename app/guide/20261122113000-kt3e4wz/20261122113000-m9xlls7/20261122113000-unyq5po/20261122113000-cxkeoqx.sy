			"Children": [
				{
					"Type": "NodeText",
					"Data": "Обзор"
				}
			]
		},
		{
			"ID": "20261122113000-1cnsph4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-1cnsph4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Виртуальные ссылки отмечают в редакторе потенциально связанный текст на основе текста якоря существующих ссылок, имён блоков содержимого и другой информации, поддерживая всплывающий предпросмотр. Это лишь подсказка о связи — фактическая ссылка на блок автоматически не создаётся."
				}
			]
		},
		{
			"ID": "20261122113000-txc77s2",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-txc77s2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Способ использования"
				}
			]
		},
		{
			"ID": "20261122113000-db0tone",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-db0tone",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Двусторонние ссылки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Виртуальные ссылки"
				},
				{
					"Type": "NodeText",
					"Data": " и включите переключатель."
