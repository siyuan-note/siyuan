								{
									"Type": "NodeText",
									"Data": "Имена полей: включите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Макет"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Показать имя поля"
								},
								{
									"Type": "NodeText",
									"Data": " в настройках вида, чтобы отображать имя поля рядом со значением неключевых полей, при этом первичный ключ по-прежнему служит заголовком записи. Этот параметр по умолчанию выключен и сохраняется для каждого вида календаря; после выключения снова отображаются только значения полей"
								}
							]
