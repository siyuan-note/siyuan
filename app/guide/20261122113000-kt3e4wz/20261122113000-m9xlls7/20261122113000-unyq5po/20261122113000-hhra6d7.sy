			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Назначение и возможности полей см. "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-4x02oe8",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Типы полей"
				},
				{
					"Type": "NodeText",
					"Data": "; статистику в нижней части столбцов см. "
