							"ID": "20261122113000-7bb5rtv",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-7bb5rtv",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Удаление фильтра"
								},
								{
									"Type": "NodeText",
									"Data": ": нажмите кнопку удаления справа от условия фильтра, чтобы удалить одно условие; через меню фильтра можно очистить все одним нажатием"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-ybhiq7h",
