							"Properties": {
								"id": "20261122113000-qv58i80",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Управление столбцами"
								},
								{
									"Type": "NodeText",
									"Data": ": каждый столбец соответствует полю; поддерживается перетаскивание для изменения ширины и порядка столбцов; правый клик по заголовку столбца позволяет редактировать, удалять и скрывать поле"
								}
							]
						}
					]
				},
