					"Data": "。"
				}
			]
		},
		{
			"ID": "20261122113000-19zcyou",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-19zcyou",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Шаблон отображения"
				}
			]
		},
		{
			"ID": "20261122113000-wh8xbzk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wh8xbzk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Для обычных полей можно настроить шаблон отображения без смены типа поля. Откройте меню поля в заголовке столбца и введите шаблон в поле ввода шаблона внизу. Шаблон отображения меняет только представление; при редактировании ячейки по-прежнему считывается и записывается исходное хранимое значение. Поля шаблона, сводки, номера строки, времени создания и времени обновления не поддерживают шаблоны отображения."
				}
			]
		},
		{
			"ID": "20261122113000-uio2uuy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-uio2uuy",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Шаблон отображения использует тот же синтаксис Go-шаблонов, что и фрагменты шаблонов, с разделителями "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": " и может содержать HTML. Например, если в поле прогресса хранится значение 42, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;progress value=\".action{.Прогресс}\" max=\"100\"&gt;&lt;/progress&gt; .action{.Прогресс}%"
				},
				{
					"Type": "NodeText",
					"Data": " отобразит индикатор выполнения на 42% и текст 42%. HTML по умолчанию проходит безопасную фильтрацию."
				}
			]
		},
		{
			"ID": "20261122113000-9ui7gws",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9ui7gws",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Можно ссылаться на другие поля той же строки по имени. Например, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;strong&gt;.action{.Название}&lt;/strong&gt;: .action{.Прогресс}%"
				},
				{
					"Type": "NodeText",
					"Data": " объединит поля названия и прогресса. Если имя поля содержит пробелы или символы, используйте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index . \"Название проекта\"}"
				},
				{
					"Type": "NodeText",
					"Data": ". Чтобы избежать неоднозначности при совпадении или переименовании полей, можно ссылаться по ID поля с помощью "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{index .id_mod \"ID_поля\"}"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-xrkk0ha",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-xrkk0ha",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Шаблон отображения считывает исходные хранимые значения полей и не читает результаты шаблонов отображения других полей. Для фильтрации, сортировки и группировки можно выбрать использование исходного значения или отрендеренного шаблоном значения. Очистите шаблон отображения, чтобы вернуть исходный способ показа поля. Поле связи следует шаблону отображения первичного ключа целевой базы данных, включая пустой результат, при этом исходное значение первичного ключа и связь сохраняются."
				}
			]
		},
		{
			"ID": "20261122113000-mq4paxe",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-mq4paxe",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Автоматизация"
				}
			]
		},
		{
			"ID": "20261122113000-n26c5tw",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-n26c5tw",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Настройка правил"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-wx0opp5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wx0opp5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Автоматизация"
				},
				{
					"Type": "NodeText",
					"Data": " в виде базы данных и добавьте правило. Изменения сохраняются автоматически, текст сохраняется при потере фокуса или нажатии Enter. Новое правило по умолчанию отключено; при неполной конфигурации оно автоматически отключается с подсказкой о недостающих пунктах — после заполнения включите его вручную. Правила общие для всей базы данных, и изменение записи в любом виде или зеркале может их запускать"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20261122113000-9x5oq94",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9x5oq94",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После удаления или смены типа поля, на которое есть ссылка, либо удаления целевой базы данных последующая запись в элемент автоматически отключит затронутое правило и покажет имя правила и недействительную ссылку. Изменения пользователя сохраняются штатно, а конфигурация правила остаётся; после исправления конфигурации правило нужно включить вручную. При блокировке базы данных, сбое аутентификации, повреждении данных или ошибке записи изменения пользователя и автоматические действия откатываются вместе."
				}
			]
		},
		{
			"ID": "20261122113000-0jqyz8s",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0jqyz8s",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "«Уведомлять при успешном выполнении» включено по умолчанию и настраивается отдельно для каждого правила. Уведомление показывается только тогда, когда автоматическое добавление, обновление или сбор действительно внесли изменения и вся транзакция успешно зафиксирована; одна транзакция объединяется в одно сообщение, учитываются только правила с включённым уведомлением, а обновление нескольких полей одной записи считается как одна запись. Отключение уведомлений не останавливает выполнение и не скрывает ошибки. При несоответствии условиям, отсутствии цели, неизменённом значении, повторном совпадении, ручном сборе или очистке, отмене/повторе и неудачных транзакциях уведомление об успехе не отправляется."
				}
			]
		},
		{
			"ID": "20261122113000-q5ubu9a",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-q5ubu9a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Условия срабатывания"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-a4hy1ep",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-a4hy1ep",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Настройка разделена на три блока: «Когда происходит следующее событие», «И триггерная запись удовлетворяет следующим условиям (необязательно)» и «Выполнить следующие действия». Сначала выберите событие добавления записи или изменения поля; изменение поля может отслеживать указанное поле или любое редактируемое поле, повторная запись того же значения не срабатывает. Второй блок проверяет значения полей триггерной записи после изменения; если условия не заданы, ограничений нет."
				}
			]
		},
		{
			"ID": "20261122113000-10iz1jh",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-10iz1jh",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Действия и присваивание"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-knjydvl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-knjydvl",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Каждое правило может содержать несколько действий, выполняемых по порядку. Сначала выберите операцию и объект операции, затем добавьте настраиваемые поля и способ присваивания. Операция изменения поддерживает триггерную запись, связанные записи или подходящие записи в выбранной базе данных; условия внутри действия фильтруют изменяемые записи отдельно от условий триггерной записи, а при отсутствии целевых условий подходят все записи выбранной цели. Операция добавления создаёт непривязанную запись в текущей или другой базе данных."
				}
			]
		},
		{
			"ID": "20261122113000-epc9m99",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-epc9m99",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Значением поля в действии может быть фиксированное значение, совместимое по типу исходное поле, время срабатывания, связь с триггерной записью или вычисление по шаблону. Время срабатывания подходит для поля даты; связь с триггерной записью — для поля связи, указывающего на исходную базу данных. Изменение текста первичного ключа сохраняет существующую привязку и значок."
				}
			]
		},
		{
			"ID": "20261122113000-xk8iq53",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-xk8iq53",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Присваивание с помощью шаблона"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-5tqc1au",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5tqc1au",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После выбора способа присваивания «Шаблон» можно редактировать шаблон "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{...}"
				},
				{
					"Type": "NodeText",
					"Data": " прямо в строке. Редактирование шаблона приостанавливает правило — после завершения включите его снова. Шаблоны поддерживаются для всех редактируемых полей; вычисляемые поля (время создания, время обновления, номер строки, сводка и поле шаблона) присваивание не поддерживают. Первичный ключ изменяет только текст, сохраняя существующую привязку."
				}
			]
		},
		{
			"ID": "20261122113000-6a6iz3a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-6a6iz3a",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Например, взяв в качестве триггерной записи задачу полива цветов со статусом «Выполнено», создайте следующую задачу и задайте дату как "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{((now).AddDate 0 0 7).Format \"2006-01-02\"}"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "now"
				},
				{
					"Type": "NodeText",
					"Data": " фиксируется как текущее время срабатывания,"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate 0 0 7"
				},
				{
					"Type": "NodeText",
					"Data": " сдвигается на семь календарных дней вперёд. При первом использовании шаблона в правиле сохраняется текущий часовой пояс интерфейса, который продолжает использоваться при выполнении на других устройствах."
				}
			]
		},
		{
			"ID": "20261122113000-f2c5qtd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-f2c5qtd",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "field \"ID_поля\""
				},
				{
					"Type": "NodeText",
					"Data": " считывает хранимое значение исходной записи, дата может участвовать в вычислениях "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "AddDate"
				},
				{
					"Type": "NodeText",
					"Data": "; переименование поля не влияет на ссылку по ID."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "value \"ID_поля\""
				},
				{
					"Type": "NodeText",
					"Data": " считывает структурированную нагрузку,"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "toJson"
				},
				{
					"Type": "NodeText",
					"Data": " выводит JSON. Например,"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{toJson (dateAdd 0 0 7 (value \"ID_поля\"))}"
				},
				{
					"Type": "NodeText",
					"Data": " одновременно сдвигает начало и конец диапазона дат, сохраняя настройку только даты или точного времени."
				}
			]
		},
		{
			"ID": "20261122113000-15aa73i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-15aa73i",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Текст, ссылка, email и телефон используют текстовый результат, число должно быть допустимым конечным числовым значением, флажок использует "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "true"
				},
				{
					"Type": "NodeText",
					"Data": " или "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "false"
				},
				{
					"Type": "NodeText",
					"Data": ". Дата принимает дату ISO, дату и время или JSON нагрузки даты; одиночный выбор использует имя существующего варианта, множественный выбор — JSON-массив имён или массив вариантов; связь — массив ID существующих записей; ресурс и местоположение — существующий JSON нагрузки. Варианты, связанные записи и ресурсы автоматически не создаются."
				}
			]
		},
		{
			"ID": "20261122113000-1i6ca53",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-1i6ca53",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Раскройте «Данные для предпросмотра», выберите реальную запись в качестве примера, измените дату предпросмотра или ссылаемые поля и посмотрите результат предпросмотра. Эти входные данные влияют только на предпросмотр и не изменяют реальную запись. Допустимый пустой вывод очищает поле; отсутствующая переменная, пустая исходная дата, ошибка типа или ссылки вызывают откат триггерного изменения вместе со всеми автоматическими действиями."
				}
			]
		},
		{
			"ID": "20261122113000-z7fl7hk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-z7fl7hk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Результат шаблона записывается только при срабатывании, а повтор использует первый результат. Шаблоны не поддерживают SQL, файлы, циклы или рекурсию; правила с HTTP выполняются после сохранения правки. Исходный код — до 8 КиБ, ввод и вывод одного поля — до 64 КиБ. После сохранения шаблона база данных требует клиент с поддержкой автоматизации версии 2, старые версии явно откажутся её читать; прежние правила версии 1 сохраняют совместимость."
				}
			]
		},
		{
			"ID": "20261122113000-0ffua4z",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0ffua4z",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Выберите исходное поле по имени в редакторе шаблона и нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Вставить ссылку на поле"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы вставить в позицию курсора стабильную ссылку по ID поля, которая сохранит работоспособность после переименования поля; нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Скопировать ИД"
				},
				{
					"Type": "NodeText",
					"Data": " для копирования ID выбранного поля. Эта кнопка также доступна на мобильных устройствах."
				}
			]
		},
		{
			"ID": "20261122113000-azdqh73",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-azdqh73",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Ручное выполнение"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-esih6yk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-esih6yk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Выберите триггер "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Вручную"
				},
				{
					"Type": "NodeText",
					"Data": ", добавьте действие записи в обычное поле, задайте способ присваивания "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Шаблон"
				},
				{
					"Type": "NodeText",
					"Data": " и включите правило. Нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Выполнить сейчас"
				},
				{
					"Type": "NodeText",
					"Data": " для обработки всех сохранённых записей, соответствующих условиям правила. Результаты можно просматривать офлайн, повторное открытие базы данных не запрашивает данные заново. Выполнение по расписанию пока не предоставляется."
				}
			]
		},
		{
			"ID": "20261122113000-uutw5f3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-uutw5f3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Выражения .action{...} в ручных правилах поддерживают httpGet и fromJson. Например, следующий шаблон записывает возвращённый заголовок слайда в текстовое поле:"
				}
			]
		},
		{
			"ID": "20261122113000-01c31wx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-01c31wx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{$r := httpGet \"https://httpbingo.org/json\"}.action{(fromJson $r.body).slideshow.title}"
				}
			]
		},
		{
			"ID": "20261122113000-yifcu1p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-yifcu1p",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Сетевые запросы требуют подтверждения в текущем окне и подчиняются HTTP-ограничениям шаблонов. Постоянное разрешение привязывается к сохранённой версии правила и может быть отозвано на панели автоматизации. Интерфейс ручного выполнения сохраняет каждую подходящую запись независимо: все действия одной записи либо выполняются вместе, либо сохраняют прежние значения, не затрагивая другие успешные записи. Каждая запись считывает снимок хранилища на тот момент, и все действия этой записи используют его; изменения базы данных во время получения данных отклоняют устаревший результат. Отмена и повтор используют сохранённые результаты без повторного запроса. Лимиты HTTP общие для партий: не более 1 000 записей полей и добавлений записей за раунд. Ручные шаблоны не предоставляют предпросмотр полей. Ручные правила требуют формата автоматизации 9; прежние форматы 1–8 по-прежнему читаются, а старые клиенты отклоняют формат 9 без перезаписи базы данных."
				}
			]
		},
		{
			"ID": "20261122113000-a8y8g7x",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-a8y8g7x",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Во время выполнения отображается количество успешных, неудачных, ожидающих и пропущенных записей, можно раскрыть список неудачных записей. «Повторить для неудачных и незавершённых записей» обрабатывает только эти записи, не дублируя уже успешные добавления. Лимиты запросов, размера ответа, общего времени и записи общие для партий; при достижении лимита, отказе в авторизации или закрытии панели дальнейшая обработка останавливается с сохранением уже зафиксированных результатов. Явный повтор открывает новый раунд бюджета. При потере ответа сначала запрашивается прогресс, затем продолжается запись. Прогресс привязан к текущему главному окну, действует пятнадцать минут и очищается при переходе блокнота к блокировке; после истечения срока сначала проверьте сохранённые значения и начните заново. Существующие вызовы API без явного включения поштучного режима сохраняют атомарную фиксацию всей партии и ответ null."
				}
			]
		},
		{
			"ID": "20261122113000-9z4838p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9z4838p",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Флажок можно использовать как переключатель обновления: отслеживайте его изменение с условием «отмечен», в том же правиле сохраняйте результат HTTP и снимайте флажок. Успешная запись не запускает повторно другие автоматизации; при сбое флажок и прежний результат сохраняются — можно снять и снова поставить флажок для повтора."
				}
			]
		},
		{
			"ID": "20261122113000-o4afhyx",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-o4afhyx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Автоматические сетевые запросы и функции форматирования"
				}
			],
			"HeadingLevel": 3
		},
		{
			"ID": "20261122113000-5zk38ky",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5zk38ky",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В триггерах добавления записи и изменения поля всё правило, содержащее httpGet, выполняет все действия после сохранения правки. Последовательные правки одной базы данных объединяются, а разрешение на сетевой доступ подтверждается текущим окном. При сбое сохраняются сохранённая правка и прежний результат; изменения базы данных во время ожидания отбрасывают устаревший результат. Полученные результаты сохраняются вместе и образуют отдельный шаг отмены: первая отмена откатывает результат, сохраняя ввод, а следующая отменяет сам ввод. Повтор использует сохранённые результаты без повторного сетевого запроса; запись результата не запускает другие автоматизации. Запись через API без интерактивного окна только сохраняет правку и не выполняет правила с HTTP. Выполнение по расписанию пока не предоставляется."
				}
			]
		},
		{
			"ID": "20261122113000-vw7u1d6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-vw7u1d6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Все шаблоны автоматизации поддерживают printf, urlquery, dict, toString и fromJson. printf поддерживает обычные спецификаторы формата и ограничивает ширину и точность скалярных аргументов, не поддерживая динамическую ширину (*) или индексацию аргументов; dict требует строковых ключей и полных пар ключ-значение. Эти вспомогательные функции принимают до 64 аргументов, сериализованный ввод и строковый вывод — до 64 КиБ. Новые функции форматирования и событийные правила HTTP требуют формата автоматизации 10. Прежние форматы 1–9 по-прежнему читаются, отключённые незавершённые шаблоны сохраняются как есть; старые клиенты отклоняют формат 10 без перезаписи базы данных."
				}
			]
		},
		{
			"ID": "20261122113000-3g4t3p6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-3g4t3p6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Например, сборка URL на основе исходного поля (замените FIELD_ID на ID поля):"
				}
			]
		},
		{
			"ID": "20261122113000-z269f01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-z269f01",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ".action{printf \"https://example.com?q=%s\" (urlquery (field \"FIELD_ID\"))}"
				}
			]
		},
		{
			"ID": "20261122113000-ef7s4nk",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-ef7s4nk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Примеры шаблонов"
				}
			]
		},
		{
			"ID": "20261122113000-u0rhruc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-u0rhruc",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Скопируйте полный пример в поле ввода шаблона."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "FIELD_ID"
				},
				{
					"Type": "NodeText",
					"Data": " — это заполнитель; замените его на ID исходного поля базы данных триггерной записи, а не на имя поля. При копировании поля исходное и целевое поля должны быть одного типа; при копировании связи оба поля связи должны указывать на одну и ту же базу данных."
				}
			]
		},
		{
			"ID": "20261122113000-2fgugbj",
			"Type": "NodeTable",
			"TableAligns": [
				0,
				0
			],
			"Properties": {
				"id": "20261122113000-2fgugbj",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTableHead",
					"Children": [
						{
							"Type": "NodeTableRow",
							"Children": [
								{
									"Type": "NodeTableCell",
									"Children": [
										{
											"Type": "NodeText",
											"Data": "Назначение"
										}
									]
								},
								{
									"Type": "NodeTableCell",
									"Children": [
										{
											"Type": "NodeText",
											"Data": "Содержимое шаблона"
										}
									]
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Дата: день срабатывания"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{now | date \"2006-01-02\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Дата: через семь дней после срабатывания"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{((now).AddDate 0 0 7).Format \"2006-01-02\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Дата: сдвиг исходной даты или диапазона на семь дней вперёд с сохранением настроек времени"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{toJson (dateAdd 0 0 7 (value \"FIELD_ID\"))}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Текст, первичный ключ, ссылка, email или телефон: копирование исходного поля"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{field \"FIELD_ID\"}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Текст или первичный ключ: добавление суффикса после исходного текста"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{field \"FIELD_ID\"} (в следующий раз)"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Число: прибавление единицы к исходному числу, поддерживаются десятичные дроби"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{addf (field \"FIELD_ID\") 1}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Флажок: противоположное значение исходного поля"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": ".action{not (field \"FIELD_ID\")}"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Одиночный выбор: установка существующего варианта"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Выполнено"
								}
							]
						}
					]
				},
				{
