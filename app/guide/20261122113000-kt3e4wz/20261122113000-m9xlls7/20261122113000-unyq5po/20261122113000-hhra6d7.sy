							"Children": [
								{
									"Type": "NodeText",
									"Data": "Множественный выбор: установка двух существующих вариантов"
								}
							]
						},
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "[\"Работа\",\"Важное\"]"
								}
							]
						}
					]
				},
				{
					"Type": "NodeTableRow",
					"Children": [
						{
							"Type": "NodeTableCell",
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Дата, множественный выбор, связь, ресурс или местоположение: копирование исходного поля того же типа"
								}
							]
						},
						{
