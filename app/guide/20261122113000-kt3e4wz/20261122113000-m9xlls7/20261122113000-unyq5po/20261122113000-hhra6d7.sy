							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-f2p5zgr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-f2p5zgr",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В мобильной версии нажмите на название текущего представления базы данных, чтобы открыть панель представлений. Когда редактор заблокирован, выбор представления позволяет временно переключиться на него. Для изменения настроек представления необходимо разблокировать редактор."
				}
			]
		},
		{
			"ID": "20261122113000-zypmefo",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-zypmefo",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Макет вида"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261122113000-u6ywn1o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-u6ywn1o",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "База данных"
				},
				{
					"Type": "NodeText",
					"Data": " настройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать значки записей в первичном ключе"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать значки записей в связях и сводках"
				},
				{
					"Type": "NodeText",
					"Data": ". Оба параметра включены по умолчанию и действуют только при создании новых баз данных и видов; изменение настроек по умолчанию не влияет на существующие виды."
				}
			]
		},
		{
			"ID": "20261122113000-j217twj",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-j217twj",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В меню "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макет"
				},
				{
					"Type": "NodeText",
					"Data": " текущего вида управляйте двумя типами значков через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать значки записей в первичном ключе"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Показывать значки записей в связях и сводках"
				},
				{
					"Type": "NodeText",
					"Data": ". При дублировании вида или переключении макета эти две настройки сохраняются."
				}
			]
		},
		{
			"ID": "20261122113000-vrm87u4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-vrm87u4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В меню "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Атрибут"
				},
				{
					"Type": "NodeText",
					"Data": " можно перетаскивать поля в пределах одной области для изменения порядка, а также перетаскивать между областями «Показанные поля» и «Скрытые поля», одновременно меняя видимость и позицию. Если область пуста, можно перетащить в нижнюю половину заголовка области. Заголовки областей, в которых уже есть поля, не принимают перетаскивание. Изменения поддерживают отмену и повтор. Поле первичного ключа в видах таблицы, списка и календаря скрыть нельзя."
				}
			]
		},
		{
			"ID": "20261122113000-m3xdmct",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-m3xdmct",
				"updated": "20261122174056"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Табличный вид"
				}
			]
		},
		{
			"ID": "20261122113000-la39ecw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-la39ecw",
				"updated": "20261122174056"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Вид базы данных по умолчанию, отображающий данные в виде таблицы со строками и столбцами. В настольном редакторе, когда полоса прокрутки внизу широкой таблицы выходит за пределы видимой области, перетаскивайте горизонтальную полосу прокрутки у нижнего края видимой области."
				}
			]
		},
		{
			"ID": "20261122113000-9mhdldr",
