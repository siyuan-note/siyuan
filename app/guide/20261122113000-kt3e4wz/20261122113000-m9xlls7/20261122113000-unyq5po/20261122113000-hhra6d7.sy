							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Способ переключения"
								},
								{
									"Type": "NodeText",
									"Data": ": после создания базы данных по умолчанию используется табличный вид; для переключения из другого вида выберите «Табличный вид» в выпадающем меню"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-srhxv4z",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
