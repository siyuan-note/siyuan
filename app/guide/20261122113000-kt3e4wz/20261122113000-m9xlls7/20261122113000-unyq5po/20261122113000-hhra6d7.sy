									"Children": [
										{
											"ID": "20261122113000-oc5q82j",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-oc5q82j",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Таблица и список: после группировки строки распределяются по группам, каждую группу можно сворачивать и разворачивать"
												}
											]
										}
									]
								},
								{
									"ID": "20261122113000-cg6nipb",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20261122113000-cg6nipb",
										"updated": "20261122113000"
									},
									"Children": [
										{
											"ID": "20261122113000-mh688x9",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-mh688x9",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Вид карточек: после группировки карточки распределяются по группам"
												}
											]
										}
									]
								},
								{
									"ID": "20261122113000-lwxi9ew",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20261122113000-lwxi9ew",
										"updated": "20261122113000"
									},
									"Children": [
										{
											"ID": "20261122113000-m3sv8i7",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-m3sv8i7",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Канбан: группировка обязательна, каждое значение группы образует столбец; отмена группировки не поддерживается. Если полем группировки является одиночный или множественный выбор, перетаскивание карточки в другой столбец автоматически изменяет значение поля (кроме полей шаблона, времени создания и времени обновления)"
												}
											]
										}
									]
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-6ug0tb7",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-6ug0tb7",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-qjoa5t8",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-qjoa5t8",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Удаление группировки"
								},
								{
									"Type": "NodeText",
									"Data": ": в видах таблицы, списка и карточек можно выбрать «Нет» для отмены группировки; в канбане отмена невозможна"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-03plrc1",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-03plrc1",
				"updated": "20261122113000"
			},
			"HeadingLevel": 2,
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Макет и сортировка панели базы данных"
				}
			]
		},
		{
			"ID": "20261122113000-mdh9ybz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-mdh9ybz",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "База данных"
				},
				{
					"Type": "NodeText",
					"Data": " выберите «Одна колонка», «Две колонки (по строкам)» или «Две колонки (по столбцам)» в параметре «Макет полей панели базы данных» (по умолчанию «Две колонки (по строкам)»). Эта настройка одновременно действует для панели базы данных вверху документа и панели отдельной записи; при нехватке места автоматически используется одна колонка, а смена макета не меняет порядок полей. После привязки непривязанной записи на панели, если включено отображение свойств базы данных, панель открывает редактор привязанного блока. На панели уже привязанной записи кнопка перепривязки не отображается — меняйте привязку в виде базы данных."
				}
			]
		},
		{
			"ID": "20261122113000-su6m6xy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-su6m6xy",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При расположении по строкам поля отображаются слева направо и сверху вниз. Перетащите мышью маркер слева от поля в ячейку целевого поля для предпросмотра нового порядка в реальном времени; после отпускания порядок сохраняется. При расположении по столбцам сначала сверху вниз отображается левый столбец, затем правый; видимые поля делятся поровну по количеству (при нечётном числе в левом столбце на одно больше), а редактирование содержимого поля не вызывает автоматического переноса в другой столбец. В макетах по столбцам и в одну колонку горизонтальная линия-индикатор показывает позицию вставки сверху или снизу. Отмена перетаскивания возвращает исходный порядок; сортировка полей поддерживает отмену и повтор."
				}
			]
		},
		{
			"ID": "20261122113000-5l9gwkh",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-5l9gwkh",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Видимость полей панели базы данных"
				}
			]
		},
		{
			"ID": "20261122113000-88odhx6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-88odhx6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите на имя поля на панели свойств базы данных вверху документа, на странице записи базы данных или в диалоге свойств блока, чтобы задать «Видимость поля на панели базы данных»: «Всегда показывать», «Скрывать, если пусто» или «Всегда скрывать». «По умолчанию» сохраняет прежнюю настройку панели, при этом панель вверху документа использует глобальную настройку скрытия пустых полей. Правило действует для панели свойств этой базы данных и не влияет на видимость полей в видах базы данных. Нажатие кнопки редактирования на панели временно раскрывает скрытые поля для редактирования значений или изменения правила отображения."
				}
			]
		},
		{
			"ID": "20261122113000-7bxffh0",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-7bxffh0",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Значок записи"
				}
			]
		},
		{
			"ID": "20261122113000-wf73px6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wf73px6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Непривязанные записи могут иметь собственный значок — нажмите на значок рядом с первичным ключом, в деталях записи или в поле связи, чтобы изменить или очистить его. Шаблон записи может заранее задавать значок для непривязанных записей и записей документов. Непривязанные записи без пользовательского значка отображают короткое тире, при этом настройки отображения значков вида сохраняют силу."
				}
			]
		},
		{
			"ID": "20261122113000-xrxgvo5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-xrxgvo5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "При привязке или перепривязке к обычному блоку без пользовательского значка блок наследует значок записи. Если у обычного блока уже есть значок или привязка выполняется к существующему документу, используется собственный значок целевого блока. Новый документ, созданный при привязке, наследует значок, заданный у записи; если у записи значок не задан, используется значок шаблона документа. После привязки запись и привязанный блок делят один значок. Отмена привязки сохраняет последний отображавшийся значок, после чего его можно менять независимо."
				}
			]
		},
		{
			"ID": "20261122113000-a0gltwd",
			"Type": "NodeHeading",
			"Properties": {
				"id": "20261122113000-a0gltwd",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Шаблон записи"
				}
			],
			"HeadingLevel": 2
		},
		{
			"ID": "20261122113000-tiud0b0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-tiud0b0",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откройте выпадающее меню рядом с кнопкой создания записи и выберите «Новый шаблон» для настройки шаблона записи. Можно заранее задать тип записи, значок, содержимое первичного ключа и значения полей; для записи документа также можно задать место сохранения, шаблон содержимого и скрытие в дереве документов."
				}
			]
		},
		{
			"ID": "20261122113000-t23z4k1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-t23z4k1",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Выберите шаблон из того же меню, чтобы создать запись по его настройкам. Меню «Ещё» шаблона позволяет редактировать, назначить по умолчанию и удалить шаблон; обычное создание записи использует шаблон по умолчанию, также можно выбрать пустую запись. Изменение шаблона не затрагивает уже созданные записи."
				}
			]
		},
		{
			"ID": "20261122113000-pvo8ye0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pvo8ye0",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Шаблон записи служит для предзаполнения содержимого при создании, а поле шаблона — для вычисления значений полей существующих записей в виде; их назначение различно. Для поля даты можно заранее задать фиксированное время или текущее время на момент создания."
				}
			]
		},
		{
			"ID": "20261122113000-pyw2vmv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pyw2vmv",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В шаблоне записи через выпадающее меню "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Открывать элемент после создания"
				},
				{
					"Type": "NodeText",
					"Data": " выберите «Не открывать» (по умолчанию), «Открыть» (в текущей панели) или «Разделить вправо». Поддерживается как для привязанных, так и для свободных записей; для привязанного документа фокус сначала переходит на редактируемый заголовок, в остальных случаях — на первичный ключ. На мобильных устройствах оба способа открытия используют существующую страницу или всплывающее окно."
				}
			]
		},
		{
			"ID": "20261122113000-in0s6zn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-in0s6zn",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Существующие шаблоны сохраняют прежнее поведение открытия, если этот параметр не изменён. Создание пустой записи без шаблона следует поведению вида; при необходимости можно создать шаблон пустой свободной записи и назначить его по умолчанию."
				}
			]
		},
		{
			"ID": "20261122113000-mru7msm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-mru7msm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Зеркальная база данных"
				}
			]
		},
		{
			"ID": "20261122113000-zn668l8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-zn668l8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Копирование и вставка блока базы данных создаёт зеркальную базу данных: эти блоки используют общие данные, и изменение данных в любом из них синхронизируется со всеми остальными зеркалами."
				}
			]
		},
		{
			"ID": "20261122113000-rmmg68f",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-rmmg68f",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Связи и сводки"
				}
			]
		},
		{
			"ID": "20261122113000-f9mkopz",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-f9mkopz",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Две базы данных можно связать через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Связь"
				},
				{
					"Type": "NodeText",
					"Data": "​ для совместного управления. Например, связь между двумя базами данных "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Авторы"
				},
				{
					"Type": "NodeText",
					"Data": "​ и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Книги"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20261122113000-zti70j8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-zti70j8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Панель выбора связей на настольной и мобильной версиях всегда предоставляет кнопку создания и применяет шаблон по умолчанию связанной базы данных. Если введённое имя отличается от имени, сгенерированного шаблоном первичного ключа, отображаются два варианта с их фактическими именами: создать по шаблону по умолчанию или создать с введённым именем. Использование введённого имени перезаписывает только первичный ключ, а значения полей по умолчанию, значок, шаблон содержимого и место сохранения по-прежнему берутся из шаблона по умолчанию. Если ввод пуст, шаблон первичного ключа не настроен или имена совпадают, показывается только один вариант. Если шаблон по умолчанию не настроен, создаётся независимая запись. Создание записи и обновление связи можно отменить вместе."
				}
			]
		},
		{
			"ID": "20261122113000-zp61skb",
			"Type": "NodeAttributeView",
			"Properties": {
				"id": "20261122113000-zp61skb",
				"updated": "20261122113000"
			},
			"AttributeViewID": "20261122113000-q4n3gjm",
			"AttributeViewType": "table"
		},
		{
			"ID": "20261122113000-7gm8lb2",
			"Type": "NodeAttributeView",
			"Properties": {
