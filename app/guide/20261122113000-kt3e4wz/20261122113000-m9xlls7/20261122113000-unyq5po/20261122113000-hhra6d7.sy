							"Properties": {
								"id": "20261122113000-acl4u9j",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Операции со строками"
								},
								{
									"Type": "NodeText",
									"Data": ": нажмите на начало строки, чтобы раскрыть детали строки; перетаскивайте строки для изменения порядка; правый клик по строке позволяет удалить, дублировать или переместить её в другую базу данных"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-hallrlz",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
