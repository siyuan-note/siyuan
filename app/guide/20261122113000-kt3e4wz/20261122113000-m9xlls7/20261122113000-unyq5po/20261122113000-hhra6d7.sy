			]
		},
		{
			"ID": "20261122113000-xhnrelc",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-xhnrelc",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Вид календаря"
				}
			]
		},
		{
			"ID": "20261122113000-nfb9ctr",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-nfb9ctr",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Отображает записи с датами по месяцам или неделям. Недельный вид содержит семь столбцов дат, а многодневные записи отображаются непрерывно на соответствующих днях. Текущий режим и просматриваемая дата в разных редакторах не влияют друг на друга. Режим месяца или недели каждого вида календаря сохраняется в текущем рабочем пространстве и восстанавливается при открытии в новом редакторе или после перезапуска SiYuan. Новый редактор начинает просмотр с сегодняшнего дня."
				}
			]
		},
		{
			"ID": "20261122113000-orxpcrq",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-orxpcrq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-a7mxrgp",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-a7mxrgp",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-wn8u3xa",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-wn8u3xa",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Способ переключения: выберите "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Макет"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Календарь"
								},
								{
									"Type": "NodeText",
									"Data": " в настройках вида; также можно вставить вид календаря базы данных через меню слэша"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-240v8g1",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-240v8g1",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-3uvcvmb",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-3uvcvmb",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Поле даты: выберите в настройках макета поле даты, времени создания или времени обновления. При отсутствии подходящего поля календарь предложит выбрать или создать поле и не будет автоматически заполнять обычные даты для существующих записей; записи без даты не отображаются в ячейках календаря. При привязке обычного поля даты такие записи можно найти в списке без даты"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-f1n2eek",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-f1n2eek",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-ea9e9sf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-ea9e9sf",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Дата по шаблону: если для поля даты задан шаблон отображения, календарь размещает записи по вычисленной шаблоном дате, а исходная дата остаётся без изменений. Шаблон должен выводить дату в виде обычного текста; поддерживаются форматы YYYY-MM-DD, выбранный в поле числовой формат даты, а также локальный формат даты текущего языка (например, 2 октября 2026 г.); можно добавить время HH:mm или HH:mm:ss через пробел или символ T. Даты интерпретируются в локальном часовом поясе текущего устройства, а даты со слэшами — строго по формату поля без угадывания порядка дня и месяца. Пустые результаты, некорректные даты и прочие форматы не отображаются и не попадают в список записей без даты. Вычисляемые даты нельзя перетаскивать, очищать или использовать для создания записи на дату — изменяйте исходное поле или шаблон; при многоязычном использовании рекомендуется выводить дату в формате YYYY-MM-DD"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-czk5chw",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-czk5chw",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-mn04964",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-mn04964",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Просмотр дат: переключайте даты кнопками «Назад», «Вперёд», «Сегодня» или выбором даты. В месячном виде дни с большим количеством записей сворачиваются — нажмите кнопку «Ещё», чтобы раскрыть соответствующую неделю. Даты отображаются в локальном часовом поясе текущего устройства. Месячный вид показывает четыре, пять или шесть недель в зависимости от потребностей месяца. В месячном и недельном видах у начальной даты каждой строки отображается номер недели ISO. Нажмите кнопку календаря, чтобы перейти к дате или к году и номеру недели ISO. Если неделя начинается не с понедельника, номер недели определяется по четвергу этой строки"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-csieuhv",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-csieuhv",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-tvpi0ik",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-tvpi0ik",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Редактирование записей: нажатие на запись открывает существующий интерфейс редактирования записи базы данных. При использовании обычного поля даты можно создавать записи через плюс в ячейке даты, перетаскивать запись для изменения даты или перетаскивать края для изменения диапазона дат. Нажатие кнопки «Без даты» рядом с фильтром вида позволяет искать незапланированные записи; перетащите запись в ячейку даты или сначала выберите запись, а затем нажмите на ячейку даты (на сенсорных устройствах также доступен второй способ). При планировании записывается дата на весь день, а после очистки даты запись возвращается в список без даты. Изменение даты поддерживает отмену; на сенсорных устройствах можно перетаскивать маркер перемещения на существующей записи в календаре. После нажатия или создания записи фокус автоматически переходит на поле первичного ключа; при перетаскивании предпросматривается изменённый диапазон дат и подсвечиваются соответствующие ячейки, а сохранение происходит после отпускания. Контекстное меню также поддерживает дублирование, создание и привязку нового документа, добавление в другую базу данных, редактирование полей и создание новой записи на выбранную дату"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-cd5g6g4",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-cd5g6g4",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-hqm0rkx",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-hqm0rkx",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Системное время: время создания и время обновления используют фактическое время записи или привязанного блока, не поддерживают перетаскивание и не предоставляют кнопку создания в ячейке даты"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-reu7cku",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-reu7cku",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-wpw2jkc",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-wpw2jkc",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Диапазон дат: диапазон на весь день включает день окончания; диапазон со временем, заканчивающийся в полночь, отображается до предыдущего дня. Если задана только одна граница, запись отображается на эту дату; если окончание раньше начала, отмечается ошибка и сохраняется исходное значение"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-1a2w5fr",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-1a2w5fr",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-5xdqqwu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-5xdqqwu",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Настройки вида: наследуются фильтрация, сортировка, видимость полей и шаблон новой записи базы данных, а фон записи можно задать через условные цвета. Макет календаря пока не применяет группировку, но при возврате к другому макету прежние настройки группировки сохраняются. В настройках макета количество отображаемых строк записей можно выбрать 3, 5, 10 или «Все» (по умолчанию 3), что сохраняется в текущем виде календаря. Эта настройка управляет только сворачиванием в месячном виде; в недельном виде показываются все записи, а данные в диапазоне дат загружаются полностью"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-fncswp9",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261122113000-fncswp9",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-l58i65a",
							"Type": "NodeParagraph",
							"Properties": {
