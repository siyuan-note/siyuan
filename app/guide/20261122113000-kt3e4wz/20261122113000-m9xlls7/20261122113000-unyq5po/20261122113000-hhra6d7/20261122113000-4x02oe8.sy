				},
				{
					"ID": "20261122113000-2rqtjyh",
					"Type": "NodeListItem",
					"Data": "-",
					"ListData": {
						"Tight": true,
						"BulletChar": 45,
						"Padding": 2,
						"Marker": "LQ==",
						"Num": -1
					},
					"Properties": {
						"id": "20261122113000-2rqtjyh",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-sns2kmu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-sns2kmu",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Способ редактирования"
								},
								{
									"Type": "NodeText",
									"Data": ": нажатие на ячейку открывает выбор даты. Общий выбор даты всегда отображает понедельник слева, а воскресенье справа независимо от языка интерфейса или региональных настроек; названия месяцев и дней недели отображаются на выбранном языке. В сетке календаря клавиша Home переходит к понедельнику текущей недели, а End — к воскресенью (с поддержкой перехода между месяцами и годами). Представление «Календарь» в базе данных сохраняет собственные настройки первого дня недели"
								}
							]
						}
					]
				},
