									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Настройки"
								},
								{
									"Type": "NodeText",
									"Data": ": при создании можно отметить «Включать время» и настроить диапазон дат (дата начала и окончания)"
								}
							]
						}
