		{
			"ID": "20261122113000-kuxxksq",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20261122113000-kuxxksq",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": ">"
				},
				{
					"ID": "20261122113000-qx8jae7",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20261122113000-qx8jae7",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "​"
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "code",
							"TextMarkTextContent": ".values"
						},
						{
							"Type": "NodeText",
							"Data": "​ — количество элементов зависит от типа столбца: пустые ячейки пропускаются; в столбцах с одиночными значениями (числа, текст и т. п.) каждая непустая ячейка считается одним значением; в столбцах с множественными значениями (множественный выбор, ресурсы и т. п.) каждый вариант считается отдельно (аналогично встроенному «Подсчёту значений»)."
						}
					]
				},
				{
					"ID": "20261122113000-uj02nnt",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20261122113000-uj02nnt",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"Type": "NodeTextMark",
							"TextMarkType": "code",
							"TextMarkTextContent": ".values"
						},
						{
							"Type": "NodeText",
							"Data": " содержит значения, полученные путём числового преобразования поля; непустой текст и другие значения, которые невозможно преобразовать в число, могут участвовать в расчёте как 0. Поэтому примеры числового сравнения следует использовать для числовых столбцов. Для сравнения исходного текста или проверки вариантов используйте "
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "code",
							"TextMarkTextContent": ".strings"
						},
						{
							"Type": "NodeText",
							"Data": " или "
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "code",
							"TextMarkTextContent": ".raw"
						},
						{
							"Type": "NodeText",
							"Data": ". Результат расчёта доли находится в диапазоне от 0 до 1 и может отображаться в процентном формате."
						}
					]
				}
			]
		},
