	"Properties": {
		"id": "20261122113000-hiyijl2",
		"title": "Гиперссылка на блок",
		"type": "doc",
		"updated": "20261122113000"
	},
	"Children": [
		{
			"ID": "20261122113000-hui1kf7",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-hui1kf7",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Обзор"
				}
			]
		},
		{
			"ID": "20261122113000-grbsujb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-grbsujb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если вам нужно запустить настольное приложение SiYuan из другого места (например, из браузера или программы, поддерживающей переходы по гиперссылкам), можно использовать гиперссылку "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "siyuan://"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-fghywid",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-fghywid",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Формат ссылки"
				}
			]
		},
		{
			"ID": "20261122113000-s5rwrwa",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-s5rwrwa",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "siyuan://blocks/{id}"
				},
				{
					"Type": "NodeText",
					"Data": ": напрямую открывает блок содержимого; требуется, чтобы блокнот с этим блоком уже был открыт."
				}
			]
		},
		{
			"ID": "20261122113000-pl8srt8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pl8srt8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Поддерживаемые параметры запроса:"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "focus=1"
				},
				{
					"Type": "NodeText",
					"Data": " означает открытие с фокусировкой, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "fullscreen=1"
				},
				{
					"Type": "NodeText",
					"Data": " означает открытие на весь экран. Гиперссылки на записи базы данных также могут содержать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "avItemID"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "avViewID"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "avGroupID"
				},
				{
					"Type": "NodeText",
					"Data": ", которые обычно автоматически генерируются командой "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Копировать гиперссылку на запись"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
