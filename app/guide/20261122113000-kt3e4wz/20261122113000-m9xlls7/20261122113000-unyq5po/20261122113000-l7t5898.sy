			]
		},
		{
			"ID": "20261122113000-djy948g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-djy948g",
				"updated": "20261126195512"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Завершение создания карточки: выберите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Быстро создать карточку"
				},
				{
					"Type": "NodeText",
					"Data": " в меню значка блока. Рядом с исходным блоком появится жёлтая вертикальная линия."
				}
			]
		},
		{
			"ID": "20261128115453-8vm89jy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128115453-8vm89jy",
				"updated": "20261128115453"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Введите / в абзаце и выберите «Скрытие областей изображения». Выберите изображение или перетащите его в диалоговое окно, чтобы вставить его и открыть редактор масок. Для выбранной маски можно указать ответ для самопроверки или ID блока с пояснением из обычного блокнота. При открытии маски введённый ответ проверяется и появляется пояснение. Из него можно перейти к исходному блоку. Оцените карточку после открытия последней маски."
				}
			]
		},
		{
			"ID": "20261128115453-xdh66p1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128115453-xdh66p1",
				"updated": "20261128115453"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите значок флеш-карточки рядом с исходным блоком, чтобы просмотреть карточки, приостановить или возобновить повторение отдельной карточки либо открыть расширенные настройки источника. Для источника вопросов и ответов можно также выбрать прямое, обратное или двустороннее направление."
				}
			]
		},
		{
			"ID": "20261128033010-riindy6",
			"Type": "NodeHeading",
			"HeadingLevel": 4,
			"Properties": {
				"id": "20261128033010-riindy6",
				"updated": "20261128033010"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Блоки, источники и флеш-карточки"
				}
			]
		},
		{
			"ID": "20261128033010-3bnea33",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128033010-3bnea33",
				"updated": "20261128033010"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Блоки содержат текст заметки. Источник карточек ссылается на блоки и хранит настройки создания, не копируя содержимое заметки. Один источник может ссылаться на один или несколько блоков, а разные источники могут ссылаться на один и тот же блок. Например, из блоков «Столица Китая» и «Пекин» можно сделать карточки в обоих направлениях: один источник создаст прямую и обратную карточки. Типы, такие как пропуски и скрытие областей изображения, выбираются для источника при создании, а не для каждой карточки по отдельности. После правки заметки содержимое карточек обновляется, но оценки и прогресс повторения у каждой карточки свои."
				}
			]
		},
		{
			"ID": "20261128033010-ewb0xrn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128033010-ewb0xrn",
				"updated": "20261128033010"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В колоду входят отдельные карточки, а не их источники. Прямую карточку можно добавить в «Географию», обратную — в «Вспомнить вопрос по ответу», а обе — в «Подготовку к экзамену». У одной и той же карточки общий прогресс во всех колодах."
				}
			]
		},
		{
			"ID": "20261128033010-x86au0l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128033010-x86au0l",
				"updated": "20261128033010"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Теги флеш-карточек не связаны с тегами заметок. Если добавить тег «Столицы» к источнику, его унаследуют обе карточки. Если добавить тег «Частая ошибка» только к обратной карточке, прямая не изменится. При фильтрации учитываются как унаследованные теги, так и теги, добавленные к отдельной карточке."
				}
			]
		},
		{
			"ID": "20261128033010-964odqm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261128033010-964odqm",
				"updated": "20261128033010"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Источник задаёт предустановку расписания по умолчанию; колода её не назначает. Если обе карточки используют A, а для обратной выбрать B, прямая продолжит использовать A. Чтобы обратная карточка снова использовала предустановку источника, верните наследование. Если при создании не выбрать предустановку, SiYuan проверит текущий документ, родительские документы, блокнот и настройки рабочего пространства в этом порядке и сохранит первую найденную предустановку в источнике."
				}
			]
		},
		{
			"ID": "20261122113000-wazw33q",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-wazw33q",
				"updated": "20261128180103"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Повторение"
				}
			]
		},
