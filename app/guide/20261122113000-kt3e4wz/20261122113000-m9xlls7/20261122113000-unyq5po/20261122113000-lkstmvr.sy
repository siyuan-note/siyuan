				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "символов"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "слов"
				},
				{
					"Type": "NodeText",
					"Data": " в текущем документе. Если в документе есть другие элементы, также отображается количество ссылок, изображений, ссылок на блоки и блоков."
				}
			]
		},
