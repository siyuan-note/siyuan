		},
		{
			"ID": "20261122113000-tmohru3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-tmohru3",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "«Ссылка» означает привязку файла ресурсов через гиперссылку, вставленное изображение или HTML-тег (например, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;img&gt;"
				},
				{
					"Type": "NodeText",
					"Data": " , "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;iframe&gt;"
				},
				{
					"Type": "NodeText",
					"Data": ") с атрибутом "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "src"
				},
				{
					"Type": "NodeText",
					"Data": ". Возможны два случая:"
				}
			]
		},
