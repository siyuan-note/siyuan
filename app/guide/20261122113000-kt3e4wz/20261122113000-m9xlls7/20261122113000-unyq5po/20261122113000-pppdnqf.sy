								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При включении в «"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Базовая аутентификация сервиса"
								},
								{
									"Type": "NodeText",
