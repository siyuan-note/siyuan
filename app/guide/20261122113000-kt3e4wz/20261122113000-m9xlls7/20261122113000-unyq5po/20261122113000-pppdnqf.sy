								},
								{
									"Type": "NodeText",
									"Data": "​: будет использоваться "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "a",
									"TextMarkAHref": "https://developer.mozilla.org/zh-CN/docs/Web/HTTP/Guides/Authentication#basic_%E9%AA%8C%E8%AF%81%E6%96%B9%E6%A1%88",
									"TextMarkTextContent": "схема Basic-аутентификации"
								},
								{
									"Type": "NodeText",
									"Data": " для аутентификации посетителей. Перед просмотром опубликованного содержимого посетитель должен правильно ввести имя пользователя и пароль, заданные в разделе "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Аутентифицированные учётные записи"
