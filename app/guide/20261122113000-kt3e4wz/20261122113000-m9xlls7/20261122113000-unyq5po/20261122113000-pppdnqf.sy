										{
											"ID": "20261122113000-xcv9o8x",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-xcv9o8x",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Порт по умолчанию — "
												},
												{
													"Type": "NodeTextMark",
													"TextMarkType": "code",
													"TextMarkTextContent": "6808"
												},
												{
													"Type": "NodeText",
													"Data": "​"
												},
												{
													"Type": "NodeText",
													"Data": ". При развёртывании через Docker с включённым сервисом публикации, помимо проброса основного порта сервера, в команду создания контейнера необходимо добавить "
												},
												{
													"Type": "NodeTextMark",
													"TextMarkType": "code",
													"TextMarkTextContent": "-p 6808:6808"
												},
												{
													"Type": "NodeText",
													"Data": ". Формат проброса портов Docker — порт_хоста:порт_контейнера; при изменении порта службы публикации необходимо синхронно изменить порт контейнера, а для доступа использовать порт хоста. Задавайте фиксированный порт службы публикации и не устанавливайте значение 0"
												}
											]
										}
									]
								},
								{
									"ID": "20261122113000-adry07x",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20261122113000-adry07x",
										"updated": "20261122113000"
									},
									"Children": [
										{
											"ID": "20261122113000-59k5syz",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-59k5syz",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Если указать порт "
												},
												{
													"Type": "NodeTextMark",
													"TextMarkType": "code",
													"TextMarkTextContent": "0"
												},
												{
													"Type": "NodeText",
													"Data": "​, будет использоваться случайный порт"
												}
											]
										}
									]
								}
							]
						}
					]
				},
