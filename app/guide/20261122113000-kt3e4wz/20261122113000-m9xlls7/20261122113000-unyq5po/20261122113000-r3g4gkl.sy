				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-29wb1rd",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-29wb1rd",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-b1422ko",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-b1422ko",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Протокол: прямое подключение (без прокси), системный прокси, HTTP, HTTPS или SOCKS5; для прямого подключения и системного прокси указывать хост и порт не требуется"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-hu16reg",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261122113000-hu16reg",
						"updated": "20261122113000"
					},
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261122113000-axz1jz0",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-axz1jz0",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Системный режим использует поддерживаемые настройки ОС или переменные окружения прокси, унаследованные при запуске ядра. Ядро поддерживает чтение ручных настроек прокси в Windows, Linux GNOME, Linux KDE и macOS; в Linux и macOS явно заданные переменные окружения прокси имеют приоритет. Автоматическая настройка PAC не поддерживается, как и автоопределение в Windows и macOS; на остальных платформах ядро сохраняет окружение прокси на момент запуска и не считывает системные настройки"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-385h720",
					"Type": "NodeListItem",
					"Properties": {
						"id": "20261122113000-385h720",
						"updated": "20261122113000"
					},
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Children": [
						{
							"ID": "20261122113000-vbmfn14",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-vbmfn14",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "В macOS поддерживаются ручные прокси HTTP, HTTPS и SOCKS5. Список исключений преобразуется в правила NO_PROXY с поддержкой IP-адресов, подсетей CIDR (включая 169.254/16), доменных имён, шаблонов доменов вида *. и хвостовых масок IPv4 вроде 10.*. Опция «Исключать простые имена хостов» и другие шаблоны подстановок не поддерживаются — используйте явные записи исключений. При ошибке чтения или преобразования ядро записывает предупреждение и сохраняет окружение прокси на момент запуска. После изменения системного прокси в macOS перезапустите ядро либо переключитесь на другой режим прокси и вернитесь обратно к системному"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-n76e9vl",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-n76e9vl",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-uf93s6p",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-uf93s6p",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Хост"
								},
								{
									"Type": "NodeText",
									"Data": ": укажите адрес прокси-сервера в формате "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "IP"
								},
								{
									"Type": "NodeText",
									"Data": "​ или "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "логин:пароль@IP"
								},
								{
									"Type": "NodeText",
									"Data": "​ (если требуется аутентификация)"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-9fvu5nf",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-9fvu5nf",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-11a1izu",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-11a1izu",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Порт"
								},
								{
									"Type": "NodeText",
									"Data": ": укажите порт прокси-сервера"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-fqo9d4v",
			"Type": "NodeParagraph",
