			]
		},
		{
			"ID": "20261122113000-qciggi3",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-qciggi3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Макет нового окна"
				}
			]
		},
		{
			"ID": "20261122113000-foj5m6q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-foj5m6q",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Макет нового окна используется для сохранения вкладок, разделения экрана и позиции чтения именованного окна. Макеты главного окна и макеты новых окон сгруппированы в одном меню макетов, но сохраняются раздельно. При сохранении или обновлении макета главного окна также записываются размер, положение и развёрнутое или полноэкранное состояние окна; для именованных новых окон эти сведения сохраняются автоматически. При открытии макета восстанавливается соответствующее состояние окна, а при изменении конфигурации мониторов оно корректируется в пределах доступного экрана."
				}
			]
		},
		{
			"ID": "20261122113000-8axcdf2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-8axcdf2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Старые макеты без информации об окне продолжают работать как обычно. Восстановление положения и размера окна ограничено возможностями операционной системы и может не поддерживаться в среде Wayland. Можно отметить не более одного макета главного окна и несколько макетов новых окон, а затем нажать кнопку «Открыть» над списком, чтобы открыть их одновременно; выбор флажков не сохраняется."
				}
			]
		},
		{
			"ID": "20261122113000-5gmr734",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-5gmr734",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Эта функция предназначена для настольного клиента; вкладки зашифрованных блокнотов не записываются в конфигурацию макета."
				},
				{
					"Type": "NodeText",
					"Data": "Повторное нажатие на кнопку макета закрывает всплывающее окно ввода имени. В разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Внешний вид"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Видимость и порядок меню и кнопок"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Верхняя панель нового окна"
				},
				{
					"Type": "NodeText",
					"Data": " можно настроить отображение и порядок кнопок макета и закрепления окна поверх остальных."
				}
			]
		},
		{
			"ID": "20261122113000-8ger21o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-8ger21o",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Создание: расположите вкладки в новом окне, нажмите кнопку "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сохранить как макет нового окна"
				},
				{
					"Type": "NodeText",
					"Data": ", введите название и сохраните. В дальнейшем изменения вкладок, разделения экрана, позиции чтения документов и номеров страниц PDF будут сохраняться автоматически."
				}
			]
		},
		{
			"ID": "20261122113000-onhj7nw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-onhj7nw",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Повторное открытие: в главном окне откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макет"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макеты нового окна"
				},
				{
					"Type": "NodeText",
					"Data": " и выберите макет, чтобы восстановить сохранённый макет в новом окне. Если соответствующее окно уже открыто, произойдёт переключение на него. Список поддерживает поиск по названию."
				}
			]
		},
		{
			"ID": "20261122113000-la6kdj6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-la6kdj6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Управление: рядом с разделом "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макеты главного окна"
				},
				{
					"Type": "NodeText",
					"Data": " нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сохранить"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы сохранить текущий макет главного окна. При наведении указателя мыши на элемент или стрелку справа от него открывается подменю при сохранении списка макетов. Для макетов новых окон последовательно доступны пункты "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Открыть"
				},
				{
					"Type": "NodeText",
					"Data": " (если соответствующее окно уже открыто, отображается "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Перейти"
				},
				{
					"Type": "NodeText",
					"Data": "）、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Переименовать"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Удалить"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20261122113000-y0w3irx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-y0w3irx",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Для макетов главного окна доступны пункты "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Использовать"
				},
				{
					"Type": "NodeText",
					"Data": ", загружающий выбранный макет, и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Обновить"
				},
				{
					"Type": "NodeText",
					"Data": ", сохраняющий текущее главное окно в эту запись (макеты новых окон сохраняются автоматически). В конце подменю обоих типов макетов отображается время последнего сохранения. Переименовать макет нового окна также можно, нажав на значок макета рядом с кнопкой закрепления окна."
				}
			]
		},
		{
			"ID": "20261122113000-7qi84cb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7qi84cb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Всплывающие окна переименования имеют заголовки "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макеты главного окна"
				},
				{
					"Type": "NodeText",
					"Data": " и "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Макеты нового окна"
				},
				{
					"Type": "NodeText",
					"Data": " соответственно и содержат кнопки «Отмена» и «ОК». Удаление макета сохраняет документы, вложения и открытые окна. Поле поиска закреплено сверху, а список ниже прокручивается независимо."
				}
			]
		},
