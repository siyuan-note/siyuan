							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Перетаскивание между окнами"
								},
								{
									"Type": "NodeText",
									"Data": ": вкладки можно перетаскивать между разными окнами"
