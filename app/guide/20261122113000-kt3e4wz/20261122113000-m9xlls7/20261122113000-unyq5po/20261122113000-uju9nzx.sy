							"ID": "20261122113000-6d7wis6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-6d7wis6",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Аннотация прямоугольной области"
								},
								{
									"Type": "NodeText",
									"Data": ": нажмите кнопку аннотации области на панели инструментов PDF и перетащите курсор по странице PDF, чтобы нарисовать прямоугольную область. Поддерживаются два стиля: залитый прямоугольник (с цветом фона) и контурный прямоугольник (только рамка), которые можно переключать кнопкой смены стиля в меню аннотации"
								}
							]
						}
					]
				}
			]
		},
