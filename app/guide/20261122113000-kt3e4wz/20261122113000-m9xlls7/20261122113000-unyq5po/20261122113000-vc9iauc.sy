							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-2vt2cgw",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Безопасно выйдите из SiYuan через "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Выйти из приложения"
								},
								{
									"Type": "NodeText",
									"Data": " в левом меню верхней панели и дождитесь завершения соответствующего процесса ядра"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-3env8yw",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Tight": true,
