					"Data": "Переключение рабочего пространства"
				}
			]
		},
		{
			"ID": "20261122113000-v0tw6xi",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-v0tw6xi",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-tdx4owp",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-tdx4owp",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-znai1t6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-znai1t6",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "На настольной версии можно открыть несколько рабочих пространств через выпадающее меню в левой части верхней панели"
								}
							]
						},
						{
							"ID": "20261122113000-7pr0ali",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-7pr0ali",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если вам нужно часто запускать несколько рабочих пространств, можно создать отдельный ярлык запуска для каждого из них и указать параметр запуска "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;абсолютный_путь_к_рабочему_пространству&quot;"
								},
								{
									"Type": "NodeText",
									"Data": " или "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace &quot;абсолютный_путь_к_рабочему_пространству&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​ (пожалуйста, используйте "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​, чтобы заключить путь в кавычки). Например, в Windows можно скопировать несколько ярлыков и в каждом в поле «Свойства» -> «Объект» добавить параметр пути к рабочему пространству, например "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--workspace=&quot;F:\\SiYuan&quot;"
								},
								{
									"Type": "NodeText",
									"Data": "​. Кроме того, можно указать порт, который прослушивает ядро, с помощью "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "--port=12345"
								},
								{
									"Type": "NodeText",
									"Data": ""
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-h7wqjmu",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-h7wqjmu",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-ajbrtq6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-ajbrtq6",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "На мобильных устройствах переключаться между рабочими пространствами можно в разделе "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Ещё"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Настройки"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Приложение"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Рабочее пространство"
								},
								{
									"Type": "NodeText",
									"Data": ""
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-hisfnh7",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
