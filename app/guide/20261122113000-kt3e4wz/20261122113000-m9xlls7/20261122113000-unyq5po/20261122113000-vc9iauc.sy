								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Перезапустите SiYuan и выберите переименованную папку в окне выбора рабочего пространства; если вы уже вошли в другое рабочее пространство, выберите эту папку через "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Рабочее пространство"
								},
								{
									"Type": "NodeText",
									"Data": " - "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "kbd",
									"TextMarkTextContent": "Создать / Открыть"
								},
								{
									"Type": "NodeText",
									"Data": " в левом меню верхней панели"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-lzle6mn",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-lzle6mn",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Простое закрытие окна или открытие другого рабочего пространства не обязательно завершает исходное рабочее пространство. Если вы использовали параметр "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--workspace"
				},
				{
					"Type": "NodeText",
					"Data": ", перед перезапуском обновите путь в команде запуска или ярлыке на новое имя."
				}
			]
		},
