								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Разные рабочие пространства изолированы друг от друга папками файловой системы"
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-r11qqs5",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-r11qqs5"
					},
					"Children": [
						{
							"ID": "20261122113000-5a81j5u",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-5a81j5u",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Одно рабочее пространство может обслуживаться только одним процессом ядра"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-fg5pmzm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
