				{
					"Type": "NodeText",
					"Data": "Использование в браузере"
				}
			]
		},
		{
			"ID": "20261122113000-um035i4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-um035i4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В запущенном приложении откройте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сервер"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Используйте в обозревателе"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Открыть обозреватель"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы работать с приложением в локальном браузере. Не останавливайте ядро и используйте открытый адрес с его портом."
				}
			]
		},
		{
			"ID": "20261122113000-gof2ep9",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-gof2ep9",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перед доступом с других устройств в той же локальной сети сначала задайте пароль блокировки экрана или корректную конфигурацию "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-8q8xgxj",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Вход через OIDC"
				},
				{
					"Type": "NodeText",
					"Data": ", включите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сервер"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сетевое обслуживание"
				},
				{
					"Type": "NodeText",
					"Data": " и перезапустите SiYuan после полного выхода. Затем замените в адресе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "127.0.0.1"
				},
				{
					"Type": "NodeText",
					"Data": " на IP-адрес компьютера с ядром в локальной сети, сохранив указанный порт, и разрешите этот порт в брандмауэре. Для доступа из внешней сети можно использовать следующие способы развёртывания:"
				}
			]
		},
		{
