					"Type": "NodeText",
					"Data": "Вход через OIDC"
				}
			]
		},
		{
			"ID": "20261122113000-op2r18r",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-op2r18r",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Подробное описание провайдеров, URL обратного вызова, правил доступа, входа с нескольких устройств, настройки Docker и устранения неполадок см. в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-8q8xgxj",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Вход через OIDC"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		}
	]
