					"Data": "### "
				},
				{
					"Type": "NodeText",
					"Data": "пароля блокировки экрана"
				}
			]
		},
		{
			"ID": "20261122113000-uysh8gv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-uysh8gv",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Вход и токены"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Пароль блокировки экрана"
				},
				{
					"Type": "NodeText",
					"Data": " задайте пароль блокировки экрана. Если оставить поле пустым, вход по паролю будет отключён; однако для обычного нелокального доступа всё равно требуется пароль или корректная настройка OIDC. Сначала настройте аутентификацию и только затем открывайте доступ к ядру для других устройств."
				}
			]
		},
		{
			"ID": "20261122113000-i5p2y0m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-i5p2y0m",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Параметр "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Блокировать вместе с системой"
				},
				{
					"Type": "NodeText",
					"Data": " для настольного клиента поддерживается только в Windows и macOS. В Linux перед блокировкой системы заблокируйте SiYuan вручную через пункт "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Заблокировать экран"
				},
				{
					"Type": "NodeText",
					"Data": " в меню рабочего пространства."
				}
			]
		},
		{
			"ID": "20261122113000-rm6dybk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-rm6dybk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Вход и токены"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Обои экрана блокировки"
				},
				{
					"Type": "NodeText",
					"Data": " загрузите изображение JPEG, PNG или WebP (до 10 MiB и 16 мегапикселей), чтобы настроить фон страницы аутентификации при запуске и после блокировки экрана. Также можно нажать «Встроенные» и выбрать изображение из галереи по категориям. Встроенные картинки широкоформатные: при заполнении экрана они обрезаются по центру, особенно заметно в портретной ориентации. Выбор или загрузка нового изображения заменяет прежнее, а кнопка «Сбросить» возвращает фон по умолчанию."
				}
			]
		},
		{
			"ID": "20261122113000-vr1f2od",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-vr1f2od",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Настройка обоев появляется после установки пароля или включения входа через OIDC. При использовании пользовательских обоев страница аутентификации сначала показывает фон и местное время; панель входа появляется после клика, касания экрана или нажатия клавиши. Если сразу начать вводить пароль, первый символ тоже попадёт в поле пароля. Если обои не заданы или изображение не удалось загрузить, сразу отображается стандартный экран входа."
				},
				{
					"Type": "NodeText",
					"Data": "Когда панель входа открыта, нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " для возврата к обоям и часам; введённый пароль и код проверки сохраняются. При переходе вперёд и назад проигрывается короткая анимация (при включённом в системе уменьшении движения переключение происходит мгновенно)."
				}
			]
		},
		{
			"ID": "20261122113000-gmqwsbu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-gmqwsbu",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Обои хранятся в текущем рабочем пространстве, не участвуют в синхронизации заметок и не включаются в экспорт настроек. До входа в систему это изображение видит любой, у кого есть доступ к странице аутентификации, поэтому не выбирайте картинки с конфиденциальной информацией."
				}
			]
		},
		{
			"ID": "20261122113000-nyn16vl",
			"Type": "NodeHeading",
			"HeadingLevel": 3,
			"Properties": {
				"id": "20261122113000-nyn16vl",
				"updated": "20261122113000"
