			]
		},
		{
			"ID": "20261122113000-sihuxvk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-sihuxvk",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Исполняемый файл CLI — "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;каталог_установки&gt;/resources/kernel/SiYuan-Kernel"
				},
				{
					"Type": "NodeText",
					"Data": "​; его можно вызывать командой "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "siyuan"
				},
				{
					"Type": "NodeText",
					"Data": "​."
				}
			]
		},
		{
			"ID": "20261122113000-6q95zp3",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20261122113000-6q95zp3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"ID": "20261122113000-slnleyl",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20261122113000-slnleyl",
						"updated": "20261122113000"
					},
					"Children": [
						{
							"ID": "20261122113000-yskz9hl",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-yskz9hl",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "Windows"
								},
								{
									"Type": "NodeText",
									"Data": ": установщик автоматически добавляет каталог ядра в "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "PATH"
								},
								{
									"Type": "NodeText",
									"Data": "​, поэтому можно сразу использовать "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan"
								},
								{
									"Type": "NodeText",
									"Data": "​"
								},
								{
									"Type": "NodeText",
									"Data": ". Версия из Microsoft Store (3.8.7 и выше) в Windows 10 1607 (сборка 14393) и новее регистрирует псевдоним выполнения приложения "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan.exe"
								},
								{
									"Type": "NodeText",
									"Data": "​. После установки или обновления откройте новый терминал и выполните "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan --help"
								},
								{
									"Type": "NodeText",
									"Data": "​"
								}
							]
						},
						{
							"ID": "20261122115500-rnst0r1",
							"Type": "NodeCodeBlock",
							"IsFencedCodeBlock": true,
							"Properties": {
								"id": "20261122115500-rnst0r1",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeCodeBlockFenceOpenMarker",
									"Data": "```"
								},
								{
									"Type": "NodeCodeBlockFenceInfoMarker",
									"CodeBlockInfo": "cG93ZXJzaGVsbA=="
								},
								{
									"Type": "NodeCodeBlockCode",
									"Data": "siyuan --help\n\n# Проверить фактически используемую команду\nGet-Command siyuan -All\nwhere.exe siyuan\n"
								},
								{
									"Type": "NodeCodeBlockFenceCloseMarker",
									"Data": "```"
								}
							]
						},
						{
							"ID": "20261122113000-zljqcsh",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-zljqcsh",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если команда не найдена, проверьте, включён ли в Windows псевдоним выполнения приложения для SiYuan, и добавлен ли путь "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "%LOCALAPPDATA%\\Microsoft\\WindowsApps"
								},
								{
									"Type": "NodeText",
									"Data": " в переменную "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "PATH"
								},
								{
									"Type": "NodeText",
									"Data": ". Указанные выше команды позволяют проверить разрешение имени команды; одновременная установка нескольких версий SiYuan или порядок записей в "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "PATH"
								},
								{
									"Type": "NodeText",
									"Data": " могут привести к вызову другого исполняемого файла"
								}
							]
						},
						{
							"ID": "20261122115500-rnun1n2",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122115500-rnun1n2",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Если ранее создавался старый перенаправитель "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "siyuan.cmd"
								},
								{
									"Type": "NodeText",
									"Data": ", сначала выполните "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "& \"$env:LOCALAPPDATA\\Microsoft\\WindowsApps\\siyuan.exe\" --help"
								},
								{
									"Type": "NodeText",
									"Data": ", чтобы убедиться в работоспособности псевдонима версии из Microsoft Store, а затем при необходимости удалите перенаправитель:"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Remove-Item \"$env:LOCALAPPDATA\\Microsoft\\WindowsApps\\siyuan.cmd\""
								}
							]
						}
					]
				},
				{
					"ID": "20261122113000-f5s2emb",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
