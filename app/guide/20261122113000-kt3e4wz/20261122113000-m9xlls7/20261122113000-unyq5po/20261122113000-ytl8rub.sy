			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Используйте "
				},
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "repo create --memo \"checkpoint\""
				},
				{
					"Type": "NodeText",
					"Data": " для создания контрольной точки снимка."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "export data"
				},
				{
					"Type": "NodeText",
					"Data": " экспортирует только полный каталог "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "data"
				},
				{
					"Type": "NodeText",
					"Data": " и не включает "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "conf"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "history"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "repo"
				},
				{
					"Type": "NodeText",
					"Data": " и другие каталоги рабочего пространства, поэтому не является полной резервной копией рабочего пространства; при наличии хотя бы одного зашифрованного блокнота выполнение будет отклонено."
				}
			]
		},
