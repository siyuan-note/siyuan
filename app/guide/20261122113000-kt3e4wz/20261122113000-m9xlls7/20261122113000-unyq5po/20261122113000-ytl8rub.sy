				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--safe-mode"
				},
				{
					"Type": "NodeText",
					"Data": " включает безопасный режим."
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--attach-ui"
				},
