					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--readonly"
				},
				{
					"Type": "NodeText",
					"Data": " включает режим только для чтения, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--accessAuthCode"
				},
				{
					"Type": "NodeText",
					"Data": " задаёт код доступа для аутентификации, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--lang"
				},
				{
					"Type": "NodeText",
					"Data": " задаёт язык интерфейса, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "--mode"
				},
				{
					"Type": "NodeText",
					"Data": " задаёт режим dev или prod, "
