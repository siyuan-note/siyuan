		{
			"ID": "20261122113000-liluep2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-liluep2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SiYuan оснащён встроенным CLI (интерфейсом командной строки), позволяющим напрямую обращаться к данным рабочего пространства без запуска службы ядра. Он удобен для автоматизации с помощью скриптов, массового управления и чтения/записи заметок совместно с ИИ-агентами."
				}
			]
		},
		{
			"ID": "20261122113000-yeg1618",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-yeg1618",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "siyuan [глобальные_флаги] &lt;команда&gt; [параметры]"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20261122113000-sy566l5",
