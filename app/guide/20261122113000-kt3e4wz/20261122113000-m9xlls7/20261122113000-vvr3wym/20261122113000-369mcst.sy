		},
		{
			"ID": "20261123123905-vqws36w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261123123905-vqws36w",
				"updated": "20261128033450"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В новых рабочих пространствах эта проверка по умолчанию выключена. Чтобы получать предупреждение перед удалением или вырезанием блоков, на которые есть ссылки или которые привязаны к базе данных, включите в настройках редактора «Проверять ссылки на блоки перед удалением или вырезанием». Если проверка ссылок на блоки и привязок к базам данных затянулась, нажмите «Отмена» в окне проверки, чтобы прервать удаление или вырезание."
				}
			]
		},
