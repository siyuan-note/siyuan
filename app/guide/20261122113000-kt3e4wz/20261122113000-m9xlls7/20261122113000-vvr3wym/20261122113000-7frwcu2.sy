			"Children": [
				{
					"Type": "NodeText",
					"Data": "Пользовательские атрибуты"
				}
			]
		},
		{
			"ID": "20261122113000-171otur",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-171otur",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Создаётся через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Меню значка блока"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Свойства"
				},
				{
					"Type": "NodeText",
					"Data": " задаёт пользовательские атрибуты. Имя должно начинаться со строчной латинской буквы и может содержать строчные буквы, цифры и дефис (-), например "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "doing"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "day1"
				},
				{
					"Type": "NodeText",
					"Data": "、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "project-id"
				},
				{
					"Type": "NodeText",
					"Data": ". После сохранения SiYuan автоматически добавляет префикс "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "custom-"
				},
				{
					"Type": "NodeText",
					"Data": " для отличия от встроенных атрибутов."
				}
			]
		},
		{
			"ID": "20261122113000-m6of1ru",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-m6of1ru",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Запрос блоков по атрибутам"
				}
			]
		},
		{
			"ID": "20261122113000-7jmaqq8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7jmaqq8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Например, если для блока задан атрибут "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "progress=30"
				},
				{
					"Type": "NodeText",
					"Data": "、 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "priority=2"
				},
				{
					"Type": "NodeText",
					"Data": ", можно найти через SQL все блоки с прогрессом 30 и приоритетом 2:"
				}
			]
		},
		{
			"ID": "20261122113000-kau4fvm",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20261122113000-kau4fvm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "c3Fs"
				},
				{
					"ID": "20261122113000-0gnpt1q",
					"Type": "NodeCodeBlockCode",
					"Data": "SELECT *\nFROM blocks\nWHERE id IN (\n    SELECT block_id\n    FROM attributes AS a\n    WHERE (a.name = 'custom-progress' AND a.value = '30')\n       OR (a.name = 'custom-priority' AND a.value = '2')\n    GROUP BY block_id\n    HAVING count(block_id) = 2\n);\n",
					"Properties": {
						"id": "20261122113000-0gnpt1q"
					}
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		}
	]
}