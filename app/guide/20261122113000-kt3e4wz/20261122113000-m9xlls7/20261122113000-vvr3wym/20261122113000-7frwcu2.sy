			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "На панели атрибутов псевдонимы отображаются как теги. При вводе можно разделять их английской запятой для массового добавления."
				}
			]
		},
		{
			"ID": "20261122113000-7wyun15",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7wyun15",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " или снимите фокус для сохранения, нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " для отмены ввода."
				}
			]
		},
		{
			"ID": "20261122113000-hq7whhs",
