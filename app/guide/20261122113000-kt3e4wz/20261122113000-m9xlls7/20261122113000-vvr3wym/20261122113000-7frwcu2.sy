			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Перетаскивайте псевдонимы для изменения порядка; при перетаскивании нажмите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
