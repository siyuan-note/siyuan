				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Поведение"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Угловая иконка блока контента"
				},
				{
					"Type": "NodeText",
					"Data": ", можно отображать имя, псевдонимы и примечание в редакторе."
				}
			]
		},
		{
			"ID": "20261122113000-rh4ov3g",
			"Type": "NodeParagraph",
			"Properties": {
