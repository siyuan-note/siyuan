			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Определение блока контента"
				}
			]
		},
		{
			"ID": "20261122113000-olekzta",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-olekzta",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Блок контента — это единица содержимого в SiYuan, которую можно независимо редактировать, цитировать и организовывать. Каждый блок имеет автоматически сгенерированный глобально уникальный ID, например "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "20261122113000-zm774i1"
				},
				{
					"Type": "NodeText",
					"Data": ". ID состоит из 14-значной метки времени ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "YYYYMMDDHHMMSS"
				},
				{
					"Type": "NodeText",
					"Data": "), дефиса и 7 случайных строчных латинских букв или цифр."
				}
			]
		},
		{
			"ID": "20261122113000-vfroqny",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-vfroqny",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Типы блоков контента"
				}
			]
		},
		{
			"ID": "20261122113000-mvfzkhv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-mvfzkhv",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Самый распространённый блок — абзац, используемый для основного текста. Каждый абзац является независимым блоком."
				}
			]
		},
		{
			"ID": "20261122113000-zb91knp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-zb91knp",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Заголовки, списки, таблицы и блоки цитат выражают различные структуры содержимого."
				}
			]
		},
		{
			"ID": "20261122113000-ic8alae",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-ic8alae",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Особенности и правила вложенности каждого типа описаны в разделе "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-heqg3qd",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "Типы блоков контента"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20261122113000-zr50zj6",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-zr50zj6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Комбинирование блоков контента"
				}
			]
		},
		{
			"ID": "20261122113000-qia8dw6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-qia8dw6",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Документ состоит из нескольких блоков. Типы, способные содержать другие блоки, называются контейнерными блоками (например, списки и цитаты)."
				}
			]
		},
		{
			"ID": "20261122113000-fso6byb",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-fso6byb",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Сам документ также является блоком контента. Как весь документ, так и отдельные абзацы можно связывать через "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-369mcst",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "ссылки на блоки контента"
				},
				{
					"Type": "NodeText",
					"Data": ", не разбивая текст на отдельные документы."
				}
			]
		},
		{
			"ID": "20261122113000-ob7oz0z",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261122113000-ob7oz0z",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Имя, псевдонимы и примечание"
				}
			]
		},
		{
			"ID": "20261122113000-0mzd5ya",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-0mzd5ya",
				"memo": "Примечание обычно представляет собой короткую фразу.",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Для блока можно задать имя, псевдонимы и примечание. Имя и псевдонимы используются для "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "block-ref",
					"TextMarkBlockRefID": "20261122113000-xheyk4j",
					"TextMarkBlockRefSubtype": "s",
					"TextMarkTextContent": "упоминаний в обратных ссылках"
				},
				{
					"Type": "NodeText",
					"Data": "; примечание служит для дополнительной информации, не отображаемой в основном тексте."
				}
			]
		},
		{
			"ID": "20261122113000-edr6xdr",
			"Type": "NodeParagraph",
			"Properties": {
