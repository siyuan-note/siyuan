		{
			"ID": "20261122113000-pnlm2q1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-pnlm2q1",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если в блоке таблицы нужно использовать "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "|"
				},
				{
					"Type": "NodeText",
					"Data": "​ , используйте экранирование "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
