				},
				{
					"Type": "NodeText",
					"Data": "​。"
				}
			]
		},
		{
			"ID": "20261122113000-otwzsy5",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-otwzsy5",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Для переноса строки в ячейке используйте "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Введите"
				},
				{
					"Type": "NodeText",
					"Data": "​。"
				}
			]
		},
		{
			"ID": "20261122113000-j2wmil3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-j2wmil3",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Если таблица содержит объединённые ячейки или многострочный заголовок, при копировании и экспорте в Markdown используется HTML-таблица."
				}
			]
		},
		{
			"ID": "20261122113000-n95eghm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-n95eghm",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Откройте меню блока и выберите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Блок таблицы"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Закрепить столбец заголовка"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы первый столбец оставался видимым при горизонтальной прокрутке. Можно одновременно включить "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Закрепить строку заголовка"
				},
				{
					"Type": "NodeText",
					"Data": ", чтобы шапка таблицы оставалась видимой и при вертикальной прокрутке. Объединённые ячейки, охватывающие первый и последующие столбцы, прокручиваются вместе со всей таблицей. Если видимая область слишком узкая, первый столбец временно прокручивается вместе с таблицей."
				}
			]
		},
		{
			"ID": "20261122113000-4sylnko",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-4sylnko",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "На мобильном устройстве нажмите на ячейку для редактирования текста; долгое нажатие переводит в режим выделения области."
				}
			]
		},
		{
			"ID": "20261122113000-um1x4f8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-um1x4f8",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "После нажатия на ячейку на границах её строки и столбца появляются синие маркеры для выделения всей строки или столбца."
				}
			]
		},
		{
			"ID": "20261122113000-qnvrej2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-qnvrej2",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Нажмите на разделитель столбцов и перетащите его по горизонтали для изменения ширины столбца."
				}
			]
		},
