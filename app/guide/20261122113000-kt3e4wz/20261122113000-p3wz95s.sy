		{
			"ID": "20261122113000-wj68i84",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-wj68i84",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Мобильные темы могут использовать селектор `#keyboardToolbar.keyboard--sheet-open` для стилизации состояния, когда одновременно отображаются панель инструментов клавиатуры и нижнее меню или диалоговая панель. Это состояние определяется логикой видимости в приложении и не зависит от стилей, заданных темой. Класс удаляется при скрытии панели инструментов или закрытии всех нижних панелей."
				}
			]
		},
		{
			"ID": "20261122113000-s4r32bf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-s4r32bf",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Примечание"
				},
				{
					"Type": "NodeText",
					"Data": "​:"
				}
			]
		},
		{
			"ID": "20261122113000-iesntwx",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
