									},
									"Properties": {
										"id": "20261122113000-xnc3ls2",
										"updated": "20261126150544"
									},
									"Children": [
										{
											"ID": "20261122113000-cfacw2z",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-cfacw2z",
												"updated": "20261126150544"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Если документ создаётся напрямую через API (например, через API "
												},
												{
													"Type": "NodeTextMark",
													"TextMarkType": "code",
													"TextMarkTextContent": "createDocWithMd"
												},
												{
													"Type": "NodeText",
													"Data": "​), добавьте этот атрибут документу вручную"
												}
											]
										}
									]
								}
							]
						}
					]
