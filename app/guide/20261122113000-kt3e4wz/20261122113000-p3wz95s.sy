					"Children": [
						{
							"ID": "20261122113000-qm48cgp",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-qm48cgp",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При создании ежедневной заметки SiYuan автоматически добавляет документу атрибут `custom-dailynote-yyyymmdd`, чтобы отличать ежедневные заметки от обычных документов"
								}
							]
						},
						{
							"ID": "20261122113000-kws326k",
							"Type": "NodeBlockquote",
							"Properties": {
								"id": "20261122113000-kws326k",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeBlockquoteMarker",
									"Data": ">"
								},
								{
									"ID": "20261122113000-b5f11w9",
									"Type": "NodeParagraph",
									"Properties": {
										"id": "20261122113000-b5f11w9",
										"updated": "20261122113000"
									},
									"Children": [
										{
											"Type": "NodeText",
											"Data": "Подробнее см. GitHub Issue #9807"
										}
									]
								}
							]
						},
						{
							"ID": "20261122113000-w73wo79",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20261122113000-w73wo79",
								"updated": "20261126150544"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "При создании ежедневной заметки из кода учитывайте следующее:"
								}
							]
						},
						{
							"ID": "20261122113000-i6rrl38",
							"Type": "NodeList",
							"ListData": {},
							"Properties": {
								"id": "20261122113000-i6rrl38",
								"updated": "20261126150544"
							},
							"Children": [
								{
									"ID": "20261122113000-kiiqhan",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20261122113000-kiiqhan",
										"updated": "20261122113000"
									},
									"Children": [
										{
											"ID": "20261122113000-jpztxvv",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20261122113000-jpztxvv",
												"updated": "20261122113000"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "Если вызывается "
												},
												{
													"Type": "NodeTextMark",
													"TextMarkType": "code",
													"TextMarkTextContent": "/api/filetree/createDailyNote"
												},
												{
													"Type": "NodeText",
													"Data": "​ для создания ежедневной заметки, этот атрибут добавляется документу автоматически и не требует дополнительной обработки"
												}
											]
										}
									]
								},
								{
									"ID": "20261122113000-xnc3ls2",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
