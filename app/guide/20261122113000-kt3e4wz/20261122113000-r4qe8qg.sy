			"Children": [
				{
					"Type": "NodeText",
					"Data": "Использование маркетплейса"
				}
			]
		},
		{
			"ID": "20261122113000-9ndvdj4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-9ndvdj4",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В некоторых версиях из магазинов приложений маркетплейс может отсутствовать внутри приложения из-за требований модерации."
				}
			]
		},
		{
			"ID": "20261122113000-uxivjyo",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-uxivjyo",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "В ограниченных версиях маркетплейс всё равно можно использовать: включите "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Аутентификация"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Сетевое обслуживание"
				},
				{
					"Type": "NodeText",
					"Data": ", а затем откройте SiYuan через браузер на компьютере."
				}
			]
		},
		{
