							"Properties": {
								"id": "20261122113000-d8uxyp9",
								"updated": "20261122113000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Автоматический перенос: во время работы SiYuan каждые 7 секунд проверяет локальный каталог быстрых заметок и переносит новые записи в заданное место в панели документов"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20261122113000-f7kzaui",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-f7kzaui",
				"updated": "20261126150544"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Импортированные быстрые заметки следуют переключателям синтаксиса Markdown в "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Настройки"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Редактор"
				},
				{
					"Type": "NodeText",
					"Data": ". Включённый строчный синтаксис, ограждения кода со средней точкой ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "···"
				},
				{
					"Type": "NodeText",
					"Data": ") и полноширинный быстрый синтаксис задач ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "【】"
				},
				{
					"Type": "NodeText",
					"Data": ", "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "【X】"
				},
				{
					"Type": "NodeText",
					"Data": ") преобразуются сразу при импорте без необходимости повторного редактирования."
				}
			]
		},
		{
			"ID": "20261122113000-7fj5ohi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261122113000-7fj5ohi",
				"updated": "20261122113000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Каждая быстрая заметка разбирается отдельно, поэтому незакрытый блок кода не повлияет на следующую заметку. Уже импортированные документы повторно не разбираются."
				}
			]
		},
