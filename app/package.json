{
  "name": "SiYuan",
  "desktopName": "org.b3log.siyuan",
  "version": "3.8.11-alpha.1",
  "description": "From thought to insight, with agents",
  "homepage": "https://b3log.org/siyuan",
  "main": "./electron-dist/main.js",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "pnpm run typecheck && eslint . --fix --cache && pnpm run css:check && pnpm run menu:check && node scripts/startup-languages.mjs --check",
    "menu:check": "node ../scripts/check-menu-owner.mjs",
    "css:check": "node scripts/css-contracts.mjs",
    "css:unused": "node scripts/css-contracts.mjs --report-unused",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.api.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.electron.test.json",
    "api:generate": "node scripts/api-contracts.mjs",
    "api:check": "node scripts/api-contracts.mjs --check",
    "test": "node scripts/test.mjs",
    "test:focused": "node scripts/test-focused.mjs",
    "test:quicklook:macos": "node scripts/test-quicklook-macos.js",
    "test:changed": "node scripts/test-changed.mjs",
    "test:affected": "node scripts/test-changed.mjs --run",
    "dev": "webpack --mode development --config webpack.config.js --config webpack.markdown.js",
    "dev:markdown": "webpack --mode development --config webpack.markdown.js",
    "prepare:markdown": "node scripts/markdown-assets.js",
    "dev:mobile": "webpack --mode development --config webpack.mobile.js",
    "dev:desktop": "webpack --mode development --config webpack.desktop.js",
    "dev:export": "webpack --mode development --config webpack.export.js",
    "build": "node scripts/clean-stage.mjs && pnpm run /build:.*/",
    "build:app": "webpack --mode production --config webpack.config.js",
    "build:mobile": "webpack --mode production --config webpack.mobile.js",
    "build:desktop": "webpack --mode production --config webpack.desktop.js",
    "build:electron": "node scripts/build-electron.mjs",
    "build:export": "webpack --mode production --config webpack.export.js",
    "build:markdown": "webpack --mode production --config webpack.markdown.js",
    "gen:types": "tsc -d",
    "gen:arch": "node ../scripts/generate-arch-svg.js",
    "start": "pnpm run build:electron && cross-env NODE_ENV=development electron ./electron-dist/main.js",
    "start:simulate-rosetta": "pnpm run build:electron && cross-env NODE_ENV=development electron ./electron-dist/main.js --simulate-rosetta",
    "install:electron": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "sign:dev": "node scripts/signDevElectron.js",
    "dist": "pnpm run build:electron && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.yml --publish=never",
    "dist-arm64": "pnpm run build:electron && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --config electron-builder-arm64.yml --publish=never",
    "dist-darwin": "pnpm run build:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder-darwin.yml --publish=never",
    "dist-darwin-arm64": "pnpm run build:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --mac --config electron-builder-darwin-arm64.yml --publish=never",
    "dist-linux": "pnpm run build:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder-linux.yml --publish=never",
    "dist-linux-arm64": "pnpm run build:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --linux --config electron-builder-linux-arm64.yml --publish=never"
  },
  "keywords": [
    "markdown",
    "note-taking",
    "notebook"
  ],
  "author": {
    "name": "Yunnan Liandi Technology Co., Ltd.",
    "email": "845765@qq.com",
    "url": "https://ld246.com"
  },
  "maintainers": [
    {
      "name": "Liang Ding",
      "email": "845765@qq.com",
      "url": "https://ld246.com/member/88250"
    },
    {
      "name": "Liyuan Li",
      "email": "84588990@qq.com",
      "url": "https://ld246.com/member/Vanessa"
    }
  ],
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "blueimp-md5": "^2.19.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dayjs": "^1.11.23",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "encoding": "^0.1.14",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.14.0",
    "file-loader": "^6.2.0",
    "filesize": "^11.0.28",
    "globals": "^15.12.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.5.0",
    "iconv-lite": "^0.7.3",
    "ifdef-loader": "^2.3.2",
    "mini-css-extract-plugin": "2.10.2",
    "parse5": "7.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.29",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.7",
    "safer-buffer": "^2.1.2",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unzipper": "0.12.5",
    "vditor": "4.0.2-alpha.8",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "zxcvbn": "4.4.2"
  }
}
