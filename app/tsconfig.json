{
  "compilerOptions": {
    "outDir": "./src/types/dist",
    "rootDir": "./src",
    "strict": false,
    "useDefineForClassFields": false,
    "noImplicitAny": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
