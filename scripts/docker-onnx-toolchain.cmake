# 使用构建机的 Clang 和目标 Alpine 的开发文件，避免在模拟器内执行编译器。
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_SYSROOT /arm-sysroot)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET armv7-alpine-linux-musleabihf)
set(CMAKE_CXX_COMPILER_TARGET armv7-alpine-linux-musleabihf)
set(CMAKE_ASM_COMPILER_TARGET armv7-alpine-linux-musleabihf)

if("$ENV{TARGETVARIANT}" STREQUAL "v8")
    set(ARM_FLAGS "-march=armv8-a -mfpu=neon-fp-armv8 -mfloat-abi=hard")
else()
    set(ARM_FLAGS "-march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard")
endif()
set(CMAKE_C_FLAGS_INIT "${ARM_FLAGS} --gcc-toolchain=/arm-sysroot/usr")
set(CMAKE_CXX_FLAGS_INIT "${ARM_FLAGS} --gcc-toolchain=/arm-sysroot/usr")
set(CMAKE_ASM_FLAGS_INIT "${ARM_FLAGS} --gcc-toolchain=/arm-sysroot/usr")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH /arm-sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
